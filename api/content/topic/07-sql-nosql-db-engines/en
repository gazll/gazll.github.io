{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},"meta":{"topic_type":"data","key":"07-sql-nosql-db-engines","vi":{"label":"SQL/NoSQL & DB engines","title":"SQL vs NoSQL — Oracle / MySQL / PostgreSQL / MongoDB","intro":"Bức tranh toàn cảnh các hệ CSDL: khi nào SQL/NoSQL, vì sao doanh nghiệp chuộng Oracle, và phần so sánh trực tiếp Oracle–MySQL từ storage vật lý, toàn vẹn dữ liệu, ACID tới CAP.","tags":["SQL vs NoSQL","Oracle RAC/PLSQL","PostgreSQL","MongoDB/WiredTiger","ACID vs BASE","Oracle vs MySQL","Data integrity","CAP (C/A/P)","Redis","Search engine"]},"en":{"label":"SQL/NoSQL & DB engines","title":"SQL vs NoSQL — Oracle / MySQL / PostgreSQL / MongoDB","intro":"The whole database landscape: when SQL and when NoSQL, why enterprises stay on Oracle, and a direct Oracle–MySQL comparison from physical storage and data integrity through ACID and CAP.","tags":["SQL vs NoSQL","Oracle RAC/PLSQL","PostgreSQL","MongoDB/WiredTiger","ACID vs BASE","Oracle vs MySQL","Data integrity","CAP (C/A/P)","Redis","Search engine"]},"created_at":"2026-07-31","updated_at":"2026-11-06"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"07-sql-nosql-db-engines.engine-by-engine.q4":"2026-08-12","07-sql-nosql-db-engines.engine-by-engine.q2":"2026-08-01","07-sql-nosql-db-engines.engine-by-engine.q5":"2026-08-01","07-sql-nosql-db-engines.the-big-picture.q4":"2026-08-03","07-sql-nosql-db-engines.engine-by-engine.q8":"2026-08-03","07-sql-nosql-db-engines.engine-by-engine.q9":"2026-08-10","07-sql-nosql-db-engines.engine-by-engine.q10":"2026-08-23","07-sql-nosql-db-engines.engine-by-engine.q11":"2026-11-06"},"lang":"en","body":{"sections":[{"title":"The big picture","items":[{"id":"07-sql-nosql-db-engines.the-big-picture.q1","q":"SQL vs NoSQL — how do you choose based on the problem?","a":"- [[b:SQL (relational)]]: strict schema, strong ACID, complex relationships, flexible querying (JOIN, aggregate) — the standard for financial/transactional data\n- [[b:NoSQL]]: flexible schema, easy horizontal scaling, optimized for a specific access pattern, usually BASE/eventual\n\n<table class=\"cmp\"><thead><tr><th>Criteria</th><th>SQL</th><th>NoSQL</th></tr></thead><tbody>\n<tr><td>Schema</td><td>strict, constrained, migrations</td><td>flexible, schema-on-read</td></tr>\n<tr><td>Consistency</td><td>strong ACID</td><td>BASE/eventual (depends)</td></tr>\n<tr><td>Relations/JOIN</td><td>strong</td><td>weak, favors denormalization</td></tr>\n<tr><td>Scale</td><td>scale-up + replicas; sharding is hard</td><td>horizontal scale-out</td></tr>\n<tr><td>Good fit for</td><td>ledgers, transactions</td><td>catalogs, sessions, logs, time-series</td></tr>\n</tbody></table>\n\nIn practice it's usually [[g:polyglot persistence]]: each service picks the DB that fits its job.\n\n:::deep\nAvoid the binary 'which one is better' — reason in terms of access pattern + consistency requirements.\n\nOTA polyglot: booking/payment use Postgres (ACID), price &amp; availability are cached in Redis, search logs go to Elasticsearch, events go through Kafka.\n\n**The physical layer is a separate axis.** SQL versus NoSQL describes the logical model, API, and transaction contract; B+Tree versus LSM describes how one storage engine arranges pages, sorted runs, logs, and I/O.\n\nInnoDB and PostgreSQL commonly expose B-tree paths, Cassandra and RocksDB use LSM-shaped components, and the labels still cross: a NoSQL product such as MongoDB/WiredTiger can use B-trees, while a SQL product such as CockroachDB can sit on an LSM-based Pebble layer.\n\nRead the physical walkthrough at (05-db-core-index-lock.transactions-mvcc-locking.q7).\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.the-big-picture.q2","q":"The types of NoSQL and their typical use cases?","a":"<table class=\"cmp\"><thead><tr><th>Type</th><th>Example</th><th>Use case</th></tr></thead><tbody>\n<tr><td>Document</td><td>MongoDB</td><td>profile/catalog/CMS (nested JSON)</td></tr>\n<tr><td>Key-Value</td><td>Redis, DynamoDB</td><td>cache, session, counter</td></tr>\n<tr><td>Wide-column</td><td>Cassandra, HBase</td><td>heavy writes, time-series, IoT</td></tr>\n<tr><td>Graph</td><td>Neo4j</td><td>social, fraud, recommendation</td></tr>\n</tbody></table>\n\n:::deep\n- [[b:Document]] (Mongo): reads a whole aggregate in one go (itinerary/profile), flexible schema, but cross-document relationships/transactions are weak\n- [[b:Key-Value]] (Redis/DynamoDB): extremely fast by key (cache/session/counter/feature flag); non-key queries are weak\n- [[b:Wide-column]] (Cassandra): massive writes, scales linearly per node, modeled *around the query* (denormalize, no JOIN); tunable consistency\n- [[b:Graph]] (Neo4j): multi-hop relationships (fraud rings, recommendations, connecting-flight itineraries)\n\nOTA: Cassandra/Scylla for clickstream/search logs; Redis for price caching &amp; seat holds; graph for 'find the optimal connecting itinerary'. Choose by access pattern, not by how 'hot' the technology is.\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.the-big-picture.q3","q":"ACID vs BASE — the philosophical trade-off?","a":"- [[b:ACID]] (Atomicity, Consistency, Isolation, Durability): prioritizes correctness — the RDBMS standard, mandatory for ledgers\n- [[b:BASE]] (Basically Available, Soft state, Eventual consistency): prioritizes availability & scale, accepts eventual consistency — common in distributed NoSQL\n\nThis is the design-philosophy-level expression of CAP/PACELC.\n\n:::deep\n- ACID = a property of a *transaction* (correctness); BASE = a *distributed-systems philosophy* (availability + eventual consistency)\n- [[r:'Eventual consistency' is not a vague 'it'll be correct if you wait long enough']] — you must define the *convergence window*, the conflict-resolution mechanism (LWW/CRDT/version vector), and the acceptance boundary\n\nFintech/OTA — a clear dividing line:\n- ledger/balance/seat hold = [[g:ACID]] (absolute consistency)\n- history/loyalty/notifications = [[o:BASE]]\n\nThe key question: 'where does a DECISION about money get made based on this data?' → that part must be ACID.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.the-big-picture.q4","difficulty":"advanced","q":"CAP: what do Consistency, Availability and Partition Tolerance actually promise—and does SQL automatically choose C while NoSQL chooses A?","a":"CAP applies to a **distributed service** whose replicas communicate over a network; it is not a label attached to every SQL or NoSQL database. The three guarantees are:\n\n<table class=\"cmp\"><thead><tr><th>Letter</th><th>Guarantee</th><th>What it does not mean</th></tr></thead><tbody>\n<tr><td>C — Consistency</td><td>every successful read behaves as if there were one current copy (linearizable)</td><td>not the same as ACID's “valid state” invariant</td></tr>\n<tr><td>A — Availability</td><td>every request to a non-failed node eventually receives a non-error response</td><td>the response may be stale; it is not an uptime/SLA promise</td></tr>\n<tr><td>P — Partition tolerance</td><td>the service keeps operating while messages between nodes are lost, delayed, or split by a network partition</td><td>it does not mean that every kind of node or disk failure is harmless</td></tr>\n</tbody></table>\n\nWhen a partition separates replicas, a system cannot keep all three guarantees. “Pick two” is a useful shorthand, not a deployment recipe: in a real distributed system P is usually an operating assumption, so the choice is what to sacrifice during the partition.\n\n<table class=\"cmp\"><thead><tr><th>During a partition</th><th>What the system does</th><th>Cost</th></tr></thead><tbody>\n<tr><td>CP</td><td>waits for a quorum or rejects a conflicting operation, preserving a single ordering of writes</td><td>some requests fail or block, so availability falls</td></tr>\n<tr><td>AP</td><td>continues serving each reachable side and reconciles replicas later</td><td>reads can be stale and concurrent writes can need conflict resolution</td></tr>\n</tbody></table>\n\nSQL versus NoSQL is not a CAP classification:\n- a single-node Oracle or MySQL instance has no replica-to-replica partition to tolerate;\n- a distributed SQL database can use quorum/CP behaviour, while a relational read replica can still be stale;\n- NoSQL engines range from AP/eventual to strongly consistent or tunable, depending on the engine, topology, and read/write policy.\n\n:::deep\nCAP-C is usually discussed as [[b:linearizability]] (a read sees the newest completed write in real-time order); ACID-C means that a transaction preserves the application's constraints and invariants.\n\nCAP-A means a reachable, non-failed node answers; ACID-D means a committed change survives failure. They are different axes, so “SQL is consistent” and “NoSQL is available” are both too broad.\n\nPACELC adds a second question: **else** (when there is no partition), do we trade latency for stronger consistency? Define the consistency contract per operation, then test failover and recovery rather than assigning a permanent CAP badge to a product.\n:::"}]},{"title":"Engine by engine","items":[{"id":"07-sql-nosql-db-engines.engine-by-engine.q1","q":"Why do large enterprises still favor Oracle — from features down to physical storage?","a":"Oracle is expensive but still chosen for core systems because of:\n- [[b:RAC]] (Real Application Clusters): multiple instances sharing storage → HA & scale, transparent failover\n- powerful [[b:PL/SQL]]; a mature optimizer; partitioning, materialized views, Flashback, Data Guard (DR)\n- deep physical administration: tablespaces, ASM, redo/undo, RMAN backup\n- [[g:enterprise support + contracts + compliance certification]] — decisive in banking/insurance\n\n:::tip Bottom line\nenterprises pay for HA, mature operational tooling, and 'a single throat to choke' when something breaks — not just SQL features.\n:::\n\n:::deep\n- [[b:RAC]] (instances sharing storage via Cache Fusion) → HA + scale, transparent failover\n- [[b:Data Guard]] (DR standby), [[b:RMAN]] backup, [[b:Flashback]] (restore a past state — invaluable for financial investigations), [[b:ASM]], partitioning &amp; parallel query, an extremely mature optimizer/PLSQL\n- the core value: [[g:HA + tooling + support contracts + compliance]] — downtime/errors mean lost money + legal exposure\n\nTrend: new systems shift to Postgres (cost), but legacy core banking stays on Oracle because of migration risk &amp; operational features.\n:::\n\n**The whole picture:** how buffer cache, undo, redo and SCN serve a read and a locking read is (07-sql-nosql-db-engines.engine-by-engine.q11).","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q2","q":"Why is MySQL/InnoDB widely used, and where does it fit best?","a":"MySQL/InnoDB is a pragmatic OLTP default because it combines ACID transactions, MVCC, clustered primary-key storage, secondary indexes, foreign keys, crash recovery, replication options, mature drivers, and broad managed-service support.\n\nMySQL now publishes two release tracks. [[g:8.4 is an LTS series]] aimed at a stable feature set and longer support; Innovation releases deliver features and behavior changes more frequently. Pin the track and upgrade path explicitly—“MySQL 8” is no longer a sufficient production target.\n\n<table class=\"cmp\"><thead><tr><th>Good fit</th><th>Investigate before choosing</th></tr></thead><tbody>\n<tr><td>transactional web/SaaS workloads with well-understood access paths</td><td>complex analytical SQL, extension requirements, or specialized index/operator needs</td></tr>\n<tr><td>teams that value operational familiarity and managed offerings</td><td>write topology, failover semantics, replica lag, backup/restore RTO and licensing/support</td></tr>\n<tr><td>schemas that benefit from relational constraints</td><td>hot clustered keys, large secondary indexes, and cross-region consistency requirements</td></tr>\n</tbody></table>\n\n:::deep\nInnoDB's clustered index means every secondary-index leaf stores the primary key. A short, stable primary key can reduce all secondary indexes; a random or ever-growing hot key changes page locality and write behavior.\n\nIts redo log provides durability, undo records support MVCC/rollback, and the buffer pool controls most read performance—these are concrete mechanisms, not “cheap but good enough.”\n\nDo not transfer cloud-product claims to upstream MySQL. Aurora, Cloud SQL, RDS, and self-managed MySQL have different storage, replication, failover, observability, and cost models. Benchmark the selected product and topology, including failover and restore, rather than comparing only SQL features.\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q3","q":"How does PostgreSQL differ from MySQL, and why is it on the rise?","a":"- stricter SQL standard compliance; advanced features: [[g:JSONB]] (indexable), recursive CTEs, powerful window functions, partial/expression/GiST/GIN indexes, materialized views\n- a rich set of [[g:extensions]]: PostGIS (geo), TimescaleDB (time-series), [[g:pgvector]] (AI embeddings) → a 'do-it-all' database\n- MVCC works differently from MySQL: stores tuple versions inside the table → needs [[o:VACUUM]] to clean up dead tuples\n\n:::tip Bottom line\nPostgres wins when you need advanced features + JSON + extensions (especially pgvector for AI). MySQL wins on simplicity & ubiquity.\n:::\n\n:::deep\n- [[b:JSONB]] (binary, GIN-indexable — a hybrid relational+document model), recursive CTEs, window functions, partial/expression indexes\n- [[b:extensions]]: PostGIS, TimescaleDB, [[g:pgvector]] (a major reason Postgres is rising in the AI era)\n- MVCC stores tuple versions *inside the table* → requires `VACUUM`/autovacuum; falling behind → [[r:table/index bloat]] + transaction ID wraparound (requires a vacuum freeze)\n\nOTA: Postgres + pgvector for semantic recommendations/search, JSONB for trip-search-result snapshots, PostGIS for 'airports near you'.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q4","q":"When can MongoDB's document model make reads efficient, and what does it trade away?","a":"MongoDB can make a known aggregate read efficient when data that is read and changed together is embedded in one bounded document. One indexed lookup can then return the aggregate without application-side joins or several network round trips.\n\nThat advantage comes from [[g:data modelling and access-path locality]], not a rule that MongoDB is faster than SQL.\n\nTrade-offs are workload-specific:\n\n- embedding can duplicate data and make fan-out updates or document growth expensive;\n- referencing keeps one source of truth but reintroduces multiple reads or `$lookup`;\n- a document has a size limit, and broad projections waste cache/network if the aggregate is too large;\n- relational databases can be equally fast for indexed point reads and are often clearer for ad-hoc joins, constraints, and set-based analysis;\n- MongoDB supports transactions and configurable consistency; it is wrong to classify it as inherently weak-consistency storage.\n\n:::warn Compare equivalent models\nMeasure the same business response, indexes, durability/consistency settings, dataset larger than memory, concurrency, and network topology. Comparing one denormalized MongoDB read with N unindexed SQL queries measures schema/query design, not database-engine speed.\n:::\n\n:::deep\nWiredTiger provides MVCC, compression, cache management, and document-level write concurrency. Performance still depends on index selectivity, working-set fit, document shape, update amplification, checkpoints, and storage latency.\n\nGood candidates include bounded catalog/product views, user preferences, and immutable snapshots.\n\nMoney ledgers or inventory can also be stored in MongoDB only if the chosen schema, unique constraints, transaction boundary, write/read concerns, audit trail, and operational recovery prove the invariant.\n\nChoosing an RDBMS is often simpler, but it is an engineering decision rather than a product label.\n\n**Runnable `mongosh` example — one embedded document makes the hold atomic:**\n<pre><code>db.inventory.insertOne({_id:\"sku-1\", available:1, version:7, holds:[]})\ndb.inventory.updateOne(\n  {_id:\"sku-1\", available:{$gte:1}, version:7},\n  {$inc:{available:-1, version:1},\n   $push:{holds:{id:\"h-42\", expiresAt:new Date(Date.now()+300000)}}}\n)\n// matchedCount: 1, modifiedCount: 1\n// run the same update again: matchedCount: 0; it cannot oversell this document</code></pre>\n\nThe atomic single-document update rechecks its predicate, so the expected version prevents a lost update.\n\n- **Benefit:** inventory, version and hold move together without a multi-document transaction.\n- **Cost:** one popular document becomes a hot serialization point; `holds` cannot grow without bound, and duplicated data needs an update policy.\n- **Exit criterion:** reference or bucket children when cardinality or lifecycle no longer fits one aggregate.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q5","q":"MongoDB: sharding and the consistency model?","a":"Sharding and consistency are separate design axes.\n\n- A shard key determines data placement and whether a query can target one shard. Evaluate cardinality, frequency, monotonicity, query routing, zone requirements, document growth, and the ability to refine or reshard later; a poor key creates hotspots or scatter-gather work.\n- `readPreference` chooses which replica-set member may serve a read. The default is `primary`.\n- `readConcern` controls consistency/isolation. The default `local` concern can return data that is later rolled back, even when reading from the primary—so “primary by default means strong consistency” is false.\n- `writeConcern` controls acknowledgement/durability. A majority write combined with the right read concern/session semantics gives stronger guarantees at availability/latency cost.\n\n<pre><code><span class=\"c\">// Example policy for an invariant-sensitive operation; tune to the actual contract</span>\nsession.<span class=\"f\">withTransaction</span>(work,\n    TransactionOptions.<span class=\"f\">builder</span>()\n        .<span class=\"f\">readConcern</span>(ReadConcern.SNAPSHOT)\n        .<span class=\"f\">writeConcern</span>(WriteConcern.MAJORITY)\n        .<span class=\"f\">readPreference</span>(ReadPreference.primary())\n        .<span class=\"f\">build</span>());</code></pre>\n\n:::deep\n`majority` reads return majority-committed data but do not by themselves mean “the newest value anywhere.” `linearizable` reads have stricter real-time semantics for eligible single-document reads on the primary and should use `maxTimeMS`.\n\nCausally consistent sessions are the tool for guarantees such as read-your-own-writes across related operations.\n\nMulti-document transactions are a supported correctness mechanism, not something to ban.\n\nThey add coordination and can reduce throughput, so keep them short and measure them; model a bounded aggregate into one document when that naturally preserves the invariant, and use a transaction when the invariant genuinely crosses documents.\n\nAvoiding a necessary transaction is not an optimization.\n:::","difficulty":"extra"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q6","q":"Redis: why is it fast, what data structures does it offer, and how does persistence work?","a":"Redis is fast because it's [[g:in-memory]] + a single-threaded event loop (no lock contention) + data structures tuned for the job.\n\n**Data structures:** string, hash, list, set, sorted set (leaderboards!), stream, bitmap, HyperLogLog.\n\n**Persistence:**\n- [[b:RDB]] (snapshot)\n- [[b:AOF]] (append log)\n\n→ a trade-off between durability and performance.\n\nUsed for: caching, sessions, rate limiting, lightweight queues, distributed locks, leaderboards.\n\n:::deep\n- single-threaded data path → one O(N) command (`KEYS *`, `SMEMBERS` on a large set) [[r:blocks everything]] → avoid it; use the `SCAN` cursor\n- persistence: RDB (loses data between two snapshots) vs AOF (`everysec` is the common balance); use both for high durability\n- HA: Redis Sentinel (failover) or Redis Cluster (16384 hash slots + replicas)\n- [[r:lock/dedup]]: TTL expiring mid-operation → breaks correctness → use a fencing token\n\nOTA: seat-hold TTL (`SET seat NX PX`), short-TTL price/availability caching, token-bucket rate limiting, sorted sets for 'trending routes/inventory counts'.\n\n- This exact TTL mechanism is a common LLD question: implementing your own key-value store with TTL using lazy expiration + sampling, just like Redis does (22-low-level-design-ood.patterns-in-interview-code.q4).\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q7","q":"A decision framework: how do you choose a DB for a specific use case?","a":"Ask in sequence:\n- does the data have [[b:relationships]]? does it need [[b:strong ACID]]?\n- [[b:access pattern]]: by key / range / full-text / graph?\n- read/write ratio & scale? strong or eventual consistency?\n\n**Quick map:**\n- ledger/transactions → RDBMS (Postgres/MySQL/Oracle)\n- cache/session → Redis\n- catalog/CMS → MongoDB\n- time-series/heavy writes → Cassandra/Timescale\n- search → Elasticsearch\n- AI embeddings → pgvector\n\nOften you combine several — [[g:polyglot persistence]].\n\n:::deep\nQuestion framework: (1) relational &amp; needs JOIN? (2) needs strong ACID (money/booking)? (3) primary access pattern? (4) read/write & scale (beyond a single node)? (5) strong or eventual?\n\nMap: ledger/booking → RDBMS; cache/session/seat-hold → Redis; flight/destination search → Elasticsearch; large clickstream/logs → Cassandra/Timescale; AI embeddings → pgvector; analytics → columnar (ClickHouse/BigQuery).\n\n[[r:Mistake]]: forcing one DB to do everything, or adding a new DB just because it's 'trendy' (raises operational cost).\n:::","difficulty":"extra"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q8","difficulty":"advanced","q":"Oracle vs MySQL/InnoDB: when does the enterprise premium buy something real?","a":"Oracle Database and MySQL with InnoDB are both relational SQL systems, and both can provide ACID transactions. Compare the **engine, topology, durability settings, workload, and operating contract**—not the product names alone.\n\n**Term note — High Availability / Disaster Recovery (HA/DR):** HA keeps the service available through instance or node failures. DR restores service and data after a site-level or regional failure. Their targets are usually expressed as RTO (recovery time objective) and RPO (recovery point objective).\n\n<table class='cmp'><thead><tr><th>Dimension</th><th>Oracle Database</th><th>MySQL + InnoDB</th></tr></thead><tbody>\n<tr><td>Process and memory</td><td><b>Memory:</b> SGA/PGA<br><b>Log writer:</b> LGWR<br><b>Database writers:</b> DBWn; checkpoint coordination: CKPT</td><td><b>Process:</b> <code>mysqld</code><br><b>Memory:</b> InnoDB buffer pool and log buffer</td></tr>\n<tr><td>Logical → disk</td><td><b>Hierarchy:</b> tablespace → segment → extent → block<br>Datafiles contain data/index blocks; control files describe the database.</td><td><b>Hierarchy:</b> tables/indexes → pages<br>The clustered primary-key index stores the row; tablespaces include <code>.ibd</code>, system, undo, and temporary space.</td></tr>\n<tr><td>Transaction and recovery</td><td><b>Rollback/read consistency:</b> undo<br><b>Recovery:</b> online and archived redo, checkpoints, RMAN, and Flashback</td><td><b>Concurrency/rollback:</b> undo + multi-version concurrency control (MVCC)<br><b>Recovery:</b> redo + doublewrite<br><b>Replication/PITR:</b> a separate binary log</td></tr>\n<tr><td>High availability / disaster recovery (HA/DR)</td><td><b>HA:</b> RAC + Cache Fusion<br><b>DR:</b> Data Guard with Maximum Protection, Maximum Availability, or Maximum Performance (default)</td><td><b>HA:</b> Group Replication/InnoDB Cluster or a managed-service equivalent<br><b>Replication/DR:</b> binlog replicas, often asynchronous; the exact guarantee depends on topology</td></tr>\n<tr><td>Integrity and isolation</td><td><b>Integrity:</b> declarative constraints, automatic locking, and multiversion read consistency<br><b>Default isolation:</b> READ COMMITTED; also SERIALIZABLE and READ ONLY</td><td><b>Integrity:</b> primary/unique/foreign-key constraints, row locks, and MVCC; CHECK is enforced since 8.0.16<br><b>Default isolation:</b> REPEATABLE READ</td></tr>\n<tr><td>Cost and operations</td><td>Deep enterprise tooling, support, and certification<br>Higher licence/option cost and DBA complexity</td><td>Low entry cost, familiar drivers, and many managed offerings<br>Enterprise support and HA still carry operational cost</td></tr>\n</tbody></table>\n\nThe engines use different names and files, but the write-ahead principle can be read as three separate paths:\n\n<pre><code>WRITE — transaction is running\nSQL statement\n    ↓\nlocking + MVCC visibility\n    ↓\nchange page in memory\n+ create undo\n    ↓\ngenerate redo records\n(write-ahead logging principle)\n────────────────────────────\nCOMMIT — synchronous critical path\nCOMMIT\n    ↓\nflush required redo\nto durable storage\n    ↓\nACK success to client\n────────────────────────────\nPAGE WRITE — asynchronous\ndirty pages stay in buffer\n    ↓\ncheckpoint / DBWn /\nbackground writer\n    ↓\ndatafile pages</code></pre>\n\nCrash recovery is a second, separate flow:\n\n<pre><code>CRASH\n  ↓\nREDO\nroll forward durable log records\nsince the last checkpoint\n  ↓\nUNDO\nroll back transactions\nwithout a commit record</code></pre>\n\nRedo can therefore restore changes from an incomplete transaction before undo removes them. “Redo only committed work” is an oversimplification.\n\n**Data integrity has separate layers:**\n\n- **Entity rules:** primary key and NOT NULL\n- **Referential rules:** foreign keys\n- **Domain rules:** types, CHECK, and UNIQUE\n- **Business invariants:** a transaction boundary plus the required lock or isolation level\n\nRedo, checksums, backup, and point-in-time recovery protect the physical copy. They do not replace constraints.\n\n**MySQL/InnoDB durability settings:**\n\n- The guarantees here are for InnoDB. A non-transactional table, disabled `foreign_key_checks`, relaxed flush policy, or asynchronous replica changes the real contract.\n- `innodb_flush_log_at_trx_commit=1` (default): write and flush redo at every commit; this is the fully durable transaction setting.\n- `innodb_flush_log_at_trx_commit=2`: write redo to the OS cache at commit; survives a `mysqld` crash, but not necessarily an OS crash or power loss.\n- `innodb_flush_log_at_trx_commit=0`: write and flush periodically; even a process crash can lose recent commits. The interval is approximately one second, not a guaranteed maximum.\n- Use `sync_binlog=1` with `innodb_flush_log_at_trx_commit=1` when the binary log must follow the fully durable contract too.\n\n**Oracle commit behaviour has two independent axes:**\n\n- `WAIT|NOWAIT`: whether COMMIT waits until redo is persistent—the durability decision\n- `IMMEDIATE|BATCH`: whether redo is offered immediately or batched for group commit\n\nThe default is `WAIT IMMEDIATE`; `COMMIT_WAIT` and `COMMIT_LOGGING` apply when the clause is omitted. In either product, read the selected configuration instead of inferring durability from the brand.\n\n**ACID is a transaction contract:**\n\n- **Atomicity:** commit everything or roll everything back.\n- **Consistency:** move from one valid, invariant-preserving state to another.\n- **Isolation:** control what concurrent transactions can observe.\n- **Durability:** a successful commit survives the failures covered by the log, storage, and configuration.\n\nACID-C is not CAP-C, and ACID-D is not CAP-A; see (07-sql-nosql-db-engines.the-big-picture.q4).\n\n**When Oracle's premium can be justified:**\n\n- RAC/Data Guard materially reduce the required RTO/RPO.\n- Mature recovery, audit, compliance, partitioning, parallel execution, PL/SQL, or optimizer behaviour matters to the workload.\n- Vendor SLA/certification or an existing Oracle estate reduces operational and migration risk.\n- The organisation accepts separately licensed options, support cost, and DBA complexity.\n\n**When MySQL/InnoDB is often the better fit:**\n\n- Web/SaaS OLTP has clear access paths and a well-defined transaction boundary.\n- The team prioritises lower cost and managed-cloud operations.\n- The chosen topology passes the same durability, failover, and backup/restore tests.\n- The benchmark keeps schema, indexes, durability policy, dataset, and RTO/RPO comparable.\n\nAurora, RDS, Cloud SQL, and self-managed MySQL are different products. Do not transfer one topology's storage, replication, or failover claims to another.\n\n:::deep\nUse Oracle when the invariant is mission-critical **and** the organisation values High Availability / Disaster Recovery, recovery, compliance, and support enough to pay for that ecosystem.\n\nUse MySQL/InnoDB when the same required guarantees can be proven with a simpler topology and lower total cost. Start with the invariant and access pattern; choose the brand after recovery and failover testing.\n:::\n\n**The whole picture:** how Oracle's reads use undo and SCN on top of this write path is (07-sql-nosql-db-engines.engine-by-engine.q11)."},{"id":"07-sql-nosql-db-engines.engine-by-engine.q9","q":"When does a search engine earn its place next to the database, and what must it never own?","a":"Relational full-text search is fine until you need relevance ranking, fuzzy matching, faceting and aggregation over millions of documents at low latency. That is the point where an inverted index stops being optional (05-db-core-index-lock.indexes-what-they-really-are.q1).\n\n<table class=\"cmp\"><thead><tr><th></th><th>Relational `LIKE`/full-text</th><th>Search engine</th></tr></thead><tbody>\n<tr><td>`%term%`</td><td>full scan, no index</td><td>indexed by token</td></tr>\n<tr><td>Relevance</td><td>none, or bolted on</td><td>scoring is the core feature</td></tr>\n<tr><td>Typos, synonyms, stemming</td><td>manual</td><td>analyzers</td></tr>\n<tr><td>Facets over millions of rows</td><td>heavy aggregation</td><td>designed for it</td></tr>\n<tr><td>Transactions and correctness</td><td>ACID</td><td>[[r:near real-time, no transactions]]</td></tr>\n</tbody></table>\n\n**The index is a read model, not a database.** It is derived data — rebuildable from the source at any time — which is exactly what makes it safe to reindex, and exactly why it must never be the system of record (12-architecture-patterns.domain-driven-design.q4).\n\n**Feeding it.** Writing to the database and the index in the same request is a dual write: one of them fails and the two drift apart forever. Feed it from the outbox or from CDC so the index follows a log rather than a best effort (06-db-scaling.sharding-partitioning.q7).\n\n:::warn Near real-time is visible to users\nA document is searchable after a refresh, not at commit. \"I just saved it and search cannot find it\" is the expected behaviour — read the detail page from the database, not from the index.\n:::\n\n:::deep\n- [[g:reindex behind an alias]]: build the new index, verify, then flip the alias atomically. Mapping changes are not in-place edits, and pretending otherwise turns a schema tweak into downtime.\n- decide [[o:what the index stores]]: enough to render a result list, no more. Storing the whole document tempts people to read it as truth and doubles the data you must protect (13-security-oauth2.protecting-the-data-you-store.q2).\n- deep pagination has the same cost problem it has in SQL; use `search_after` rather than large offsets (04-rest-grpc-webflux.protocols.q5).\n- a search cluster is an operational commitment: heap and shard sizing, snapshots, version upgrades, and a reindex path. Do not add one for a feature a well-chosen index would serve (07-sql-nosql-db-engines.engine-by-engine.q7).\n- the same shape covers analytics: derive a read store from the transactional one, keep the derivation replayable, and never let reports run on the primary.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q10","difficulty":"advanced","q":"How do you make a search, cache, or OLAP projection rebuildable and freshness-aware?","a":"Treat the transactional model as the authority and every derived store as a versioned projection. The projection contract needs more than a connection string:\n\n- a snapshot boundary and a replay source\n- event identity, aggregate/key, source version or log position, and the ordering scope\n- schema version, upsert semantics, delete/tombstone handling, and retention\n- a watermark/freshness metric and a policy for stale, paused, or failed states\n- a repair path that can replay a range or rebuild a new version\n\n- **Search mapping or materialized table:** build version N+1 beside N, backfill it, catch up from the recorded position, compare counts and domain samples, then swap an alias or controlled route.\n- **Cache:** define invalidation/version/TTL and accept that eviction or loss is normal; do not pretend cache persistence is source durability.\n- **OLAP:** define late-arriving data, correction, lineage, and access control rather than running reports on the OLTP primary.\n\nCDC is useful because it supplies a replayable change stream, but at-least-once delivery still requires idempotent/version-checked projection writes. A healthy consumer process is not proof that it has applied every source change.\n\n:::warn Never let a stale derived store authorize a critical mutation\nSearch can find a candidate, cache can accelerate a read, and OLAP can answer an aggregate. Charge, grant entitlement, decrement inventory, and settle money against the authority or an explicitly authoritative design.\n:::"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q11","difficulty":"advanced","q":"Oracle at a glance: how do buffer cache, undo, redo, SCN, MVCC and isolation serve a SELECT and a SELECT FOR UPDATE?","a":"In one line: a plain `SELECT` reads the past without locking; `SELECT ... FOR UPDATE` works on the present and locks it. The [[b:SCN]] picks which past, [[g:undo]] rebuilds it, and [[g:redo]] makes a commit durable.\n\n<figure class='db-figure'><a href='/assets/diagrams/oracle-select-index-heap.webp' target='_blank' rel='noopener noreferrer'><img src='/assets/diagrams/oracle-select-index-heap.webp' alt='A primary-key SELECT in Oracle step by step: parse and snapshot SCN, B-tree root and leaf, ROWID, heap block and row directory, with buffer cache and disk' width='1536' height='1024' loading='lazy' decoding='async'></a><figcaption>One plain SELECT by primary key, from parse to result, with a consistent read check at every block. Its labels are in Vietnamese. Writes, FOR UPDATE and isolation are covered below. Open it for full size.</figcaption></figure>\n\n**Memory and disk.** The buffer cache holds current blocks plus consistent read (CR) clones. DBWn writes dirty blocks to datafiles later; LGWR writes the redo log buffer to the online redo log.\n\nDetail: (07-sql-nosql-db-engines.engine-by-engine.q8)\n\n**A write.** The row is locked until `COMMIT` or `ROLLBACK`. Undo keeps the old value, and one redo record covers both the data block and the undo block. The commit is LGWR's write of that redo and the commit SCN; data blocks follow later.\n\nDetail: (05-db-core-index-lock.transactions-mvcc-locking.q8)\n\n**A plain SELECT.** It takes a snapshot SCN, then finds each block in the cache or reads it from a datafile. If the block holds anything newer than the snapshot, Oracle copies it and applies undo to build a CR clone. No row lock, no dirty read.\n\nDetail: (05-db-core-index-lock.transactions-mvcc-locking.q2) is the same idea in InnoDB.\n\n**SELECT FOR UPDATE.** It finds the rows, checks their current version and locks them until the transaction ends. By default it waits for a held lock; `NOWAIT`, `WAIT n` and `SKIP LOCKED` change that.\n\nDetail: (28-distributed-lock-lease.choose-the-authority-before-the-mechanism.q2), and (05-db-core-index-lock.transactions-mvcc-locking.q3) for pessimistic vs optimistic.\n\n**Isolation.** READ COMMITTED, the default, takes a snapshot per statement. SERIALIZABLE and READ ONLY take one per transaction. A serializable update of a row changed by a transaction that committed after it began fails with `ORA-08177`.\n\nDetail: (05-db-core-index-lock.transactions-mvcc-locking.q1), (05-db-core-index-lock.transactions-mvcc-locking.q9)\n\n**Specific to Oracle, with no other card:**\n\n- [[b:MVCC]] is not a component: it is SCN + undo + CR clones. Readers and writers do not block each other; writers of the same row do, and `FOR UPDATE` is the one read that locks.\n- [[b:Row locks]] are recorded in the data block's interested transaction list (ITL), and under normal circumstances Oracle does not escalate them to block or table level.\n- [[r:A resumed statement sees the committed row.]] Oracle's own example has a blocked `UPDATE` end with 0 rows because the new row no longer matched its predicate.\n- [[r:Snapshot too old]] (`ORA-01555`): undo a long reader needs was overwritten. Raise `undo_retention`.\n- [[b:Commit cleanout]]: an ITL entry can outlive the commit. A later session checks the undo segment header and cleans the block, which generates redo.\n\n:::tip Bottom line\nReads go back in time through SCN and undo, writes go forward through redo, and locks only stand between statements after the same row.\n:::"}]}]},"hasVi":true,"stem":"07-sql-nosql-db-engines","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-ra