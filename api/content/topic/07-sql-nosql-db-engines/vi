json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},"meta":{"topic_type":"data","key":"07-sql-nosql-db-engines","vi":{"label":"SQL/NoSQL & DB engines","title":"SQL vs NoSQL — Oracle / MySQL / PostgreSQL / MongoDB","intro":"Bức tranh toàn cảnh các hệ CSDL: khi nào SQL/NoSQL, vì sao doanh nghiệp chuộng Oracle, và phần so sánh trực tiếp Oracle–MySQL từ storage vật lý, toàn vẹn dữ liệu, ACID tới CAP.","tags":["SQL vs NoSQL","Oracle RAC/PLSQL","PostgreSQL","MongoDB/WiredTiger","ACID vs BASE","Oracle vs MySQL","Data integrity","CAP (C/A/P)","Redis","Search engine"]},"en":{"label":"SQL/NoSQL & DB engines","title":"SQL vs NoSQL — Oracle / MySQL / PostgreSQL / MongoDB","intro":"The whole database landscape: when SQL and when NoSQL, why enterprises stay on Oracle, and a direct Oracle–MySQL comparison from physical storage and data integrity through ACID and CAP.","tags":["SQL vs NoSQL","Oracle RAC/PLSQL","PostgreSQL","MongoDB/WiredTiger","ACID vs BASE","Oracle vs MySQL","Data integrity","CAP (C/A/P)","Redis","Search engine"]},"created_at":"2026-07-31","updated_at":"2026-11-06"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"07-sql-nosql-db-engines.engine-by-engine.q4":"2026-08-12","07-sql-nosql-db-engines.engine-by-engine.q2":"2026-08-01","07-sql-nosql-db-engines.engine-by-engine.q5":"2026-08-01","07-sql-nosql-db-engines.the-big-picture.q4":"2026-08-03","07-sql-nosql-db-engines.engine-by-engine.q8":"2026-08-03","07-sql-nosql-db-engines.engine-by-engine.q9":"2026-08-10","07-sql-nosql-db-engines.engine-by-engine.q10":"2026-08-23","07-sql-nosql-db-engines.engine-by-engine.q11":"2026-11-06"},"lang":"vi","body":{"sections":[{"title":"Bức tranh chung","items":[{"id":"07-sql-nosql-db-engines.the-big-picture.q1","q":"SQL vs NoSQL — chọn cái nào theo bài toán?","a":"- [[b:SQL (quan hệ)]]: schema chặt, ACID mạnh, quan hệ phức tạp, query linh hoạt (JOIN, aggregate) — chuẩn cho data tài chính/transaction\n- [[b:NoSQL]]: schema linh hoạt, scale ngang dễ, tối ưu cho access pattern cụ thể, thường BASE/eventual\n\n<table class=\"cmp\"><thead><tr><th>Tiêu chí</th><th>SQL</th><th>NoSQL</th></tr></thead><tbody>\n<tr><td>Schema</td><td>chặt, constraint, migration</td><td>linh hoạt, schema-on-read</td></tr>\n<tr><td>Nhất quán</td><td>ACID mạnh</td><td>BASE/eventual (tuỳ)</td></tr>\n<tr><td>Quan hệ/JOIN</td><td>mạnh</td><td>kém, ưu tiên denormalize</td></tr>\n<tr><td>Scale</td><td>scale-up + replica; shard khó</td><td>scale-out ngang</td></tr>\n<tr><td>Hợp với</td><td>ledger, transaction</td><td>catalog, session, log, time-series</td></tr>\n</tbody></table>\n\nThực tế thường [[g:polyglot persistence]]: mỗi service chọn DB hợp việc.\n\n:::deep\nTránh nhị phân 'cái nào tốt hơn' — nói theo access pattern + yêu cầu nhất quán.\n\nOTA polyglot: booking/payment dùng Postgres (ACID), giá &amp; availability cache ở Redis, log tìm kiếm ở Elasticsearch, event ở Kafka.\n\n**Tầng vật lý là một trục khác.** SQL so với NoSQL mô tả model logic, API và transaction contract; B+Tree so với LSM mô tả một storage engine sắp xếp page, sorted run, log và I/O ra sao.\n\nInnoDB và PostgreSQL thường expose access path kiểu B-tree, Cassandra và RocksDB dùng thành phần theo hình thái LSM, nhưng nhãn vẫn giao nhau: NoSQL như MongoDB/WiredTiger có thể dùng B-tree, còn SQL như CockroachDB có thể chạy trên lớp Pebble dựa trên LSM.\n\nXem phần walkthrough vật lý ở (05-db-core-index-lock.transactions-mvcc-locking.q7).\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.the-big-picture.q2","q":"Các loại NoSQL và use case điển hình?","a":"<table class=\"cmp\"><thead><tr><th>Loại</th><th>Ví dụ</th><th>Use case</th></tr></thead><tbody>\n<tr><td>Document</td><td>MongoDB</td><td>profile/catalog/CMS (JSON lồng nhau)</td></tr>\n<tr><td>Key-Value</td><td>Redis, DynamoDB</td><td>cache, session, counter</td></tr>\n<tr><td>Wide-column</td><td>Cassandra, HBase</td><td>ghi lớn, time-series, IoT</td></tr>\n<tr><td>Graph</td><td>Neo4j</td><td>social, fraud, recommendation</td></tr>\n</tbody></table>\n\n:::deep\n- [[b:Document]] (Mongo): aggregate đọc trọn (itinerary/profile), schema linh hoạt, nhưng quan hệ/transaction đa-document yếu\n- [[b:Key-Value]] (Redis/DynamoDB): cực nhanh theo key (cache/session/counter/feature flag); query phi-key kém\n- [[b:Wide-column]] (Cassandra): ghi khổng lồ, tuyến tính theo node, mô hình *theo query* (denormalize, không JOIN); nhất quán tunable\n- [[b:Graph]] (Neo4j): quan hệ nhiều bậc (fraud ring, recommendation, hành trình nối chuyến)\n\nOTA: Cassandra/Scylla cho clickstream/search log; Redis cho cache giá &amp; seat hold; graph cho 'tìm hành trình nối chuyến tối ưu'. Chọn theo access pattern, không theo độ 'hot'.\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.the-big-picture.q3","q":"ACID vs BASE — trade-off triết lý?","a":"- [[b:ACID]] (Atomicity, Consistency, Isolation, Durability): ưu tiên đúng đắn — chuẩn RDBMS, bắt buộc cho ledger\n- [[b:BASE]] (Basically Available, Soft state, Eventual consistency): ưu tiên sẵn sàng & scale, chấp nhận eventual consistency — nhiều NoSQL phân tán\n\nĐây là biểu hiện của CAP/PACELC ở tầng triết lý thiết kế.\n\n:::deep\n- ACID = tính chất của *transaction* (đúng đắn); BASE = *triết lý hệ phân tán* (sẵn sàng + eventual consistency)\n- [[r:'Eventual consistency' không phải 'sẽ đúng nếu chờ' mơ hồ]] — phải định nghĩa *window hội tụ*, cơ chế giải xung đột (LWW/CRDT/version vector), ranh giới chấp nhận\n\nFintech/OTA — lằn ranh rõ:\n- ledger/số dư/giữ ghế = [[g:ACID]] (Consistency tuyệt đối)\n- lịch sử/loyalty/notification = [[o:BASE]]\n\nCâu khoá: 'chỗ nào RA QUYẾT ĐỊNH tiền dựa trên data?' → chỗ đó phải ACID.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.the-big-picture.q4","difficulty":"advanced","q":"CAP: Consistency, Availability và Partition Tolerance thực sự hứa hẹn gì — có phải SQL tự chọn C còn NoSQL chọn A?","a":"CAP áp dụng cho một **dịch vụ phân tán** có các replica liên lạc qua network; đây không phải nhãn gắn sẵn cho mọi database SQL hay NoSQL. Ba bảo đảm là:\n\n<table class=\"cmp\"><thead><tr><th>Ký hiệu</th><th>Bảo đảm</th><th>Không có nghĩa là</th></tr></thead><tbody>\n<tr><td>C — Consistency</td><td>mọi lần đọc thành công có hành vi như đang đọc một bản sao hiện tại duy nhất (linearizable)</td><td>không đồng nghĩa với invariant “state hợp lệ” của ACID</td></tr>\n<tr><td>A — Availability</td><td>mọi request tới node không hỏng cuối cùng nhận được response không lỗi</td><td>response có thể stale; đây không phải cam kết uptime/SLA</td></tr>\n<tr><td>P — Partition tolerance</td><td>dịch vụ vẫn hoạt động khi message giữa các node bị mất, trễ hoặc mạng bị chia partition</td><td>không có nghĩa mọi kiểu hỏng node hay disk đều vô hại</td></tr>\n</tbody></table>\n\nKhi partition tách các replica, hệ thống không thể giữ cả ba bảo đảm. “Chọn hai” là cách nói rút gọn hữu ích, không phải công thức triển khai: trong hệ phân tán thật, P gần như là giả định vận hành, nên phải chọn hy sinh C hay A trong lúc partition.\n\n<table class=\"cmp\"><thead><tr><th>Trong lúc partition</th><th>Hệ thống làm gì</th><th>Chi phí</th></tr></thead><tbody>\n<tr><td>CP</td><td>chờ quorum hoặc từ chối operation xung đột, giữ một thứ tự ghi duy nhất</td><td>một phần request fail hoặc block, availability giảm</td></tr>\n<tr><td>AP</td><td>tiếp tục phục vụ ở mỗi phía còn liên lạc được rồi hội tụ replica sau</td><td>read có thể stale, write đồng thời có thể cần giải quyết conflict</td></tr>\n</tbody></table>\n\nSQL và NoSQL không phải cách phân loại CAP:\n- Oracle hoặc MySQL một node không có partition giữa replica để mà chịu;\n- database SQL phân tán có thể dùng quorum/CP, còn read replica quan hệ vẫn có thể stale;\n- NoSQL trải từ AP/eventual tới strong consistency hoặc tunable, tuỳ engine, topology và policy read/write.\n\n:::deep\nCAP-C thường được nói dưới dạng [[b:linearizability]] (read thấy write hoàn tất mới nhất theo thứ tự real-time); ACID-C nghĩa là transaction giữ được constraint và invariant của ứng dụng.\n\nCAP-A nghĩa là node còn reachable và không hỏng phải trả lời; ACID-D nghĩa là thay đổi đã commit sống sót qua failure. Đây là các trục khác nhau, nên nói “SQL nhất quán” hay “NoSQL sẵn sàng” đều quá rộng.\n\nPACELC thêm câu hỏi thứ hai: **else** (khi không có partition), ta đổi latency lấy consistency mạnh hơn hay không? Hãy định nghĩa contract nhất quán cho từng operation rồi test failover/recovery, thay vì gắn một nhãn CAP cố định cho sản phẩm.\n:::"}]},{"title":"So sánh các engine","items":[{"id":"07-sql-nosql-db-engines.engine-by-engine.q1","q":"Vì sao doanh nghiệp lớn vẫn chuộng Oracle — từ tính năng tới vật lý?","a":"Oracle đắt nhưng được chọn cho hệ lõi nhờ:\n- [[b:RAC]] (Real Application Clusters): nhiều instance chung storage → HA & scale, failover trong suốt\n- [[b:PL/SQL]] mạnh; optimizer chín; partitioning, materialized view, Flashback, Data Guard (DR)\n- quản trị vật lý sâu: tablespace, ASM, redo/undo, RMAN backup\n- [[g:hỗ trợ enterprise + hợp đồng + compliance certification]] — quyết định trong ngân hàng/bảo hiểm\n\n:::tip Chốt\ndoanh nghiệp trả tiền cho HA, tooling vận hành chín, và 'một cổ để nắm' khi sự cố — không chỉ tính năng SQL.\n:::\n\n:::deep\n- [[b:RAC]] (instance chung shared storage qua Cache Fusion) → HA + scale, failover trong suốt\n- [[b:Data Guard]] (DR standby), [[b:RMAN]] backup, [[b:Flashback]] (khôi phục trạng thái quá khứ — vàng cho điều tra tài chính), [[b:ASM]], partitioning &amp; parallel query, optimizer/PLSQL cực chín\n- cốt lõi: [[g:HA + tooling + hợp đồng hỗ trợ + compliance]] — downtime/sai = mất tiền + pháp lý\n\nXu hướng: dịch sang Postgres (chi phí) cho hệ mới, nhưng core banking legacy vẫn Oracle vì rủi ro di trú &amp; tính năng vận hành.\n:::\n\n**Bức tranh tổng thể:** buffer cache, undo, redo và SCN phục vụ lệnh đọc và lệnh đọc có khoá ra sao là (07-sql-nosql-db-engines.engine-by-engine.q11).","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q2","q":"Vì sao MySQL/InnoDB được dùng rộng rãi, và nó hợp nhất ở đâu?","a":"MySQL/InnoDB là default OLTP thực dụng vì kết hợp ACID transaction, MVCC, clustered primary-key storage, secondary index, foreign key, crash recovery, nhiều lựa chọn replication, driver chín và managed service phổ biến.\n\nMySQL hiện có hai release track. [[g:8.4 là LTS series]] hướng tới feature set ổn định và hỗ trợ dài hơn; Innovation release đưa feature và behavior change nhanh hơn. Phải pin rõ track cùng upgrade path — “MySQL 8” không còn là production target đủ chính xác.\n\n<table class=\"cmp\"><thead><tr><th>Hợp với</th><th>Cần điều tra trước khi chọn</th></tr></thead><tbody>\n<tr><td>web/SaaS transaction có access path rõ</td><td>analytical SQL phức tạp, extension hoặc index/operator chuyên biệt</td></tr>\n<tr><td>team coi trọng vận hành quen thuộc và managed offering</td><td>write topology, failover semantics, replica lag, backup/restore RTO và licensing/support</td></tr>\n<tr><td>schema hưởng lợi từ relational constraint</td><td>clustered key nóng, secondary index lớn và yêu cầu consistency cross-region</td></tr>\n</tbody></table>\n\n:::deep\nClustered index của InnoDB khiến mỗi leaf của secondary index chứa primary key. PK ngắn, ổn định có thể làm mọi secondary index nhỏ hơn; key random hoặc key tăng dần bị nóng sẽ đổi locality và write behavior.\n\nRedo log tạo durability, undo record hỗ trợ MVCC/rollback, còn buffer pool chi phối phần lớn read performance — đây là cơ chế cụ thể, không phải “rẻ nhưng đủ tốt”.\n\nĐừng gán claim của cloud product cho upstream MySQL. Aurora, Cloud SQL, RDS và MySQL tự quản có storage, replication, failover, observability và cost model khác nhau. Benchmark đúng product/topology đã chọn, kể cả failover và restore, thay vì chỉ so tính năng SQL.\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q3","q":"PostgreSQL khác MySQL ra sao và vì sao đang lên ngôi?","a":"- tuân chuẩn SQL chặt hơn; tính năng nâng cao: [[g:JSONB]] (index được), CTE đệ quy, window function mạnh, partial/expression/GiST/GIN index, materialized view\n- [[g:extension]] phong phú: PostGIS (geo), TimescaleDB (time-series), [[g:pgvector]] (AI embedding) → 'đa năng'\n- MVCC khác MySQL: lưu tuple version trong table → cần [[o:VACUUM]] dọn tuple chết\n\n:::tip Chốt\nPostgres thắng khi cần tính năng nâng cao + JSON + extension (nhất là pgvector cho AI). MySQL thắng ở đơn giản & phổ cập.\n:::\n\n:::deep\n- [[b:JSONB]] (binary, index GIN được — hybrid relational+document), CTE đệ quy, window function, partial/expression index\n- [[b:extension]]: PostGIS, TimescaleDB, [[g:pgvector]] (lý do lớn khiến Postgres lên ngôi thời AI)\n- MVCC lưu tuple version *trong table* → cần `VACUUM`/autovacuum; không kịp → [[r:table/index bloat]] + transaction ID wraparound (phải vacuum freeze)\n\nOTA: Postgres + pgvector cho gợi ý/tìm kiếm ngữ nghĩa, JSONB cho snapshot kết quả tìm chuyến, PostGIS cho 'sân bay gần bạn'.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q4","q":"Khi nào document model của MongoDB giúp đọc hiệu quả, và nó trade-off gì?","a":"MongoDB có thể đọc một aggregate đã biết rất hiệu quả khi data được đọc và đổi cùng nhau được embed trong một document có bound. Một indexed lookup khi đó trả cả aggregate mà không cần join phía ứng dụng hay nhiều network round trip.\n\nLợi thế đến từ [[g:data model và locality của access path]], không phải luật MongoDB nhanh hơn SQL.\n\nTrade-off phụ thuộc workload:\n\n- embedding có thể lặp data, khiến fan-out update hoặc document growth tốn kém;\n- reference giữ một source of truth nhưng đưa nhiều lần đọc hoặc `$lookup` trở lại;\n- document có giới hạn kích thước, projection rộng sẽ phí cache/network nếu aggregate quá lớn;\n- relational database có thể nhanh tương đương ở indexed point read và thường rõ hơn cho ad-hoc join, constraint, set-based analysis;\n- MongoDB hỗ trợ transaction và consistency cấu hình được; gọi nó là weak-consistency storage bẩm sinh là sai.\n\n:::warn So đúng mô hình tương đương\nĐo cùng business response, index, durability/consistency setting, dataset lớn hơn memory, concurrency và network topology. So một MongoDB read đã denormalize với N SQL query không có index là đo schema/query design, không phải tốc độ database engine.\n:::\n\n:::deep\nWiredTiger cung cấp MVCC, compression, cache management và document-level write concurrency. Hiệu năng vẫn phụ thuộc index selectivity, working-set fit, document shape, update amplification, checkpoint và storage latency.\n\nỨng viên tốt gồm catalog/product view có bound, user preference và immutable snapshot.\n\nMoney ledger hay inventory vẫn có thể đặt trên MongoDB nếu schema, unique constraint, transaction boundary, write/read concern, audit trail và operational recovery chứng minh được invariant.\n\nChọn RDBMS thường đơn giản hơn, nhưng đó là quyết định kỹ thuật chứ không phải nhãn sản phẩm.\n\n**Ví dụ `mongosh` chạy được — một embedded document làm hold atomic:**\n<pre><code>db.inventory.insertOne({_id:\"sku-1\", available:1, version:7, holds:[]})\ndb.inventory.updateOne(\n  {_id:\"sku-1\", available:{$gte:1}, version:7},\n  {$inc:{available:-1, version:1},\n   $push:{holds:{id:\"h-42\", expiresAt:new Date(Date.now()+300000)}}}\n)\n// matchedCount: 1, modifiedCount: 1\n// chạy lại cùng update: matchedCount: 0; document này không thể oversell</code></pre>\n\nSingle-document update atomic kiểm tra lại predicate, nên expected version ngăn lost update.\n\n- **Ưu điểm:** inventory, version và hold đổi cùng nhau mà không cần multi-document transaction.\n- **Chi phí:** document phổ biến thành điểm serialize nóng; `holds` không thể tăng vô hạn và dữ liệu lặp cần policy cập nhật.\n- **Điểm thoát:** reference hoặc bucket child khi cardinality hay lifecycle không còn vừa một aggregate.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q5","q":"MongoDB: sharding và consistency model?","a":"Sharding và consistency là hai trục thiết kế riêng.\n\n- Shard key quyết định data placement và query có target được một shard không. Đánh giá cardinality, frequency, monotonicity, query routing, zone requirement, document growth và khả năng refine/reshard; key tệ tạo hotspot hoặc scatter-gather.\n- `readPreference` chọn replica-set member được phép phục vụ read. Mặc định là `primary`.\n- `readConcern` điều khiển consistency/isolation. Concern mặc định `local` có thể trả data sau đó bị rollback, kể cả đọc từ primary — vì vậy “mặc định primary nghĩa là strong consistency” là sai.\n- `writeConcern` điều khiển acknowledgement/durability. Majority write kết hợp đúng read concern/session semantics cho guarantee mạnh hơn, đổi bằng availability/latency.\n\n<pre><code><span class=\"c\">// Policy ví dụ cho operation nhạy invariant; phải tune theo contract thật</span>\nsession.<span class=\"f\">withTransaction</span>(work,\n    TransactionOptions.<span class=\"f\">builder</span>()\n        .<span class=\"f\">readConcern</span>(ReadConcern.SNAPSHOT)\n        .<span class=\"f\">writeConcern</span>(WriteConcern.MAJORITY)\n        .<span class=\"f\">readPreference</span>(ReadPreference.primary())\n        .<span class=\"f\">build</span>());</code></pre>\n\n:::deep\nRead `majority` trả majority-committed data nhưng tự nó không có nghĩa “giá trị mới nhất ở bất kỳ đâu”. Read `linearizable` có real-time semantics chặt hơn cho single-document read hợp lệ trên primary và nên kèm `maxTimeMS`.\n\nCausally consistent session là công cụ cho guarantee như read-your-own-writes qua các operation liên quan.\n\nMulti-document transaction là cơ chế correctness được hỗ trợ, không phải thứ phải cấm.\n\nNó thêm coordination và có thể giảm throughput, nên giữ ngắn và đo; model bounded aggregate vào một document khi cách đó tự nhiên giữ invariant, còn nếu invariant thật sự xuyên document thì dùng transaction. Né một transaction cần thiết không phải optimization.\n:::","difficulty":"extra"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q6","q":"Redis: vì sao nhanh, các cấu trúc dữ liệu và persistence?","a":"Redis nhanh vì [[g:in-memory]] + single-thread event loop (không lock contention) + cấu trúc data tối ưu.\n\n**Data structures:** string, hash, list, set, sorted set (leaderboard!), stream, bitmap, HyperLogLog.\n\n**Persistence:**\n- [[b:RDB]] (snapshot)\n- [[b:AOF]] (append log)\n\n→ trade-off durability vs hiệu năng.\n\nDùng cho: cache, session, rate limit, queue nhẹ, distributed lock, leaderboard.\n\n:::deep\n- single-thread data path → một lệnh O(N) (`KEYS *`, `SMEMBERS` set lớn) [[r:chặn toàn bộ]] → tránh; dùng `SCAN` cursor\n- persistence: RDB (mất data giữa hai snapshot) vs AOF (`everysec` cân bằng phổ biến); bền cao dùng cả hai\n- HA: Redis Sentinel (failover) hoặc Redis Cluster (16384 hash slot + replica)\n- [[r:lock/dedup]]: TTL hết giữa chừng → mất đúng đắn → fencing token\n\nOTA: seat hold TTL (`SET seat NX PX`), cache giá/availability TTL ngắn, rate-limit token bucket, sorted set cho 'chuyến hot/đếm tồn'.\n\n- Chính cơ chế TTL này là một đề LLD hay gặp: tự cài key-value store có TTL bằng lazy expiration + sampling đúng như Redis làm (22-low-level-design-ood.patterns-in-interview-code.q4).\n:::","difficulty":"core"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q7","q":"Khung quyết định: chọn DB cho một use case cụ thể?","a":"Hỏi tuần tự:\n- data có [[b:quan hệ]] không? cần [[b:ACID mạnh]] không?\n- [[b:access pattern]]: theo key / range / full-text / graph?\n- tỉ lệ đọc/ghi & quy mô? nhất quán strong hay eventual?\n\n**Map nhanh:**\n- ledger/transaction → RDBMS (Postgres/MySQL/Oracle)\n- cache/session → Redis\n- catalog/CMS → MongoDB\n- time-series/ghi lớn → Cassandra/Timescale\n- search → Elasticsearch\n- AI embedding → pgvector\n\nThường kết hợp nhiều cái — [[g:polyglot persistence]].\n\n:::deep\nKhung hỏi: (1) quan hệ &amp; cần JOIN? (2) cần ACID mạnh (tiền/giữ chỗ)? (3) access pattern chính? (4) đọc/ghi &amp; quy mô (vượt 1 node?)? (5) strong hay eventual?\n\nMap: ledger/booking → RDBMS; cache/session/seat-hold → Redis; search chuyến/điểm đến → Elasticsearch; clickstream/log lớn → Cassandra/Timescale; AI embedding → pgvector; analytics → cột (ClickHouse/BigQuery).\n\n[[r:Sai lầm]]: ép một DB làm mọi thứ, hoặc thêm DB mới chỉ vì 'mốt' (tăng chi phí vận hành).\n:::","difficulty":"extra"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q8","difficulty":"advanced","q":"Oracle vs MySQL/InnoDB: khi nào “phần premium enterprise” của Oracle thật sự đáng tiền?","a":"Oracle Database và MySQL dùng InnoDB đều là hệ quản trị database quan hệ dùng SQL, và cả hai đều có thể cung cấp transaction ACID. Hãy so sánh **engine, topology, cấu hình durability, workload và hợp đồng vận hành**—không chỉ so tên sản phẩm.\n\n**Chú thích thuật ngữ — High Availability / Disaster Recovery (HA/DR):** HA giữ dịch vụ sẵn sàng khi instance hoặc node hỏng. DR khôi phục dịch vụ và dữ liệu sau sự cố ở cấp site hoặc region. Mục tiêu thường được biểu diễn bằng RTO (thời gian phục hồi mục tiêu) và RPO (điểm dữ liệu phục hồi mục tiêu).\n\n<table class='cmp'><thead><tr><th>Khía cạnh</th><th>Oracle Database</th><th>MySQL + InnoDB</th></tr></thead><tbody>\n<tr><td>Process và memory</td><td><b>Memory:</b> SGA/PGA<br><b>Log writer:</b> LGWR<br><b>Database writer:</b> DBWn; CKPT điều phối checkpoint</td><td><b>Process:</b> <code>mysqld</code><br><b>Memory:</b> InnoDB buffer pool và log buffer</td></tr>\n<tr><td>Logical → disk</td><td><b>Phân cấp:</b> tablespace → segment → extent → block<br>Datafile chứa block data/index; control file mô tả database.</td><td><b>Phân cấp:</b> table/index → page<br>Clustered primary-key index chứa row; tablespace gồm <code>.ibd</code>, system, undo và temporary space.</td></tr>\n<tr><td>Transaction và recovery</td><td><b>Rollback/read consistency:</b> undo<br><b>Recovery:</b> online/archived redo, checkpoint, RMAN và Flashback</td><td><b>Concurrency/rollback:</b> undo + Multi-Version Concurrency Control (MVCC)<br><b>Recovery:</b> redo + doublewrite<br><b>Replication/PITR:</b> binary log riêng</td></tr>\n<tr><td>High Availability / Disaster Recovery (HA/DR)</td><td><b>HA:</b> RAC + Cache Fusion<br><b>DR:</b> Data Guard với Maximum Protection, Maximum Availability hoặc Maximum Performance (mặc định)</td><td><b>HA:</b> Group Replication/InnoDB Cluster hoặc giải pháp tương đương của managed service<br><b>Replication/DR:</b> replica qua binlog, thường asynchronous; guarantee chính xác phụ thuộc topology</td></tr>\n<tr><td>Integrity và isolation</td><td><b>Integrity:</b> declarative constraint, automatic locking và multiversion read consistency<br><b>Isolation mặc định:</b> READ COMMITTED; ngoài ra có SERIALIZABLE và READ ONLY</td><td><b>Integrity:</b> primary/unique/foreign-key constraint, row lock và MVCC; CHECK được enforce từ 8.0.16<br><b>Isolation mặc định:</b> REPEATABLE READ</td></tr>\n<tr><td>Chi phí và vận hành</td><td>Tooling enterprise, support và certification sâu<br>License/option đắt hơn và DBA phức tạp hơn</td><td>Chi phí đầu vào thấp, driver quen thuộc và nhiều managed offering<br>Enterprise support và HA vẫn có chi phí vận hành</td></tr>\n</tbody></table>\n\nTên gọi và file của hai engine khác nhau, nhưng nguyên lý write-ahead nên được đọc thành ba flow tách biệt:\n\n<pre><code>WRITE — transaction đang chạy\nSQL statement\n    ↓\nlock + kiểm tra visibility MVCC\n    ↓\nđổi page trong memory\n+ tạo undo\n    ↓\ntạo redo record\n(nguyên lý write-ahead logging)\n────────────────────────────\nCOMMIT — synchronous critical path\nCOMMIT\n    ↓\nflush phần redo cần thiết\nxuống durable storage\n    ↓\nACK thành công cho client\n────────────────────────────\nPAGE WRITE — asynchronous\ndirty page còn trong buffer\n    ↓\ncheckpoint / DBWn /\nbackground writer\n    ↓\ndatafile page</code></pre>\n\nCrash recovery là một flow riêng khác:\n\n<pre><code>CRASH\n  ↓\nREDO\nroll forward log record bền\nkể từ checkpoint\n  ↓\nUNDO\nrollback transaction\nkhông có commit record</code></pre>\n\nVì vậy redo có thể khôi phục thay đổi của một transaction chưa hoàn tất, rồi undo mới loại bỏ chúng. Câu “redo chỉ phần đã commit” là cách nói quá đơn giản.\n\n**Tính toàn vẹn dữ liệu có các lớp tách biệt:**\n\n- **Entity rule:** primary key và NOT NULL\n- **Referential rule:** foreign key\n- **Domain rule:** type, CHECK và UNIQUE\n- **Business invariant:** transaction boundary cùng lock hoặc isolation level cần thiết\n\nRedo, checksum, backup và point-in-time recovery bảo vệ bản copy vật lý. Chúng không thay thế constraint.\n\n**Cấu hình durability của MySQL/InnoDB:**\n\n- Các guarantee ở đây áp dụng cho InnoDB. Table non-transactional, `foreign_key_checks` bị tắt, flush policy nới lỏng hoặc asynchronous replica sẽ làm contract thực tế thay đổi.\n- `innodb_flush_log_at_trx_commit=1` (mặc định): write và flush redo ở mỗi commit; đây là cấu hình transaction bền đầy đủ.\n- `innodb_flush_log_at_trx_commit=2`: write redo vào OS cache lúc commit; sống sót qua `mysqld` crash nhưng không chắc qua OS crash hoặc mất điện.\n- `innodb_flush_log_at_trx_commit=0`: write và flush định kỳ; ngay cả process crash cũng có thể làm mất commit gần nhất. Chu kỳ xấp xỉ một giây, không phải mức tối đa được bảo đảm.\n- Dùng `sync_binlog=1` cùng `innodb_flush_log_at_trx_commit=1` khi binary log cũng phải tuân theo contract bền đầy đủ.\n\n**Commit của Oracle có hai trục độc lập:**\n\n- `WAIT|NOWAIT`: COMMIT có chờ redo trở nên persistent hay không—đây là quyết định về durability\n- `IMMEDIATE|BATCH`: redo được gửi ngay hay gom lại để group commit\n\nMặc định là `WAIT IMMEDIATE`; `COMMIT_WAIT` và `COMMIT_LOGGING` áp dụng khi mệnh đề bị lược bỏ. Với cả hai product, phải đọc đúng cấu hình đã chọn thay vì suy durability từ brand.\n\n**ACID là contract của transaction:**\n\n- **Atomicity:** commit toàn bộ hoặc rollback toàn bộ.\n- **Consistency:** chuyển từ một state hợp lệ sang state hợp lệ khác mà vẫn giữ invariant.\n- **Isolation:** kiểm soát những gì các transaction đồng thời có thể quan sát.\n- **Durability:** commit thành công sống sót qua những failure mà log, storage và cấu hình bao phủ.\n\nACID-C không phải CAP-C, và ACID-D không phải CAP-A; xem (07-sql-nosql-db-engines.the-big-picture.q4).\n\n**Khi phần premium của Oracle có thể đáng tiền:**\n\n- RAC/Data Guard giúp đáp ứng RTO/RPO bắt buộc.\n- Workload cần recovery, audit, compliance, partitioning, parallel execution, PL/SQL hoặc optimizer đã chín.\n- SLA/certification của vendor hoặc Oracle estate sẵn có giúp giảm rủi ro vận hành và migration.\n- Tổ chức chấp nhận option cấp license riêng, support cost và độ phức tạp DBA.\n\n**Khi MySQL/InnoDB thường phù hợp hơn:**\n\n- OLTP web/SaaS có access path rõ và transaction boundary được định nghĩa tốt.\n- Team ưu tiên chi phí thấp hơn và vận hành trên managed cloud.\n- Topology đã chọn vượt qua cùng bài test durability, failover và backup/restore.\n- Benchmark giữ schema, index, durability policy, dataset và RTO/RPO tương đương.\n\nAurora, RDS, Cloud SQL và MySQL tự quản là các sản phẩm khác nhau. Không bê nguyên claim về storage, replication hoặc failover của topology này sang topology khác.\n\n:::deep\nDùng Oracle khi invariant là mission-critical **và** tổ chức coi High Availability / Disaster Recovery, recovery, compliance và support đáng với chi phí của hệ sinh thái đó. Dùng MySQL/InnoDB khi có thể chứng minh cùng guarantee cần thiết bằng topology đơn giản hơn và total cost thấp hơn.\n\nHãy bắt đầu từ invariant và access pattern; chỉ chọn brand sau khi đã test recovery và failover.\n:::\n\n**Bức tranh tổng thể:** lệnh đọc của Oracle dùng undo và SCN trên đường ghi này ra sao là (07-sql-nosql-db-engines.engine-by-engine.q11)."},{"id":"07-sql-nosql-db-engines.engine-by-engine.q9","q":"Khi nào một search engine xứng đáng đứng cạnh database, và nó tuyệt đối không được sở hữu cái gì?","a":"Full-text search trong quan hệ vẫn ổn cho tới khi bạn cần xếp hạng độ liên quan, khớp mờ, faceting và tổng hợp trên hàng triệu tài liệu với latency thấp. Đó là điểm mà inverted index hết còn là tuỳ chọn (05-db-core-index-lock.indexes-what-they-really-are.q1).\n\n<table class=\"cmp\"><thead><tr><th></th><th>Quan hệ `LIKE`/full-text</th><th>Search engine</th></tr></thead><tbody>\n<tr><td>`%từ khoá%`</td><td>quét toàn table, không dùng index</td><td>đã index theo token</td></tr>\n<tr><td>Độ liên quan</td><td>không có, hoặc gắn thêm</td><td>chấm điểm là tính năng lõi</td></tr>\n<tr><td>Sai chính tả, đồng nghĩa, stemming</td><td>làm tay</td><td>analyzer lo</td></tr>\n<tr><td>Facet trên hàng triệu row</td><td>tổng hợp rất nặng</td><td>sinh ra để làm việc đó</td></tr>\n<tr><td>Transaction và tính đúng đắn</td><td>ACID</td><td>[[r:gần real-time, không transaction]]</td></tr>\n</tbody></table>\n\n**Index là một read model, không phải database.** Nó là dữ liệu dẫn xuất — dựng lại từ nguồn lúc nào cũng được — chính điều đó khiến reindex an toàn, và cũng chính vì thế nó không bao giờ được làm nguồn sự thật (12-architecture-patterns.domain-driven-design.q4).\n\n**Nạp dữ liệu cho nó.** Ghi vào database và ghi vào index trong cùng một request là dual write: một bên lỗi là hai bên lệch nhau vĩnh viễn. Hãy nạp từ outbox hoặc từ CDC để index đi theo một cái log chứ không đi theo nỗ lực may rủi (06-db-scaling.sharding-partitioning.q7).\n\n:::warn User nhìn thấy được cái \"gần real-time\"\nTài liệu chỉ tìm được sau một lần refresh, không phải ngay lúc commit. \"Tôi vừa lưu xong mà tìm không ra\" là hành vi đúng như thiết kế — trang chi tiết phải đọc từ database, không đọc từ index.\n:::\n\n:::deep\n- [[g:reindex phía sau một alias]]: dựng index mới, kiểm tra, rồi lật alias một cách nguyên tử. Đổi mapping không phải sửa tại chỗ, và giả vờ như vậy sẽ biến một chỉnh sửa schema thành downtime.\n- quyết [[o:index lưu cái gì]]: đủ để vẽ ra danh sách kết quả, không hơn. Nhét cả tài liệu vào đó khiến người ta muốn đọc nó như sự thật, và nhân đôi lượng dữ liệu bạn phải bảo vệ (13-security-oauth2.protecting-the-data-you-store.q2).\n- pagination sâu vẫn tốn kém y như trong SQL; dùng `search_after` thay cho offset lớn (04-rest-grpc-webflux.protocols.q5).\n- một cụm search là cam kết vận hành: cấp phát heap và shard, snapshot, nâng version, và một đường reindex. Đừng dựng nó cho một tính năng mà một index chọn khéo đã phục vụ được (07-sql-nosql-db-engines.engine-by-engine.q7).\n- cùng khuôn hình đó áp cho analytics: dẫn xuất một kho đọc từ kho transaction, giữ cho phép dẫn xuất phát lại được, và đừng bao giờ cho báo cáo chạy trên primary.\n:::","difficulty":"advanced"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q10","difficulty":"advanced","q":"Làm sao để search, cache hoặc OLAP projection có thể rebuild và biết mình đang stale đến mức nào?","a":"Hãy coi transactional model là authority, còn mọi store dẫn xuất là projection có version. Contract của projection cần nhiều hơn một connection string:\n\n- snapshot boundary và nguồn replay\n- event identity, aggregate/key, source version hoặc log position, cùng phạm vi ordering\n- schema version, upsert semantics, xử lý delete/tombstone và retention\n- watermark/freshness metric và policy khi stale, paused hoặc failed\n- repair path có thể replay một range hoặc rebuild version mới\n\n- **Search mapping hoặc materialized table:** dựng version N+1 cạnh N, backfill, catch up từ position đã ghi, so counts và sample theo domain, rồi swap alias hoặc route có kiểm soát.\n- **Cache:** định nghĩa invalidation/version/TTL và chấp nhận eviction/loss là bình thường; đừng coi persistence của cache là durability của source.\n- **OLAP:** phải có policy cho late-arriving data, correction, lineage và access control thay vì cho report chạy trên OLTP primary.\n\nCDC hữu ích vì cung cấp change stream có thể replay, nhưng delivery at-least-once vẫn cần projection write idempotent và check version. Consumer process đang healthy không chứng minh nó đã apply hết mọi source change.\n\n:::warn Đừng để derived store stale quyết định mutation quan trọng\nSearch dùng để tìm candidate, cache để tăng tốc read, OLAP để trả aggregate. Charge, cấp entitlement, trừ inventory và settle money phải đi qua authority hoặc một thiết kế nói rõ derived store chính là authority.\n:::"},{"id":"07-sql-nosql-db-engines.engine-by-engine.q11","difficulty":"advanced","q":"Tổng quan Oracle: buffer cache, undo, redo, SCN, MVCC và isolation phục vụ SELECT và SELECT FOR UPDATE ra sao?","a":"Một dòng: `SELECT` thường đọc quá khứ và không khoá; `SELECT ... FOR UPDATE` làm việc trên hiện tại và khoá nó. [[b:SCN]] chọn quá khứ nào, [[g:undo]] dựng lại quá khứ đó, còn [[g:redo]] làm commit bền vững.\n\n<figure class='db-figure'><a href='/assets/diagrams/oracle-select-index-heap.webp' target='_blank' rel='noopener noreferrer'><img src='/assets/diagrams/oracle-select-index-heap.webp' alt='Từng bước một lệnh SELECT theo primary key trên Oracle: parse và snapshot SCN, root và leaf của B-tree, ROWID, heap block và row directory, cùng buffer cache và đĩa' width='1536' height='1024' loading='lazy' decoding='async'></a><figcaption>Một lệnh SELECT thường theo primary key, từ parse tới kết quả, với bước kiểm tra consistent read ở mỗi block. Ghi, FOR UPDATE và isolation nằm ở phần dưới. Mở ảnh để xem cỡ đầy đủ.</figcaption></figure>\n\n**Bộ nhớ và đĩa.** Buffer cache giữ current block cùng các consistent read (CR) clone. DBWn ghi dirty block xuống datafile sau; LGWR ghi redo log buffer xuống online redo log.\n\nChi tiết: (07-sql-nosql-db-engines.engine-by-engine.q8)\n\n**Một lần ghi.** Row bị khoá tới `COMMIT` hoặc `ROLLBACK`. Undo giữ giá trị cũ, và một redo record phủ cả data block lẫn undo block. Commit chính là lần LGWR ghi redo đó cùng commit SCN; data block xuống đĩa sau.\n\nChi tiết: (05-db-core-index-lock.transactions-mvcc-locking.q8)\n\n**SELECT thường.** Lấy snapshot SCN, rồi tìm từng block trong cache hoặc đọc từ datafile. Nếu block có thay đổi mới hơn snapshot, Oracle chép nó ra và áp undo để dựng CR clone. Không khoá row, không dirty read.\n\nChi tiết: (05-db-core-index-lock.transactions-mvcc-locking.q2) là cùng ý tưởng trên InnoDB.\n\n**SELECT FOR UPDATE.** Tìm row, kiểm tra phiên bản hiện hành rồi khoá chúng tới hết transaction. Mặc định sẽ chờ lock đang bị giữ; `NOWAIT`, `WAIT n` và `SKIP LOCKED` đổi hành vi đó.\n\nChi tiết: (28-distributed-lock-lease.choose-the-authority-before-the-mechanism.q2), và (05-db-core-index-lock.transactions-mvcc-locking.q3) cho pessimistic vs optimistic.\n\n**Isolation.** READ COMMITTED, mặc định, lấy snapshot theo từng statement. SERIALIZABLE và READ ONLY lấy một snapshot cho cả transaction. Serializable update một row do transaction khác commit sau khi nó bắt đầu thì lỗi `ORA-08177`.\n\nChi tiết: (05-db-core-index-lock.transactions-mvcc-locking.q1), (05-db-core-index-lock.transactions-mvcc-locking.q9)\n\n**Riêng của Oracle, chưa có câu nào khác:**\n\n- [[b:MVCC]] không phải một thành phần: nó là SCN + undo + CR clone. Reader và writer không chặn nhau; writer cùng một row thì có, và `FOR UPDATE` là lệnh đọc duy nhất khoá row.\n- [[b:Row lock]] được ghi trong interested transaction list (ITL) của chính data block, và trong điều kiện bình thường Oracle không escalate lên mức block hay table.\n- [[r:Statement chạy tiếp sẽ thấy row đã commit.]] Ví dụ của chính Oracle có một `UPDATE` bị chặn kết thúc với 0 row vì row mới không còn khớp predicate.\n- [[r:Snapshot too old]] (`ORA-01555`): undo mà reader chạy lâu cần đã bị ghi đè. Tăng `undo_retention`.\n- [[b:Commit cleanout]]: ITL entry có thể còn lại sau commit. Session sau kiểm tra undo segment header rồi dọn block, và việc đó sinh redo.\n\n:::tip Bottom line\nĐọc đi lùi thời gian qua SCN và undo, ghi đi tới qua redo, còn lock chỉ đứng giữa các lệnh nhắm cùng một row.\n:::"}]}]},"hasVi":true,"stem":"07-sql-nosql-db-engines","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"dist