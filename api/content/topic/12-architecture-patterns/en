{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},"meta":{"topic_type":"design","key":"12-architecture-patterns","vi":{"label":"Architecture & patterns","title":"Software architecture: DDD, Clean, Hexagonal & design patterns","intro":"Ở mốc 8 năm, kiến trúc là giá trị cốt lõi. Nắm vững DDD và các kiến trúc 'dependency hướng vào trong', so sánh với layered, và dùng pattern đúng chỗ thay vì học thuộc.","tags":["Layered","Hexagonal","Clean","DDD chiến lược/tactical","CQRS","SOLID","Anti-patterns","Clean Architecture","Dependency Rule","ArchUnit","Spring Modulith"]},"en":{"label":"Architecture & patterns","title":"Software architecture: DDD, Clean, Hexagonal & design patterns","intro":"At the eight-year mark, architecture is the core of what you sell. Know DDD and the dependencies-point-inward architectures, compare them honestly against layered, and reach for patterns where they fit rather than reciting them.","tags":["Layered","Hexagonal","Clean","DDD strategic & tactical","CQRS","SOLID","Anti-patterns","Clean Architecture","Dependency Rule","ArchUnit","Spring Modulith"]},"created_at":"2026-07-31","updated_at":"2026-10-02"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"12-architecture-patterns.patterns-principles.q7":"2026-10-02"},"lang":"en","body":{"sections":[{"title":"Architecture styles","items":[{"id":"12-architecture-patterns.architecture-styles.q1","q":"Layered (n-tier) architecture: pros/cons?","a":"Layers: controller → service → repository → DB, dependencies point downward.\n\n- [[g:Pros]]: familiar, simple, easy to onboard\n- [[r:Cons]]: business logic easily leaks into a thin service (anemic domain), framework/DB seeps back upward, hard to test logic in isolation, prone to becoming a 'big ball of mud' as it grows\n\n:::deep\n- dependencies point *downward* to the DB → framework/JPA/DB seeps back up into the domain (JPA entity = domain model → tight coupling to infrastructure)\n- business logic leaks into a thin 'service' → [[r:anemic domain]] (entity is just getters/setters); prone to becoming a 'big ball of mud' (god-class service)\n\n[[o:Layered is NOT wrong]] — it's a reasonable default for most apps; it only becomes a problem when the domain is complex &amp; long-lived (fintech core). That's when you move to Hexagonal/Clean. [[r:Don't over-engineer Clean for simple CRUD.]]\n\n- The clearest sign layered has run out of room: when a small business change forces edits across all four layers, or when testing one business rule requires standing up the whole Spring context plus a database.\n- The real-world build of the replacement architecture is in 12.15, and the gradual migration path is in 12.21.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.architecture-styles.q2","q":"Hexagonal (Ports & Adapters): what's the core idea?","a":"<figure class='dgm'><svg viewBox='0 0 680 300' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11' text-anchor='middle'>\n<polygon points='340,60 470,135 470,225 340,300 210,225 210,135' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='2'/>\n<text x='340' y='175' fill='#085239' font-weight='600'>DOMAIN</text><text x='340' y='195' fill='#42536C'>(doesn't know about DB/web)</text>\n<rect x='150' y='40' width='130' height='40' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='215' y='60' fill='#3D4E8F'>REST/gRPC</text><text x='215' y='75' fill='#42536C'>driving adapter</text>\n<rect x='400' y='40' width='130' height='40' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='465' y='60' fill='#3D4E8F'>Scheduler/CLI</text><text x='465' y='75' fill='#42536C'>driving adapter</text>\n<rect x='150' y='235' width='130' height='44' rx='6' fill='#F6E8E5' stroke='#AE4536'/><text x='215' y='255' fill='#7d2f24'>DB repository</text><text x='215' y='270' fill='#AE4536'>driven adapter</text>\n<rect x='400' y='235' width='130' height='44' rx='6' fill='#F6E8E5' stroke='#AE4536'/><text x='465' y='255' fill='#7d2f24'>Kafka/PSP</text><text x='465' y='270' fill='#AE4536'>driven adapter</text>\n<g stroke='#42536C' stroke-width='1.4' marker-end='url(#ar10)'><line x1='245' y1='80' x2='285' y2='112'/><line x1='435' y1='80' x2='395' y2='112'/></g>\n<g stroke='#42536C' stroke-width='1.4'><line x1='265' y1='205' x2='235' y2='233'/><line x1='415' y1='205' x2='445' y2='233'/></g>\n<text x='600' y='150' fill='#0B6E4F' font-weight='600'>PORT</text><text x='600' y='168' fill='#42536C'>= interface</text>\n<text x='340' y='30' fill='#42536C'>Dependency points INWARD · infrastructure plugs in through ports · same idea as Clean / Onion</text>\n<defs><marker id='ar10' markerWidth='8' markerHeight='8' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#42536C'/></marker></defs>\n</svg></figure>\n\nPut [[g:the domain at the center]], communicating outward through a [[b:port]] (interface). The outside world (web, DB, queue) is an [[b:adapter]] plugged into the port.\n\nThe domain [[r:knows NOTHING]] about the framework/DB.\n\n- [[b:driving adapter]] (UI/API): calls *into* the domain\n- [[b:driven adapter]] (DB/broker): is called *out* to by the domain through a port\n\nBenefit: swapping infrastructure doesn't touch the domain, the domain can be tested with mock adapters, boundaries are clear.\n\n:::deep\n- the domain defines the port (interface); the adapter implements the port (dependency inversion: the domain defines `PaymentGateway`, infrastructure implements a Stripe adapter)\n- measurable benefit: test the use case with an in-memory adapter (no DB/Docker), swap infrastructure without touching the domain\n\nOTA: the Booking domain doesn't know about Postgres/Kafka/GDS — it has ports `SeatInventory`, `PaymentGateway`, `GdsClient`; adapters plug into them.\n\n[[r:The cost]]: mapping between domain entities and JPA + a lot of interfaces → only worth it when the domain is complex.\n\n- The real-world build in code: `port/in`, `port/out` package structure, adapters for a Spring Boot service (12-architecture-patterns.clean-layered-building-it-for-real.q1), and which layer transaction/validation/mapping belong in (12-architecture-patterns.clean-layered-building-it-for-real.q5).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.architecture-styles.q3","q":"Clean Architecture and the Dependency Rule?","a":"Concentric rings: Entities → Use Cases → Interface Adapters → Frameworks/Drivers.\n\n[[g:Dependency Rule]]: dependencies point *inward* only; an inner ring never knows about an outer ring.\n\nUses [[g:dependency inversion]] (interface on the inside, implementation on the outside) → DB/web become swappable details.\n\n:::tip Bottom line\nHexagonal, Onion, and Clean are the same idea: domain at the core, infrastructure at the edge, dependencies pointing inward. They differ mostly in vocabulary and level of detail.\n:::\n\n:::deep\n- Clean/Hexagonal is NOT 'split into 4 folders' — it's a [[g:dependency rule]] — the domain imports nothing from Spring/JPA/Kafka\n- enforced through dependency inversion: the domain defines `PaymentGateway` (a port), the infrastructure module implements it with a Stripe/PSP adapter\n- benefit: test the use case with an in-memory adapter, swap the PSP without touching the domain, the domain reads as pure 'business' with no 'JPA' in sight\n\n[[r:The cost]]: lots of interfaces/mapping — only worth it when the domain is complex. Plain CRUD → layered is enough. Bottom line: 'architecture serves the business's rate of change, not diagram aesthetics'.\n\n**Carry the rule into the real build:**\n\n- Package a Spring Boot service around the architecture: (12-architecture-patterns.clean-layered-building-it-for-real.q1)\n- Enforce the Dependency Rule with ArchUnit or Spring Modulith: (12-architecture-patterns.clean-layered-building-it-for-real.q4)\n- Without automated enforcement, the dependency rule drifts over time.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.architecture-styles.q4","q":"Layered vs Hexagonal/Clean — when to pick which?","a":"<table class=\"cmp\"><thead><tr><th></th><th>Layered</th><th>Hexagonal/Clean</th></tr></thead><tbody>\n<tr><td>Good fit for</td><td>simple CRUD, small team, thin domain</td><td>complex domain, long lifespan, many integrations</td></tr>\n<tr><td>Testability</td><td>tied to DB/framework</td><td>test the domain with a mock adapter</td></tr>\n<tr><td>Changing infrastructure</td><td>seeps everywhere</td><td>only touch the adapter</td></tr>\n<tr><td>Cost</td><td>low</td><td>more layers/abstraction</td></tr>\n</tbody></table>\n\n<figure class='dgm'><svg viewBox='0 0 680 300' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='10.5' text-anchor='middle'>\n<defs><marker id='ar20' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#AE4536'/></marker><marker id='ar21' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#0B6E4F'/></marker></defs>\n<text x='170' y='20' fill='#14233A' font-weight='600' font-size='12'>LAYERED (n-tier)</text>\n<rect x='56' y='34' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='56' fill='#3D4E8F'>Controller / Web</text>\n<rect x='56' y='86' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='108' fill='#3D4E8F'>Service (business logic)</text>\n<rect x='56' y='138' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='160' fill='#3D4E8F'>Repository</text>\n<rect x='56' y='190' width='230' height='40' rx='6' fill='#F6E8E5' stroke='#AE4536' stroke-width='1.6'/><text x='171' y='208' fill='#7d2f24' font-weight='600'>DB · JPA · Framework</text><text x='171' y='223' fill='#AE4536'>infrastructure sits at the BOTTOM</text>\n<g stroke='#AE4536' stroke-width='1.5' marker-end='url(#ar20)'><line x1='171' y1='70' x2='171' y2='82'/><line x1='171' y1='122' x2='171' y2='134'/><line x1='171' y1='174' x2='171' y2='186'/></g>\n<text x='171' y='252' fill='#AE4536' font-weight='600'>dependencies point DOWNWARD</text>\n<text x='171' y='268' fill='#42536C'>→ infrastructure seeps back up into the domain</text>\n<text x='171' y='284' fill='#42536C'>→ testing logic requires standing up the DB</text>\n<line x1='322' y1='28' x2='322' y2='286' stroke='#DBE1EA' stroke-width='1.5' stroke-dasharray='4 4'/>\n<text x='510' y='20' fill='#14233A' font-weight='600' font-size='12'>CLEAN / HEXAGONAL</text>\n<rect x='372' y='34' width='274' height='196' rx='10' fill='#F7F9FC' stroke='#7E8DA3'/><text x='510' y='50' fill='#42536C'>Frameworks &amp; Drivers</text>\n<rect x='398' y='58' width='222' height='148' rx='9' fill='#E7EAF6' stroke='#3D4E8F'/><text x='510' y='74' fill='#3D4E8F'>Interface Adapters</text>\n<rect x='424' y='82' width='170' height='100' rx='8' fill='#EFEAF7' stroke='#5B3E8E'/><text x='510' y='98' fill='#5B3E8E'>Use Cases</text>\n<rect x='452' y='106' width='114' height='52' rx='7' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='1.6'/><text x='509' y='130' fill='#085239' font-weight='600'>Entities</text><text x='509' y='145' fill='#0B6E4F'>domain</text>\n<g stroke='#0B6E4F' stroke-width='1.6' marker-end='url(#ar21)'><line x1='510' y1='224' x2='510' y2='212'/><line x1='510' y1='200' x2='510' y2='188'/><line x1='510' y1='176' x2='510' y2='164'/></g>\n<text x='510' y='252' fill='#0B6E4F' font-weight='600'>dependencies point INWARD</text>\n<text x='510' y='268' fill='#42536C'>→ the domain doesn't know DB/web exist</text>\n<text x='510' y='284' fill='#42536C'>→ testing the domain needs no Spring</text>\n</svg></figure>\n\n:::warn Warning\ndon't apply Clean to trivial CRUD — the boilerplate cost isn't worth it. Choose based on domain complexity.\n:::\n\n:::deep\n- [[o:not a whole-system binary choice]] — apply it *per service/context*: complex Booking/Payment → Clean; simple lookup/reporting → layered\n- signs you need Clean: logic is hard to test because it's tied to DB/framework, or swapping a PSP means editing everywhere\n- signs of over-engineering: lots of interfaces/mapping for trivial CRUD\n\n'Architecture serves the business's rate of change, not diagram aesthetics' — choose based on domain complexity &amp; how often it changes.\n\n- Measure the cost and the benefit with the test pyramid mapped onto each layer (12-architecture-patterns.clean-layered-building-it-for-real.q6); migrating a running layered codebase gradually follows the six steps in 12.21.\n:::","difficulty":"advanced"}]},{"title":"Domain-Driven Design","items":[{"id":"12-architecture-patterns.domain-driven-design.q1","q":"Strategic DDD: bounded context, ubiquitous language, context mapping?","a":"- [[b:Bounded Context]]: a boundary within which one model/language has consistent meaning ('Account' in Billing differs from Auth) → a natural choice for micro-service boundaries\n- [[b:Ubiquitous Language]]: developers and domain experts share the same vocabulary, reflected in the code\n- [[b:Context Mapping]]: describes the relationships between contexts (Customer-Supplier, Anti-Corruption Layer, Shared Kernel...)\n\n:::tip Bottom line\nStrategic DDD is essentially the tool for [[g:drawing micro-service boundaries]] along business lines — matching 'service boundary = consistency boundary'.\n:::\n\n:::deep\n- a bounded context is usually = one service + one dedicated DB; the boundary sits where language/meaning changes (OTA: 'Booking', 'Inventory', 'Pricing', 'Payment', 'Loyalty' — 'fare' in Pricing differs from 'amount' in Payment)\n- context map: Payment = Supplier, Booking = Customer; insert an *Anti-Corruption Layer* when integrating a legacy GDS\n- an aggregate holds invariants within a transaction boundary (`Booking` guarantees 'total seats = number of passengers')\n\n[[r:Mistake]]: splitting services by technical layer (controller-service-dao) instead of by business capability → distributed monolith.\n\n- Topic 24 is the deep dive on this section: getting the ubiquitous language right (24-domain-driven-design.strategic-splitting-the-domain.q1)\n- finding boundaries with event storming (24-domain-driven-design.strategic-splitting-the-domain.q4)\n- the relationship types in a context map (24-domain-driven-design.strategic-splitting-the-domain.q3).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.domain-driven-design.q2","q":"Tactical DDD: entity, value object, aggregate, repository, domain event?","a":"- [[b:Entity]]: has identity, a lifecycle (Account, Order)\n- [[b:Value Object]]: immutable, defined by its value (Money, Address)\n- [[b:Aggregate]]: a cluster of objects with an *aggregate root* as the entry point, protecting invariants; a transaction should be scoped to one aggregate\n- [[b:Repository]]: an abstraction for retrieving aggregates (hides the DB)\n- [[b:Domain Event]]: something that already happened (OrderPlaced) — the foundation for event-driven/outbox\n\n[[g:Money]] is the classic value object in fintech (immutable, carries a currency).\n\n:::deep\n- an [[g:Aggregate]] is a *transaction & consistency* boundary — only changed through the *aggregate root*, protecting invariants; one transaction should be scoped to *one* aggregate (cross-aggregate work uses eventual consistency + domain events)\n- keep aggregates small ([[r:don't gather the whole world]] → heavy contention/locking)\n- Value Objects are immutable (Money, SeatNumber) — compared by value, thread-safe\n\nOTA: the `Booking` aggregate holds the seat/price invariant; `LedgerEntry` is append-only; a `PaymentSucceeded` domain event is published. [[r:An aggregate boundary that's too large = lock contention & hard to scale.]]\n\n- Deep dive into each block: Entity vs. Value Object (24-domain-driven-design.tactical-modelling-it.q1), how to size aggregate boundaries (24-domain-driven-design.tactical-modelling-it.q2), where Repository/Factory/Domain Service each belong (24-domain-driven-design.tactical-modelling-it.q4).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.domain-driven-design.q3","q":"When SHOULD and SHOULDN'T you use DDD?","a":"- [[g:Use it]] when the domain is *business-complex* (many rules, changing over time) — fintech, insurance, logistics\n- [[r:Don't]] when it's just CRUD/forms-over-data: the conceptual cost (aggregate, context) > the benefit\n\nDDD is about *modelling the business*, not a mandatory code pattern.\n\n:::deep\n- USE it when the domain is complex (many rules, needs a shared language with domain experts) — fintech, OTA (fare rules, overbooking, refund policy)\n- DON'T when it's CRUD/forms-over-data (the cost of aggregates, bounded contexts, mapping > the benefit)\n- you can use strategic DDD (bounded contexts splitting services) without heavy tactical DDD, or vice versa\n\n[[o:Apply DDD selectively]]: core domain (booking/pricing/ledger: full tactical DDD) vs. supporting/generic (notifications/reporting: layered/CRUD or buy off-the-shelf). [[r:Mistake]]: DDD-ifying everything, or skipping it on a genuinely complex core (anemic domain + logic leaking through every service).\n\n- 'What problem DDD actually solves' is covered in more depth in 24.1 — and it also opens with exactly this question of when not to use it.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.domain-driven-design.q4","q":"CQRS and Event Sourcing — when do they make sense?","a":"- [[b:CQRS]]: separates the write model (command) from the read model (query) → each optimized independently, reads use a read model/projection\n- [[b:Event Sourcing]]: state = a sequence of events\n\nA powerful pairing for audit trails & rebuilding views (a great fit for a ledger).\n\n[[r:Trade-off]]: complexity, eventual consistency between the write and read model, event versioning.\n\n[[o:Don't use it by default]] — only when audit needs/read scaling/model transformation justify it.\n\n:::deep\n- CQRS separates the command (normalized, protects invariants) from the query (read model optimized for the screen) → scale &amp; optimize independently; the read model can be denormalized/live in a different store (Elasticsearch/Redis)\n- Event Sourcing stores the event sequence as the source of truth → perfect audit trail, time-travel, rebuildable projections\n- trade-offs: eventual consistency between write↔read model, event versioning/upcasting, snapshots for fast replay\n\nOTA: an event-sourced ledger (easy reconciliation/balance rebuilding); a separate 'booking history' read model projection. But [[g:lightweight CQRS]] (just splitting the read model, not full ES) is usually enough — don't default to full ES because it 'sounds impressive'.\n\n- Before even considering event sourcing, distinguish a domain event from an integration event first (24-domain-driven-design.tactical-modelling-it.q3): using domain events doesn't mean storing state as events.\n:::","difficulty":"advanced"}]},{"title":"Patterns & principles","items":[{"id":"12-architecture-patterns.patterns-principles.q1","q":"Which design patterns should a senior engineer know cold (and why)?","a":"- [[b:Strategy]]: pick an algorithm at runtime (PSP routing) — avoids a giant if-else chain\n- [[b:Factory/Abstract Factory]]: create complex/multi-variant objects\n- [[b:Builder]]: construct an immutable object with many fields\n- [[b:Decorator]]: add behavior (logging, caching) without modifying the core\n- [[b:Adapter]]: bridge incompatible interfaces (anti-corruption layer)\n- [[b:Observer]]: internal event-driven behavior\n- distributed: Circuit Breaker, Saga, Outbox, CQRS\n\n[[o:Describe a pattern through the *problem* + *trade-off*, not just the name.]]\n\n:::deep\n- Strategy (routing PSP/GDS by condition, replacing if-else — underpins OCP), Factory (multi-variant objects)\n- Builder (immutable object with many fields — Itinerary), Decorator (logging/caching/retry without touching the core), Adapter (ACL with a legacy GDS), Observer (internal event-driven behavior)\n\nA pattern is *shared vocabulary* + a proven solution — but [[r:don't cram patterns in]] (over-engineering); pick one when the problem genuinely shows up. Knowing when NOT to use a pattern matters just as much for a senior engineer.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.patterns-principles.q2","q":"SOLID — a pragmatic reading for backend engineers?","a":"- [[b:S]]RP: a class has one reason to change\n- [[b:O]]CP: open for extension, closed for modification (Strategy/polymorphism)\n- [[b:L]]SP: a subtype can replace its supertype without breaking behavior\n- [[b:I]]SP: small, need-specific interfaces, avoid a 'fat interface'\n- [[b:D]]IP: depend on abstractions — the foundation of Hexagonal/Clean\n\n[[g:DIP + ISP]] are exactly what let the domain stay independent of infrastructure.\n\n:::deep\n- SRP: a service/class shouldn't carry multiple responsibilities (PaymentService shouldn't also do notifications)\n- OCP: adding a new PSP shouldn't require editing existing code (Strategy/polymorphism)\n- LSP: don't override in a way that narrows behavior; ISP: small need-specific interfaces (avoid a fat interface); DIP: the domain defines the port, infrastructure implements it\n\n[[o:SOLID is guidance, not hard law]] — apply it with judgment ([[r:don't create an abstraction for something with only one implementation 'just in case']] → YAGNI). The goal: code that's safe to change, not dogma compliance.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.patterns-principles.q3","q":"Common anti-patterns: distributed monolith, anemic domain, god object?","a":"- [[r:Distributed monolith]]: services are split but tightly coupled (shared DB, long synchronous call chains) → you get all of micro-services' downsides with none of the benefits. Sign: changing 1 service forces deploying several others\n- [[r:Anemic domain model]]: entities are just getters/setters, logic piles up in the service → loses the power of OOP/DDD\n- [[r:God object/service]]: one class does far too much\n\n:::warn Golden rule\n'a service does not share a database'. Two services writing to the same table is a distributed-monolith red flag.\n:::\n\n:::deep\n- [[r:Distributed monolith]]: tight coupling (shared DB, long synchronous call chains, synchronized deploys). Sign: changing 1 service forces deploying 5 others; two services writing to the same table → fix: database-per-service, clear async communication/contracts, boundaries drawn along bounded contexts\n- Anemic domain → fix: move behavior/invariants into the aggregate; God object → fix: split along SRP\n\n'Micro-services are a trade-off, not an upgrade'; without a clear organizational/scaling reason → stick with a [[g:modular monolith]].\n\n- Anemic domain from the DDD angle: how to spot it (24-domain-driven-design.strategic-splitting-the-domain.q1) and how to avoid it — behavior belongs to the aggregate, and only what belongs to no aggregate becomes a Domain Service (24-domain-driven-design.tactical-modelling-it.q4).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.patterns-principles.q4","q":"Coupling & cohesion — the design compass?","a":"Goal: [[g:low coupling, high cohesion]] — independent modules, each module gathering related things.\n\n- low coupling → local changes don't spread\n- high cohesion → code is easy to understand/locate\n\nThis is the implicit criterion behind every module/service boundary decision.\n\n<table class=\"cmp\"><thead><tr><th>Coupling type</th><th>Symptom</th><th>Danger level</th></tr></thead><tbody>\n<tr><td>Shared database</td><td>two services write to the same table</td><td>highest — nobody can change the schema anymore</td></tr>\n<tr><td>Long synchronous call chains</td><td>A calls B calls C calls D</td><td>high — errors and latency compound</td></tr>\n<tr><td>Shared model library</td><td>one shared DTO jar</td><td>medium — bumping the version touches everyone</td></tr>\n<tr><td>Via events with a contract</td><td>publish/subscribe</td><td>low — but still needs versioning</td></tr>\n</tbody></table>\n\n:::deep\n- low coupling = changing A doesn't force changing B (via interface/event, not sharing internals/DB)\n- high cohesion = everything in a module serves one purpose\n- measure by: how far do changes spread? (high coupling = spreads a lot); does a module have 'many reasons to change'? (low cohesion)\n\nA bounded context = a cohesion boundary; coupling between contexts is kept minimal via context map/ACL/events. [[o:Connascence]] (how strongly two parts must change together) is a more refined way to measure coupling.\n\nBottom line: two things that must change together often → same module; loosely related → split apart.\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.patterns-principles.q5","q":"Modular monolith vs micro-services — when do you split?","a":"<table class=\"cmp\"><thead><tr><th></th><th>Modular monolith</th><th>Micro-services</th></tr></thead><tbody>\n<tr><td>Deploy</td><td>single</td><td>each service independently</td></tr>\n<tr><td>Transaction</td><td>local ACID</td><td>distributed (Saga)</td></tr>\n<tr><td>Operations</td><td>simple</td><td>network, consistency, observability</td></tr>\n<tr><td>Split when</td><td>—</td><td>need independent scale/deploy/team</td></tr>\n</tbody></table>\n\n:::tip 8 years of experience, bottom line\nstart with a modular monolith with clean boundaries; only split into micro-services when there's a clear organizational/scaling reason. 'Microservices are a trade-off, not an upgrade.'\n:::\n\n:::deep\n- [[b:Modular monolith]]: single deploy, clearly bounded modules (each module has an internal API, no reaching across internals) → 1 deploy, schema-per-module, local ACID transactions, boundaries are easy to refactor (same codebase)\n- [[b:Micro-services]] when you need: independent scaling, independent deploys per team (Conway's law), isolating failures/technology — traded for distributed complexity\n\nStart with a modular monolith with clean boundaries (easy to split later); split when there's a clear *organizational/scaling* reason. [[r:Splitting too early + wrong boundaries = distributed monolith.]]\n\n- Enforcing module boundaries right inside the monolith with Spring Modulith, and package-by-feature vs. package-by-layer (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.patterns-principles.q6","q":"What does an Anti-Corruption Layer (ACL) do when integrating with a legacy system?","a":"[[g:ACL]] (Anti-Corruption Layer) = a translation layer between your domain and an external/legacy system with a different model → protects the domain from being 'contaminated' by bad concepts/structures.\n\n- usually implemented as an Adapter + mapping\n- useful when integrating with old core banking systems or a PSP with a non-standard model\n\n:::warn Interview trap\nAn ACL is easily mistaken for 'just a mapper'.\n:::\n\nThe distinguishing point: a mapper translates *structure* (this field to that field), while an ACL also translates *concepts* — the other side calls it `PAX` with five states while your domain only has three, and the ACL must decide which mapping applies and reject what's invalid.\n\nIf your ACL never throws an error anywhere, it's almost certainly just a mapper.\n\n:::deep\n- ACL = Adapter + mapping between the domain and a messy external/legacy system → changes on their side only affect the ACL, never spreading into the domain\n- implementation: an interface (port) on the domain side + an adapter that translates the external system's DTO ↔ the domain model, also handling differences in semantics/units/errors\n\nOTA: integrating a legacy GDS/airline system (Amadeus/Sabre with their own schema/format, odd error codes) through an ACL → the Booking domain only ever sees a clean model; switching GDS providers only touches the ACL.\n\nThe ACL is also where you gather retry/idempotency/circuit-breaker logic for external integrations.\n\n- ACL is one relationship type in a context map, alongside Customer/Supplier, Conformist, and Open Host Service — pick the wrong relationship type and an ACL can't save you (24-domain-driven-design.strategic-splitting-the-domain.q3).\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.patterns-principles.q7","difficulty":"extra","q":"The 23 GoF patterns — which does modern Java already give you, which do you still write, and which has the language replaced?","a":"The useful way to hold the catalogue is not 23 definitions but three groups, then a second cut by *who writes the pattern today*.\n\n**Creational (5) — how an object is made:** Factory Method, Abstract Factory, Builder, Prototype, Singleton.\n\n**Structural (7) — how objects are composed:** Adapter, Bridge, Composite, Decorator, Facade, Flyweight, Proxy.\n\n**Behavioral (11) — how objects divide work:** Chain of Responsibility, Command, Interpreter, Iterator, Mediator, Memento, Observer, State, Strategy, Template Method, Visitor.\n\n<table>\n<tr><th>Where it lives now</th><th>Patterns</th><th>Example</th></tr>\n<tr><td><b>The platform ships it</b> — use it, don't write it</td><td>Iterator · Proxy · Observer<br>Chain of Responsibility · Facade · Flyweight</td><td><code>Iterable</code> · Spring AOP and <code>@Transactional</code> proxies<br><code>ApplicationEventPublisher</code> · servlet and Security filter chains<br>SLF4J (the F is facade) · <code>Integer.valueOf</code> caching −128..127</td></tr>\n<tr><td><b>You still write it</b> in service code</td><td>Strategy · Factory · Builder · Adapter<br>Decorator · State · Template Method · Command</td><td>PSP routing per provider · an adapter as anti-corruption layer<br>a decorator for retry or metrics · an order state machine</td></tr>\n<tr><td><b>A language feature replaced it</b></td><td>Visitor · Prototype · Singleton<br>one-method Strategy or Command classes</td><td>sealed types + pattern-matching <code>switch</code> (Java 21)<br>copy constructor · container scope · a lambda</td></tr>\n<tr><td><b>Rare in backend code</b></td><td>Interpreter · Memento · Mediator · Bridge · Composite</td><td>expression languages · undo · UI coordination<br>driver/API splits · trees</td></tr>\n</table>\n\n:::tip How to talk about one\nName the problem first, then the pattern, then its cost: \"the rules for choosing a PSP changed weekly, so routing became a Strategy per provider; the cost is one more indirection to trace.\"\n:::\n\n:::deep\n- **Visitor → `switch`.** Visitor exists to add operations to a closed hierarchy without editing it. With a `sealed` interface and record patterns, a `switch` over the subtypes is exhaustive and compiler-checked, so a missing case is a compile error instead of a missing `visit` method.\n- **Prototype → copy constructors.** `Object.clone()` is a shallow copy with an awkward contract (Effective Java, Item 13); a copy constructor or static copy factory says exactly what gets copied.\n- **Strategy and Command → lambdas.** A strategy with one method and no state is a `Function`, `Comparator` or `Runnable`. A class per strategy earns its keep once it has configuration, a name in the logs, or tests of its own.\n- **Template Method vs callbacks.** Spring's `JdbcTemplate` and `TransactionTemplate` keep the fixed steps (acquire, run, release) and take the varying part as a callback instead of a subclass — the same idea, with composition instead of inheritance.\n- **Decorator vs Proxy.** Both wrap the same interface; a decorator adds behaviour the caller wants, a proxy controls access to the target — and a Spring proxy is why self-invocation skips `@Transactional` (03-spring-boot-deep-build.ioc-container-transactions.q2).\n- **State vs Strategy** differ in who switches: a strategy is chosen from outside, a state replaces itself on each transition (22-low-level-design-ood.patterns-in-interview-code.q2). Singleton in practice is (22-low-level-design-ood.patterns-in-interview-code.q7).\n- the short list to know cold is (12-architecture-patterns.patterns-principles.q1). The grouping above is this site's judgement for Java backend services, not a measurement; the catalogue and its intents come from Gamma, Helm, Johnson and Vlissides (1994).\n:::"}]},{"title":"Clean & layered — building it for real","items":[{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q1","q":"What does a real-world package structure for a Spring Boot service look like under Clean/Hexagonal?","a":"12.3 covers the *rule*; this one covers the *folders*. The most common structure, split by [[g:feature first, layer second]]:\n\n<pre><code>com.acme.booking\n├── domain/                     <span class=\"c\">// does NOT import Spring, JPA, Jackson</span>\n│   ├── Booking.java            <span class=\"c\">// business entity + invariants</span>\n│   ├── Money.java              <span class=\"c\">// value object</span>\n│   ├── BookingStatus.java\n│   └── DomainException.java\n├── application/\n│   ├── port/in/                <span class=\"c\">// use case interface (entry port)</span>\n│   │   ├── HoldSeatUseCase.java\n│   │   └── CancelBookingUseCase.java\n│   ├── port/out/               <span class=\"c\">// exit port — domain DEFINES it, infrastructure implements it</span>\n│   │   ├── BookingRepository.java\n│   │   ├── PaymentGateway.java\n│   │   └── SeatLockPort.java\n│   └── service/\n│       └── HoldSeatService.java   <span class=\"c\">// orchestration, opens the transaction</span>\n├── adapter/\n│   ├── in/web/                 <span class=\"c\">// Controller, request/response DTOs</span>\n│   ├── in/messaging/           <span class=\"c\">// Kafka consumer</span>\n│   ├── out/persistence/        <span class=\"c\">// JpaBookingRepository + BookingJpaEntity</span>\n│   └── out/psp/                <span class=\"c\">// StripePaymentGateway</span>\n└── config/                     <span class=\"c\">// @Configuration, wiring, the only place that knows everything</span></code></pre>\n\nDependency direction: `adapter` → `application` → `domain`. [[r:Never the other way around.]]\n\nAn easily missed point: [[o:`port/out` lives inside `application`, not inside `adapter`]].\n\nThe interface is defined by the inside according to its own needs, and the outside is what implements it — that's exactly dependency inversion, and it's also what separates someone who understands it from someone who just copied the folder layout.\n\n<figure class='dgm'><svg viewBox='0 0 680 250' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='10' text-anchor='middle'>\n<defs><marker id='ar22' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#42536C'/></marker></defs>\n<text x='340' y='18' fill='#14233A' font-weight='600' font-size='11.5'>POST /bookings/8H2K/holds — one request passing through the layers</text>\n<rect x='16' y='36' width='118' height='52' rx='7' fill='#E7EAF6' stroke='#3D4E8F'/><text x='75' y='56' fill='#3D4E8F' font-weight='600'>adapter/in/web</text><text x='75' y='70' fill='#42536C'>Controller</text><text x='75' y='82' fill='#7E8DA3'>WebRequest</text>\n<rect x='160' y='36' width='124' height='52' rx='7' fill='#EFEAF7' stroke='#5B3E8E'/><text x='222' y='56' fill='#5B3E8E' font-weight='600'>application</text><text x='222' y='70' fill='#42536C'>HoldSeatService</text><text x='222' y='82' fill='#7E8DA3'>@Transactional</text>\n<rect x='310' y='36' width='112' height='52' rx='7' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='1.6'/><text x='366' y='56' fill='#085239' font-weight='600'>domain</text><text x='366' y='70' fill='#42536C'>Booking.holdSeat()</text><text x='366' y='82' fill='#7E8DA3'>business rule</text>\n<rect x='448' y='36' width='104' height='52' rx='7' fill='#FBFCFE' stroke='#7E8DA3' stroke-dasharray='3 3'/><text x='500' y='56' fill='#42536C' font-weight='600'>port/out</text><text x='500' y='70' fill='#42536C'>BookingRepository</text><text x='500' y='82' fill='#7E8DA3'>interface</text>\n<rect x='578' y='36' width='88' height='52' rx='7' fill='#F6E8E5' stroke='#AE4536'/><text x='622' y='56' fill='#7d2f24' font-weight='600'>adapter/out</text><text x='622' y='70' fill='#42536C'>JPA · Stripe</text>\n<g stroke='#42536C' stroke-width='1.4' marker-end='url(#ar22)'><line x1='134' y1='62' x2='156' y2='62'/><line x1='284' y1='62' x2='306' y2='62'/><line x1='422' y1='62' x2='444' y2='62'/><line x1='552' y1='62' x2='574' y2='62'/></g>\n<text x='145' y='108' fill='#7E8DA3'>Command</text><text x='295' y='108' fill='#7E8DA3'>domain obj</text><text x='433' y='108' fill='#7E8DA3'>called via interface</text><text x='563' y='108' fill='#7E8DA3'>implementation</text>\n<rect x='16' y='132' width='650' height='44' rx='8' fill='#FBFCFE' stroke='#DBE1EA'/>\n<text x='340' y='150' fill='#14233A' font-weight='600'>COMPILE-TIME direction: adapter → application → domain (domain imports nothing from anyone)</text>\n<text x='340' y='166' fill='#42536C'>The RUNTIME direction at steps 4→5 is reversed — that's exactly dependency inversion</text>\n<text x='340' y='198' fill='#AE4536'>Seeing an import of jakarta.persistence or org.springframework in domain/ = already broken</text>\n<text x='340' y='218' fill='#42536C'>An ArchUnit rule (12-architecture-patterns.clean-layered-building-it-for-real.q4) catches exactly this mistake in CI</text>\n</svg></figure>\n\n:::deep\n- Name ports after the [[g:business language]], not the technology: `PaymentGateway`, not `StripeClient`; `SeatLockPort`, not `RedisLock`. A name that leaks the technology is a sign infrastructure is seeping inward.\n- one use case = one small interface in `port/in` (12-architecture-patterns.clean-layered-building-it-for-real.q3). A 20-method interface is the old `Service` wearing a new outfit.\n- `config` is the [[o:only place]] allowed to know about every layer — it wires adapters into ports. Keep it thin and free of logic.\n- package-private is your friend: keeping `BookingJpaEntity` package-private inside `out/persistence` means no other layer can accidentally use it (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n- [[r:Don't]] create a separate Maven module right from the start — use packages first, split into modules only when you genuinely need to enforce the boundary (12-architecture-patterns.clean-layered-building-it-for-real.q4).\n- For a thin domain (CRUD), this structure is over-engineering — 12.4 already warned about this. Use it when the domain has real invariants worth protecting.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q2","q":"Domain model and JPA entity: two separate classes, or share one class?","a":"The most contentious real-world question when applying Clean to Spring. Three options:\n\n<table class=\"cmp\"><thead><tr><th></th><th>Share 1 class</th><th>Split into 2 classes + mapper</th><th>Shared but hides JPA</th></tr></thead><tbody>\n<tr><td>Boilerplate</td><td>none</td><td><b>a lot</b> (two-way mapper)</td><td>little</td></tr>\n<tr><td>Clean domain</td><td>no — tied to JPA</td><td><b>completely clean</b></td><td>mostly clean</td></tr>\n<tr><td>Invariants</td><td>hard — JPA needs a no-arg ctor + setters</td><td>protected</td><td>partially protected</td></tr>\n<tr><td>Lazy loading</td><td>leaks outside the domain</td><td>doesn't leak</td><td>still leaks</td></tr>\n<tr><td>Good fit when</td><td>CRUD, thin domain</td><td>complex, long-lived domain</td><td>middle ground</td></tr>\n</tbody></table>\n\n**Why sharing hurts:** JPA requires a no-arg constructor and setters so it can reconstruct the object → the domain can no longer enforce its invariants.\n\nOn top of that, a lazy `@OneToMany` turns a plain property read in the domain into an actual SQL query, and `LazyInitializationException` blows up in a layer that has nothing to do with the DB.\n\n<pre><code><span class=\"c\">// domain/Booking.java — no annotations at all</span>\n<span class=\"k\">public final class</span> Booking {\n    <span class=\"k\">private final</span> BookingId id;\n    <span class=\"k\">private</span> BookingStatus status;\n    <span class=\"k\">private final</span> List&lt;Passenger&gt; passengers;\n<span class=\"c\">    </span>\n    <span class=\"k\">public void</span> <span class=\"f\">cancel</span>() {                       <span class=\"c\">// invariant lives in the domain</span>\n        <span class=\"k\">if</span> (status == ISSUED) <span class=\"k\">throw new</span> DomainException(<span class=\"s\">\"Ticket already issued, must be refunded\"</span>);\n        status = CANCELLED;\n    }\n}\n<span class=\"c\">// adapter/out/persistence/BookingJpaEntity.java — pure storage</span>\n<span class=\"k\">@Entity @Table</span>(name = <span class=\"s\">\"bookings\"</span>)\n<span class=\"k\">class</span> BookingJpaEntity {\n    <span class=\"k\">@Id</span> <span class=\"k\">private</span> String id;\n    <span class=\"k\">@Enumerated</span>(STRING) <span class=\"k\">private</span> BookingStatus status;\n    <span class=\"k\">protected</span> <span class=\"f\">BookingJpaEntity</span>() {}          <span class=\"c\">// JPA needs it — but never exposed to the domain</span>\n}</code></pre>\n\n:::deep\n- Hand-written mappers are error-prone and tedious → use [[g:MapStruct]] (generates code at compile time, no reflection at runtime). This is a case where a library is worth it.\n- The real cost of splitting is [[o:not]] the mapper — it's when the domain and the table diverge significantly (an aggregate spanning 4 tables). That's when the repository adapter has to assemble/split them — and that's exactly what it exists to do.\n- [[r:Half-hearted trap]]: splitting into 2 classes but letting the domain's `getId()` return the DB's auto-increment `Long`. The domain should use its own id (UUID/business code), generated in the domain — see 17.1.\n- If you choose to share: at minimum keep setters package-private, add `@Access(FIELD)`, and [[g:forbid `EAGER`]] — reduces leakage without paying for a mapper.\n- Decide [[o:per bounded context]], not for the whole repo: Booking/Payment get split; a simple airport-code lookup table can share a class, or even skip a domain model entirely.\n- Common trick question: *\"does the repository return the domain object or the entity?\"* — [[g:always the domain object]]. If it returns the entity, that port isn't really a port.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q3","q":"How should a use case (application service) be designed? One class per use case, or grouped into a service?","a":"[[g:One class per use case]] — this is the biggest difference from an 800-line `BookingService` in the layered style.\n\n<pre><code><span class=\"c\">// port/in — the contract, reading it tells you what the system can do</span>\n<span class=\"k\">public interface</span> HoldSeatUseCase {\n    HoldResult <span class=\"f\">hold</span>(HoldSeatCommand cmd);\n}\n<span class=\"c\">// application/service — orchestration, contains NO business rules</span>\n<span class=\"k\">@Service</span>\n<span class=\"k\">class</span> HoldSeatService <span class=\"k\">implements</span> HoldSeatUseCase {\n    <span class=\"k\">private final</span> BookingRepository bookings;   <span class=\"c\">// port/out</span>\n    <span class=\"k\">private final</span> SeatLockPort locks;\n<span class=\"c\">    </span>\n    <span class=\"k\">@Override</span> <span class=\"k\">@Transactional</span>                    <span class=\"c\">// the transaction boundary is HERE</span>\n    <span class=\"k\">public</span> HoldResult <span class=\"f\">hold</span>(HoldSeatCommand cmd) {\n        <span class=\"k\">if</span> (!locks.<span class=\"f\">tryLock</span>(cmd.<span class=\"f\">flightId</span>(), cmd.<span class=\"f\">seatNo</span>())) <span class=\"k\">return</span> HoldResult.<span class=\"f\">taken</span>();\n        Booking b = bookings.<span class=\"f\">findById</span>(cmd.<span class=\"f\">bookingId</span>())\n                            .<span class=\"f\">orElseThrow</span>(NotFound::<span class=\"k\">new</span>);\n        b.<span class=\"f\">holdSeat</span>(cmd.<span class=\"f\">seatNo</span>());                <span class=\"c\">// the rule lives in the DOMAIN</span>\n        bookings.<span class=\"f\">save</span>(b);\n        <span class=\"k\">return</span> HoldResult.<span class=\"f\">ok</span>(b.<span class=\"f\">holdExpiresAt</span>());\n    }\n}</code></pre>\n\n**Clear boundary:** the use case *orchestrates* (fetch → call the domain → save → publish event). The business decision of *\"can this seat be held\"* lives inside `Booking`, not here. If a use case is full of business `if` statements, the domain is anemic (12.11 anemic domain).\n\n**Command/Result are the application layer's DTOs**, separate from the web layer's DTOs (`adapter/in/web`).\n\nThis sounds redundant, but it lets you change the REST contract (17-rest-api-design.contracts-errors-lifecycle.q4) without touching the use case, and lets the same use case run from a Kafka consumer.\n\n:::deep\n- A Command should [[g:self-validate its syntax]] right in the constructor (a `record` compact constructor) — it should be impossible to create a meaningless `HoldSeatCommand`. This is the \"make invalid state unrepresentable\" style.\n- A use case calling another use case is a [[r:smell]]: either extract the shared part down into a domain service, or use a domain event. Nested calls muddy the transaction and make errors hard to trace.\n- [[o:Don't]] let a use case return a raw JPA entity or domain object to the controller — return a `Result` so the controller doesn't depend on the domain's shape.\n- A read-only (query) use case usually [[g:doesn't need to go through the domain]]: read directly via a projection for speed. That's the natural gateway into CQRS (12-architecture-patterns.domain-driven-design.q4) without doing full event sourcing.\n- Class names should be [[g:business verbs]]: `HoldSeat`, `IssueTicket`, `RefundBooking`. Reading the file list in `port/in` tells you what the system does — 'screaming architecture' (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n- Quick quality check: `application/service` imports should only include `domain`, `port`, and transaction annotations. Seeing `javax.persistence` or `HttpServletRequest` here means it's already broken.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q4","q":"How do you enforce the Dependency Rule? Without tooling, the architecture drifts within 3 months.","a":"A rule that lives only in people's heads [[r:will drift]] — a new dev adds `import javax.persistence` to the domain and nobody catches it in review. Three levels of enforcement, increasing in strength:\n\n**1. ArchUnit — a test like any other, cheapest, do this first:**\n\n<pre><code><span class=\"k\">@AnalyzeClasses</span>(packages = <span class=\"s\">\"com.acme.booking\"</span>)\n<span class=\"k\">class</span> ArchitectureTest {\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule domain_does_not_depend_on_infrastructure =\n        noClasses().that().resideInAPackage(<span class=\"s\">\"..domain..\"</span>)\n            .should().dependOnClassesThat()\n            .resideInAnyPackage(<span class=\"s\">\"..adapter..\"</span>, <span class=\"s\">\"org.springframework..\"</span>,\n                                <span class=\"s\">\"jakarta.persistence..\"</span>, <span class=\"s\">\"com.fasterxml..\"</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule layers_respect_direction =\n        layeredArchitecture().consideringOnlyDependenciesInLayers()\n            .layer(<span class=\"s\">\"Domain\"</span>).definedBy(<span class=\"s\">\"..domain..\"</span>)\n            .layer(<span class=\"s\">\"Application\"</span>).definedBy(<span class=\"s\">\"..application..\"</span>)\n            .layer(<span class=\"s\">\"Adapter\"</span>).definedBy(<span class=\"s\">\"..adapter..\"</span>)\n            .whereLayer(<span class=\"s\">\"Adapter\"</span>).mayNotBeAccessedByAnyLayer()\n            .whereLayer(<span class=\"s\">\"Application\"</span>).mayOnlyBeAccessedByLayers(<span class=\"s\">\"Adapter\"</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule no_field_injection_allowed =\n        noFields().should().beAnnotatedWith(Autowired.<span class=\"k\">class</span>);\n}</code></pre>\n\n**2. Maven/Gradle module** — `domain` is a module that declares no dependency on Spring/JPA at all. The compiler blocks it instead of a test; in exchange the build gets more complex and cross-module refactors get slower.\n\n**3. Spring Modulith** — `ApplicationModules.of(App.class).verify()` checks module boundaries inside a monolith, and also generates documentation and diagrams (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n\n[[g:Practical recommendation]]: ArchUnit from day one (10 lines, runs in CI), split into modules only once the team is large and the rule keeps getting violated.\n\n:::deep\n- Put ArchUnit in [[o:mandatory CI]], not an optional test. A rule that doesn't run in the pipeline is a rule that doesn't exist.\n- Start with [[g:a single rule]] (domain doesn't depend on infrastructure) and tighten gradually. Applying 15 rules to an old codebase at once makes the team disable the whole test suite.\n- For a codebase with existing violations: ArchUnit has `freeze()` (`FreezingArchRule`) — it locks in current violations as a baseline and only blocks *new* ones. This is the only way to apply it to a project already in flight, and it's a very \"actually done this\" answer.\n- Rules worth adding early: forbid `System.out`, forbid `java.util.Date`, require class names in `port/in` to end with `UseCase`, forbid cycles between packages (`slices().should().beFreeOfCycles()`).\n- ArchUnit reads bytecode, so it [[r:cannot]] catch dependencies through reflection or class-name strings — rare, but worth knowing the limitation.\n- Tooling still needs to run alongside review: dependencies pointing the right way while business logic sits in the wrong place is something no tool catches.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q5","q":"Which layer should transactions, validation, and mapping live in?","a":"Three things that cut across layers, and getting them wrong is a common reason an architecture with \"the right folders\" is still hard to maintain.\n\n**Transaction — in `application/service`, exactly one place.**\n- [[g:Use case = one transaction]]. Opens on entry, closes on exit.\n- [[r:Don't]] put `@Transactional` on the controller (holds the transaction open through JSON serialization) and [[r:don't]] put it on the repository adapter (each call becomes its own transaction → the use case loses atomicity).\n- The domain [[g:must not know]] what a transaction even is — it's an infrastructure detail.\n\n**Validation — three kinds, three different places:**\n\n<table class=\"cmp\"><thead><tr><th>Kind</th><th>Example</th><th>Lives in</th><th>Returns error</th></tr></thead><tbody>\n<tr><td>Syntactic</td><td>well-formed email, positive number, required field</td><td>adapter/in (<code>@Valid</code> on the web DTO)</td><td>400</td></tr>\n<tr><td>Domain invariant</td><td>can't cancel an already-issued ticket</td><td><b>domain</b></td><td>409/422</td></tr>\n<tr><td>Rule needing external data</td><td>is the seat still free, is the balance sufficient</td><td>application (read via port, then ask the domain)</td><td>409</td></tr>\n</tbody></table>\n\nA domain invariant [[o:must]] live in the domain, even if the adapter already checked it — the adapter can be bypassed (Kafka consumer, batch job, test), the domain cannot.\n\n**Mapping — each layer maps into the layer inward from it, never skipping layers:**\n\n<pre><code>WebRequest ──(adapter/in)──&gt; Command ──&gt; Domain\nDomain ──&gt; Result ──(adapter/in)──&gt; WebResponse\nDomain &lt;──(adapter/out)──&gt; JpaEntity</code></pre>\n\n:::deep\n- `@Transactional` on a `private` method or called internally via `this` [[r:doesn't run]] — Spring's proxying (03-spring-boot-deep-build.ioc-container-transactions.q4). This is a classic bug, and in this architecture it tends to show up when a use case gets split into small methods within the same class.\n- Calling an external API (PSP, GDS) [[r:must not]] happen inside a DB transaction (18-query-optimization.rewriting-the-query-reshaping-the-model.q4): it holds the connection open for the entire network wait.\n- Correct pattern: a short transaction writes `PENDING` status → call external system → a short transaction writes the result, or use an outbox (topic 9).\n- Any invariant [[o:that can't]] be protected in memory (preventing double-booking across multiple instances) has to fall back to a DB constraint or an atomic update\n- this is the real boundary of Clean Architecture, and being able to explain it scores well (16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2).\n- `@Valid` only checks shape. Don't stuff business rules into a custom validator — they'll end up outside the domain and unreusable.\n- Mapping across many layers looks excessive for CRUD, so for a simple context [[g:deliberately allow a shortcut]] and record the decision (an ADR) instead of rigidly applying it everywhere.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q6","q":"How does the test pyramid map onto the layers? Why does Clean make testing cheaper?","a":"The most pragmatic reason to choose Clean is [[o:not]] \"cleanliness\" but [[g:fast, stable tests]] — answering with this hits the real point.\n\n<table class=\"cmp\"><thead><tr><th>Layer</th><th>Test kind</th><th>Tooling</th><th>Speed</th><th>Proportion</th></tr></thead><tbody>\n<tr><td>Domain</td><td>pure unit, no Spring</td><td>JUnit + AssertJ</td><td>~1ms</td><td><b>the most</b></td></tr>\n<tr><td>Application (use case)</td><td>unit with fake ports</td><td>JUnit + fake/mock</td><td>~5ms</td><td>a lot</td></tr>\n<tr><td>Adapter out (DB)</td><td>narrow integration</td><td><code>@DataJpaTest</code> + Testcontainers</td><td>~1s</td><td>moderate</td></tr>\n<tr><td>Adapter in (web)</td><td>narrow integration</td><td><code>@WebMvcTest</code></td><td>~1s</td><td>moderate</td></tr>\n<tr><td>Full system</td><td>main happy paths</td><td><code>@SpringBootTest</code></td><td>~10s</td><td><b>very few</b></td></tr>\n<tr><td>Architecture</td><td>rules</td><td>ArchUnit</td><td>~2s</td><td>1 suite</td></tr>\n</tbody></table>\n\n**Why it's cheaper:** the domain doesn't import Spring, so testing it [[g:needs no context to start up]]. A 2000-test domain suite runs in a few seconds. In a layered codebase where logic sits in `@Service` calling `Repository` directly, every test has to spin up a context or mock JPA — slow and brittle.\n\n<pre><code><span class=\"c\">// Testing the use case: the port is an interface so it can be faked, no DB needed</span>\n<span class=\"k\">@Test</span> <span class=\"k\">void</span> <span class=\"f\">cannot_hold_a_seat_someone_else_already_holds</span>() {\n    <span class=\"k\">var</span> locks = <span class=\"k\">new</span> InMemorySeatLocks();       <span class=\"c\">// hand-written fake, not Mockito</span>\n    locks.<span class=\"f\">tryLock</span>(<span class=\"s\">\"VN231\"</span>, <span class=\"s\">\"12A\"</span>);              <span class=\"c\">// someone else holds it first</span>\n    <span class=\"k\">var</span> service = <span class=\"k\">new</span> HoldSeatService(<span class=\"k\">new</span> InMemoryBookings(booking), locks);\n<span class=\"c\">    </span>\n    <span class=\"k\">var</span> r = service.<span class=\"f\">hold</span>(<span class=\"k\">new</span> HoldSeatCommand(id, <span class=\"s\">\"VN231\"</span>, <span class=\"s\">\"12A\"</span>));\n<span class=\"c\">    </span>\n    assertThat(r.<span class=\"f\">status</span>()).<span class=\"f\">isEqualTo</span>(TAKEN);\n}</code></pre>\n\n:::deep\n- [[g:Hand-written fakes beat mocks]] for a port used a lot: `InMemoryBookingRepository` written once, used in 50 tests, is easier to read than 5 lines of `when(...).thenReturn(...)`. Mocks are fine for a single call.\n- [[r:Anti-pattern number one]]: `@SpringBootTest` for everything. The suite takes 8 minutes to run, developers stop running tests locally, and tests fail for reasons that have nothing to do with what they're testing.\n- Testcontainers [[g:beats H2]]: H2 has no next-key locking, different syntax, a different query plan — tests pass while prod fails. This is a place worth being strict about.\n- Domain tests should be named after the [[o:business rule]] (`cannot_cancel_an_already_issued_ticket`) rather than the method (`testCancel`). Reading the test list reads like a spec.\n- This architecture also makes [[g:consumer-driven contract testing]] (17-rest-api-design.contracts-errors-lifecycle.q4) natural: the web adapter is thin, so contract tests only need to touch the adapter.\n- Measure with [[o:mutation testing]] (PIT) if you want to know whether tests actually catch bugs — high coverage with a low mutation score means tests exercise the code without actually checking anything.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q7","q":"How do you migrate a running layered codebase to Clean, step by step?","a":"This question separates people who read about it from people who've actually done it: [[r:nobody gets to rewrite from scratch]]. Do it incrementally, staying deployable at every step.\n\n**A deliberate order — 6 steps:**\n\n1. **Pick the single most painful bounded context** (usually Booking or Payment), not the whole repo. Win in one place before spreading out.\n2. **Build a safety net first**: characterization tests for current behavior. Without tests, every refactor is a gamble.\n3. **Extract `port/out` first** — this is the highest-payoff step. Create a `BookingRepository` interface in `application/port/out` and have the existing `JpaBookingRepository` implement it. No need to change the model or add a mapper yet.\n4. **Pull business rules out of `Service` and down into the domain**, one rule at a time. Each pull adds a pure domain test.\n5. **Split use cases** out of the `BookingService` god-class: each public method becomes its own use case class.\n6. **Split the model** (12-architecture-patterns.clean-layered-building-it-for-real.q2) — [[o:do this last]], since it's the most effort for the least payoff. Many teams stop at step 5, and that's good enough.\n\n**Guarding against drifting back:** turn on ArchUnit with `freeze()` starting at step 3 — lock in old violations as a baseline, block new ones (12-architecture-patterns.clean-layered-building-it-for-real.q4). Without it, new code keeps getting written the old way while you're cleaning up the old code.\n\n:::warn Common mistake\nStarting by [[r:creating all 4 folders and dumping the old classes into them as-is]]. The result is layered wearing a Clean costume: folders are right, dependencies are still wrong, and the team believes it's done. The dependency direction is the architecture, not the folder tree.\n:::\n\n:::deep\n- Apply the [[g:strangler fig]] pattern: write *new* features in the new structure right away, migrate old features when there's a reason to touch them anyway. No sprint ever gets approved for \"pure refactoring\" — so it has to ride along with real work.\n- Step 3 has the highest payoff because it [[o:unlocks testing]]: having an interface means you can fake it, which means you can write tests fast, and every later step depends on that.\n- Measure progress with numbers: how many classes in `domain` don't import Spring, how many tests need no context, how long the suite takes to run. Saying \"it's cleaner now\" doesn't get you approval to keep going.\n- Write an [[g:ADR]] (Architecture Decision Record) for big decisions — six months later even you will have forgotten why you chose to split the model.\n- For legacy systems integrated externally, insert an [[o:Anti-Corruption Layer]] (12-architecture-patterns.patterns-principles.q6) at the boundary so their messy model doesn't seep into the new domain.\n- Know when to [[r:stop]]: a purely CRUD context only needs steps 1–3. Forcing Clean onto a lookup module is exactly the over-engineering 12.4 warns about.\n\n**A migration slice needs an executable equivalence gate, not only a package move:**\n<pre><code>@Test\nvoid extractedQuoteUseCasePreservesObservedLegacyBehaviour() {\n  QuoteRequest fixture = Fixtures.quoteWithTaxAndDiscount();\n  Quote legacyResult = legacyPricing.quote(fixture);\n  Quote extractedResult = new QuoteUseCase(\n      new LegacyPricingAdapter(legacyPricing), fixedClock).quote(fixture);\n  assertThat(extractedResult)\n      .usingRecursiveComparison()\n      .isEqualTo(legacyResult);\n}\n./mvnw -Dtest=PricingMigrationCharacterizationTest test</code></pre>\n\nThis characterization test creates a seam before callers move.\n\n- **Benefit:** extraction can be incremental and rollback is a routing change.\n- **Cost:** it freezes observed behaviour, including bugs. Mark known defects, then replace temporary equivalence with domain/contract tests once the new owner is established.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q8","q":"Package-by-layer vs package-by-feature, and Spring Modulith for a modular monolith?","a":"**Package-by-layer** (the default for most Spring projects):\n\n<pre><code>com.acme\n├── controller/   BookingController, FlightController, UserController\n├── service/      BookingService, FlightService, UserService\n└── repository/   BookingRepository, FlightRepository, UserRepository</code></pre>\n\nOpening the repo only tells you *\"this is a Spring app\"*. Changing one feature touches 3 folders, and [[r:nothing stops]] `UserService` from calling `BookingRepository` directly.\n\n**Package-by-feature** (also called [[o:screaming architecture]]):\n\n<pre><code>com.acme\n├── booking/      web/ · application/ · domain/ · persistence/\n├── flight/       web/ · application/ · domain/ · persistence/\n└── user/         web/ · application/ · domain/ · persistence/</code></pre>\n\nOpening the repo tells you right away *what this system does*. More importantly: `booking` can keep everything except its public API [[g:package-private]] — the compiler blocks cross-access, no tooling needed.\n\n**Spring Modulith** — turns that boundary into something checkable:\n\n<pre><code><span class=\"k\">@Test</span> <span class=\"k\">void</span> <span class=\"f\">modules_respect_boundaries</span>() {\n    ApplicationModules.<span class=\"f\">of</span>(Application.<span class=\"k\">class</span>).<span class=\"f\">verify</span>();     <span class=\"c\">// fails on a violation</span>\n}\n<span class=\"c\">// Modules communicate via events, not by calling each other's beans directly</span>\n<span class=\"k\">@ApplicationModuleListener</span>                            <span class=\"c\">// = async + transactional</span>\n<span class=\"k\">void</span> <span class=\"f\">on</span>(BookingConfirmed e) { notifications.<span class=\"f\">send</span>(e.<span class=\"f\">bookingId</span>()); }</code></pre>\n\nIt also generates module diagrams and documentation straight from the code, and has an event publication registry so events aren't lost when a consumer fails.\n\n:::deep\n- The two axes are [[o:independent]]: layer vs. feature is *how you split packages*; Clean/Hexagonal is *dependency direction*. The best combination is feature on the outside, layer on the inside (12-architecture-patterns.clean-layered-building-it-for-real.q1).\n- A modular monolith is the right stopping point for most teams (12-architecture-patterns.patterns-principles.q5): clear boundaries without paying the distributed-systems cost.\n- Split into micro-services when there's an [[g:operational reason]] — uneven scaling, different release cadences, separate teams — not just for \"cleanliness\".\n- Modules communicating via [[g:domain events]] instead of calling beans directly is the best preparation for splitting services later: switching from in-process events to Kafka barely touches business code.\n- Spring Modulith by default treats [[o:each direct subpackage of the root package]] as a module, and only what's at the module's top level counts as its public API — this convention is what keeps it lightweight.\n- Don't split modules by technical layer (`web`, `db`) — split by business capability. A shared `persistence` module is a distributed monolith in miniature (12-architecture-patterns.patterns-principles.q3).\n- Getting the split wrong is still fixable while it's a monolith; getting it wrong after splitting into micro-services is very expensive. That's why [[g:modular monolith first, split later]] is almost always the right advice.\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q9","q":"How do architecture fitness functions and ADRs keep a boundary honest after the initial design?","a":"A diagram is a hypothesis. An [[g:architecture fitness function]] is an executable check that protects a boundary while the code changes; an [[g:ADR]] records why the boundary exists, what trade-off was accepted, and when to revisit it. Neither proves that the original boundary is still correct.\n\n<table class=\"cmp\"><thead><tr><th>Boundary claim</th><th>Executable signal</th><th>Review question</th></tr></thead><tbody>\n<tr><td>Domain does not depend on infrastructure</td><td>ArchUnit/package rule and compile-time module dependency</td><td>Can the domain test run without Spring/JPA/Jackson?</td></tr>\n<tr><td>Module owns its data</td><td>No foreign repository/table access; migration owner is explicit</td><td>Which use case needs this data, and who approves the schema change?</td></tr>\n<tr><td>Integration is asynchronous</td><td>Versioned event contract, outbox/relay or durable publication, consumer idempotency</td><td>What happens after commit, before publish, on replay, and during version skew?</td></tr>\n<tr><td>Service can deploy independently</td><td>Compatibility test, bounded synchronous dependencies, rollback path</td><td>Can old and new versions run together without a coordinated deploy?</td></tr>\n</tbody></table>\n\n:::deep\n- A fitness rule should fail on a new violation, not merely produce a report nobody reads. Keep exceptions small, named, reviewed and time-bounded.\n- An ADR should state context, decision, alternatives, consequences, owner and trigger for reassessment. It is not a substitute for a test or a ticket.\n- Measure the boundary with change-impact evidence: number of modules touched per feature, cross-module calls, deployment coordination, projection lag, contract failures and incident blast radius.\n- A passing package rule can still protect the wrong boundary. Revisit it when language, invariant, ownership, contention, latency or recovery requirements change.\n- Do not turn every class dependency into a forbidden edge. A rule that blocks legitimate adapters creates workarounds and loses trust; enforce the smallest rule that protects a real invariant.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"12-architecture-patterns","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"distributed-rate-limiter","11-system-design-cases.the-big-prompts.q5":"distributed-rate-limiter","16-project-concurrency-whiteboard.whiteboard-dsa.q1":"distributed-r