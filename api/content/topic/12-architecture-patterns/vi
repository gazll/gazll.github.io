json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},"meta":{"topic_type":"design","key":"12-architecture-patterns","vi":{"label":"Architecture & patterns","title":"Software architecture: DDD, Clean, Hexagonal & design patterns","intro":"Ở mốc 8 năm, kiến trúc là giá trị cốt lõi. Nắm vững DDD và các kiến trúc 'dependency hướng vào trong', so sánh với layered, và dùng pattern đúng chỗ thay vì học thuộc.","tags":["Layered","Hexagonal","Clean","DDD chiến lược/tactical","CQRS","SOLID","Anti-patterns","Clean Architecture","Dependency Rule","ArchUnit","Spring Modulith"]},"en":{"label":"Architecture & patterns","title":"Software architecture: DDD, Clean, Hexagonal & design patterns","intro":"At the eight-year mark, architecture is the core of what you sell. Know DDD and the dependencies-point-inward architectures, compare them honestly against layered, and reach for patterns where they fit rather than reciting them.","tags":["Layered","Hexagonal","Clean","DDD strategic & tactical","CQRS","SOLID","Anti-patterns","Clean Architecture","Dependency Rule","ArchUnit","Spring Modulith"]},"created_at":"2026-07-31","updated_at":"2026-10-02"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"12-architecture-patterns.patterns-principles.q7":"2026-10-02"},"lang":"vi","body":{"sections":[{"title":"Các kiểu kiến trúc","items":[{"id":"12-architecture-patterns.architecture-styles.q1","q":"Layered (n-tier) architecture: ưu/nhược?","a":"Tầng: controller → service → repository → DB, phụ thuộc đi xuống.\n\n- [[g:Ưu]]: quen thuộc, đơn giản, dễ onboard\n- [[r:Nhược]]: business logic dễ rò vào service mỏng (anemic domain), framework/DB thấm ngược lên, khó test logic độc lập, dễ thành 'big ball of mud' khi lớn\n\n:::deep\n- phụ thuộc đi *xuống* tới DB → framework/JPA/DB thấm ngược lên domain (entity JPA = domain model → coupling chặt hạ tầng)\n- business logic rò vào 'service' mỏng → [[r:anemic domain]] (entity chỉ getter/setter); dễ thành 'big ball of mud' (service god-class)\n\n[[o:Layered KHÔNG sai]] — mặc định hợp lý cho phần lớn app; chỉ thành vấn đề khi domain phức tạp &amp; sống lâu (fintech core). Khi đó chuyển Hexagonal/Clean. [[r:Đừng over-engineer Clean cho CRUD đơn giản.]]\n\n- Nhìn thấy layered hết đất ở đâu là rõ nhất: khi một thay đổi nghiệp vụ nhỏ phải sửa cả bốn tầng, hoặc khi muốn test một luật nghiệp vụ lại phải dựng Spring context cùng một database. Phần dựng thật của kiến trúc thay thế ở 12.15, còn lộ trình chuyển dần ở 12.21.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.architecture-styles.q2","q":"Hexagonal (Ports & Adapters): ý tưởng cốt lõi?","a":"<figure class='dgm'><svg viewBox='0 0 680 300' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11' text-anchor='middle'>\n<polygon points='340,60 470,135 470,225 340,300 210,225 210,135' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='2'/>\n<text x='340' y='175' fill='#085239' font-weight='600'>DOMAIN</text><text x='340' y='195' fill='#42536C'>(không biết DB/web)</text>\n<rect x='150' y='40' width='130' height='40' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='215' y='60' fill='#3D4E8F'>REST/gRPC</text><text x='215' y='75' fill='#42536C'>driving adapter</text>\n<rect x='400' y='40' width='130' height='40' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='465' y='60' fill='#3D4E8F'>Scheduler/CLI</text><text x='465' y='75' fill='#42536C'>driving adapter</text>\n<rect x='150' y='235' width='130' height='44' rx='6' fill='#F6E8E5' stroke='#AE4536'/><text x='215' y='255' fill='#7d2f24'>DB repository</text><text x='215' y='270' fill='#AE4536'>driven adapter</text>\n<rect x='400' y='235' width='130' height='44' rx='6' fill='#F6E8E5' stroke='#AE4536'/><text x='465' y='255' fill='#7d2f24'>Kafka/PSP</text><text x='465' y='270' fill='#AE4536'>driven adapter</text>\n<g stroke='#42536C' stroke-width='1.4' marker-end='url(#ar10)'><line x1='245' y1='80' x2='285' y2='112'/><line x1='435' y1='80' x2='395' y2='112'/></g>\n<g stroke='#42536C' stroke-width='1.4'><line x1='265' y1='205' x2='235' y2='233'/><line x1='415' y1='205' x2='445' y2='233'/></g>\n<text x='600' y='150' fill='#0B6E4F' font-weight='600'>PORT</text><text x='600' y='168' fill='#42536C'>= interface</text>\n<text x='340' y='30' fill='#42536C'>Dependency hướng VÀO trong · hạ tầng cắm qua port · giống Clean / Onion</text>\n<defs><marker id='ar10' markerWidth='8' markerHeight='8' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#42536C'/></marker></defs>\n</svg></figure>\n\nĐặt [[g:domain ở trung tâm]], giao tiếp ra ngoài qua [[b:port]] (interface). Thế giới bên ngoài (web, DB, queue) là [[b:adapter]] cắm vào port.\n\nDomain [[r:KHÔNG biết]] về framework/DB.\n\n- [[b:driving adapter]] (UI/API): gọi *vào* domain\n- [[b:driven adapter]] (DB/broker): được domain gọi *ra* qua port\n\nLợi: thay hạ tầng không đụng domain, test domain bằng mock adapter, ranh giới rõ.\n\n:::deep\n- domain định nghĩa port (interface); adapter implement port (dependency inversion: domain định nghĩa `PaymentGateway`, hạ tầng implement Stripe adapter)\n- lợi đo được: test use-case với in-memory adapter (không DB/Docker), thay hạ tầng không đụng domain\n\nOTA: domain Booking không biết Postgres/Kafka/GDS — có port `SeatInventory`, `PaymentGateway`, `GdsClient`; adapter cắm vào.\n\n[[r:Cái giá]]: mapping entity domain↔JPA + nhiều interface → chỉ đáng khi domain phức tạp.\n\n- Phần dựng thật trong code: cấu trúc package `port/in`, `port/out`, adapter cho một service Spring Boot (12-architecture-patterns.clean-layered-building-it-for-real.q1), và transaction/validation/mapping đặt ở tầng nào (12-architecture-patterns.clean-layered-building-it-for-real.q5).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.architecture-styles.q3","q":"Clean Architecture và Dependency Rule?","a":"Các vòng đồng tâm: Entities → Use Cases → Interface Adapters → Frameworks/Drivers.\n\n[[g:Dependency Rule]]: phụ thuộc chỉ hướng *vào trong*; vòng trong không biết vòng ngoài.\n\nDùng [[g:dependency inversion]] (interface ở trong, implementation ở ngoài) → DB/web là chi tiết thay được.\n\n:::tip Chốt\nHexagonal, Onion, Clean cùng một ý tưởng: domain ở lõi, hạ tầng ở rìa, dependency hướng vào trong. Khác nhau chủ yếu ở từ vựng/độ chi tiết.\n:::\n\n:::deep\n- Clean/Hexagonal KHÔNG phải 'chia 4 thư mục', mà là [[g:quy tắc phụ thuộc]] — domain không import gì từ Spring/JPA/Kafka\n- thực thi bằng dependency inversion: domain định nghĩa `PaymentGateway` (port), module hạ tầng implement bằng Stripe/PSP adapter\n- lợi: test use-case bằng in-memory adapter, thay PSP không đụng domain, domain đọc thuần 'business' không thấy 'JPA'\n\n[[r:Cái giá]]: nhiều interface/mapping — chỉ đáng khi domain phức tạp. CRUD thuần → layered đủ. Câu chốt: 'kiến trúc phục vụ tốc độ thay đổi của business, không phải để đẹp sơ đồ'.\n\n**Đưa quy tắc vào bản build thật:**\n\n- Tổ chức package Spring Boot theo kiến trúc: (12-architecture-patterns.clean-layered-building-it-for-real.q1)\n- Cưỡng chế Dependency Rule bằng ArchUnit hoặc Spring Modulith: (12-architecture-patterns.clean-layered-building-it-for-real.q4)\n- Không có kiểm tra tự động, quy tắc phụ thuộc sẽ trôi dần theo thời gian.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.architecture-styles.q4","q":"So sánh Layered vs Hexagonal/Clean — chọn khi nào?","a":"<table class=\"cmp\"><thead><tr><th></th><th>Layered</th><th>Hexagonal/Clean</th></tr></thead><tbody>\n<tr><td>Hợp cho</td><td>CRUD đơn giản, team nhỏ, domain mỏng</td><td>domain phức tạp, vòng đời dài, nhiều tích hợp</td></tr>\n<tr><td>Testability</td><td>dính DB/framework</td><td>test domain bằng mock adapter</td></tr>\n<tr><td>Đổi hạ tầng</td><td>thấm khắp nơi</td><td>chỉ sửa adapter</td></tr>\n<tr><td>Chi phí</td><td>thấp</td><td>nhiều lớp/abstraction</td></tr>\n</tbody></table>\n\n<figure class='dgm'><svg viewBox='0 0 680 300' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='10.5' text-anchor='middle'>\n<defs><marker id='ar20' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#AE4536'/></marker><marker id='ar21' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#0B6E4F'/></marker></defs>\n<text x='170' y='20' fill='#14233A' font-weight='600' font-size='12'>LAYERED (n-tier)</text>\n<rect x='56' y='34' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='56' fill='#3D4E8F'>Controller / Web</text>\n<rect x='56' y='86' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='108' fill='#3D4E8F'>Service (business logic)</text>\n<rect x='56' y='138' width='230' height='36' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='171' y='160' fill='#3D4E8F'>Repository</text>\n<rect x='56' y='190' width='230' height='40' rx='6' fill='#F6E8E5' stroke='#AE4536' stroke-width='1.6'/><text x='171' y='208' fill='#7d2f24' font-weight='600'>DB · JPA · Framework</text><text x='171' y='223' fill='#AE4536'>hạ tầng nằm ở ĐÁY</text>\n<g stroke='#AE4536' stroke-width='1.5' marker-end='url(#ar20)'><line x1='171' y1='70' x2='171' y2='82'/><line x1='171' y1='122' x2='171' y2='134'/><line x1='171' y1='174' x2='171' y2='186'/></g>\n<text x='171' y='252' fill='#AE4536' font-weight='600'>phụ thuộc đi XUỐNG</text>\n<text x='171' y='268' fill='#42536C'>→ hạ tầng thấm ngược lên domain</text>\n<text x='171' y='284' fill='#42536C'>→ test logic phải dựng DB</text>\n<line x1='322' y1='28' x2='322' y2='286' stroke='#DBE1EA' stroke-width='1.5' stroke-dasharray='4 4'/>\n<text x='510' y='20' fill='#14233A' font-weight='600' font-size='12'>CLEAN / HEXAGONAL</text>\n<rect x='372' y='34' width='274' height='196' rx='10' fill='#F7F9FC' stroke='#7E8DA3'/><text x='510' y='50' fill='#42536C'>Frameworks &amp; Drivers</text>\n<rect x='398' y='58' width='222' height='148' rx='9' fill='#E7EAF6' stroke='#3D4E8F'/><text x='510' y='74' fill='#3D4E8F'>Interface Adapters</text>\n<rect x='424' y='82' width='170' height='100' rx='8' fill='#EFEAF7' stroke='#5B3E8E'/><text x='510' y='98' fill='#5B3E8E'>Use Cases</text>\n<rect x='452' y='106' width='114' height='52' rx='7' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='1.6'/><text x='509' y='130' fill='#085239' font-weight='600'>Entities</text><text x='509' y='145' fill='#0B6E4F'>domain</text>\n<g stroke='#0B6E4F' stroke-width='1.6' marker-end='url(#ar21)'><line x1='510' y1='224' x2='510' y2='212'/><line x1='510' y1='200' x2='510' y2='188'/><line x1='510' y1='176' x2='510' y2='164'/></g>\n<text x='510' y='252' fill='#0B6E4F' font-weight='600'>phụ thuộc hướng VÀO TRONG</text>\n<text x='510' y='268' fill='#42536C'>→ domain không biết DB/web tồn tại</text>\n<text x='510' y='284' fill='#42536C'>→ test domain không cần Spring</text>\n</svg></figure>\n\n:::warn Cảnh báo\nđừng áp Clean cho CRUD tầm thường — chi phí boilerplate không xứng. Chọn theo độ phức tạp domain.\n:::\n\n:::deep\n- [[o:không nhị phân toàn-hệ-thống]] — áp *theo từng service/context*: Booking/Payment phức tạp → Clean; tra cứu/báo cáo đơn giản → layered\n- dấu hiệu cần Clean: logic khó test vì dính DB/framework, hoặc đổi PSP phải sửa khắp nơi\n- dấu hiệu over-engineer: nhiều interface/mapping cho CRUD tầm thường\n\n'Kiến trúc phục vụ tốc độ thay đổi của business, không phải để đẹp sơ đồ' — chọn theo độ phức tạp domain &amp; tần suất thay đổi.\n\n- Đo cái giá và cái lợi bằng test pyramid ánh xạ vào từng tầng (12-architecture-patterns.clean-layered-building-it-for-real.q6); chuyển dần một codebase layered đang chạy thì đi theo sáu bước ở 12.21.\n:::","difficulty":"advanced"}]},{"title":"Domain-Driven Design","items":[{"id":"12-architecture-patterns.domain-driven-design.q1","q":"DDD chiến lược: bounded context, ubiquitous language, context mapping?","a":"- [[b:Bounded Context]]: ranh giới trong đó một mô hình/ngôn ngữ có nghĩa nhất quán ('Account' trong Billing khác trong Auth) → lựa chọn tự nhiên cho ranh giới micro-service\n- [[b:Ubiquitous Language]]: dev và domain expert dùng chung bộ thuật ngữ, phản ánh trong code\n- [[b:Context Mapping]]: mô tả quan hệ giữa các context (Customer-Supplier, Anti-Corruption Layer, Shared Kernel...)\n\n:::tip Chốt\nDDD chiến lược chính là công cụ [[g:vẽ ranh giới micro-service]] theo nghiệp vụ — khớp 'ranh giới service = ranh giới consistency'.\n:::\n\n:::deep\n- một bounded context thường = một service + một DB riêng; ranh giới đặt ở chỗ ngôn ngữ/đổi nghĩa (OTA: 'Booking', 'Inventory', 'Pricing', 'Payment', 'Loyalty' — 'fare' trong Pricing khác 'amount' trong Payment)\n- context map: Payment = Supplier, Booking = Customer; chèn *Anti-Corruption Layer* khi tích hợp GDS legacy\n- aggregate giữ invariant trong ranh giới transaction (`Booking` đảm bảo 'tổng ghế = số hành khách')\n\n[[r:Sai lầm]]: chia service theo tầng kỹ thuật (controller-service-dao) thay vì theo nghiệp vụ → distributed monolith.\n\n- Chủ đề 24 là phần đào sâu của mục này: ubiquitous language cho đúng (24-domain-driven-design.strategic-splitting-the-domain.q1)\n- tìm ranh giới bằng event storming (24-domain-driven-design.strategic-splitting-the-domain.q4)\n- các kiểu quan hệ trong context map (24-domain-driven-design.strategic-splitting-the-domain.q3).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.domain-driven-design.q2","q":"DDD tactical: entity, value object, aggregate, repository, domain event?","a":"- [[b:Entity]]: có định danh, vòng đời (Account, Order)\n- [[b:Value Object]]: bất biến, định nghĩa bằng giá trị (Money, Address)\n- [[b:Aggregate]]: cụm object có *aggregate root* làm cổng vào, bảo vệ invariant; transaction nên gói trong một aggregate\n- [[b:Repository]]: trừu tượng truy xuất aggregate (giấu DB)\n- [[b:Domain Event]]: việc đã xảy ra (OrderPlaced) — nền cho event-driven/outbox\n\n[[g:Money]] là value object kinh điển trong fintech (bất biến, có currency).\n\n:::deep\n- [[g:Aggregate]] là ranh giới *transaction & nhất quán* — chỉ thay đổi qua *aggregate root*, bảo vệ invariant; một transaction nên gói trong *một* aggregate (liên aggregate dùng eventual + domain event)\n- aggregate nhỏ ([[r:đừng gom cả thế giới]] → contention/lock lớn)\n- Value Object bất biến (Money, SeatNumber) — so sánh bằng giá trị, thread-safe\n\nOTA: `Booking` aggregate giữ invariant ghế/giá; `LedgerEntry` append-only; phát `PaymentSucceeded` domain event. [[r:Ranh giới aggregate quá to = lock contention & khó scale.]]\n\n- Đào sâu từng khối: Entity so với Value Object (24-domain-driven-design.tactical-modelling-it.q1), đặt ranh giới aggregate to nhỏ thế nào (24-domain-driven-design.tactical-modelling-it.q2), Repository/Factory/Domain Service mỗi thứ ở đâu (24-domain-driven-design.tactical-modelling-it.q4).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.domain-driven-design.q3","q":"Khi nào DÙNG và KHÔNG nên dùng DDD?","a":"- [[g:Dùng]] khi domain *phức tạp về nghiệp vụ* (nhiều rule, biến đổi theo thời gian) — fintech, bảo hiểm, logistics\n- [[r:Không nên]] khi chỉ CRUD/forms-over-data: chi phí khái niệm (aggregate, context) > lợi ích\n\nDDD là về *mô hình hoá nghiệp vụ*, không phải pattern code bắt buộc.\n\n:::deep\n- DÙNG khi domain phức tạp (nhiều rule, cần ngôn ngữ chung với domain expert) — fintech, OTA (fare rules, overbooking, refund policy)\n- KHÔNG khi CRUD/forms-over-data (chi phí aggregate, bounded context, mapping > lợi ích)\n- có thể dùng strategic (bounded context chia service) mà không nặng tactical, hoặc ngược lại\n\n[[o:Áp DDD chọn lọc]]: core domain (booking/pricing/ledger: tactical đầy đủ) vs supporting/generic (notification/báo cáo: layered/CRUD hoặc mua sẵn). [[r:Sai lầm]]: DDD hoá mọi thứ, hoặc bỏ qua ở core phức tạp (anemic + logic rò khắp service).\n\n- Vế 'DDD giải quyết vấn đề gì' nói kỹ hơn ở 24.1 — và nó cũng mở đầu bằng đúng vế 'khi nào không nên'.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.domain-driven-design.q4","q":"CQRS và Event Sourcing — khi nào hợp lý?","a":"- [[b:CQRS]]: tách mô hình ghi (command) và đọc (query) → tối ưu riêng, đọc dùng read model/projection\n- [[b:Event Sourcing]]: state = chuỗi event\n\nCặp đôi mạnh cho audit & rebuild view (rất hợp ledger).\n\n[[r:Trade-off]]: phức tạp, eventual consistency giữa write↔read model, versioning event.\n\n[[o:Đừng mặc định dùng]] — chỉ khi audit/scale đọc/biến đổi mô hình biện minh được.\n\n:::deep\n- CQRS tách command (chuẩn hoá, bảo vệ invariant) khỏi query (read model tối ưu cho màn hình) → scale &amp; tối ưu riêng; read model có thể denormalize/ở store khác (Elasticsearch/Redis)\n- Event Sourcing lưu chuỗi event là nguồn sự thật → audit hoàn hảo, time-travel, rebuild projection\n- trade-off: eventual consistency write↔read model, event versioning/upcasting, snapshot để replay nhanh\n\nOTA: ledger event-sourced (đối soát/rebuild số dư dễ); read model 'booking history' projection riêng. Nhưng [[g:CQRS nhẹ]] (chỉ tách read model, không full ES) thường đủ — đừng mặc định full ES vì 'nghe hay'.\n\n- Trước khi nghĩ tới event sourcing, phân biệt domain event với integration event đã (24-domain-driven-design.tactical-modelling-it.q3): dùng domain event không có nghĩa là lưu trạng thái bằng event.\n:::","difficulty":"advanced"}]},{"title":"Patterns & nguyên tắc","items":[{"id":"12-architecture-patterns.patterns-principles.q1","q":"Các design pattern senior nên dùng thuần thục (và vì sao)?","a":"- [[b:Strategy]]: chọn thuật toán runtime (routing PSP) — tránh if-else khổng lồ\n- [[b:Factory/Abstract Factory]]: tạo object phức tạp/đa biến thể\n- [[b:Builder]]: dựng object bất biến nhiều field\n- [[b:Decorator]]: thêm hành vi (logging, caching) không sửa lõi\n- [[b:Adapter]]: ghép interface không tương thích (anti-corruption layer)\n- [[b:Observer]]: event-driven nội bộ\n- phân tán: Circuit Breaker, Saga, Outbox, CQRS\n\n[[o:Kể pattern bằng *vấn đề* + *trade-off*, không tên suông.]]\n\n:::deep\n- Strategy (routing PSP/GDS theo điều kiện, thay if-else — nền OCP), Factory (object đa biến thể)\n- Builder (object bất biến nhiều field — Itinerary), Decorator (logging/caching/retry không sửa lõi), Adapter (ACL với GDS legacy), Observer (event-driven nội bộ)\n\nPattern là *từ vựng giao tiếp* + giải pháp đã kiểm chứng — nhưng [[r:đừng nhồi pattern]] (over-engineering); chọn khi vấn đề thực sự xuất hiện. Senior biết khi nào KHÔNG dùng pattern cũng quan trọng.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.patterns-principles.q2","q":"SOLID — diễn giải thực dụng cho backend?","a":"- [[b:S]]RP: một lớp một lý do thay đổi\n- [[b:O]]CP: mở rộng không sửa (Strategy/polymorphism)\n- [[b:L]]SP: subtype thay được supertype không phá hành vi\n- [[b:I]]SP: interface nhỏ, đúng nhu cầu, tránh 'fat interface'\n- [[b:D]]IP: phụ thuộc vào abstraction — nền của Hexagonal/Clean\n\n[[g:DIP + ISP]] chính là cơ sở để domain độc lập hạ tầng.\n\n:::deep\n- SRP: service/class không ôm nhiều trách nhiệm (PaymentService không kiêm notification)\n- OCP: thêm PSP mới không sửa code cũ (Strategy/polymorphism)\n- LSP: đừng override làm hẹp hành vi; ISP: interface nhỏ đúng nhu cầu (tránh fat interface); DIP: domain định nghĩa port, hạ tầng implement\n\n[[o:SOLID là hướng dẫn không phải luật cứng]] — áp có phán đoán ([[r:đừng tạo abstraction cho thứ chỉ một implementation 'phòng xa']] → YAGNI). Mục tiêu: code dễ đổi an toàn, không tuân thủ giáo điều.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.patterns-principles.q3","q":"Anti-patterns hay gặp: distributed monolith, anemic domain, god object?","a":"- [[r:Distributed monolith]]: tách service nhưng coupling chặt (share DB, gọi đồng bộ chuỗi dài) → nhận hết nhược micro-service mà không lợi ích. Dấu hiệu: đổi 1 service phải deploy nhiều cái\n- [[r:Anemic domain model]]: entity chỉ getter/setter, logic dồn vào service → mất sức mạnh OOP/DDD\n- [[r:God object/service]]: một lớp làm quá nhiều thứ\n\n:::warn Vàng\n'service không share database'. Hai service ghi chung một table là tín hiệu distributed monolith.\n:::\n\n:::deep\n- [[r:Distributed monolith]]: coupling chặt (share DB, gọi đồng bộ chuỗi dài, deploy đồng bộ). Dấu hiệu: đổi 1 service phải deploy 5 cái; hai service ghi chung table → sửa: database-per-service, giao tiếp async/contract rõ, ranh giới theo bounded context\n- Anemic domain → sửa: đưa hành vi/invariant vào aggregate; God object → sửa: tách theo SRP\n\n'Micro-services là trade-off, không phải nâng cấp'; chưa có lý do tổ chức/scale rõ → [[g:modular monolith]].\n\n- Anemic domain nhìn từ phía DDD: dấu hiệu nhận ra (24-domain-driven-design.strategic-splitting-the-domain.q1) và cách tránh — hành vi thuộc về aggregate, chỉ cái gì không thuộc aggregate nào mới ra Domain Service (24-domain-driven-design.tactical-modelling-it.q4).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.patterns-principles.q4","q":"Coupling & cohesion — la bàn thiết kế?","a":"Mục tiêu: [[g:low coupling, high cohesion]] — module độc lập, mỗi module gom thứ liên quan.\n\n- coupling thấp → thay đổi cục bộ không lan\n- cohesion cao → code dễ hiểu/định vị\n\nĐây là tiêu chí ngầm sau mọi quyết định module/service boundary.\n\n<table class=\"cmp\"><thead><tr><th>Kiểu coupling</th><th>Biểu hiện</th><th>Mức nguy hiểm</th></tr></thead><tbody>\n<tr><td>Chung database</td><td>hai service ghi cùng một table</td><td>cao nhất — không ai đổi schema được nữa</td></tr>\n<tr><td>Gọi đồng bộ chuỗi dài</td><td>A gọi B gọi C gọi D</td><td>cao — lỗi và latency cộng dồn</td></tr>\n<tr><td>Chung thư viện model</td><td>một jar DTO dùng chung</td><td>trung bình — nâng version là đụng cả nhà</td></tr>\n<tr><td>Qua event có hợp đồng</td><td>publish/subscribe</td><td>thấp — nhưng vẫn phải versioning</td></tr>\n</tbody></table>\n\n:::deep\n- coupling thấp = đổi A không buộc đổi B (qua interface/event, không share internal/DB)\n- cohesion cao = mọi thứ trong module phục vụ một mục đích\n- đo bằng: thay đổi lan rộng bao nhiêu? (coupling cao = lan nhiều); module có 'nhiều lý do thay đổi'? (cohesion thấp)\n\nBounded context = ranh giới cohesion; coupling giữa context giữ tối thiểu qua context map/ACL/event. [[o:Connascence]] (mức hai phần phải đổi cùng nhau) là cách đo coupling tinh hơn.\n\nChốt: hai thứ phải đổi cùng nhau thường xuyên → cùng module; ít liên quan → tách.\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.patterns-principles.q5","q":"Modular monolith vs micro-services — khi nào tách?","a":"<table class=\"cmp\"><thead><tr><th></th><th>Modular monolith</th><th>Micro-services</th></tr></thead><tbody>\n<tr><td>Deploy</td><td>một</td><td>độc lập từng service</td></tr>\n<tr><td>Transaction</td><td>local ACID</td><td>distributed (Saga)</td></tr>\n<tr><td>Vận hành</td><td>đơn giản</td><td>network, consistency, observability</td></tr>\n<tr><td>Tách khi</td><td>—</td><td>cần scale/deploy/team độc lập</td></tr>\n</tbody></table>\n\n:::tip Chốt 8 năm KN\nbắt đầu modular monolith với ranh giới sạch; chỉ tách micro-service khi có lý do tổ chức/scale rõ ràng. 'Microservices là trade-off, không phải nâng cấp.'\n:::\n\n:::deep\n- [[b:Modular monolith]]: một deploy, module ranh giới rõ (mỗi module API nội bộ, không gọi xuyên internal) → 1 deploy, schema-per-module, transaction local ACID, dễ refactor ranh giới (cùng codebase)\n- [[b:Micro-services]] khi cần: scale độc lập, deploy độc lập theo team (Conway's law), cô lập lỗi/công nghệ — đổi lấy phức tạp phân tán\n\nBắt đầu modular monolith với ranh giới sạch (dễ tách sau); tách khi có lý do *tổ chức/scale* rõ. [[r:Tách sớm + ranh giới sai = distributed monolith.]]\n\n- Cưỡng chế ranh giới module ngay trong monolith bằng Spring Modulith, và package-by-feature so với package-by-layer (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.patterns-principles.q6","q":"Anti-Corruption Layer (ACL) để làm gì khi tích hợp hệ legacy?","a":"[[g:ACL]] (Anti-Corruption Layer) = lớp dịch giữa domain của bạn và hệ ngoài/legacy có mô hình khác → bảo vệ domain khỏi 'nhiễm' khái niệm/cấu trúc xấu.\n\n- thường hiện thực bằng Adapter + mapping\n- hữu ích khi tích hợp core banking cũ hoặc PSP với mô hình lệch chuẩn\n\n:::warn Bẫy phỏng vấn\nACL rất dễ bị mô tả thành 'một cái mapper'.\n:::\n\nĐiểm phân biệt: mapper dịch *cấu trúc* (field này sang field kia), còn ACL dịch cả *khái niệm* — bên kia gọi là `PAX` với năm trạng thái trong khi domain của bạn chỉ có ba, ACL phải quyết định ánh xạ nào và từ chối cái không hợp lệ.\n\nNếu ACL của bạn không có chỗ nào ném lỗi thì gần như chắc nó chỉ là mapper.\n\n:::deep\n- ACL = Adapter + mapping giữa domain và hệ ngoài/legacy bẩn → thay đổi phía họ chỉ ảnh hưởng ACL, không lan vào domain\n- hiện thực: interface (port) ở domain + adapter dịch DTO của hệ ngoài ↔ model domain, xử lý cả khác biệt ngữ nghĩa/đơn vị/lỗi\n\nOTA: tích hợp GDS/airline legacy (Amadeus/Sabre schema/format riêng, mã lỗi lạ) qua ACL → domain Booking chỉ thấy model sạch; đổi nhà cung cấp GDS chỉ sửa ACL.\n\nACL cũng là nơi gom retry/idempotency/circuit-breaker cho tích hợp ngoài.\n\n- ACL là một kiểu quan hệ trong context map, đứng cạnh Customer/Supplier, Conformist và Open Host Service — chọn sai kiểu quan hệ thì ACL cũng không cứu được (24-domain-driven-design.strategic-splitting-the-domain.q3).\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.patterns-principles.q7","difficulty":"extra","q":"23 mẫu GoF — Java hiện đại đã cho sẵn mẫu nào, mẫu nào bạn vẫn tự viết, và mẫu nào ngôn ngữ đã thay thế?","a":"Cách nhớ catalogue hữu ích không phải 23 định nghĩa mà là ba nhóm, rồi cắt thêm một lần theo *ai viết mẫu đó hôm nay*.\n\n**Creational (5) — object được tạo ra thế nào:** Factory Method, Abstract Factory, Builder, Prototype, Singleton.\n\n**Structural (7) — object được ghép với nhau thế nào:** Adapter, Bridge, Composite, Decorator, Facade, Flyweight, Proxy.\n\n**Behavioral (11) — object chia việc với nhau thế nào:** Chain of Responsibility, Command, Interpreter, Iterator, Mediator, Memento, Observer, State, Strategy, Template Method, Visitor.\n\n<table>\n<tr><th>Hiện nằm ở đâu</th><th>Mẫu</th><th>Ví dụ</th></tr>\n<tr><td><b>Nền tảng đã có sẵn</b> — dùng, đừng tự viết</td><td>Iterator · Proxy · Observer<br>Chain of Responsibility · Facade · Flyweight</td><td><code>Iterable</code> · proxy của Spring AOP và <code>@Transactional</code><br><code>ApplicationEventPublisher</code> · filter chain của servlet và Security<br>SLF4J (chữ F là facade) · cache của <code>Integer.valueOf</code> từ −128..127</td></tr>\n<tr><td><b>Vẫn tự viết</b> trong code service</td><td>Strategy · Factory · Builder · Adapter<br>Decorator · State · Template Method · Command</td><td>route PSP theo từng provider · adapter làm anti-corruption layer<br>decorator cho retry hay metrics · state machine của đơn hàng</td></tr>\n<tr><td><b>Tính năng ngôn ngữ đã thay</b></td><td>Visitor · Prototype · Singleton<br>class Strategy hay Command chỉ có một method</td><td>sealed type + <code>switch</code> pattern matching (Java 21)<br>copy constructor · scope của container · lambda</td></tr>\n<tr><td><b>Hiếm gặp ở backend</b></td><td>Interpreter · Memento · Mediator · Bridge · Composite</td><td>expression language · undo · điều phối UI<br>tách driver/API · cấu trúc cây</td></tr>\n</table>\n\n:::tip Nói về một mẫu thế nào\nNêu vấn đề trước, rồi tới mẫu, rồi cái giá: \"luật chọn PSP đổi hàng tuần, nên routing thành một Strategy cho mỗi provider; cái giá là thêm một tầng gián tiếp phải lần theo.\"\n:::\n\n:::deep\n- **Visitor → `switch`.** Visitor tồn tại để thêm thao tác cho một hệ phân cấp đóng mà không sửa nó. Với interface `sealed` và record pattern, `switch` trên các subtype là exhaustive và được compiler kiểm, thiếu case là lỗi biên dịch thay vì thiếu một method `visit`.\n- **Prototype → copy constructor.** `Object.clone()` là shallow copy với hợp đồng khó dùng (Effective Java, Item 13); copy constructor hay static copy factory nói rõ chính xác thứ gì được chép.\n- **Strategy và Command → lambda.** Một strategy chỉ có một method và không có state thì chính là `Function`, `Comparator` hay `Runnable`. Mỗi strategy một class chỉ đáng khi nó có cấu hình, có tên trong log, hoặc có test riêng.\n- **Template Method và callback.** `JdbcTemplate` và `TransactionTemplate` của Spring giữ các bước cố định (lấy, chạy, trả) và nhận phần thay đổi dưới dạng callback thay vì subclass — cùng ý tưởng, dùng composition thay cho kế thừa.\n- **Decorator và Proxy.** Cả hai bọc cùng một interface; decorator thêm hành vi caller muốn, proxy kiểm soát việc truy cập target — và proxy của Spring là lý do tự gọi nội bộ bỏ qua `@Transactional` (03-spring-boot-deep-build.ioc-container-transactions.q2).\n- **State và Strategy** khác nhau ở chỗ ai đổi: strategy được chọn từ bên ngoài, state tự thay chính nó ở mỗi lần chuyển trạng thái (22-low-level-design-ood.patterns-in-interview-code.q2). Singleton trong thực tế xem (22-low-level-design-ood.patterns-in-interview-code.q7).\n- danh sách ngắn cần thuộc lòng là (12-architecture-patterns.patterns-principles.q1). Cách nhóm ở trên là đánh giá của site cho service backend Java, không phải số đo; catalogue và mục đích từng mẫu lấy từ Gamma, Helm, Johnson và Vlissides (1994).\n:::"}]},{"title":"Clean & Layered — dựng thật trong code","items":[{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q1","q":"Cấu trúc package thực tế cho một service Spring Boot theo Clean/Hexagonal?","a":"12.3 nói *quy tắc*; câu này là *thư mục*. Cấu trúc hay dùng nhất, chia theo [[g:feature trước, tầng sau]]:\n\n<pre><code>com.acme.booking\n├── domain/                     <span class=\"c\">// KHÔNG import Spring, JPA, Jackson</span>\n│   ├── Booking.java            <span class=\"c\">// entity nghiệp vụ + bất biến</span>\n│   ├── Money.java              <span class=\"c\">// value object</span>\n│   ├── BookingStatus.java\n│   └── DomainException.java\n├── application/\n│   ├── port/in/                <span class=\"c\">// use case interface (cổng vào)</span>\n│   │   ├── HoldSeatUseCase.java\n│   │   └── CancelBookingUseCase.java\n│   ├── port/out/               <span class=\"c\">// cổng ra — domain ĐỊNH NGHĨA, hạ tầng cài</span>\n│   │   ├── BookingRepository.java\n│   │   ├── PaymentGateway.java\n│   │   └── SeatLockPort.java\n│   └── service/\n│       └── HoldSeatService.java   <span class=\"c\">// điều phối, mở transaction</span>\n├── adapter/\n│   ├── in/web/                 <span class=\"c\">// Controller, DTO request/response</span>\n│   ├── in/messaging/           <span class=\"c\">// Kafka consumer</span>\n│   ├── out/persistence/        <span class=\"c\">// JpaBookingRepository + BookingJpaEntity</span>\n│   └── out/psp/                <span class=\"c\">// StripePaymentGateway</span>\n└── config/                     <span class=\"c\">// @Configuration, wiring, chỉ nơi này biết hết</span></code></pre>\n\nChiều phụ thuộc: `adapter` → `application` → `domain`. [[r:Không bao giờ ngược lại.]]\n\nĐiểm dễ bỏ sót: [[o:`port/out` nằm trong `application`, không nằm trong `adapter`]]. Interface do bên trong định nghĩa theo nhu cầu của mình, bên ngoài mới đi cài — đó chính là dependency inversion, và cũng là chỗ phân biệt người hiểu với người chỉ chép thư mục.\n\n<figure class='dgm'><svg viewBox='0 0 680 250' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='10' text-anchor='middle'>\n<defs><marker id='ar22' markerWidth='9' markerHeight='9' refX='6' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#42536C'/></marker></defs>\n<text x='340' y='18' fill='#14233A' font-weight='600' font-size='11.5'>POST /bookings/8H2K/holds — một request đi qua các tầng</text>\n<rect x='16' y='36' width='118' height='52' rx='7' fill='#E7EAF6' stroke='#3D4E8F'/><text x='75' y='56' fill='#3D4E8F' font-weight='600'>adapter/in/web</text><text x='75' y='70' fill='#42536C'>Controller</text><text x='75' y='82' fill='#7E8DA3'>WebRequest</text>\n<rect x='160' y='36' width='124' height='52' rx='7' fill='#EFEAF7' stroke='#5B3E8E'/><text x='222' y='56' fill='#5B3E8E' font-weight='600'>application</text><text x='222' y='70' fill='#42536C'>HoldSeatService</text><text x='222' y='82' fill='#7E8DA3'>@Transactional</text>\n<rect x='310' y='36' width='112' height='52' rx='7' fill='#E4F1EB' stroke='#0B6E4F' stroke-width='1.6'/><text x='366' y='56' fill='#085239' font-weight='600'>domain</text><text x='366' y='70' fill='#42536C'>Booking.holdSeat()</text><text x='366' y='82' fill='#7E8DA3'>luật nghiệp vụ</text>\n<rect x='448' y='36' width='104' height='52' rx='7' fill='#FBFCFE' stroke='#7E8DA3' stroke-dasharray='3 3'/><text x='500' y='56' fill='#42536C' font-weight='600'>port/out</text><text x='500' y='70' fill='#42536C'>BookingRepository</text><text x='500' y='82' fill='#7E8DA3'>interface</text>\n<rect x='578' y='36' width='88' height='52' rx='7' fill='#F6E8E5' stroke='#AE4536'/><text x='622' y='56' fill='#7d2f24' font-weight='600'>adapter/out</text><text x='622' y='70' fill='#42536C'>JPA · Stripe</text>\n<g stroke='#42536C' stroke-width='1.4' marker-end='url(#ar22)'><line x1='134' y1='62' x2='156' y2='62'/><line x1='284' y1='62' x2='306' y2='62'/><line x1='422' y1='62' x2='444' y2='62'/><line x1='552' y1='62' x2='574' y2='62'/></g>\n<text x='145' y='108' fill='#7E8DA3'>Command</text><text x='295' y='108' fill='#7E8DA3'>domain obj</text><text x='433' y='108' fill='#7E8DA3'>gọi qua interface</text><text x='563' y='108' fill='#7E8DA3'>cài đặt</text>\n<rect x='16' y='132' width='650' height='44' rx='8' fill='#FBFCFE' stroke='#DBE1EA'/>\n<text x='340' y='150' fill='#14233A' font-weight='600'>Chiều COMPILE-TIME: adapter → application → domain (domain không import gì của ai)</text>\n<text x='340' y='166' fill='#42536C'>Chiều RUNTIME ở bước 4→5 thì ngược lại — đó chính là dependency inversion</text>\n<text x='340' y='198' fill='#AE4536'>Thấy import jakarta.persistence hoặc org.springframework trong domain/ = đã thủng</text>\n<text x='340' y='218' fill='#42536C'>Một ArchUnit rule (12-architecture-patterns.clean-layered-building-it-for-real.q4) bắt đúng lỗi này trong CI</text>\n</svg></figure>\n\n:::deep\n- Đặt tên port theo [[g:ngôn ngữ nghiệp vụ]], không theo công nghệ: `PaymentGateway` chứ không phải `StripeClient`; `SeatLockPort` chứ không phải `RedisLock`. Tên lộ công nghệ là dấu hiệu hạ tầng đang rò vào trong.\n- một use case = một interface nhỏ ở `port/in` (12-architecture-patterns.clean-layered-building-it-for-real.q3). Interface 20 method là đang bê `Service` cũ vào mặc áo mới.\n- `config` là [[o:nơi duy nhất]] được biết mọi tầng — nó ráp adapter vào port. Giữ nó mỏng và không có logic.\n- package-private là bạn: để `BookingJpaEntity` package-private trong `out/persistence` thì không tầng nào lỡ dùng được nó (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n- [[r:Đừng]] tạo module Maven riêng ngay từ đầu — package trước, tách module khi thật sự cần cưỡng chế (12-architecture-patterns.clean-layered-building-it-for-real.q4).\n- Với domain mỏng (CRUD), cấu trúc này là over-engineer — 12.4 đã cảnh báo. Dùng khi domain có bất biến thật sự để bảo vệ.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q2","q":"Domain model và JPA entity: tách làm hai hay dùng chung một class?","a":"Câu hỏi thực chiến gây tranh cãi nhất khi áp Clean vào Spring. Ba lựa chọn:\n\n<table class=\"cmp\"><thead><tr><th></th><th>Dùng chung 1 class</th><th>Tách 2 class + mapper</th><th>Chung nhưng giấu JPA</th></tr></thead><tbody>\n<tr><td>Boilerplate</td><td>không có</td><td><b>nhiều</b> (mapper 2 chiều)</td><td>ít</td></tr>\n<tr><td>Domain sạch</td><td>không — dính JPA</td><td><b>sạch tuyệt đối</b></td><td>gần sạch</td></tr>\n<tr><td>Bất biến</td><td>khó — JPA cần no-arg ctor + setter</td><td>bảo vệ được</td><td>bảo vệ một phần</td></tr>\n<tr><td>Lazy loading</td><td>rò ra ngoài domain</td><td>không rò</td><td>vẫn rò</td></tr>\n<tr><td>Hợp khi</td><td>CRUD, domain mỏng</td><td>domain phức tạp, sống lâu</td><td>trung dung</td></tr>\n</tbody></table>\n\n**Vì sao dùng chung lại đau:** JPA bắt phải có constructor không tham số và setter để nó dựng lại object → domain không còn ép được bất biến. Thêm nữa `@OneToMany` lazy làm một phép đọc thuộc tính trong domain bỗng bắn ra câu SQL, và `LazyInitializationException` nổ ở tầng chẳng liên quan gì tới DB.\n\n<pre><code><span class=\"c\">// domain/Booking.java — không có annotation nào</span>\n<span class=\"k\">public final class</span> Booking {\n    <span class=\"k\">private final</span> BookingId id;\n    <span class=\"k\">private</span> BookingStatus status;\n    <span class=\"k\">private final</span> List&lt;Passenger&gt; passengers;\n<span class=\"c\">    </span>\n    <span class=\"k\">public void</span> <span class=\"f\">cancel</span>() {                       <span class=\"c\">// bất biến sống trong domain</span>\n        <span class=\"k\">if</span> (status == ISSUED) <span class=\"k\">throw new</span> DomainException(<span class=\"s\">\"Vé đã xuất, phải hoàn\"</span>);\n        status = CANCELLED;\n    }\n}\n<span class=\"c\">// adapter/out/persistence/BookingJpaEntity.java — thuần lưu trữ</span>\n<span class=\"k\">@Entity @Table</span>(name = <span class=\"s\">\"bookings\"</span>)\n<span class=\"k\">class</span> BookingJpaEntity {\n    <span class=\"k\">@Id</span> <span class=\"k\">private</span> String id;\n    <span class=\"k\">@Enumerated</span>(STRING) <span class=\"k\">private</span> BookingStatus status;\n    <span class=\"k\">protected</span> <span class=\"f\">BookingJpaEntity</span>() {}          <span class=\"c\">// JPA cần — nhưng không lộ ra domain</span>\n}</code></pre>\n\n:::deep\n- Mapper viết tay dễ sai và chán → dùng [[g:MapStruct]] (sinh code lúc compile, không reflection lúc chạy). Đây là chỗ đáng dùng thư viện.\n- Chi phí thật của việc tách [[o:không phải]] mapper, mà là khi domain và table lệch nhau nhiều (aggregate gồm 4 table). Lúc đó repository adapter phải ráp/tách — và đó chính là việc nó sinh ra để làm.\n- [[r:Bẫy nửa vời]]: tách 2 class nhưng để domain có `getId()` trả `Long` auto-increment của DB. Domain nên dùng id riêng (UUID/mã nghiệp vụ), sinh ở domain — liên hệ 17.1.\n- Nếu chọn dùng chung: ít nhất giữ setter package-private, thêm `@Access(FIELD)`, và [[g:cấm `EAGER`]] — giảm rò rỉ mà không tốn mapper.\n- Quyết định [[o:theo từng bounded context]], không phải cho cả repo: Booking/Payment tách; table tra cứu mã sân bay thì dùng chung, thậm chí không cần domain model.\n- Câu hỏi vặn hay gặp: *\"repository trả domain hay entity?\"* — [[g:luôn trả domain]]. Nếu nó trả entity thì cái port ấy chưa phải port.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q3","q":"Use case (application service) thiết kế thế nào? Một class một use case hay gom vào service?","a":"[[g:Một class cho một use case]] — đây là điểm khác biệt lớn nhất so với `BookingService` 800 dòng của kiểu layered.\n\n<pre><code><span class=\"c\">// port/in — hợp đồng, đọc là biết hệ thống làm được gì</span>\n<span class=\"k\">public interface</span> HoldSeatUseCase {\n    HoldResult <span class=\"f\">hold</span>(HoldSeatCommand cmd);\n}\n<span class=\"c\">// application/service — điều phối, KHÔNG chứa business rule</span>\n<span class=\"k\">@Service</span>\n<span class=\"k\">class</span> HoldSeatService <span class=\"k\">implements</span> HoldSeatUseCase {\n    <span class=\"k\">private final</span> BookingRepository bookings;   <span class=\"c\">// port/out</span>\n    <span class=\"k\">private final</span> SeatLockPort locks;\n<span class=\"c\">    </span>\n    <span class=\"k\">@Override</span> <span class=\"k\">@Transactional</span>                    <span class=\"c\">// ranh giới transaction ở ĐÂY</span>\n    <span class=\"k\">public</span> HoldResult <span class=\"f\">hold</span>(HoldSeatCommand cmd) {\n        <span class=\"k\">if</span> (!locks.<span class=\"f\">tryLock</span>(cmd.<span class=\"f\">flightId</span>(), cmd.<span class=\"f\">seatNo</span>())) <span class=\"k\">return</span> HoldResult.<span class=\"f\">taken</span>();\n        Booking b = bookings.<span class=\"f\">findById</span>(cmd.<span class=\"f\">bookingId</span>())\n                            .<span class=\"f\">orElseThrow</span>(NotFound::<span class=\"k\">new</span>);\n        b.<span class=\"f\">holdSeat</span>(cmd.<span class=\"f\">seatNo</span>());                <span class=\"c\">// luật nằm trong DOMAIN</span>\n        bookings.<span class=\"f\">save</span>(b);\n        <span class=\"k\">return</span> HoldResult.<span class=\"f\">ok</span>(b.<span class=\"f\">holdExpiresAt</span>());\n    }\n}</code></pre>\n\n**Ranh giới rõ ràng:** use case *điều phối* (lấy ra → gọi domain → lưu → phát event). Quyết định nghiệp vụ *\"ghế này có giữ được không\"* nằm trong `Booking`, không nằm ở đây. Nếu use case đầy `if` về nghiệp vụ thì domain đang thiếu máu (12.11 anemic domain).\n\n**Command/Result là DTO của tầng application**, tách khỏi DTO của web (`adapter/in/web`). Nghe thừa, nhưng nó cho phép đổi hợp đồng REST (17-rest-api-design.contracts-errors-lifecycle.q4) mà không đụng use case, và cho phép cùng use case chạy từ Kafka consumer.\n\n:::deep\n- Command nên [[g:tự validate cú pháp]] ngay trong constructor (`record` compact constructor) — không thể tạo ra một `HoldSeatCommand` vô nghĩa. Đây là kiểu \"làm cho trạng thái sai không biểu diễn được\".\n- Use case gọi use case khác là [[r:mùi]]: hoặc tách phần chung xuống domain service, hoặc dùng domain event. Gọi lồng làm transaction và lỗi khó lần.\n- [[o:Đừng]] để use case trả entity JPA hay domain object thô ra controller — trả `Result` để controller không phụ thuộc hình dạng domain.\n- Use case chỉ đọc (query) thường [[g:không cần đi qua domain]]: đọc thẳng bằng projection cho nhanh. Đó là cửa ngõ tự nhiên vào CQRS (12-architecture-patterns.domain-driven-design.q4) mà không phải làm event sourcing.\n- Tên class là [[g:động từ nghiệp vụ]]: `HoldSeat`, `IssueTicket`, `RefundBooking`. Đọc danh sách file trong `port/in` là biết hệ thống làm gì — 'screaming architecture' (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n- Kiểm tra nhanh chất lượng: import của `application/service` chỉ được có `domain`, `port`, và annotation transaction. Thấy `javax.persistence` hay `HttpServletRequest` ở đây là đã thủng.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q4","q":"Cưỡng chế Dependency Rule bằng gì? Không có công cụ thì kiến trúc trôi sau 3 tháng.","a":"Quy tắc chỉ nằm trong đầu thì [[r:sẽ trôi]] — một dev mới thêm `import javax.persistence` vào domain và không ai thấy trong review. Ba mức cưỡng chế, mạnh dần:\n\n**1. ArchUnit — test như mọi test khác, rẻ nhất, làm trước:**\n\n<pre><code><span class=\"k\">@AnalyzeClasses</span>(packages = <span class=\"s\">\"com.acme.booking\"</span>)\n<span class=\"k\">class</span> ArchitectureTest {\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule domain_khong_phu_thuoc_ha_tang =\n        noClasses().that().resideInAPackage(<span class=\"s\">\"..domain..\"</span>)\n            .should().dependOnClassesThat()\n            .resideInAnyPackage(<span class=\"s\">\"..adapter..\"</span>, <span class=\"s\">\"org.springframework..\"</span>,\n                                <span class=\"s\">\"jakarta.persistence..\"</span>, <span class=\"s\">\"com.fasterxml..\"</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule cac_tang_dung_chieu =\n        layeredArchitecture().consideringOnlyDependenciesInLayers()\n            .layer(<span class=\"s\">\"Domain\"</span>).definedBy(<span class=\"s\">\"..domain..\"</span>)\n            .layer(<span class=\"s\">\"Application\"</span>).definedBy(<span class=\"s\">\"..application..\"</span>)\n            .layer(<span class=\"s\">\"Adapter\"</span>).definedBy(<span class=\"s\">\"..adapter..\"</span>)\n            .whereLayer(<span class=\"s\">\"Adapter\"</span>).mayNotBeAccessedByAnyLayer()\n            .whereLayer(<span class=\"s\">\"Application\"</span>).mayOnlyBeAccessedByLayers(<span class=\"s\">\"Adapter\"</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">@ArchTest</span>\n    <span class=\"k\">static final</span> ArchRule khong_ai_duoc_dung_field_injection =\n        noFields().should().beAnnotatedWith(Autowired.<span class=\"k\">class</span>);\n}</code></pre>\n\n**2. Module Maven/Gradle** — `domain` là module không khai báo dependency nào tới Spring/JPA. Compiler chặn thay vì test chặn; đổi lại build phức tạp hơn và refactor xuyên module chậm hơn.\n\n**3. Spring Modulith** — `ApplicationModules.of(App.class).verify()` kiểm tra ranh giới module trong một monolith, kèm sinh tài liệu và sơ đồ (12-architecture-patterns.clean-layered-building-it-for-real.q8).\n\n[[g:Khuyến nghị thực dụng]]: ArchUnit từ ngày đầu (10 dòng, chạy trong CI), tách module chỉ khi đội đông và quy tắc bị vi phạm liên tục.\n\n:::deep\n- Đặt ArchUnit vào [[o:CI bắt buộc]], không phải test tuỳ chọn. Rule không chạy trong pipeline là rule không tồn tại.\n- Bắt đầu bằng [[g:một rule duy nhất]] (domain không phụ thuộc hạ tầng) rồi siết dần. Áp 15 rule vào codebase cũ thì đội sẽ tắt cả bộ test.\n- Codebase đã lỡ vi phạm: ArchUnit có `freeze()` (`FreezingArchRule`) — chốt các vi phạm hiện có làm baseline, chỉ chặn vi phạm *mới*. Đây là cách duy nhất áp được vào dự án đang chạy, và là câu trả lời rất \"đã làm thật\".\n- Rule đáng thêm sớm: cấm `System.out`, cấm `java.util.Date`, bắt tên class trong `port/in` kết thúc bằng `UseCase`, cấm cycle giữa các package (`slices().should().beFreeOfCycles()`).\n- ArchUnit đọc bytecode nên [[r:không]] bắt được phụ thuộc qua reflection hay chuỗi tên class — hiếm, nhưng nên biết giới hạn.\n- Song song với công cụ vẫn cần review: dependency đúng chiều mà logic nghiệp vụ nằm nhầm chỗ thì không máy nào bắt được.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q5","q":"Transaction, validation và mapping đặt ở tầng nào?","a":"Ba thứ xuyên tầng, và đặt sai là lý do phổ biến khiến kiến trúc \"đúng thư mục\" vẫn khó bảo trì.\n\n**Transaction — ở `application/service`, đúng một chỗ.**\n- [[g:Use case = một transaction]]. Vào mở, ra đóng.\n- [[r:Không]] đặt `@Transactional` ở controller (giữ transaction suốt lúc serialize JSON) và [[r:không]] đặt ở repository adapter (mỗi lời gọi một transaction → mất tính nguyên tử của use case).\n- Domain [[g:không được biết]] transaction là gì — nó là chi tiết hạ tầng.\n\n**Validation — ba loại, ba chỗ khác nhau:**\n\n<table class=\"cmp\"><thead><tr><th>Loại</th><th>Ví dụ</th><th>Đặt ở</th><th>Trả lỗi</th></tr></thead><tbody>\n<tr><td>Cú pháp</td><td>email đúng dạng, số dương, field bắt buộc</td><td>adapter/in (<code>@Valid</code> trên DTO web)</td><td>400</td></tr>\n<tr><td>Bất biến domain</td><td>không huỷ được vé đã xuất</td><td><b>domain</b></td><td>409/422</td></tr>\n<tr><td>Quy tắc cần dữ liệu ngoài</td><td>ghế còn trống không, đủ số dư không</td><td>application (đọc qua port rồi hỏi domain)</td><td>409</td></tr>\n</tbody></table>\n\nBất biến domain [[o:phải]] nằm trong domain, kể cả khi adapter đã kiểm rồi — adapter có thể bị bỏ qua (consumer Kafka, job, test), domain thì không.\n\n**Mapping — mỗi tầng tự map vào tầng trong, không map xuyên tầng:**\n\n<pre><code>WebRequest ──(adapter/in)──&gt; Command ──&gt; Domain\nDomain ──&gt; Result ──(adapter/in)──&gt; WebResponse\nDomain &lt;──(adapter/out)──&gt; JpaEntity</code></pre>\n\n:::deep\n- `@Transactional` trên method `private` hoặc gọi nội bộ qua `this` [[r:không chạy]] — proxy của Spring (03-spring-boot-deep-build.ioc-container-transactions.q4). Đây là bug kinh điển, và ở kiến trúc này nó hay xuất hiện khi tách use case thành method nhỏ trong cùng class.\n- Gọi API ngoài (PSP, GDS) [[r:không được]] nằm trong transaction DB (18-query-optimization.rewriting-the-query-reshaping-the-model.q4): giữ connection suốt thời gian chờ mạng. Mẫu đúng: transaction ngắn ghi trạng thái `PENDING` → gọi ngoài → transaction ngắn ghi kết quả, hoặc outbox (chủ đề 9).\n- Bất biến nào [[o:không thể]] bảo vệ trong memory (chống double-booking khi nhiều instance) thì phải rơi xuống constraint DB hoặc atomic update\n- đây là ranh giới thật của Clean Architecture, nói được là rất ghi điểm (16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2).\n- `@Valid` chỉ kiểm hình dạng. Đừng nhét quy tắc nghiệp vụ vào custom validator — nó sẽ nằm ngoài domain và không tái dùng được.\n- Mapping nhiều tầng nhìn thừa cho CRUD, nên với context đơn giản thì [[g:cho phép đi tắt]] có chủ ý và ghi lại quyết định (ADR) thay vì áp cứng khắp nơi.\n:::","difficulty":"core"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q6","q":"Test pyramid ánh xạ vào các tầng thế nào? Vì sao Clean làm test rẻ hơn?","a":"Lý do thực dụng nhất để chọn Clean [[o:không phải]] \"sạch đẹp\" mà là [[g:test nhanh và ổn định]] — trả lời được điều này là trả lời đúng trọng tâm.\n\n<table class=\"cmp\"><thead><tr><th>Tầng</th><th>Kiểu test</th><th>Công cụ</th><th>Tốc độ</th><th>Tỉ lệ</th></tr></thead><tbody>\n<tr><td>Domain</td><td>unit thuần, không Spring</td><td>JUnit + AssertJ</td><td>~1ms</td><td><b>nhiều nhất</b></td></tr>\n<tr><td>Application (use case)</td><td>unit với port giả</td><td>JUnit + fake/mock</td><td>~5ms</td><td>nhiều</td></tr>\n<tr><td>Adapter out (DB)</td><td>tích hợp hẹp</td><td><code>@DataJpaTest</code> + Testcontainers</td><td>~1s</td><td>vừa</td></tr>\n<tr><td>Adapter in (web)</td><td>tích hợp hẹp</td><td><code>@WebMvcTest</code></td><td>~1s</td><td>vừa</td></tr>\n<tr><td>Toàn hệ</td><td>happy path chính</td><td><code>@SpringBootTest</code></td><td>~10s</td><td><b>rất ít</b></td></tr>\n<tr><td>Kiến trúc</td><td>rule</td><td>ArchUnit</td><td>~2s</td><td>1 bộ</td></tr>\n</tbody></table>\n\n**Vì sao rẻ hơn:** domain không import Spring nên test nó [[g:không cần khởi động context]]. Một suite 2000 test domain chạy vài giây. Trong codebase layered mà logic nằm trong `@Service` gọi thẳng `Repository`, mọi test đều phải nâng context hoặc mock JPA — chậm và giòn.\n\n<pre><code><span class=\"c\">// Test use case: port là interface nên fake được, không cần DB</span>\n<span class=\"k\">@Test</span> <span class=\"k\">void</span> <span class=\"f\">khong_giu_duoc_ghe_da_bi_nguoi_khac_giu</span>() {\n    <span class=\"k\">var</span> locks = <span class=\"k\">new</span> InMemorySeatLocks();       <span class=\"c\">// fake tự viết, không Mockito</span>\n    locks.<span class=\"f\">tryLock</span>(<span class=\"s\">\"VN231\"</span>, <span class=\"s\">\"12A\"</span>);              <span class=\"c\">// người khác giữ trước</span>\n    <span class=\"k\">var</span> service = <span class=\"k\">new</span> HoldSeatService(<span class=\"k\">new</span> InMemoryBookings(booking), locks);\n<span class=\"c\">    </span>\n    <span class=\"k\">var</span> r = service.<span class=\"f\">hold</span>(<span class=\"k\">new</span> HoldSeatCommand(id, <span class=\"s\">\"VN231\"</span>, <span class=\"s\">\"12A\"</span>));\n<span class=\"c\">    </span>\n    assertThat(r.<span class=\"f\">status</span>()).<span class=\"f\">isEqualTo</span>(TAKEN);\n}</code></pre>\n\n:::deep\n- [[g:Fake tự viết hơn mock]] cho port dùng nhiều: `InMemoryBookingRepository` viết một lần, dùng ở 50 test, đọc dễ hơn 5 dòng `when(...).thenReturn(...)`. Mock hợp cho lời gọi một lần.\n- [[r:Phản mẫu số một]]: `@SpringBootTest` cho mọi thứ. Suite chạy 8 phút, dev ngừng chạy test cục bộ, và test hỏng vì lý do chẳng liên quan.\n- Testcontainers [[g:hơn H2]]: H2 không có next-key lock, khác cú pháp, khác plan — test xanh mà prod đỏ. Đây là chỗ nên cứng rắn.\n- Test domain nên đặt tên theo [[o:luật nghiệp vụ]] (`khong_huy_duoc_ve_da_xuat`) chứ không theo method (`testCancel`). Đọc danh sách test là đọc được đặc tả.\n- Kiến trúc này cũng làm [[g:consumer-driven contract test]] (17-rest-api-design.contracts-errors-lifecycle.q4) tự nhiên: adapter web mỏng nên contract test chỉ cần chạm adapter.\n- Đo bằng [[o:mutation testing]] (PIT) nếu muốn biết test có thật sự bắt lỗi — coverage cao mà mutation score thấp nghĩa là test chỉ chạy qua code chứ không kiểm gì.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q7","q":"Chuyển một codebase layered đang chạy sang Clean từng bước thế nào?","a":"Câu hỏi phân biệt người đọc sách với người từng làm: [[r:không ai được viết lại từ đầu]]. Làm dần, mỗi bước vẫn deploy được.\n\n**Thứ tự có chủ đích — 6 bước:**\n\n1. **Chọn một bounded context đau nhất** (thường là Booking hoặc Payment), không phải cả repo. Thắng một chỗ rồi mới lan.\n2. **Dựng lưới an toàn trước**: test đặc tả (characterization test) cho hành vi hiện tại. Chưa có test thì mọi refactor là đánh bạc.\n3. **Trích `port/out` trước tiên** — đây là bước có lãi nhất. Tạo interface `BookingRepository` trong `application/port/out`, để `JpaBookingRepository` hiện có implement nó. Chưa cần đổi model, chưa cần mapper.\n4. **Kéo business rule từ `Service` xuống domain**, từng luật một. Mỗi lần kéo là thêm test domain thuần.\n5. **Tách use case** khỏi `BookingService` god-class: mỗi method public thành một class use case.\n6. **Tách model** (12-architecture-patterns.clean-layered-building-it-for-real.q2) — [[o:làm sau cùng]], vì đây là bước tốn công nhất và ít lãi nhất. Nhiều đội dừng ở bước 5 và như thế đã đủ tốt.\n\n**Chống trôi ngược:** bật ArchUnit với `freeze()` ngay từ bước 3 — chốt vi phạm cũ làm baseline, chặn vi phạm mới (12-architecture-patterns.clean-layered-building-it-for-real.q4). Không có nó thì code mới vẫn viết theo kiểu cũ trong lúc bạn đang dọn code cũ.\n\n:::warn Sai lầm hay gặp\nBắt đầu bằng việc [[r:tạo đủ 4 thư mục rồi bê nguyên class cũ vào]]. Kết quả là layered mặc áo Clean: thư mục đúng, dependency vẫn sai, mà đội thì tin là đã xong. Chiều phụ thuộc mới là kiến trúc, không phải cây thư mục.\n:::\n\n:::deep\n- Áp dụng [[g:strangler fig]]: tính năng *mới* viết theo cấu trúc mới ngay, tính năng cũ chuyển khi có lý do đụng vào nó. Không có sprint \"refactor thuần\" nào được duyệt cả — nên phải gắn vào công việc thật.\n- Bước 3 có lãi nhất vì nó [[o:mở khoá test]]: có interface là fake được, là viết test nhanh được, và mọi bước sau đều dựa vào đó.\n- Đo tiến độ bằng số đo được: số class trong `domain` không import Spring, số test không cần context, thời gian chạy suite. Nói \"sạch hơn\" thì không ai duyệt tiếp.\n- Viết [[g:ADR]] (Architecture Decision Record) cho quyết định lớn — 6 tháng sau chính bạn cũng quên vì sao chọn tách model.\n- Với hệ legacy tích hợp bên ngoài, chèn [[o:Anti-Corruption Layer]] (12-architecture-patterns.patterns-principles.q6) ở ranh giới để mô hình bẩn của họ không thấm vào domain mới.\n- Biết khi nào [[r:dừng]]: context CRUD thuần thì bước 1–3 là đủ. Ép Clean lên module tra cứu là đúng cái over-engineer mà 12.4 cảnh báo.\n\n**Một lát migration cần equivalence gate chạy được, không chỉ chuyển package:**\n<pre><code>@Test\nvoid extractedQuoteUseCasePreservesObservedLegacyBehaviour() {\n  QuoteRequest fixture = Fixtures.quoteWithTaxAndDiscount();\n  Quote legacyResult = legacyPricing.quote(fixture);\n  Quote extractedResult = new QuoteUseCase(\n      new LegacyPricingAdapter(legacyPricing), fixedClock).quote(fixture);\n  assertThat(extractedResult)\n      .usingRecursiveComparison()\n      .isEqualTo(legacyResult);\n}\n./mvnw -Dtest=PricingMigrationCharacterizationTest test</code></pre>\n\nCharacterization test này tạo seam trước khi chuyển caller.\n\n- **Ưu điểm:** extraction diễn ra tăng dần và rollback chỉ là đổi routing.\n- **Chi phí:** nó đóng băng hành vi đang thấy, kể cả bug. Đánh dấu defect rồi thay equivalence tạm bằng domain/contract test khi owner mới ổn định.\n:::","difficulty":"advanced"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q8","q":"Package-by-layer vs package-by-feature, và Spring Modulith cho modular monolith?","a":"**Package-by-layer** (mặc định của đa số dự án Spring):\n\n<pre><code>com.acme\n├── controller/   BookingController, FlightController, UserController\n├── service/      BookingService, FlightService, UserService\n└── repository/   BookingRepository, FlightRepository, UserRepository</code></pre>\n\nMở repo lên chỉ biết *\"đây là app Spring\"*. Sửa một tính năng phải đụng 3 thư mục, và [[r:không có gì ngăn]] `UserService` gọi thẳng `BookingRepository`.\n\n**Package-by-feature** (còn gọi [[o:screaming architecture]]):\n\n<pre><code>com.acme\n├── booking/      web/ · application/ · domain/ · persistence/\n├── flight/       web/ · application/ · domain/ · persistence/\n└── user/         web/ · application/ · domain/ · persistence/</code></pre>\n\nMở repo lên biết ngay *hệ thống này làm gì*. Quan trọng hơn: `booking` có thể để mọi thứ trừ API công khai ở mức [[g:package-private]] — compiler ngăn được truy cập chéo, không cần công cụ.\n\n**Spring Modulith** — biến ranh giới đó thành thứ kiểm tra được:\n\n<pre><code><span class=\"k\">@Test</span> <span class=\"k\">void</span> <span class=\"f\">module_dung_ranh_gioi</span>() {\n    ApplicationModules.<span class=\"f\">of</span>(Application.<span class=\"k\">class</span>).<span class=\"f\">verify</span>();     <span class=\"c\">// fail nếu vi phạm</span>\n}\n<span class=\"c\">// Giao tiếp giữa module bằng event, không gọi thẳng bean của nhau</span>\n<span class=\"k\">@ApplicationModuleListener</span>                            <span class=\"c\">// = async + transactional</span>\n<span class=\"k\">void</span> <span class=\"f\">on</span>(BookingConfirmed e) { notifications.<span class=\"f\">send</span>(e.<span class=\"f\">bookingId</span>()); }</code></pre>\n\nNó cũng sinh sơ đồ module và tài liệu từ chính code, và có event publication registry để event không mất khi consumer lỗi.\n\n:::deep\n- Hai trục [[o:độc lập nhau]]: layer vs feature là *cách chia package*; Clean/Hexagonal là *chiều phụ thuộc*. Kết hợp tốt nhất là feature ở ngoài, layer ở trong (12-architecture-patterns.clean-layered-building-it-for-real.q1).\n- Modular monolith là điểm dừng đúng cho phần lớn đội (12-architecture-patterns.patterns-principles.q5): có ranh giới rõ mà không tốn cái giá phân tán. Tách micro-service khi có [[g:lý do vận hành]] — scale lệch, nhịp release khác, đội tách — chứ không phải vì \"cho sạch\".\n- Module giao tiếp bằng [[g:domain event]] thay vì gọi bean trực tiếp là bước chuẩn bị tốt nhất cho việc tách service sau này: đổi từ event trong process sang Kafka gần như không đụng code nghiệp vụ.\n- Spring Modulith mặc định coi [[o:mỗi package con trực tiếp của package gốc]] là một module, và chỉ những gì ở tầng đầu của module mới là API công khai — quy ước này là thứ khiến nó nhẹ.\n- Đừng chia module theo tầng kỹ thuật (`web`, `db`) — chia theo nghiệp vụ. Module `persistence` dùng chung là distributed monolith thu nhỏ (12-architecture-patterns.patterns-principles.q3).\n- Chia sai vẫn sửa được khi còn là monolith; chia sai sau khi đã tách micro-service thì rất đắt. Đó là lý do [[g:modular monolith trước, tách sau]] gần như luôn là lời khuyên đúng.\n:::","difficulty":"extra"},{"id":"12-architecture-patterns.clean-layered-building-it-for-real.q9","q":"Làm sao fitness function và ADR giữ cho boundary không bị trôi sau thiết kế ban đầu?","a":"Sơ đồ chỉ là một giả thuyết. [[g:Architecture fitness function]] là kiểm tra có thể chạy tự động để bảo vệ boundary khi code thay đổi; [[g:ADR]] ghi lại vì sao boundary tồn tại, trade-off nào đã chấp nhận và khi nào cần xem lại. Không cái nào chứng minh boundary ban đầu vẫn đúng mãi.\n\n<table class=\"cmp\"><thead><tr><th>Khẳng định về boundary</th><th>Tín hiệu thực thi</th><th>Câu hỏi review</th></tr></thead><tbody>\n<tr><td>Domain không phụ thuộc infrastructure</td><td>Rule ArchUnit/package và dependency module ở compile time</td><td>Test domain có chạy không cần Spring/JPA/Jackson không?</td></tr>\n<tr><td>Module sở hữu dữ liệu của mình</td><td>Không truy cập repository/table của module khác; owner migration rõ</td><td>Use case nào cần dữ liệu này, ai duyệt schema change?</td></tr>\n<tr><td>Integration là bất đồng bộ</td><td>Event contract có version, outbox/relay hoặc publication bền vững, consumer idempotent</td><td>Sau commit, trước publish, khi replay và lúc lệch version xảy ra gì?</td></tr>\n<tr><td>Service deploy độc lập được</td><td>Compatibility test, dependency đồng bộ có giới hạn, rollback path</td><td>Version cũ và mới chạy cùng nhau được mà không deploy đồng bộ không?</td></tr>\n</tbody></table>\n\n:::deep\n- Fitness rule phải fail khi có violation mới, không chỉ in report rồi bị bỏ qua. Exception phải ít, có tên, được review và có thời hạn.\n- ADR nên ghi context, quyết định, phương án đã cân nhắc, hệ quả, owner và tín hiệu cần đánh giá lại. ADR không thay thế test hay ticket.\n- Đo boundary bằng evidence về change impact: số module bị đụng mỗi feature, cross-module call, số deploy phải phối hợp, projection lag, contract failure và blast radius của incident.\n- Package rule pass vẫn có thể bảo vệ sai boundary. Xem lại khi language, invariant, ownership, contention, latency hoặc recovery requirement thay đổi.\n- Đừng cấm mọi dependency giữa class. Rule chặn adapter hợp lệ sẽ tạo workaround và làm mất niềm tin; chỉ enforce rule nhỏ nhất bảo vệ invariant thật.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"12-architecture-patterns","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"distributed-rate-limiter","11-system-design-cases.the-big-prompts.q5":"distributed-rate-limiter","16-project-concurrency-whiteboard.whiteboard-dsa.q1":"distributed-rate-limiter","11-system-design-cases.the-