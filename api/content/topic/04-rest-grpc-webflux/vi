json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},"meta":{"topic_type":"design","key":"04-rest-grpc-webflux","vi":{"label":"REST/gRPC & WebFlux","title":"API protocols (REST/gRPC) & lập trình reactive (WebFlux)","intro":"Cách các service nói chuyện và xử lý I/O ở mức cao. Trọng tâm: chọn đúng protocol, hiểu reactive vs virtual threads, và thiết kế API sạch.","tags":["REST idempotency","gRPC/Protobuf","HTTP/2","Mono/Flux","Backpressure","Reactive vs VT","Versioning"]},"en":{"label":"REST/gRPC & WebFlux","title":"API protocols (REST/gRPC) & reactive programming (WebFlux)","intro":"How services talk to each other and handle I/O at a high level. The focus: picking the right protocol, reactive versus virtual threads, and designing a clean API.","tags":["REST idempotency","gRPC/Protobuf","HTTP/2","Mono/Flux","Backpressure","Reactive vs VT","Versioning"]},"created_at":"2026-07-31","updated_at":"2026-10-25"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"04-rest-grpc-webflux.reactive-webflux.q1":"2026-09-12","04-rest-grpc-webflux.reactive-webflux.q2":"2026-09-12","04-rest-grpc-webflux.protocols.q2":"2026-09-12","04-rest-grpc-webflux.protocols.q3":"2026-09-12","04-rest-grpc-webflux.protocols.q4":"2026-09-12","04-rest-grpc-webflux.protocols.q5":"2026-09-12","04-rest-grpc-webflux.protocols.q6":"2026-09-12","04-rest-grpc-webflux.reactive-webflux.q4":"2026-09-12","04-rest-grpc-webflux.reactive-webflux.q5":"2026-09-12","04-rest-grpc-webflux.protocols.q1":"2026-09-12"},"lang":"vi","body":{"sections":[{"title":"Protocols","items":[{"id":"04-rest-grpc-webflux.protocols.q1","q":"Nguyên tắc REST, tính idempotent của HTTP method và status code đúng?","a":"REST: resource + representation + thao tác qua standard method, stateless.\n\n[[g:Idempotency]]:\n- GET/PUT/DELETE/HEAD nên idempotent (gọi nhiều lần cho cùng kết quả)\n- POST [[r:không]] (tạo mới mỗi lần) → POST payment cần `Idempotency-Key`\n\n**Status code:**\n- 200/201/204 success\n- 400 sai input · 401/403 auth · 404\n- 409 conflict · 422 là quy ước validation phổ biến (hãy document policy 4xx) · 429 rate limit\n- 5xx server error\n\nDùng đúng status giúp client xử lý retry hợp lý.\n\n:::deep\n- PUT idempotent (set absolute state) nhưng [[r:cẩn thận PUT kiểu 'tăng/giảm']] (không idempotent)\n- phân biệt *safe* (GET/HEAD không đổi state) vs *idempotent* (gọi nhiều = một lần)\n- status code là [[g:contract]] với client/monitoring: 409 (ghế đã giữ), policy validation 422 được document rõ, 429 + `Retry-After`, và 503 (degrade)\n- [[r:trả 200 cho mọi thứ]] kèm error-trong-body phá retry/alerting/circuit-breaker\n- ETag + `If-Match` cho optimistic concurrency qua HTTP\n\nĐào sâu: business error code trong body + đúng status giúp client tự động hoá retry — quan trọng cho API đối tác B2B của OTA.\n\n- Phần dựng thật: từ use case ra resource và đặt tên URI (17-rest-api-design.modelling-resources-uris.q1), rồi ánh xạ hành động không phải CRUD như cancel/refund vào REST (17-rest-api-design.modelling-resources-uris.q2).\n:::","difficulty":"core"},{"id":"04-rest-grpc-webflux.protocols.q2","q":"REST vs gRPC — khác biệt và khi nào dùng cái nào?","a":"<table class=\"cmp\"><thead><tr><th></th><th>REST/JSON</th><th>gRPC</th></tr></thead><tbody>\n<tr><td>Định dạng</td><td>text (JSON)</td><td>binary (Protobuf)</td></tr>\n<tr><td>Transport</td><td>HTTP/1.1-2</td><td>HTTP/2 multiplexing</td></tr>\n<tr><td>Contract</td><td>OpenAPI (tuỳ chọn)</td><td>.proto sinh code</td></tr>\n<tr><td>Streaming</td><td>hạn chế (SSE)</td><td>4 kiểu, 2 chiều</td></tr>\n<tr><td>Hợp cho</td><td>public API, browser/mobile</td><td>nội bộ micro-service low-latency</td></tr>\n</tbody></table>\n\nThực tế, gateway dịch [[g:REST/JSON ở edge]] sang gRPC cho một số call nội bộ là topology phổ biến, không phải luật.\n\nBrowser support, public tooling, proxy, streaming, observability, ranh giới tổ chức hoặc contract governance có thể khiến hệ thống dùng REST end-to-end, gRPC kèm grpc-web/transcoding ở edge, hoặc protocol khác.\n\nChọn theo từng boundary và contract đã đo; gRPC khó dùng trực tiếp từ browser nếu không có grpc-web hoặc proxy.\n\n:::tip Chốt\nREST thường hợp với public edge và gRPC thường hợp với một số call nội bộ low-latency/streaming, nhưng boundary phụ thuộc workload và tổ chức. Protobuf hỗ trợ evolution tương thích khi tuân thủ rule của field number.\n:::\n\n:::deep\n- Wire representation của Protobuf có thể giảm byte hoặc CPU với một số schema, nhưng kết quả phụ thuộc payload, compression, runtime và client/library; phải benchmark đúng path deploy trước khi kết luận.\n- evolution an toàn vẫn phụ thuộc rule field number: thêm field tương thích và không reuse hoặc đổi nghĩa number đã xoá.\n- [[r:Bẫy]]: gRPC khó từ browser (grpc-web/Envoy); L7 load-balancing cần proxy hiểu HTTP/2 (sticky stream)\n- phải truyền deadline qua mọi hop và chỉ retry khi có policy idempotency rõ ràng cùng budget hữu hạn (15-network-i-o-models.web-protocols.q2), (17-rest-api-design.contracts-errors-lifecycle.q4)\n- Đào sâu OTA: gateway REST ra đối tác/B2C, gRPC nội bộ giữa search/pricing/inventory để giảm latency &amp; tải\n:::","difficulty":"core"},{"id":"04-rest-grpc-webflux.protocols.q3","q":"Các kiểu streaming của gRPC?","a":"Bốn kiểu:\n- [[b:unary]] (1-1)\n- [[b:server-streaming]] (1 request → nhiều response)\n- [[b:client-streaming]] (nhiều request → 1 response)\n- [[b:bidirectional]] (2 chiều đồng thời)\n\nHợp cho large data feed, telemetry, chat, real-time sync.\n\n<table class=\"cmp\"><thead><tr><th>Kiểu</th><th>Chữ ký</th><th>Dùng cho</th></tr></thead><tbody>\n<tr><td>Unary</td><td>1 request → 1 response</td><td>gọi RPC thông thường</td></tr>\n<tr><td>Server-streaming</td><td>1 → N</td><td>trả kết quả dần: tìm chuyến, tail log</td></tr>\n<tr><td>Client-streaming</td><td>N → 1</td><td>upload theo lô, đẩy metrics</td></tr>\n<tr><td>Bidirectional</td><td>N ↔ N</td><td>chat, đồng bộ hai chiều, điều khiển real-time</td></tr>\n</tbody></table>\n\n:::deep\n- [[g:server-streaming]]: trả nhiều kết quả dần (vd stream kết quả tìm chuyến bay — hãng nào về trả tới đó → UX nhanh hơn chờ gom hết)\n- [[g:client-streaming]]: upload/batch metrics\n- [[g:bidirectional]]: real-time sync/chat\n- streaming dùng HTTP/2 flow control để giới hạn byte đang bay, nhưng write return ở framework không chứng minh peer đã nhận data\n- deadline hết hạn hoặc cancellation có thể để lại partial work, nên phải propagate/check cancellation trong application code và định nghĩa semantics retry/idempotency (15-network-i-o-models.web-protocols.q2), (17-rest-api-design.contracts-errors-lifecycle.q4)\n\n- [[r:Bẫy]]: stream dài giữ connection resource → đặt deadline/timeout; leak nếu client bỏ đi mà server không phát hiện cancel\n- nếu chỉ 1 request-1 response thì unary đơn giản hơn — đừng dùng streaming chỉ vì 'nghe hay'\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.protocols.q4","q":"Chiến lược versioning API để không phá client?","a":"- [[b:URI versioning]] (`/v1/...`) — rõ ràng, phổ biến\n- [[b:Header/media-type versioning]] — sạch URL nhưng khó debug hơn\n\n**Nguyên tắc:**\n- thay đổi [[g:backward-compatible]] (thêm field optional) → không cần version mới\n- phân loại thay đổi dựa trên client thật: thêm field có thể tương thích, còn đổi nghĩa, xoá field hoặc đổi error semantics có thể là [[r:breaking]]\n- URI hoặc header version chỉ là tín hiệu route; contract check, observability của client, rollout song song và deprecation policy mới làm việc khai tử an toàn\n\n:::deep\n- ưu tiên [[g:backward-compatible evolution]]: thêm field optional, không đổi nghĩa field cũ, không xoá field đang dùng (tolerant reader)\n- khi buộc breaking: chạy song song `/v1` và `/v2`, deprecation policy (header `Sunset`, thông báo đối tác, thời hạn)\n- URI versioning dễ debug/route nhất cho public API; header/media-type sạch URL nhưng khó test. Không strategy nào tự làm schema incompatible trở nên an toàn.\n\nĐào sâu OTA B2B: đối tác đổi chậm → support version cũ lâu; dùng *consumer-driven contract test* (Pact) để biết ai còn dùng field nào trước khi xoá.\n\n- Quy trình khai tử một version thật sự — thông báo, header `Sunset`, đo xem còn ai gọi rồi mới tắt (17-rest-api-design.contracts-errors-lifecycle.q4).\n:::","difficulty":"core"},{"id":"04-rest-grpc-webflux.protocols.q5","q":"Thiết kế pagination/filtering cho API danh sách lớn?","a":"Dùng [[g:cursor/keyset pagination]] khi workload có total order ổn định (cột tuần tự cộng unique id) và chỉ cần next/previous. OFFSET lớn có thể chậm dần và bị drift khi row thay đổi, nhưng nhu cầu nhảy trang tuỳ ý hoặc token của search engine có thể cần strategy khác.\n\nTrả kèm cursor 'next'. Filtering/sorting [[o:whitelisted]] để tránh injection và query không index.\n\n:::deep\n- OFFSET lớn scan-rồi-bỏ N dòng → chậm tuyến tính + 'trượt' khi data thay đổi giữa các trang\n- [[g:keyset/cursor]] dựa cột tuần tự + tie-breaker id: `WHERE (created_at,id) &lt; (?,?) ORDER BY created_at DESC,id DESC LIMIT n` → ổn định &amp; nhanh, dùng index tốt\n- trả cursor encoded (opaque) kèm policy expiry/freshness; bind cursor với filter, sort và tenant scope, reject cursor invalid/expired. Filter/sort phải whitelist.\n\n- OTA: danh sách booking/transaction (read-heavy) nên keyset + covering index; tránh `COUNT(*)` tổng đắt\n- [[r:Hạn chế keyset]]: không nhảy thẳng 'trang N' (chỉ next/prev). Cần nhảy trang tuỳ ý thì dùng offset/page number hoặc *search_after* của Elasticsearch; với data đang mutate, phải document freshness/snapshot semantics vì order ổn định một mình không bảo đảm snapshot lặp lại.\n- Phía DB của chính bài này: vì sao `COUNT(*)` đắt và keyset pagination chạy ra sao trên table vài chục triệu dòng (18-query-optimization.rewriting-the-query-reshaping-the-model.q2).\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.protocols.q6","q":"GraphQL vs REST — khi nào hợp?","a":"[[g:GraphQL]]: client tự chọn field, gộp nhiều resource trong 1 query → giảm over/under-fetching, hợp UI phức tạp/nhiều client.\n\nĐổi lại:\n- [[r:caching khó hơn]]\n- rủi ro query nặng (cần depth/complexity limit)\n- N+1 ở resolver (cần batching/identity-map có chủ đích; DataLoader là tool phổ biến, không phải yêu cầu của spec)\n\nREST đơn giản, HTTP cache tốt hơn cho phần lớn CRUD.\n\n<table class=\"cmp\"><thead><tr><th></th><th>REST</th><th>GraphQL</th></tr></thead><tbody>\n<tr><td>Ai chọn field</td><td>server</td><td>client</td></tr>\n<tr><td>Round-trip cho màn phức tạp</td><td>nhiều</td><td>một</td></tr>\n<tr><td>Cache HTTP/CDN</td><td>sẵn có: ETag, TTL</td><td>phải tự làm: persisted query</td></tr>\n<tr><td>Giới hạn tải</td><td>theo endpoint</td><td>theo độ sâu và cost của query</td></tr>\n<tr><td>N+1</td><td>ở tầng DB</td><td>thêm một tầng ở resolver; dùng batching/identity-map có chủ đích</td></tr>\n<tr><td>Hợp với</td><td>API công khai, B2B, CRUD</td><td>app nhiều client, UI ghép nhiều nguồn</td></tr>\n</tbody></table>\n\n:::deep\n- GraphQL: generic HTTP cache khó hơn vì query shape quan trọng (persisted query và query-aware cache có thể hỗ trợ), còn query nặng/đệ quy sâu cần depth/complexity limit và rate-limit theo cost.\n- N+1 ở resolver cần batching có chủ đích hoặc data-access plan tương đương; không bắt buộc một library cụ thể.\n- REST: cache tốt (CDN/ETag), đơn giản, status code rõ\n\nĐào sâu OTA: GraphQL hợp mobile/web app gộp nhiều nguồn (chuyến + giá + ghế + loyalty) trong 1 round-trip; nhưng API đối tác B2B + webhook vẫn nên REST. [[r:Đừng dùng cho CRUD đơn giản]] — chi phí vận hành không xứng.\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.protocols.q7","q":"Làm sao benchmark REST và gRPC công bằng, và flow control thực sự bảo vệ điều gì?","a":"Đừng biến một quan sát về tốc độ serialize thành hệ số đúng cho mọi hệ thống. Hai đường đi phải dùng cùng workload: unary hay streaming, phân bố kích thước payload, compression, TLS, reuse connection, concurrency, ngôn ngữ client/server, giới hạn CPU và mục tiêu p50/p95/p99.\n\nHãy đo goodput, số byte trên wire, CPU/GC, thời gian xếp hàng, cancellation và error rate trong cùng topology.\n\nProtobuf và HTTP/2 có thể giúp cuộc gọi nội bộ, nhưng gateway translation, proxy, message nhỏ hoặc downstream bottleneck có thể chi phối toàn bộ kết quả. Benchmark thiếu các điều kiện này chỉ là quan sát cục bộ, không phải quy tắc kiến trúc.\n\nVới streaming, HTTP/2 flow control giới hạn số byte đang bay trên từng stream và connection; nó không phải durable queue và không đảm bảo delivery. Write được framework chấp nhận vẫn có thể chỉ đang nằm trong buffer.\n\nCần application buffer có giới hạn, deadline rõ ràng, propagation của cancellation và cách đọc không gây deadlock ở bidirectional stream.\n\n:::tip Phân định nội dung\nDùng q3 cho bốn dạng streaming và 15-network-i-o-models.web-protocols.q2 cho hành vi transport. Chọn protocol dựa trên bằng chứng đo được và operational surface nhỏ nhất đáp ứng contract.\n:::","difficulty":"advanced"}]},{"title":"Reactive / WebFlux","items":[{"id":"04-rest-grpc-webflux.reactive-webflux.q1","q":"Lập trình reactive (WebFlux): Mono/Flux, event loop và backpressure là gì?","a":"WebFlux dựa trên Reactor:\n- [[b:Mono]] (0-1 element), [[b:Flux]] (0-N)\n- xử lý *non-blocking* trên ít event-loop thread (Netty)\n- khi không có data, thread không bị giữ → chịu tải I/O cao với ít thread\n\n[[g:Backpressure]]: consumer chậm báo cho producer 'gửi vừa thôi' (`request(n)`), tránh tràn memory — đặc trưng của reactive streams mà blocking model không có sẵn.\n\n:::warn Bẫy\nchỉ cần một blocking call trong chuỗi reactive là [[r:chặn event-loop thread đang xử lý task đó]]. Đủ nhiều call như vậy sẽ làm nghẽn capacity và sập tail latency; nên non-blocking xuyên suốt (R2DBC driver, WebClient...) hoặc cô lập blocking work rõ ràng.\n:::\n\n:::deep\n- Reactor có cả [[b:cold publisher]] và hot publisher. Nhiều factory chain lazy/cold tới khi subscribe, còn shared sink, processor và một số adapter có thể hot. [[r:quên subscribe = cold chain không chạy]]; cần biết source và sharing policy trước khi suy luận execution.\n- `flatMap` chạy concurrent không giữ thứ tự; `concatMap` giữ thứ tự sequential\n- backpressure strategy khi quá tải: buffer/drop/latest/error\n- `publishOn` (đổi downstream thread) vs `subscribeOn` (đổi source thread)\n\n[[r:Bẫy chí mạng]]: blocking call (JDBC, `RestTemplate`) chặn Netty event-loop thread được assign cho nó; đủ nhiều worker bị chặn sẽ làm nghẽn request khác và tail latency.\n\nƯu tiên dependency non-blocking (R2DBC, WebClient), hoặc dùng `subscribeOn(boundedElastic)` kèm giới hạn queue, deadline và concurrency để cô lập blocking work bắt buộc.\n\nĐào sâu: reactive stack trace khó đọc → bật `Hooks.onOperatorDebug()`/checkpoint khi debug.\n\n**Bằng chứng chạy được rằng blocking call đã rời event loop:**\n<pre><code>@Test\nvoid blockingWorkUsesBoundedElastic() {\n  Mono&lt;String&gt; result = Mono.fromCallable(() -&gt; {\n        Thread.sleep(20);                 // đại diện cho JDBC blocking\n        return Thread.currentThread().getName();\n      })\n      .subscribeOn(Schedulers.boundedElastic())\n      .timeout(Duration.ofMillis(200));\n  StepVerifier.create(result)\n      .assertNext(name -&gt; assertThat(name).contains(\"boundedElastic\"))\n      .verifyComplete();\n}\n# thêm reactor-test rồi chạy test bằng Maven hoặc Gradle</code></pre>\n\nĐặt `subscribeOn` ngay sau blocking source; đặt muộn hơn có thể để subscription work chạy trên event loop.\n\n- **Ưu điểm:** Netty worker vẫn rảnh để phục vụ I/O.\n- **Giới hạn:** `boundedElastic` chuyển và giới hạn blocking work; nó không biến JDBC thành non-blocking. Queue vẫn có thể bão hòa, nên cần deadline, giới hạn concurrency xuống downstream và metric pending work.\n:::","difficulty":"advanced"},{"id":"04-rest-grpc-webflux.reactive-webflux.q2","q":"Reactive (WebFlux) vs Virtual Threads — năm 2025–2026 nên chọn gì?","a":"Ba cách xử lý 'nhiều I/O với ít OS thread':\n\n<table class=\"cmp\"><thead><tr><th></th><th>WebFlux (Reactor)</th><th>Vert.x</th><th>Virtual Threads</th></tr></thead><tbody>\n<tr><td>Mô hình</td><td>reactive streams</td><td>event loop + callback/Future</td><td>blocking-style, JVM unmount khi I/O hỗ trợ</td></tr>\n<tr><td>Code</td><td>Mono/Flux, khó đọc</td><td>callback/Verticle, dễ callback hell</td><td>tuần tự, dễ đọc nhất</td></tr>\n<tr><td>Backpressure</td><td>có sẵn (request(n))</td><td>thủ công (pause/resume/fetch)</td><td>không có demand signal kiểu reactive; dùng queue/semaphore có giới hạn</td></tr>\n<tr><td>Blocking code</td><td>không an toàn trên event loop; phải cô lập</td><td>không an toàn trên event loop → executeBlocking/worker</td><td>blocking I/O được hỗ trợ; vẫn phải giới hạn CPU, pinning và downstream</td></tr>\n<tr><td>Ecosystem</td><td>Spring reactive</td><td>Vert.x riêng, polyglot</td><td>reuse JDBC/Hibernate</td></tr>\n<tr><td>Debugging</td><td>operator context/checkpoint; async trace cần kỷ luật</td><td>event-loop context và async trace</td><td>stack tuần tự dễ đọc, nhưng phải kiểm tra pinning và executor saturation</td></tr>\n</tbody></table>\n\nSpring Boot không phải mô hình I/O thứ tư: nó packaging và cấu hình Spring MVC hoặc WebFlux.\n\nVới release Spring Boot có hỗ trợ feature (ví dụ Boot 3.2+ trên Java 21+), `spring.threads.virtual.enabled=true` có thể cho nhánh Servlet/Tomcat/Jetty dùng virtual thread; nó không biến MVC thành WebFlux.\n\n**Quyết định cho 2025–2026:** chọn theo workload và dependency contract, không theo bảng xếp hạng phổ biến:\n- Spring MVC imperative + JDBC/JPA, chủ yếu request-response và chờ I/O → thử MVC + virtual threads rồi đo\n- client/driver non-blocking xuyên suốt, streaming hoặc có reactive demand contract thật → WebFlux\n- cần kiểm soát event loop/multi-reactor rõ ràng, service polyglot hoặc tích hợp Vert.x → Vert.x\n\n:::tip Chốt\nChọn theo dependency và semantics:\n- virtual threads làm code blocking request-response dễ viết\n- WebFlux làm reactive stream và backpressure tường minh\n- Vert.x cho quyền kiểm soát event loop/toolkit trực tiếp\n\nKhông mô hình nào bỏ được việc giới hạn DB connection, HTTP concurrency, broker consumer hay quota partner.\n:::\n\n:::deep\n- [[b:WebFlux & Vert.x]] cùng dựa trên [[o:event-loop]]: blocking call chặn event-loop thread đang xử lý task đó; đủ nhiều worker bị chặn sẽ [[r:làm nghẽn service]]. Cô lập bằng scheduler có giới hạn, `executeBlocking`, worker verticle hoặc executor rõ ràng.\n- Vert.x nhẹ, polyglot, có distributed event-bus — mạnh cho gateway/high-throughput; nhưng callback/Future style dễ [[r:callback hell]] (giảm bằng RxJava/Mutiny)\n- Reactor cho *streaming composition* (time/window operator) + backpressure có sẵn; Vert.x backpressure phải làm tay (`ReadStream.pause/resume/fetch`)\n- [[g:Virtual threads]] cho phép viết code blocking tuần tự và dùng lại JDBC/Hibernate. Nó không có reactive demand signal, nên phải dùng connection pool, semaphore, queue có giới hạn và deadline để bảo vệ tài nguyên khan hiếm\n\n- với Kafka/RabbitMQ, threading của listener và semantics broker là hai chuyện riêng: Spring listener có thể dùng platform hoặc virtual thread, còn callback Vert.x đến trên event loop\n- Kafka ghi nhận xử lý bằng committed offset; RabbitMQ bằng consumer ack. Cả hai không đồng nghĩa business đã xong nếu không đặt sau side effect idempotent\n\nGiữ reactive/Vert.x cho stream, backpressure hoặc event-loop contract thật; dùng MVC/virtual threads khi dependency blocking imperative khiến mô hình đơn giản an toàn hơn. Quy tắc chung vẫn là: [[r:không bao giờ block event loop]].\n:::","difficulty":"advanced"},{"id":"04-rest-grpc-webflux.reactive-webflux.q3","q":"Reactor: xử lý lỗi và một số operator thường dùng?","a":"**Operator:** `map/flatMap` (transform/chain), `zip` (gộp), `filter`, `retryWhen` (retry có backoff), `timeout`.\n\n**Error:** `onErrorResume` (fallback), `onErrorMap` (đổi exception), `doOnError` (side-effect log).\n\n[[o:Error lan theo chuỗi]] → phải đặt handler đúng chỗ.\n\n:::deep\n- `onErrorResume` (fallback bằng publisher khác — vd giá cache khi GDS lỗi)\n- `onErrorReturn` (default value); `onErrorMap` (đổi sang domain exception)\n- `retryWhen(Retry.backoff(n, duration).jitter(...))` (backoff+jitter, lọc loại lỗi retry được)\n- `timeout` + fallback tránh treo; `doOnError` chỉ side-effect (log), không xử lý\n- kết hợp resilience4j (circuit breaker/bulkhead) ở tầng reactive\n\nĐào sâu: fan-out nhiều GDS song song → `flatMap` + per-call timeout + `onErrorResume(empty)` để [[g:'một hãng lỗi không kéo sập cả tìm kiếm']].\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.reactive-webflux.q4","q":"WebSocket vs SSE — chọn cho real-time thế nào?","a":"<table class=\"cmp\"><thead><tr><th></th><th>SSE</th><th>WebSocket</th></tr></thead><tbody>\n<tr><td>Chiều</td><td>1 chiều server→client</td><td>full-duplex 2 chiều</td></tr>\n<tr><td>Transport</td><td>HTTP (text/event-stream)</td><td>ws:// (upgrade từ HTTP)</td></tr>\n<tr><td>Reconnect</td><td>tự động (Last-Event-ID)</td><td>phải tự code</td></tr>\n<tr><td>Hợp cho</td><td>feed, notification, push giá</td><td>chat, collaborative, game</td></tr>\n</tbody></table>\n\nChọn theo nhu cầu 2 chiều: [[g:SSE rẻ và dễ hơn]] nếu chỉ cần push.\n\n:::deep\n- SSE 1 chiều, auto-reconnect với `Last-Event-ID` để resume — đủ cho 'push giá/ghế/booking status realtime'\n- [[r:Bẫy SSE]]: giới hạn connection mỗi origin của browser trên HTTP/1.1 (thường là sáu) phụ thuộc user-agent; HTTP/2 thay đổi constraint, còn proxy buffering vẫn có thể chặn stream.\n- hãy test đúng browser, HTTP version và proxy trước khi đặt connection budget (khi phù hợp thì tắt buffering ở Nginx).\n- [[r:Bẫy WebSocket]]: không tự reconnect (client tự code &amp; khôi phục state), cần heartbeat ping/pong phát hiện dead connection, idle-timeout của LB/proxy cắt connection im lặng &#8594; giữ ping định kỳ\n- scale: chỉ cần sticky khi connection state nằm local. Shared pub/sub hoặc session/resume state externalized có thể bỏ dependency này; hãy test LB routing và hành vi reconnect (xem 16.9).\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.reactive-webflux.q5","q":"Contract-first với OpenAPI/Protobuf mang lại lợi ích gì?","a":"Định nghĩa [[g:API contract]] trước (OpenAPI cho REST, .proto cho gRPC):\n- sinh client/server stub, mock, contract test\n- team FE/BE làm song song\n- giảm lệch hiểu\n\nContract là ngôn ngữ chung giữa BA/FE/designer.\n\n:::deep\n- contract-first → 'ngôn ngữ chung' BE/FE/đối tác: sinh stub, mock server, *contract test* bắt breaking change trong CI trước deploy\n- FE/BE làm song song dựa trên spec; versioning &amp; docs tự sinh (Swagger UI)\n- OTA/B2B: spec là cam kết; dùng *consumer-driven contract* (Pact) để biết đối tác phụ thuộc field nào trước khi đổi\n\n[[r:Bẫy]]: spec lệch code nếu generate một chiều rồi sửa tay.\n\n**Gate contract-first nên:**\n- lint schema và chạy breaking-change check\n- compile generated client/server\n- chạy provider/consumer contract test\n- chạy runtime integration test\n\nHoặc generate từ spec, hoặc fail khi generated output stale.\n\n- Contract chính là [[g:Published Language]] theo nghĩa DDD — ngôn ngữ chung ở biên giữa hai bounded context, nên phải được đối xử như một hợp đồng chứ không sửa tuỳ hứng (24-domain-driven-design.strategic-splitting-the-domain.q3).\n- Vòng đời của contract sau khi ký: thêm field optional thì không phá ai; đổi nghĩa hay xoá field thì phải qua quy trình khai tử có `Sunset` và đo xem còn ai gọi (17-rest-api-design.contracts-errors-lifecycle.q4).\n:::","difficulty":"extra"},{"id":"04-rest-grpc-webflux.reactive-webflux.q6","q":"Làm sao giữ reactive service an toàn khi downstream hoặc stream chậm hơn producer?","a":"Backpressure là tín hiệu để giảm demand, không phải giấy phép tạo một queue vô hạn. Đặt giới hạn cho mọi buffer và concurrency gate, sau đó chọn rõ contract khi overflow:\n- chờ trong deadline\n- chỉ drop dữ liệu được phép bỏ\n- trả kết quả degraded\n- reject bằng lỗi có thể retry\n\nPhải propagate cancellation khi client disconnect hoặc deadline hết hạn.\n\nMột reactive operator có thể truyền đúng signal nhưng adapter, broker client, database pool hay bounded-elastic scheduler vẫn có thể đầy; hãy đo queue depth, pending demand, in-flight work, downstream latency, cancellation và số item bị drop/reject.\n\nTuyệt đối không block event loop để biến dependency chậm thành xử lý synchronous. Đưa blocking work bắt buộc sang bounded scheduler, giới hạn queue và bảo vệ dependency bằng bulkhead.\n\nNếu consumer cần lịch sử có thể đọc lại thay vì live flow control, hãy dùng durable cursor hoặc job contract, đừng dựa vào live stream.\n\n:::deep\n<code>request(n)</code> điều khiển demand giữa các reactive publisher; nó không tự làm cho database, network hay business side effect có thể cancel. Semantics của cancellation và partial work phải nằm trong contract của adapter.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"04-rest-grpc-webflux","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.fra