{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},"meta":{"topic_type":"platform","key":"21-linux-production-debug","vi":{"label":"Linux & production debug","title":"Linux & production troubleshooting — chẩn đoán khi đang cháy","intro":"Thứ phân biệt người đọc tài liệu với người từng trực sự cố. Server chậm thì gõ lệnh gì trước, load average nói lên điều gì, hết file descriptor trông ra sao, và cách đọc thread dump / heap dump / profile của một JVM đang chạy trên production mà không làm nó tệ thêm.","tags":["load average","iowait / steal","file descriptor","OOM killer","thread dump","heap dump","async-profiler","tcpdump"]},"en":{"label":"Linux & production debug","title":"Linux & production troubleshooting — diagnosing while it burns","intro":"What separates someone who read the docs from someone who has been on call. Which command you type first when a server crawls, what load average is really telling you, what running out of file descriptors looks like, and how to read a thread dump, heap dump or profile of a live production JVM without making things worse.","tags":["load average","iowait / steal","file descriptor","OOM killer","thread dump","heap dump","async-profiler","tcpdump"]},"created_at":"2026-07-31","updated_at":"2026-10-26"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"21-linux-production-debug.jvm-network-deep-dive-on-prod.q3":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q5":"2026-08-23","21-linux-production-debug.diagnosing-the-system.q1":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q2":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q3":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q4":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q1":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q2":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q4":"2026-09-12"},"lang":"en","body":{"sections":[{"title":"Diagnosing the system","items":[{"id":"21-linux-production-debug.diagnosing-the-system.q1","q":"A server suddenly becomes slow: which commands do you run in the first 60 seconds?","a":"This repository's first-minute checklist is deliberately ordered — each command rules out a category of causes. The order follows Brendan Gregg's \"Linux Performance Analysis in 60,000 Milliseconds\" (Netflix Technology Blog, 2015); the commands are guidance, not a universal runbook:\n\n<pre><code>uptime                  <span class=\"c\"># 1/5/15-minute load averages — is the trend rising or falling?</span>\ndmesg | tail            <span class=\"c\"># OOM killer? hardware errors? packet drops?</span>\nvmstat 1                <span class=\"c\"># r (run queue), si/so (swap), us/sy/id/wa</span>\nmpstat -P ALL 1         <span class=\"c\"># one stuck core or the entire machine? (single-thread bottleneck)</span>\npidstat 1               <span class=\"c\"># which process is consuming CPU, steadily or in bursts?</span>\niostat -xz 1            <span class=\"c\"># %util, await — is disk the bottleneck?</span>\nfree -m                 <span class=\"c\"># how much RAM remains, and how much is in buff/cache?</span>\nsar -n DEV 1            <span class=\"c\"># has network bandwidth reached its ceiling?</span>\nsar -n TCP,ETCP 1       <span class=\"c\"># retransmits and connection errors</span>\ntop                     <span class=\"c\"># one final overall view</span></code></pre>\n\nThe idea: within one minute, you know whether the bottleneck is in [[o:CPU, memory, disk, or the network]] — only then do you drill down in that direction.\n\n**Which reading sends you where:**\n\n<table class=\"cmp\"><thead><tr><th>First signal</th><th>Points to</th><th>Drill down with</th></tr></thead><tbody>\n<tr><td><code>vmstat</code> <code>r</code> stays above the core count</td><td>CPU saturation</td><td><code>mpstat -P ALL</code> for one hot core, <code>pidstat 1</code> for the process, then a profile</td></tr>\n<tr><td>high load with idle CPU; <code>b</code> or <code>wa</code> up</td><td>tasks blocked in D state, usually disk or NFS</td><td><code>iostat -xz 1</code>: <code>await</code> and <code>aqu-sz</code>, not <code>%util</code> on SSD/NVMe</td></tr>\n<tr><td><code>si</code>/<code>so</code> nonzero, or OOM lines in <code>dmesg</code></td><td>memory pressure</td><td><code>free -m</code>, <code>/proc/pressure/memory</code>, the cgroup's <code>memory.events</code></td></tr>\n<tr><td><code>st</code> climbing on a cloud VM</td><td>the hypervisor is taking CPU</td><td>the instance's CPU credits or host; nothing inside the VM fixes it</td></tr>\n<tr><td><code>nr_throttled</code> rising in <code>cpu.stat</code></td><td>the container's CPU quota</td><td>the cgroup's <code>cpu.max</code>, not the host's idle CPU</td></tr>\n<tr><td>retransmits in <code>sar -n TCP,ETCP</code></td><td>the network or the peer</td><td><code>ss -ti</code> on the connection, then a capture</td></tr>\n</tbody></table>\n\nReading those counters correctly is (21-linux-production-debug.diagnosing-the-system.q2). Descriptor and port exhaustion has its own signature (21-linux-production-debug.diagnosing-the-system.q3), and the packet-level drill-down is (21-linux-production-debug.jvm-network-deep-dive-on-prod.q4).\n\n:::tip Interview answer\nYou do not need to memorize all ten commands. Articulate the [[g:diagnostic framework]] — *\"I first narrow it down to CPU / RAM / disk / network, then move into the JVM\"* — and add 3–4 concrete commands; that is convincing enough.\n:::\n\n:::deep\n- [[r:The biggest trap]]: jumping straight into the application when the cause lies in a lower layer (full disk, slow DNS, NTP drift, or a CPU-throttled container).\n- inside a [[o:container]], `top`/`free` often report **host** metrics rather than cgroup metrics → read `/sys/fs/cgroup/...` (`memory.max`, `cpu.stat`). A rising `nr_throttled` means CPU throttling — a symptom commonly misdiagnosed as 'the app is slow'.\n- `df -h` and `df -i`: a full disk [[r:and]] inode exhaustion both make applications fail in confusing ways; `df -i` is easy to forget\n- check time synchronization with `chronyc tracking` — clock drift breaks tokens, signatures, and every time-based calculation\n- modern tools such as `bpftop`, `execsnoop`, and `biolatency` (bcc/BPF) expose syscalls and per-process I/O latency without stopping anything\n- always compare against [[g:a baseline]]: 'load 8' is meaningless unless you know the normal value and the machine's core count\n\n**Make the scope explicit before interpreting a number.** A host view, a container/cgroup view, and a process view can disagree. In a container, capture the process identity and the cgroup files visible from that PID namespace before comparing the result with a host dashboard:\n\n<pre><code>pid=4127\nps -o pid,ppid,user,stat,etime,rss,vsz,cmd -p \"$pid\"\nreadlink /proc/\"$pid\"/ns/pid\ncat /proc/\"$pid\"/cgroup\ncat /sys/fs/cgroup/memory.events\ncat /sys/fs/cgroup/cpu.stat\ncat /proc/pressure/{cpu,io,memory}</code></pre>\n\nThe exact cgroup path and fields depend on cgroup v1/v2 and the runtime. Treat `memory.max`, `memory.current`, `memory.events`, `cpu.max`, `cpu.stat`, and PSI as runtime evidence; do not copy a host path into a container recipe.\n\n`jcmd`/`jstack` also require the target PID to be visible in the same PID namespace and normally require the same host and effective user. Record those boundaries with the command output.\n:::\n\n:::deep\n**What would change this answer** — state these before defending the design; each is an assumption the interviewer can ask you to justify, and a measurement that would falsify it:\n\n- The Linux distribution, kernel and cgroup mode, container runtime, Kubernetes version, JDK vendor and version, and cloud instance family — the commands and their defaults differ across them.\n- Whether the service is CPU-, I/O-, network- or dependency-bound under the incident workload, and which baseline or SLI proves it rather than assumes it.\n- The allowed diagnostic pause, artifact size, retention, access group and cleanup deadline for heap dumps, profiles and packet captures.\n- Which sysctl, file-descriptor and port settings are managed by systemd, the image, the node or the platform — and which you can actually change.\n- What falsifies the `-Xmx` and native-memory budget: a cgroup OOM with a stable heap, direct-buffer, thread or metaspace growth, or a runtime detection mismatch.\n- What falsifies a network diagnosis: packet evidence contradicting application errors, failures that are zone-specific, or retries hiding the original reset or timeout.\n:::","difficulty":"core"},{"id":"21-linux-production-debug.diagnosing-the-system.q2","q":"How should you interpret load average, iowait, and CPU steal?","a":"**Load average** — on Linux, it is [[r:not]] merely the \"number of processes waiting for CPU.\" Linux also counts processes in the [[b:D]] state (uninterruptible sleep — usually waiting on disk or NFS).\n\nThe consequence: [[o:high load with idle CPU]] means an I/O bottleneck, not a CPU shortage. This is a very common misreading.\n\nIt only becomes meaningful relative to the core count: a load of 8 on a 16-core machine is comfortable; on a 2-core machine, it is overloaded. Compare the 1/5/15-minute values to see whether the trend is [[g:rising or falling]].\n\n**Reading `vmstat 1`:**\n\n<pre><code>procs -----------memory---------- ---swap-- -----io---- --system-- ------cpu-----\n r  b   swpd   free   buff  cache   si   so    bi    bo   in   cs us sy id wa st\n 9  2      0 128360  22140 918224    0    0    12   840 4210 8830 71 12  5 10  2</code></pre>\n\n- [[b:r]] — tasks waiting for CPU. If it remains above the core count, the machine genuinely lacks CPU capacity.\n- [[b:b]] — tasks blocked on I/O\n- [[b:si/so]] — swap in/out. Any nonzero value is a [[r:red flag]] for a latency-sensitive service.\n- [[b:wa]] (iowait) — the CPU is idle *while* I/O remains pending\n- [[b:st]] (steal) — the hypervisor has taken CPU time to run another VM\n\n:::warn High iowait is not necessarily a problem\n`wa` says only, *\"the CPU is idle and some I/O is waiting.\"* High `wa` is normal on a machine running disk-heavy batch jobs. Conversely, `wa` = 0 does [[r:not]] mean the disk is healthy — if the CPU is 100% busy, time spent waiting for I/O is not counted in `wa`.\n:::\n\n:::deep\n- [[o:steal time]] (`st`) is a cloud-specific gotcha: when a shared instance (T-series burstable) exhausts its credits, `st` spikes and the application slows down while every internal metric looks 'normal'. On EC2 T2/T3, also inspect `CPUCreditBalance`.\n- Calling this out is a strong signal of production experience.\n- abnormally high context switches (`cs`) indicate too many threads or severe lock contention → correlate with a thread dump (21-linux-production-debug.jvm-network-deep-dive-on-prod.q1)\n- `%util` from `iostat` is [[r:misleading]] for SSDs/NVMe: they process many I/Os concurrently, so 100% `%util` does not necessarily mean saturation. Inspect [[g:`await` and `aqu-sz`]] instead of `%util`.\n- for Java services, swap policy is a [[o:runtime and platform decision]]: inspect node/container policy, cgroup limits, `swappiness`, and the JDK/runtime before changing it. Paging a latency-sensitive heap can amplify pauses, but do not turn one environment's policy into a universal Kubernetes claim.\n- pressure stall information (`/proc/pressure/{cpu,io,memory}`) is a modern signal that is far more interpretable than load average — mentioning it shows current operational knowledge\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.diagnosing-the-system.q3","q":"Running out of file descriptors or ephemeral ports: what are the symptoms and fixes?","a":"These are two different failures with the same symptom: a service runs normally for hours, then [[r:suddenly cannot accept or open any connections]].\n\n**File descriptor exhaustion**\n\n<pre><code>java.net.SocketException: Too many open files</code></pre>\n\nEvery socket, file, and pipe consumes an fd.\n\n<pre><code>ulimit -n                          <span class=\"c\"># soft limit for the current shell</span>\ncat /proc/&lt;pid&gt;/limits             <span class=\"c\"># ACTUAL limit for the running process</span>\nls /proc/&lt;pid&gt;/fd | wc -l          <span class=\"c\"># number currently in use</span>\nlsof -p &lt;pid&gt; | awk '{print $5}' | sort | uniq -c | sort -rn</code></pre>\n\nThe cause is almost always [[o:a leak]]: an `HttpClient`/`InputStream`/`Connection` that is never closed. Raising `ulimit` merely postpones the crash — you still have to find the leak.\n\n**Ephemeral port exhaustion**\n\n<pre><code>java.net.BindException: Cannot assign requested address</code></pre>\n\nThe client opens too many outbound connections. Do not assume a universal ephemeral range. Read `/proc/sys/net/ipv4/ip_local_port_range` (or the platform's equivalent); usable ports are constrained by local address, destination tuple, namespace, and kernel/runtime policy.\n\n<pre><code>ss -s                                        <span class=\"c\"># overview, including the TIME-WAIT count</span>\ncat /proc/sys/net/ipv4/ip_local_port_range\nss -tan state time-wait | wc -l</code></pre>\n\nThe usual culprit is [[r:creating a new client for every request]] instead of reusing a connection pool.\n\n`TIME_WAIT` duration and reuse behavior are kernel/version/configuration-sensitive; measure the states with `ss`, inspect the effective network policy, and use the target kernel documentation instead of assuming 60 seconds.\n\n:::deep\n- systemd [[r:ignores]] `/etc/security/limits.conf`; set `LimitNOFILE=` in the unit file instead. This explains the classic 'I already raised ulimit, but it still fails' incident.\n- in K8s, the fd limit comes from the image/runtime, not your shell — inspect `/proc/1/limits` inside the container\n- [[g:The root fix]] for ephemeral port exhaustion is connection pooling plus keep-alive. Share one `WebClient`/`HttpClient` across the application, not one per call.\n- `TIME_WAIT` is [[o:intentional]]: it lets delayed packets from an old connection expire. `tcp_tw_reuse`, port-range changes, and any reuse/tuning knob are kernel- and topology-sensitive; inspect the effective value and test the client path before changing them.\n- `tcp_tw_recycle` was removed because it breaks NAT — proposing it as a universal solution is a red flag.\n- distinguish them quickly: `Too many open files` = the local process exhausted its fds; `Cannot assign requested address` = source ports are exhausted; `Connection refused` = nothing is listening remotely; `Connection reset` = the peer closed abruptly\n- monitor proactively: export `process.files.open` / `process.files.max` to Prometheus and alert at 80% — this class of incident is entirely predictable\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.diagnosing-the-system.q4","q":"The OOM killer terminated a service: how do you trace the cause and prevent it?","a":"OOM has several failure boundaries; [[r:do not confuse them]]:\n\n<table class=\"cmp\"><thead><tr><th></th><th>Java OutOfMemoryError</th><th>Linux OOM killer</th></tr></thead><tbody>\n<tr><td>Who terminates it</td><td>the JVM throws an exception</td><td>the kernel sends SIGKILL</td></tr>\n<tr><td>Evidence</td><td>a stack trace in the application log</td><td><b>nothing</b> in the application log</td></tr>\n<tr><td>Where to look</td><td>application logs</td><td><code>dmesg</code>, <code>/var/log/syslog</code></td></tr>\n<tr><td>Cause</td><td>insufficient heap / a leak</td><td>total RSS exceeds the machine or cgroup limit</td></tr>\n</tbody></table>\n\n<pre><code>dmesg -T | grep -i -E \"oom|killed process\"\n<span class=\"c\"># Out of memory: Killed process 4127 (java) total-vm:9863244kB, anon-rss:6291456kB</span></code></pre>\n\nIn K8s, an OOM-terminated container is reported as `OOMKilled` with exit code [[b:137]] (128 + 9).\n\n**Why OOM can still occur when `-Xmx` is lower than RAM:** the heap is [[o:not]] the JVM's entire memory footprint. There is also metaspace, the code cache, thread stacks (~1MB/thread), direct ByteBuffers, and native-library memory.\n\n<pre><code>RSS ≈ Heap + Metaspace + CodeCache + (Threads × Stack) + Direct + Native</code></pre>\n\n**Start with a budget, not a universal percentage:**\n- `container_limit = heap + metaspace + code_cache + thread_stacks + direct/native + agents + safety_headroom`\n- `Xmx = container_limit - measured_nonheap - safety_headroom`\n\nA 50–70% `Xmx` value is only a labeled starting example for a measured workload, not a guarantee; validate it under peak traffic and the target JDK/container.\n\n:::deep\n- Java 10+ [[g:can detect the cgroup limit]] (`UseContainerSupport` is enabled by default in the documented JDK line), but that does not choose a safe application budget.\n- `-XX:MaxRAMPercentage` is one configurable starting point; derive the value from measured non-heap usage and headroom, then verify the effective flags on the target JDK.\n- older Java 8 releases [[r:do not recognize]] cgroups: the JVM sees all host RAM and sets its default heap to one quarter of that value → immediate OOMKilled. This is a classic failure when containerizing an old Java application.\n- use [[o:Native Memory Tracking]] to investigate memory outside the heap: `-XX:NativeMemoryTracking=summary`, then `jcmd &lt;pid&gt; VM.native_memory summary`\n- common off-heap leaks include direct ByteBuffers that are not released (Netty), thread pools that create unbounded numbers of threads, and `ZipInputStream`/native libraries that are not closed\n- always enable `-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dump` — [[g:without a dump, there is nothing to investigate]] (21-linux-production-debug.jvm-network-deep-dive-on-prod.q2). Remember to mount a volume; a dump written to the container's ephemeral filesystem disappears with the container.\n- in K8s, set `requests` = `limits` for critical services (QoS Guaranteed) so they are not killed first when a node runs short of memory; `oom_score_adj` determines which process dies first\n- OOMKilled recurring at regular intervals indicates [[o:a leak]]; occurring specifically at peak load indicates [[o:underprovisioning]]. These are different conclusions with different fixes.\n\n**Evidence matrix for the failure boundary:**\n\n<table class=\"cmp\"><thead><tr><th>Failure</th><th>Scope</th><th>Evidence</th><th>Next check</th></tr></thead><tbody>\n<tr><td>Java heap OOME</td><td>JVM heap</td><td>exception, GC/live-set trend, optional heap dump</td><td>heap histogram, retained paths, allocation/GC history</td></tr>\n<tr><td>Metaspace/code-cache exhaustion</td><td>JVM non-heap</td><td>specific OOME text, class-loading/code-cache metrics</td><td>class-loader churn, generated code, target JDK flags</td></tr>\n<tr><td>Direct/native/thread exhaustion</td><td>JVM or native process RSS</td><td>NMT where covered, RSS/cgroup counters, thread count, exit evidence</td><td>direct-buffer limits, native libraries, thread creation, PID limits</td></tr>\n<tr><td>cgroup OOMKilled / exit 137</td><td>container cgroup</td><td><code>memory.events</code>, orchestrator reason, exit code 137, node/runtime event</td><td>peak RSS plus cgroup limit and sibling/container pressure</td></tr>\n<tr><td>kernel global OOM</td><td>host/node</td><td>kernel log, killed PID, global memory/swap/PSI evidence</td><td>node pressure, oom score, other workloads, reclaim policy</td></tr>\n</tbody></table>\n\nExit code 137 is evidence of SIGKILL, not proof of one specific memory source. Correlate the process, cgroup, node, timestamp, and runtime event before choosing a fix.\n:::","difficulty":"advanced"}]},{"title":"JVM & network deep-dive on prod","items":[{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q1","q":"How do you read a thread dump to find deadlocks and blocked threads?","a":"<pre><code>jcmd &lt;pid&gt; Thread.print &gt; td1.txt     <span class=\"c\"># recommended approach</span>\njstack -l &lt;pid&gt; &gt; td1.txt            <span class=\"c\"># equivalent; -l adds lock information</span></code></pre>\n\nTake [[g:three dumps 5–10 seconds apart]] — a single snapshot cannot distinguish \"running\" from \"stuck.\" A thread whose stack remains unchanged across all three is the likely culprit.\n\n**States to recognize:**\n\n<table class=\"cmp\"><thead><tr><th>State</th><th>Meaning</th><th>Concerning when</th></tr></thead><tbody>\n<tr><td><code>RUNNABLE</code></td><td>running (or waiting on network I/O)</td><td>many threads are stopped at the same line of compute code</td></tr>\n<tr><td><code>BLOCKED</code></td><td>waiting to enter <code>synchronized</code></td><td>many threads are waiting on the same monitor</td></tr>\n<tr><td><code>WAITING</code></td><td><code>wait()</code> or <code>park()</code> with no timeout</td><td>a thread waits indefinitely because nothing wakes it</td></tr>\n<tr><td><code>TIMED_WAITING</code></td><td>has a timeout</td><td>usually normal</td></tr>\n</tbody></table>\n\n**Deadlock** — the JVM detects it automatically and prints it explicitly at the end of the dump:\n\n<pre><code>Found one Java-level deadlock:\n=============================\n\"thread-A\": waiting to lock monitor 0x00007f8 (object 0x000000076ab, a java.lang.Object),\n  which is held by \"thread-B\"\n\"thread-B\": waiting to lock monitor 0x00007f9 (object 0x000000076ac, a java.lang.Object),\n  which is held by \"thread-A\"</code></pre>\n\n:::warn Common misreading\nA `RUNNABLE` thread at `socketRead0` is [[r:not]] consuming CPU — it is waiting on the network. The JVM cannot distinguish blocking I/O from computation here. Many `RUNNABLE` threads at `socketRead0` mean an external dependency is slow, not that the application is CPU-bound.\n:::\n\n:::deep\n- The most important pattern to recognize is [[o:dozens of `BLOCKED` threads on the same monitor]] → a contention bottleneck. Inspect the `- locked <0x...>` line to identify the owning thread, then read **its** stack — that is the code path you need to fix.\n- pool exhaustion is immediately visible in a dump: many `TIMED_WAITING` threads at `HikariPool.getConnection` → this is not a database failure; connections are being held too long elsewhere (18-query-optimization.rewriting-the-query-reshaping-the-model.q4)\n- `jcmd` is [[g:safer than]] `jstack` (no `-F` required and less risk of hanging the JVM). Forced `jstack -F` can pause the JVM for a long time — use it sparingly in production.\n- meaningful thread names (`booking-worker-3`) make a dump far easier to read than `pool-2-thread-7`. Name every custom thread pool.\n- deadlocks involving `ReentrantLock` are [[r:not]] always detected by the JVM as `synchronized` deadlocks are — use `jstack -l` to see `Locked ownable synchronizers`\n- analysis tools include fastThread.io, or use `jstack | grep -A3 \"java.lang.Thread.State\" | sort | uniq -c` for a quick count by state\n- virtual threads (23-java-concurrency-coding.async-the-modern-toolkit.q4) change the workflow: use `jcmd &lt;pid&gt; Thread.dump_to_file -format=json` to capture them all\n\n**JDK 21 attach boundary and impact:** `jcmd`/`jstack` commands are version-scoped to the JDK 21 tooling documented here. They normally require the same host and effective user, a PID visible in the same namespace, attach permissions, and enough output destination.\n\n`Thread.print` is a bounded snapshot but can still add work during a stressed incident; take spaced samples and record the target PID, user, namespace, and timestamp. Do not assume PID 1 in a container is the host JVM.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q2","q":"How do you use a heap dump to find the source of a memory leak?","a":"**Recognize the leak before taking a dump:** graph heap usage after each Full GC. Normal behavior is a sawtooth around a stable baseline; a leak produces [[r:a steadily rising sawtooth floor]] that eventually ends in OOM.\n\n<pre><code>jcmd &lt;pid&gt; GC.heap_info                      <span class=\"c\"># quick overview</span>\njcmd &lt;pid&gt; GC.class_histogram | head -30     <span class=\"c\"># low overhead and often enough for an initial diagnosis</span>\njcmd &lt;pid&gt; GC.heap_dump /dump/heap.hprof     <span class=\"c\"># full dump</span></code></pre>\n\n:::warn Heap dumps can pause the JVM\n`GC.heap_dump` causes a [[r:stop-the-world]] pause proportional to heap size — dumping an 8GB heap can stall the process for tens of seconds. In production, drain the instance from the load balancer first, or dump an instance that is leaking but is not serving traffic.\n:::\n\n**Analyze it with Eclipse MAT** — use these three views in order:\n\n1. [[g:Leak Suspects Report]] — MAT identifies likely suspects automatically and is correct in most cases\n2. [[g:Dominator Tree]] — sort by *retained heap* (memory that would be released if this object died), not *shallow heap*\n3. [[g:Path to GC Roots]] (exclude weak/soft references) — answers the most important question: [[o:what is retaining it]]\n\n**Classic Java leak patterns:**\n- a `static` Map/List used as a cache [[r:with no bound and no TTL]]\n- a registered listener/callback that is never unregistered\n- a `ThreadLocal` without `remove()` — pool threads live forever, so their values do too\n- a `ClassLoader` leak during hot redeployment (a classic Tomcat problem)\n- a `HashMap` key that does not implement `equals`/`hashCode` → prior entries are never found again and only accumulate\n\n:::deep\n- Distinguish [[o:shallow]] size (the object itself) from [[o:retained]] size (the entire object graph kept alive exclusively by it). Sorting by shallow size almost always leads to `char[]`/`byte[]` — correct but useless.\n- seeing `char[]`/`byte[]` at the top of the histogram is [[r:normal]]; the real questions are *which strings* and *what retains them* — only Path to GC Roots can answer those\n- compare [[g:two dumps taken a few hours apart]] (MAT can compare histograms) — growing objects are the suspects; objects that were already large are often innocent\n- with an [[o:off-heap]] leak, the heap dump looks completely clean while RSS keeps growing → switch to Native Memory Tracking (21-linux-production-debug.diagnosing-the-system.q4)\n- continuous JFR recording lets you investigate *after* an incident without reproducing it: `-XX:StartFlightRecording=disk=true,maxsize=1g,dumponexit=true`\n- a dump contains [[r:all live data]] held in memory — passwords, tokens, and customer information. Treat the `.hprof` file as sensitive data: encrypt it, restrict access, and delete it after analysis.\n\n**JDK 21 impact labels:**\n- `GC.class_histogram` is a lighter first probe but still walks heap state and can require a safepoint.\n- `GC.heap_dump` is a high-impact operation whose pause, dump size, free disk, and encryption/access path must be approved.\n\nBoth require attach/user/PID-namespace checks. Confirm the target JDK 21 command set and free space before running them; a failed dump can still consume disk or disturb the evidence window.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q3","q":"How safe are async-profiler and JFR for profiling in production?","a":"Both tools can be production-safe when the recording is bounded, the chosen events/frequency are understood, and you can stop or roll back quickly. “Low overhead” is a design goal, [[r:not a universal 1–3% guarantee]]—measure on the actual JDK, hardware, container limits, event set, and workload.\n\n**async-profiler 4.x** uses the `asprof` binary launcher (the old `profiler.sh` examples are obsolete):\n\n<pre><code>asprof -d 30 -e cpu   -f /tmp/cpu.html   &lt;pid&gt;  <span class=\"c\"># on-CPU samples</span>\nasprof -d 30 -e wall  -f /tmp/wall.html  &lt;pid&gt;  <span class=\"c\"># elapsed/waiting stacks</span>\nasprof -d 30 -e alloc -f /tmp/alloc.html &lt;pid&gt;  <span class=\"c\"># allocation samples</span>\nasprof -d 30 -e lock  -f /tmp/lock.html  &lt;pid&gt;  <span class=\"c\"># lock contention</span></code></pre>\n\nModern async-profiler releases avoid classic safepoint-only sampling and can show Java, native, kernel, GC, and JIT frames.\n\nThe implementation has evolved: newer 3.x/4.x releases introduced a binary launcher and VMStructs-based stack walking rather than relying on the old “AsyncGetCallTrace plus `-XX:+DebugNonSafepoints`” recipe as a timeless explanation. Read the matching release documentation.\n\n**JFR** is built into the JDK and records a broad event model:\n\n<pre><code>jcmd &lt;pid&gt; JFR.start name=diag settings=profile duration=60s filename=/tmp/r.jfr\njcmd &lt;pid&gt; JFR.check name=diag\njcmd &lt;pid&gt; JFR.dump name=diag filename=/tmp/r.jfr</code></pre>\n\n:::warn Start narrow during an incident\nEstablish disk/memory limits, duration, sampling interval, output path, data sensitivity, and attach permissions before profiling.\n:::\n\nStart with a short CPU or standard JFR recording, inspect service SLO/resource impact, then add allocation, wall-clock, lock, native-memory, or method-tracing events only for a hypothesis. Some modes can be materially more expensive than CPU sampling.\n:::deep\nChoose the event from the symptom:\n\n- high CPU → CPU samples; slow with idle CPU → wall-clock plus traces/queue/thread states;\n- GC pressure → allocation profile plus GC/JFR events and live-set evidence;\n- contention → lock/monitor events and thread dumps;\n- native/RSS growth → native-memory tooling, not only Java heap allocation.\n\nFlame-graph width is the number/weight of samples for the selected event, not automatically elapsed time. Compare the same settings with a healthy baseline, and inspect time range/heatmaps before assuming one aggregate plateau explains the incident.\n\nContainer profiling may require matching PID namespace, JVM attach permission, perf settings/capabilities, seccomp allowances, and writable output. Grant the minimum needed; `SYS_ADMIN` is broad and should not be a default recommendation.\n\nJFR collection still needs authorization to attach/control the target process even though JFR itself ships with the JDK.\n\nAlways-on JFR can provide pre-incident history, but set a low-overhead configuration, bounded disk/age, access controls, and redaction policy.\n\nVirtual-thread events differ by JDK: monitor pinning existed in JDK 21–23 and was removed in JDK 24, so interpret recordings against the target runtime (23-java-concurrency-coding.async-the-modern-toolkit.q4).\n\n**JDK 21 profiling/NMT labels:**\n- JFR `default`/`profile`, event set, duration, disk limit, and output path determine impact; “low overhead” is not a fixed number.\n- Native Memory Tracking must be enabled with its documented startup option and has overhead; `summary`/`detail` coverage is JVM-specific and does not account for every third-party/native allocation.\n\nFor both JFR and NMT, record JDK 21 version, PID namespace, effective user/attach permission, capability/seccomp requirements, disk budget, and stop condition.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q4","q":"How do tcpdump, ss, and netstat help debug networking between two services?","a":"When two services \"cannot talk to each other,\" you need to determine where the packets stop.\n\n**Check the connection first:**\n\n<pre><code>ss -tanp | grep :5432          <span class=\"c\"># connections to Postgres, including the process</span>\nss -tan state syn-sent         <span class=\"c\"># SYN sent with no reply =&gt; blocked by firewall/SG</span>\nss -ti dst 10.0.3.41           <span class=\"c\"># RTT, cwnd, and retransmits for each connection</span></code></pre>\n\n`ss` [[g:replaces `netstat`]] and is much faster on hosts with many connections — using `netstat` today signals outdated operational knowledge.\n\n**Capture packets when you need definitive evidence:**\n\n<pre><code>tcpdump -i any -nn 'host 10.0.3.41 and port 5432' -c 200 -w /tmp/c.pcap\ntcpdump -nn -r /tmp/c.pcap | head -40</code></pre>\n\n`-nn`, which disables DNS and port-name resolution, is [[o:important]]: resolution can hang the command when DNS itself is the problem.\n\n**Reading the result:**\n- repeated `SYN` packets with no `SYN-ACK` → traffic is [[r:being blocked]] (security group, NACL, or iptables), or the destination does not exist\n- `SYN` → immediate `RST` → [[r:nothing is listening]] on that port\n- the handshake completes, followed by a long silence → the peer received the request but is processing it slowly (an application problem, not a network problem)\n- `[R]` partway through → the peer closed abruptly, often because of an LB timeout or idle timeout\n\n:::deep\n- symptoms can distinguish these cases faster than a packet capture: [[o:hanging until the timeout]] means packets are being swallowed (firewall DROP); an [[o:immediate failure]] means an RST or ICMP-unreachable response arrived\n- `ss -s` shows total connections and `TIME-WAIT` (see 21.3); `ss -ti` shows `retrans` — high retransmissions mean there is a genuine network problem\n- [[r:The MTU trap]]: the connection opens and small requests succeed, but large requests hang → packet fragmentation or PMTU discovery is broken because ICMP is blocked. This is common with VPNs and K8s overlay networks, and very hard to recognize until you have seen it once.\n- in K8s, use `kubectl debug`/an ephemeral container to run `tcpdump` in the same network namespace without adding diagnostic tools to the production image\n- DNS: run `dig +short svc.ns.svc.cluster.local` and inspect `ndots:5` in `/etc/resolv.conf` — this setting can make each external-name lookup try 4–5 suffixes and is a common cause of 'mysterious slowness' on K8s\n- TLS payloads are encrypted, so `tcpdump` shows only the handshake — diagnose certificate/SNI issues with `openssl s_client -connect host:443 -servername host`\n- [[r:A pcap file contains real traffic data]]. Limit the capture with `-c`, use a narrow filter, and delete it after analysis.\n:::","difficulty":"extra"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q5","difficulty":"advanced","q":"How do you investigate a production latency incident without making the system worse?","a":"Start with the user-facing symptom and a time window, then collect the cheapest bounded evidence before changing anything: request/error/latency rate, saturation, queue age, database connections, GC pauses, file descriptors, socket states, retransmits, and dependency health.\n\n**A safe sequence:**\n1. Compare a healthy instance, an affected instance, and the dependency path. Establish whether the problem is local, shared, or traffic-shaped.\n2. Use low-overhead snapshots first: process/container metrics, three thread dumps separated by a few seconds, socket/connection state, and a bounded JVM/GC view.\n3. If profiling is justified, set duration, event set, output size, permission, and stop conditions. A short JFR or async-profiler capture is evidence, not a universal low-overhead guarantee.\n4. Take a heap dump only when the memory hypothesis warrants the pause, disk, privacy, and post-processing cost; capture metadata and protect the file.\n5. Use packet capture narrowly by interface, peer, port, and duration; redact or restrict payloads, and do not assume “no packets” means the application is healthy.\n\nChange one reversible variable at a time, record the expected signal, and keep the incident commander informed. Do not raise limits, restart every replica, enable verbose logging, or flush caches just to make a graph move; each can erase evidence or amplify the outage.\n\nAfter mitigation, compare the same SLI and resource window before/after, preserve command output and timestamps, and turn the confirmed failure mode into a regression or runbook test. A diagnosis that cannot be reproduced or bounded remains a hypothesis.\n\n**Artifact policy:** treat heap dumps, JFR recordings, profiler output, and pcaps as sensitive operational artifacts.\n\nBefore capture, name the owner, purpose, path/volume, maximum size, encryption/access group, retention deadline, and cleanup command.\n\nKeep only the minimum evidence, store it outside an ephemeral container filesystem when it must survive restart, log the artifact hash/creation time without logging secrets, and verify deletion after the incident.\n\n<table class=\"cmp\"><thead><tr><th>Symptom</th><th>Evidence first</th><th>Reversible action</th><th>Rollback/cleanup</th></tr></thead><tbody>\n<tr><td>CPU or run queue spike</td><td>PSI, per-core/process CPU, three thread dumps</td><td>bounded CPU/JFR recording or traffic shift</td><td>stop recording, restore traffic, compare same SLI window</td></tr>\n<tr><td>Heap floor rising</td><td>GC trend, histogram, live-set and RSS</td><td>drain one instance before heap dump</td><td>protect/delete dump per retention policy; restore instance only after evidence is safe</td></tr>\n<tr><td>Network timeout/reset</td><td><code>ss</code>, retransmits, narrow tcpdump, dependency SLI</td><td>capture bounded peer/port window or route one canary</td><td>stop capture, restrict/delete pcap, undo route change</td></tr>\n<tr><td>Telemetry or diagnostic pressure</td><td>collector queue, disk, memory, dropped evidence</td><td>reduce event set/rate and preserve critical signals</td><td>remove temporary config, reclaim disk, verify monitoring health</td></tr>\n</tbody></table>"}]}]},"hasVi":true,"stem":"21-linux-production-debug","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"distributed-rate-limiter","11-syste