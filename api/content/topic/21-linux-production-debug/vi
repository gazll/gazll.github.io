{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},"meta":{"topic_type":"platform","key":"21-linux-production-debug","vi":{"label":"Linux & production debug","title":"Linux & production troubleshooting — chẩn đoán khi đang cháy","intro":"Thứ phân biệt người đọc tài liệu với người từng trực sự cố. Server chậm thì gõ lệnh gì trước, load average nói lên điều gì, hết file descriptor trông ra sao, và cách đọc thread dump / heap dump / profile của một JVM đang chạy trên production mà không làm nó tệ thêm.","tags":["load average","iowait / steal","file descriptor","OOM killer","thread dump","heap dump","async-profiler","tcpdump"]},"en":{"label":"Linux & production debug","title":"Linux & production troubleshooting — diagnosing while it burns","intro":"What separates someone who read the docs from someone who has been on call. Which command you type first when a server crawls, what load average is really telling you, what running out of file descriptors looks like, and how to read a thread dump, heap dump or profile of a live production JVM without making things worse.","tags":["load average","iowait / steal","file descriptor","OOM killer","thread dump","heap dump","async-profiler","tcpdump"]},"created_at":"2026-07-31","updated_at":"2026-10-26"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"21-linux-production-debug.jvm-network-deep-dive-on-prod.q3":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q5":"2026-08-23","21-linux-production-debug.diagnosing-the-system.q1":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q2":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q3":"2026-09-12","21-linux-production-debug.diagnosing-the-system.q4":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q1":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q2":"2026-09-12","21-linux-production-debug.jvm-network-deep-dive-on-prod.q4":"2026-09-12"},"lang":"vi","body":{"sections":[{"title":"Chẩn đoán hệ thống","items":[{"id":"21-linux-production-debug.diagnosing-the-system.q1","q":"Server chậm bất thường: quy trình 60 giây đầu tiên gõ lệnh gì?","a":"Checklist first-minute của repository có thứ tự có chủ đích — mỗi lệnh loại trừ một nhóm nguyên nhân. Thứ tự theo bài \"Linux Performance Analysis in 60,000 Milliseconds\" của Brendan Gregg (Netflix Technology Blog, 2015); các lệnh là guidance, không phải runbook áp dụng chung:\n\n<pre><code>uptime                  <span class=\"c\"># load average 1/5/15 phút — xu hướng đang lên hay xuống?</span>\ndmesg | tail            <span class=\"c\"># OOM killer? lỗi phần cứng? drop packet?</span>\nvmstat 1                <span class=\"c\"># r (run queue), si/so (swap), us/sy/id/wa</span>\nmpstat -P ALL 1         <span class=\"c\"># một core kẹt hay cả máy? (single-thread bottleneck)</span>\npidstat 1               <span class=\"c\"># process nào ăn CPU, ổn định hay bùng phát?</span>\niostat -xz 1            <span class=\"c\"># %util, await — đĩa có phải nút thắt?</span>\nfree -m                 <span class=\"c\"># còn RAM không, buff/cache bao nhiêu</span>\nsar -n DEV 1            <span class=\"c\"># băng thông mạng đã đụng trần chưa</span>\nsar -n TCP,ETCP 1       <span class=\"c\"># retransmit, connection lỗi</span>\ntop                     <span class=\"c\"># nhìn tổng thể lần cuối</span></code></pre>\n\nÝ tưởng: trong một phút bạn biết được nút thắt nằm ở [[o:CPU, memory, đĩa hay mạng]] — rồi mới đào sâu đúng hướng đó.\n\n**Con số nào dẫn bạn đi đâu:**\n\n<table class=\"cmp\"><thead><tr><th>Tín hiệu đầu tiên</th><th>Chỉ về</th><th>Đào tiếp bằng</th></tr></thead><tbody>\n<tr><td><code>vmstat</code> <code>r</code> luôn cao hơn số core</td><td>CPU bão hoà</td><td><code>mpstat -P ALL</code> tìm một core nóng, <code>pidstat 1</code> tìm process, rồi profile</td></tr>\n<tr><td>load cao mà CPU rảnh; <code>b</code> hoặc <code>wa</code> tăng</td><td>task bị block ở D state, thường là đĩa hoặc NFS</td><td><code>iostat -xz 1</code>: <code>await</code> và <code>aqu-sz</code>, không dùng <code>%util</code> với SSD/NVMe</td></tr>\n<tr><td><code>si</code>/<code>so</code> khác 0, hoặc dòng OOM trong <code>dmesg</code></td><td>áp lực memory</td><td><code>free -m</code>, <code>/proc/pressure/memory</code>, <code>memory.events</code> của cgroup</td></tr>\n<tr><td><code>st</code> tăng trên VM cloud</td><td>hypervisor đang lấy CPU</td><td>CPU credit hoặc host của instance; không gì bên trong VM sửa được</td></tr>\n<tr><td><code>nr_throttled</code> tăng trong <code>cpu.stat</code></td><td>CPU quota của container</td><td><code>cpu.max</code> của cgroup, không phải CPU rảnh của host</td></tr>\n<tr><td>retransmit trong <code>sar -n TCP,ETCP</code></td><td>mạng hoặc phía peer</td><td><code>ss -ti</code> trên connection đó, rồi capture</td></tr>\n</tbody></table>\n\nĐọc đúng các counter đó là (21-linux-production-debug.diagnosing-the-system.q2). Cạn file descriptor và port có dấu hiệu riêng (21-linux-production-debug.diagnosing-the-system.q3), còn đào tới mức packet là (21-linux-production-debug.jvm-network-deep-dive-on-prod.q4).\n\n:::tip Trả lời phỏng vấn\nKhông cần thuộc lòng 10 lệnh. Nói được [[g:khung suy nghĩ]] — *\"em khoanh vùng CPU / RAM / đĩa / mạng trước, rồi mới vào JVM\"* — cộng 3–4 lệnh cụ thể là đủ thuyết phục.\n:::\n\n:::deep\n- [[r:Bẫy lớn nhất]]: nhảy thẳng vào ứng dụng khi nguyên nhân nằm ở tầng dưới (đĩa đầy, DNS chậm, NTP lệch, container bị throttle CPU).\n- trong [[o:container]], `top`/`free` thường hiện số của **host** chứ không phải của cgroup → đọc `/sys/fs/cgroup/...` (`memory.max`, `cpu.stat`). `nr_throttled` tăng nghĩa là bị CPU throttling — triệu chứng rất hay bị chẩn đoán nhầm thành 'app chậm'.\n- `df -h` và `df -i`: đĩa đầy [[r:và]] hết inode đều làm app hỏng theo kiểu khó hiểu; `df -i` hay bị quên\n- kiểm tra thời gian: `chronyc tracking` — đồng hồ lệch làm hỏng token, chữ ký và mọi phép tính thời gian\n- công cụ hiện đại: `bpftop`, `execsnoop`, `biolatency` (bcc/BPF) xem được cả syscall và latency I/O theo process mà không cần dừng gì\n- luôn so với [[g:baseline]]: 'load 8' vô nghĩa nếu không biết bình thường là bao nhiêu và máy có mấy core\n\n**Ghi rõ scope trước khi đọc một con số.** Số liệu ở host, container/cgroup và process có thể khác nhau. Trong container, hãy chụp identity của process và các file cgroup mà PID namespace đó nhìn thấy trước khi so với dashboard của host:\n\n<pre><code>pid=4127\nps -o pid,ppid,user,stat,etime,rss,vsz,cmd -p \"$pid\"\nreadlink /proc/\"$pid\"/ns/pid\ncat /proc/\"$pid\"/cgroup\ncat /sys/fs/cgroup/memory.events\ncat /sys/fs/cgroup/cpu.stat\ncat /proc/pressure/{cpu,io,memory}</code></pre>\n\nPath và field cgroup cụ thể phụ thuộc cgroup v1/v2 và runtime. Hãy coi `memory.max`, `memory.current`, `memory.events`, `cpu.max`, `cpu.stat` và PSI là evidence đọc từ runtime; đừng copy path của host vào recipe trong container.\n\n`jcmd`/`jstack` cũng thường yêu cầu PID đích nhìn thấy trong cùng PID namespace, cùng host và effective user. Ghi các boundary đó cùng output của lệnh.\n:::\n\n:::deep\n**Điều gì làm câu trả lời này đổi** — nêu trước khi bảo vệ thiết kế; mỗi dòng là một giả định người phỏng vấn có thể yêu cầu bạn biện minh, và một phép đo có thể bác bỏ nó:\n\n- Distribution Linux, kernel và chế độ cgroup, container runtime, version Kubernetes, vendor và version JDK, họ instance cloud — lệnh và default khác nhau giữa chúng.\n- Service bị giới hạn bởi CPU, I/O, mạng hay dependency dưới workload lúc sự cố, và baseline hay SLI nào chứng minh điều đó thay vì giả định.\n- Khoảng dừng chẩn đoán cho phép, kích thước artifact, retention, nhóm truy cập và hạn dọn dẹp cho heap dump, profile và packet capture.\n- Cấu hình sysctl, file descriptor và port nào do systemd, image, node hay platform quản lý — và cái nào bạn thật sự đổi được.\n- Điều gì bác bỏ ngân sách `-Xmx` và native memory: cgroup OOM khi heap ổn định, direct buffer, thread hay metaspace tăng, hoặc runtime nhận diện sai.\n- Điều gì bác bỏ chẩn đoán mạng: bằng chứng packet mâu thuẫn với lỗi ứng dụng, lỗi chỉ xảy ra theo zone, hoặc retry che mất reset/timeout gốc.\n:::","difficulty":"core"},{"id":"21-linux-production-debug.diagnosing-the-system.q2","q":"Load average, iowait và CPU steal: đọc thế nào cho đúng?","a":"**Load average** — trên Linux [[r:không phải]] chỉ là \"số process chờ CPU\". Linux tính cả process ở trạng thái [[b:D]] (uninterruptible sleep — thường là đang chờ đĩa/NFS).\n\nHệ quả: [[o:load cao mà CPU rảnh]] = đang nghẽn I/O, không phải thiếu CPU. Đây là chỗ rất nhiều người đọc sai.\n\nChia cho số core mới có nghĩa: load 8 trên máy 16 core là nhàn; trên máy 2 core là đang cháy. So ba con số 1/5/15 phút để biết [[g:đang lên hay đang hạ]].\n\n**Đọc `vmstat 1`:**\n\n<pre><code>procs -----------memory---------- ---swap-- -----io---- --system-- ------cpu-----\n r  b   swpd   free   buff  cache   si   so    bi    bo   in   cs us sy id wa st\n 9  2      0 128360  22140 918224    0    0    12   840 4210 8830 71 12  5 10  2</code></pre>\n\n- [[b:r]] — đang chờ CPU. Lớn hơn số core kéo dài = thiếu CPU thật.\n- [[b:b]] — đang chặn ở I/O\n- [[b:si/so]] — swap in/out. Khác 0 là [[r:cờ đỏ]] với service latency-sensitive.\n- [[b:wa]] (iowait) — CPU rảnh *nhưng* đang có I/O treo\n- [[b:st]] (steal) — hypervisor lấy CPU đưa cho VM khác\n\n:::warn iowait cao chưa chắc là vấn đề\n`wa` chỉ nói *\"CPU rảnh và có I/O đang chờ\"*. Máy chạy batch đọc đĩa nhiều thì `wa` cao là bình thường. Ngược lại `wa` = 0 [[r:không]] có nghĩa là đĩa ổn — nếu CPU đang bận 100% thì thời gian chờ I/O không được tính vào `wa`.\n:::\n\n:::deep\n- [[o:steal time]] (`st`) là đặc sản cloud: instance chia sẻ (T-series burstable) hết credit → `st` vọt lên, app chậm mà mọi metric nội bộ đều 'bình thường'. Trên EC2 T2/T3 phải xem thêm `CPUCreditBalance`. Nêu được cái này rất ghi điểm.\n- context switch (`cs`) cao bất thường: quá nhiều thread, hoặc lock contention nặng → đối chiếu với thread dump (21-linux-production-debug.jvm-network-deep-dive-on-prod.q1)\n- `%util` của `iostat` [[r:gây hiểu nhầm]] với SSD/NVMe: chúng xử lý song song nhiều I/O nên `%util` 100% không có nghĩa là bão hoà. Nhìn [[g:`await` và `aqu-sz`]] thay vì `%util`.\n- swap với service Java là [[o:quyết định của runtime và platform]]: kiểm tra policy của node/container, giới hạn cgroup, `swappiness` và JDK/runtime trước khi đổi. Paging heap latency-sensitive có thể làm pause tăng mạnh, nhưng đừng biến policy của một môi trường thành claim chung cho mọi Kubernetes.\n- 'pressure stall information' (`/proc/pressure/{cpu,io,memory}`) là chỉ số hiện đại và rõ nghĩa hơn load average nhiều — nói được là đang cập nhật kiến thức\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.diagnosing-the-system.q3","q":"Hết file descriptor hoặc hết ephemeral port: dấu hiệu và cách xử lý?","a":"Hai lỗi khác nhau nhưng cùng triệu chứng: service chạy tốt vài giờ rồi [[r:đột nhiên không nhận/không mở được kết nối nào]].\n\n**Hết file descriptor**\n\n<pre><code>java.net.SocketException: Too many open files</code></pre>\n\nMỗi socket, file, pipe đều tốn một fd.\n\n<pre><code>ulimit -n                          <span class=\"c\"># giới hạn mềm của shell hiện tại</span>\ncat /proc/&lt;pid&gt;/limits             <span class=\"c\"># giới hạn THẬT của process đang chạy</span>\nls /proc/&lt;pid&gt;/fd | wc -l          <span class=\"c\"># đang dùng bao nhiêu</span>\nlsof -p &lt;pid&gt; | awk '{print $5}' | sort | uniq -c | sort -rn</code></pre>\n\nNguyên nhân gần như luôn là [[o:rò rỉ]]: `HttpClient`/`InputStream`/`Connection` không đóng. Tăng `ulimit` chỉ dời thời điểm sập — phải tìm chỗ rò.\n\n**Hết ephemeral port**\n\n<pre><code>java.net.BindException: Cannot assign requested address</code></pre>\n\nClient mở quá nhiều kết nối ra ngoài. Đừng giả định một dải ephemeral port chung. Đọc `/proc/sys/net/ipv4/ip_local_port_range` (hoặc equivalent của platform); số cổng dùng được còn bị giới hạn bởi địa chỉ local, destination tuple, namespace và policy của kernel/runtime.\n\n<pre><code>ss -s                                        <span class=\"c\"># tổng quan, đếm TIME-WAIT</span>\ncat /proc/sys/net/ipv4/ip_local_port_range\nss -tan state time-wait | wc -l</code></pre>\n\nThủ phạm quen thuộc: [[r:tạo client mới cho mỗi request]] thay vì tái sử dụng connection pool.\n\nThời gian và behavior reuse của `TIME_WAIT` phụ thuộc kernel/version/configuration; đo state bằng `ss`, kiểm tra network policy thực tế và đọc tài liệu kernel đích thay vì giả định 60 giây.\n\n:::deep\n- systemd [[r:bỏ qua]] `/etc/security/limits.conf`; phải đặt `LimitNOFILE=` trong unit file. Đây là lý do 'em đã tăng ulimit rồi mà vẫn lỗi'.\n- trong K8s: fd limit đến từ image/runtime, không phải từ shell của bạn — kiểm tra bằng `/proc/1/limits` trong container\n- [[g:Sửa gốc]] cho ephemeral port: dùng connection pool + keep-alive. Một `WebClient`/`HttpClient` dùng chung cho cả app, không phải một cái cho mỗi lần gọi.\n- `TIME_WAIT` là [[o:có chủ đích]] để gói trễ của kết nối cũ hết hạn. `tcp_tw_reuse`, thay đổi dải port và mọi tuning cho reuse đều phụ thuộc kernel/topology; đọc giá trị effective và test đường client trước khi đổi.\n- `tcp_tw_recycle` đã bị xoá vì phá NAT — nêu nó như giải pháp chung là điểm trừ.\n- phân biệt nhanh: `Too many open files` = phía mình hết fd; `Cannot assign requested address` = hết cổng nguồn; `Connection refused` = phía kia không nghe; `Connection reset` = phía kia đóng đột ngột\n- giám sát chủ động: xuất `process.files.open` / `process.files.max` ra Prometheus và alert ở 80% — đây là loại sự cố hoàn toàn dự đoán được\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.diagnosing-the-system.q4","q":"OOM killer giết service: truy nguyên và phòng ngừa thế nào?","a":"OOM có nhiều failure boundary, [[r:đừng nhầm]]:\n\n<table class=\"cmp\"><thead><tr><th></th><th>Java OutOfMemoryError</th><th>Linux OOM killer</th></tr></thead><tbody>\n<tr><td>Ai giết</td><td>JVM tự ném exception</td><td>kernel gửi SIGKILL</td></tr>\n<tr><td>Dấu vết</td><td>stack trace trong log app</td><td><b>không có gì</b> trong log app</td></tr>\n<tr><td>Tìm ở đâu</td><td>log ứng dụng</td><td><code>dmesg</code>, <code>/var/log/syslog</code></td></tr>\n<tr><td>Nguyên nhân</td><td>heap không đủ / rò rỉ</td><td>tổng RSS vượt giới hạn máy hoặc cgroup</td></tr>\n</tbody></table>\n\n<pre><code>dmesg -T | grep -i -E \"oom|killed process\"\n<span class=\"c\"># Out of memory: Killed process 4127 (java) total-vm:9863244kB, anon-rss:6291456kB</span></code></pre>\n\nTrong K8s, container bị OOM hiện là `OOMKilled` với exit code [[b:137]] (128 + 9).\n\n**Vì sao vẫn OOM dù `-Xmx` đã nhỏ hơn RAM:** heap [[o:không phải]] toàn bộ memory JVM. Còn metaspace, code cache, thread stack (~1MB/thread), direct ByteBuffer, và memory của native library.\n\n<pre><code>RSS ≈ Heap + Metaspace + CodeCache + (Threads × Stack) + Direct + Native</code></pre>\n\n**Bắt đầu bằng budget, không phải phần trăm chung:**\n- `container_limit = heap + metaspace + code_cache + thread_stacks + direct/native + agents + safety_headroom`\n- `Xmx = container_limit - measured_nonheap - safety_headroom`\n\nGiá trị `Xmx` 50–70% chỉ là starting example có label cho workload đã đo, không phải guarantee; phải validate dưới peak traffic và đúng JDK/container đích.\n\n:::deep\n- Java 10+ [[g:có thể nhận cgroup limit]] (`UseContainerSupport` bật sẵn trong dòng JDK được tài liệu hoá), nhưng điều đó không tự chọn budget an toàn cho application.\n- `-XX:MaxRAMPercentage` chỉ là một starting point có thể cấu hình; hãy suy ra giá trị từ non-heap và headroom đã đo, rồi verify flag effective trên JDK đích.\n- Java 8 cũ [[r:không nhận]] cgroup: JVM thấy RAM của cả host và đặt heap mặc định = 1/4 số đó → OOMKilled ngay. Đây là nguyên nhân kinh điển khi container hoá app Java cũ.\n- [[o:Native Memory Tracking]] để tìm phần ngoài heap: `-XX:NativeMemoryTracking=summary` rồi `jcmd &lt;pid&gt; VM.native_memory summary`\n- rò rỉ ngoài heap hay gặp: direct ByteBuffer không được giải phóng (Netty), thread pool tạo thread không giới hạn, `ZipInputStream`/native lib không đóng\n- luôn bật `-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dump` — [[g:không có dump thì không điều tra được]] (21-linux-production-debug.jvm-network-deep-dive-on-prod.q2). Nhớ mount volume, dump ghi vào container ephemeral sẽ mất cùng container.\n- K8s: đặt `requests` = `limits` cho service quan trọng (QoS Guaranteed) để không bị giết khi node thiếu memory; `oom_score_adj` quyết định ai chết trước\n- OOMKilled lặp lại đều đặn theo chu kỳ = [[o:rò rỉ]]; xảy ra đúng lúc tải cao = [[o:thiếu size]]. Hai kết luận khác nhau, hai cách sửa khác nhau.\n\n**Bảng evidence theo failure boundary:**\n\n<table class=\"cmp\"><thead><tr><th>Failure</th><th>Scope</th><th>Evidence</th><th>Kiểm tra tiếp</th></tr></thead><tbody>\n<tr><td>Java heap OOME</td><td>JVM heap</td><td>exception, xu hướng GC/live-set, heap dump nếu cần</td><td>heap histogram, retained path, lịch sử allocation/GC</td></tr>\n<tr><td>Metaspace/code-cache exhaustion</td><td>JVM non-heap</td><td>nội dung OOME cụ thể, class-loading/code-cache metric</td><td>class-loader churn, generated code, flag JDK đích</td></tr>\n<tr><td>Direct/native/thread exhaustion</td><td>RSS của JVM hoặc native process</td><td>NMT nếu được cover, RSS/cgroup counter, số thread, exit evidence</td><td>direct-buffer limit, native library, tạo thread, PID limit</td></tr>\n<tr><td>cgroup OOMKilled / exit 137</td><td>container cgroup</td><td><code>memory.events</code>, reason của orchestrator, exit code 137, event runtime/node</td><td>RSS peak cùng cgroup limit và pressure của container bên cạnh</td></tr>\n<tr><td>kernel global OOM</td><td>host/node</td><td>kernel log, PID bị kill, global memory/swap/PSI evidence</td><td>node pressure, oom score, workload khác, reclaim policy</td></tr>\n</tbody></table>\n\nExit code 137 là evidence của SIGKILL, không chứng minh một nguồn memory cụ thể. Hãy đối chiếu process, cgroup, node, timestamp và runtime event trước khi chọn cách sửa.\n:::","difficulty":"advanced"}]},{"title":"Đào sâu JVM & mạng trên prod","items":[{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q1","q":"Thread dump: đọc thế nào để tìm deadlock và thread bị chặn?","a":"<pre><code>jcmd &lt;pid&gt; Thread.print &gt; td1.txt     <span class=\"c\"># cách khuyến nghị</span>\njstack -l &lt;pid&gt; &gt; td1.txt            <span class=\"c\"># tương đương, -l thêm thông tin lock</span></code></pre>\n\nLấy [[g:3 lần cách nhau 5–10 giây]] — một bản chụp không phân biệt được \"đang chạy\" với \"đang kẹt\". Thread nào giữ nguyên stack qua cả ba bản mới là thủ phạm.\n\n**Các trạng thái cần nhận ra:**\n\n<table class=\"cmp\"><thead><tr><th>Trạng thái</th><th>Nghĩa</th><th>Đáng lo khi</th></tr></thead><tbody>\n<tr><td><code>RUNNABLE</code></td><td>đang chạy (hoặc đang chờ I/O mạng)</td><td>nhiều thread cùng đứng ở một dòng tính toán</td></tr>\n<tr><td><code>BLOCKED</code></td><td>đang chờ vào <code>synchronized</code></td><td>nhiều thread chờ cùng một monitor</td></tr>\n<tr><td><code>WAITING</code></td><td><code>wait()</code>, <code>park()</code> không thời hạn</td><td>chờ mãi không ai đánh thức</td></tr>\n<tr><td><code>TIMED_WAITING</code></td><td>có timeout</td><td>thường bình thường</td></tr>\n</tbody></table>\n\n**Deadlock** — JVM tự phát hiện và ghi hẳn ra cuối dump:\n\n<pre><code>Found one Java-level deadlock:\n=============================\n\"thread-A\": waiting to lock monitor 0x00007f8 (object 0x000000076ab, a java.lang.Object),\n  which is held by \"thread-B\"\n\"thread-B\": waiting to lock monitor 0x00007f9 (object 0x000000076ac, a java.lang.Object),\n  which is held by \"thread-A\"</code></pre>\n\n:::warn Đọc nhầm hay gặp\n`RUNNABLE` đứng ở `socketRead0` [[r:không phải]] đang tốn CPU — nó đang chờ mạng. JVM không phân biệt được I/O chặn với tính toán. Nhiều thread `RUNNABLE` ở `socketRead0` = phụ thuộc bên ngoài đang chậm, không phải app tốn CPU.\n:::\n\n:::deep\n- Mẫu quan trọng nhất cần nhận ra: [[o:hàng chục thread `BLOCKED` trên cùng một monitor]] → nút thắt contention. Xem dòng `- locked <0x...>` để biết thread nào đang giữ, rồi đọc stack của **nó** — đó mới là chỗ cần sửa.\n- pool cạn nhìn ra ngay từ dump: nhiều thread `TIMED_WAITING` ở `HikariPool.getConnection` → không phải lỗi DB mà là connection bị giữ quá lâu ở chỗ khác (18-query-optimization.rewriting-the-query-reshaping-the-model.q4)\n- `jcmd` [[g:an toàn hơn]] `jstack` (không cần `-F`, ít rủi ro làm treo JVM). `jstack -F` ép buộc có thể làm JVM dừng lâu — hạn chế trên prod.\n- tên thread có ý nghĩa (`booking-worker-3`) làm dump dễ đọc gấp nhiều lần `pool-2-thread-7`. Đặt tên cho mọi thread pool tự tạo.\n- deadlock qua `ReentrantLock` [[r:không]] luôn được JVM phát hiện như `synchronized` — cần `jstack -l` để thấy `Locked ownable synchronizers`\n- công cụ đọc: fastThread.io, hoặc `jstack | grep -A3 \"java.lang.Thread.State\" | sort | uniq -c` để đếm nhanh theo trạng thái\n- virtual thread (23-java-concurrency-coding.async-the-modern-toolkit.q4) đổi cách đọc: dùng `jcmd &lt;pid&gt; Thread.dump_to_file -format=json` mới thấy được hết\n\n**Boundary attach và impact của JDK 21:** `jcmd`/`jstack` ở đây được scope theo tooling JDK 21. Chúng thường yêu cầu cùng host và effective user, PID nhìn thấy trong cùng namespace, quyền attach và nơi ghi output đủ dung lượng.\n\n`Thread.print` là snapshot có bound nhưng vẫn tạo thêm work khi incident đang căng; hãy lấy các mẫu cách nhau và ghi PID đích, user, namespace cùng timestamp. Đừng giả định PID 1 trong container là JVM của host.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q2","q":"Heap dump và memory leak: tìm thủ phạm bằng cách nào?","a":"**Nhận diện rò rỉ trước khi lấy dump:** vẽ đồ thị heap sau mỗi lần Full GC. Bình thường là răng cưa quanh một mức ổn định; rò rỉ là [[r:đáy răng cưa dâng lên đều]] rồi kết thúc bằng OOM.\n\n<pre><code>jcmd &lt;pid&gt; GC.heap_info                      <span class=\"c\"># nhìn nhanh</span>\njcmd &lt;pid&gt; GC.class_histogram | head -30     <span class=\"c\"># nhẹ, thường đủ để đoán</span>\njcmd &lt;pid&gt; GC.heap_dump /dump/heap.hprof     <span class=\"c\"># dump đầy đủ</span></code></pre>\n\n:::warn Heap dump làm treo JVM\n`GC.heap_dump` gây [[r:stop-the-world]] tỉ lệ với kích thước heap — heap 8GB có thể treo vài chục giây. Trên prod: rút instance khỏi load balancer trước, hoặc dump từ một instance đang bị rò rỉ nhưng chưa nhận traffic.\n:::\n\n**Phân tích bằng Eclipse MAT** — ba việc theo thứ tự:\n\n1. [[g:Leak Suspects Report]] — MAT tự chỉ ra nghi phạm, đúng trong đa số trường hợp\n2. [[g:Dominator Tree]] — sắp theo *retained heap* (memory sẽ được giải phóng nếu object này chết), không phải *shallow heap*\n3. [[g:Path to GC Roots]] (loại bỏ weak/soft reference) — trả lời câu quan trọng nhất: [[o:ai đang giữ nó]]\n\n**Các kiểu rò rỉ kinh điển trong Java:**\n- `static` Map/List dùng làm cache mà [[r:không có giới hạn và không có TTL]]\n- listener/callback đăng ký mà không bao giờ gỡ\n- `ThreadLocal` không `remove()` — thread pool sống mãi nên giá trị cũng sống mãi\n- `ClassLoader` leak khi hot-redeploy (đặc sản Tomcat)\n- key của `HashMap` không cài `equals`/`hashCode` → không bao giờ tra lại được, chỉ tích tụ\n\n:::deep\n- Phân biệt [[o:shallow]] (kích thước bản thân object) với [[o:retained]] (cả cụm chỉ nó giữ). Sắp theo shallow gần như luôn dẫn tới `char[]`/`byte[]` — đúng nhưng vô dụng.\n- `char[]`/`byte[]` đứng đầu histogram là [[r:bình thường]]; câu hỏi thật là *chuỗi nào* và *ai giữ* — chỉ Path to GC Roots trả lời được\n- so [[g:hai dump cách nhau vài giờ]] (MAT có chức năng so sánh histogram) — thứ tăng lên mới là thủ phạm, thứ lớn sẵn thường vô can\n- rò rỉ [[o:ngoài heap]] thì heap dump sạch bong mà RSS vẫn tăng → chuyển sang Native Memory Tracking (21-linux-production-debug.diagnosing-the-system.q4)\n- JFR ghi liên tục cho phép điều tra *sau khi* sự cố xảy ra mà không phải tái hiện: `-XX:StartFlightRecording=disk=true,maxsize=1g,dumponexit=true`\n- dump chứa [[r:toàn bộ dữ liệu thật]] trong memory — password, token, thông tin khách. Đối xử với file `.hprof` như dữ liệu nhạy cảm: encrypt, hạn chế truy cập, xoá sau khi phân tích.\n\n**Nhãn impact của JDK 21:**\n- `GC.class_histogram` nhẹ hơn để probe đầu tiên nhưng vẫn walk heap state và có thể cần safepoint.\n- `GC.heap_dump` là operation impact cao, phải xét pause, kích thước dump, disk trống và đường encrypt/access.\n\nCả hai cần kiểm tra attach/user/PID namespace. Xác nhận command set của JDK 21 đích và dung lượng trước khi chạy; dump lỗi vẫn có thể ăn disk hoặc làm nhiễu cửa sổ evidence.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q3","q":"Profiling trên production: async-profiler và JFR — an toàn tới đâu?","a":"Cả hai tool có thể an toàn trên production khi recording có bound, team hiểu event/frequency đã chọn và dừng/rollback nhanh được. “Low overhead” là mục tiêu thiết kế, [[r:không phải bảo đảm 1–3% chung]] — phải đo trên đúng JDK, hardware, container limit, event set và workload.\n\n**async-profiler 4.x** dùng binary launcher `asprof` (ví dụ `profiler.sh` cũ đã lỗi thời):\n\n<pre><code>asprof -d 30 -e cpu   -f /tmp/cpu.html   &lt;pid&gt;  <span class=\"c\"># sample đang chạy CPU</span>\nasprof -d 30 -e wall  -f /tmp/wall.html  &lt;pid&gt;  <span class=\"c\"># stack theo elapsed/waiting</span>\nasprof -d 30 -e alloc -f /tmp/alloc.html &lt;pid&gt;  <span class=\"c\"># sample allocation</span>\nasprof -d 30 -e lock  -f /tmp/lock.html  &lt;pid&gt;  <span class=\"c\"># lock contention</span></code></pre>\n\nasync-profiler hiện đại tránh sampling chỉ tại safepoint và có thể hiện frame Java, native, kernel, GC, JIT.\n\nImplementation đã tiến hoá: release 3.x/4.x mới đưa binary launcher cùng VMStructs-based stack walking, vì vậy đừng giải thích mãi bằng công thức cũ “AsyncGetCallTrace cộng `-XX:+DebugNonSafepoints`”. Đọc documentation đúng release đang chạy.\n\n**JFR** có sẵn trong JDK và ghi event model rộng:\n\n<pre><code>jcmd &lt;pid&gt; JFR.start name=diag settings=profile duration=60s filename=/tmp/r.jfr\njcmd &lt;pid&gt; JFR.check name=diag\njcmd &lt;pid&gt; JFR.dump name=diag filename=/tmp/r.jfr</code></pre>\n\n:::warn Bắt đầu hẹp trong incident\nXác định disk/memory limit, duration, sampling interval, output path, data sensitivity và attach permission trước khi profile.\n:::\n\nBắt đầu bằng CPU ngắn hoặc JFR standard, xem impact lên SLO/resource rồi chỉ thêm allocation, wall-clock, lock, native-memory hoặc method-tracing event cho một hypothesis. Một số mode có thể đắt hơn CPU sampling đáng kể.\n:::deep\nChọn event từ symptom:\n\n- CPU cao → CPU sample; chậm nhưng CPU idle → wall-clock cùng trace/queue/thread state;\n- GC pressure → allocation profile cùng GC/JFR event và live-set evidence;\n- contention → lock/monitor event và thread dump;\n- native/RSS tăng → native-memory tooling, không chỉ Java heap allocation.\n\nĐộ rộng flame graph là số/trọng số sample của event đã chọn, không tự động là elapsed time. So cùng setting với healthy baseline và xem time range/heatmap trước khi kết luận một plateau aggregate giải thích incident.\n\nProfile trong container có thể cần đúng PID namespace, JVM attach permission, perf setting/capability, seccomp allowance và output ghi được. Chỉ cấp quyền tối thiểu; `SYS_ADMIN` quá rộng, không nên là khuyến nghị mặc định. Điều khiển JFR vẫn cần quyền attach/control target process dù JFR đi kèm JDK.\n\nJFR luôn chạy có thể giữ lịch sử trước incident, nhưng cần config low-overhead, disk/age có bound, access control và redaction policy.\n\nVirtual-thread event khác theo JDK: monitor pinning có ở JDK 21–23 và bị gỡ ở JDK 24, nên đọc recording theo runtime đích (23-java-concurrency-coding.async-the-modern-toolkit.q4).\n\n**Nhãn profiling/NMT của JDK 21:**\n- JFR `default`/`profile`, event set, duration, disk limit và output path quyết định impact; “low overhead” không phải một con số cố định.\n- Native Memory Tracking phải bật bằng startup option được tài liệu hoá và có overhead; phạm vi `summary`/`detail` phụ thuộc JVM, không cover mọi allocation của third-party/native.\n\nVới cả JFR và NMT, hãy ghi version JDK 21, PID namespace, effective user/quyền attach, capability/seccomp cần thiết, disk budget và stop condition.\n:::","difficulty":"advanced"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q4","q":"tcpdump, ss và netstat: bắt lỗi mạng giữa hai service?","a":"Khi hai service \"không nói chuyện được\", cần biết gói tin dừng ở đâu.\n\n**Kiểm tra kết nối trước:**\n\n<pre><code>ss -tanp | grep :5432          <span class=\"c\"># kết nối tới Postgres, kèm process</span>\nss -tan state syn-sent         <span class=\"c\"># SYN gửi mà không ai trả lời =&gt; firewall/SG chặn</span>\nss -ti dst 10.0.3.41           <span class=\"c\"># RTT, cwnd, retransmit của từng kết nối</span></code></pre>\n\n`ss` [[g:thay thế `netstat`]] (nhanh hơn nhiều trên máy nhiều kết nối) — dùng `netstat` giờ là dấu hiệu kiến thức cũ.\n\n**Bắt gói khi cần chắc chắn:**\n\n<pre><code>tcpdump -i any -nn 'host 10.0.3.41 and port 5432' -c 200 -w /tmp/c.pcap\ntcpdump -nn -r /tmp/c.pcap | head -40</code></pre>\n\n`-nn` (không resolve DNS/port) là [[o:quan trọng]]: resolve có thể treo lệnh khi chính DNS đang là vấn đề.\n\n**Đọc kết quả:**\n- chỉ thấy `SYN` lặp lại, không có `SYN-ACK` → [[r:bị chặn]] (security group, NACL, iptables) hoặc đích không tồn tại\n- `SYN` → `RST` ngay → [[r:không có ai nghe]] cổng đó\n- bắt tay xong rồi im lặng lâu → phía kia nhận request nhưng xử lý chậm (vấn đề ở app, không phải mạng)\n- `[R]` giữa chừng → phía kia đóng đột ngột, thường do timeout của LB hoặc idle timeout\n\n:::deep\n- Phân biệt bằng triệu chứng, nhanh hơn bắt gói: [[o:treo tới hết timeout]] = gói bị nuốt (firewall DROP); [[o:lỗi tức thì]] = có phản hồi RST hoặc ICMP unreachable\n- `ss -s` xem tổng số kết nối và `TIME-WAIT` (liên hệ 21.3); `ss -ti` cho thấy `retrans` — retransmit cao = mạng thật sự có vấn đề\n- [[r:Bẫy MTU]]: kết nối mở được, request nhỏ chạy tốt, request lớn treo → phân mảnh gói/PMTU bị chặn ICMP. Hay gặp với VPN và overlay network của K8s. Rất khó đoán nếu chưa từng gặp.\n- trong K8s dùng `kubectl debug`/ephemeral container để chạy `tcpdump` trong cùng network namespace mà không phải nhét công cụ vào image production\n- DNS: `dig +short svc.ns.svc.cluster.local`, kiểm tra `ndots:5` trong `/etc/resolv.conf` — cấu hình này khiến mỗi lần tra tên ngoài phải thử 4–5 lần và là nguyên nhân 'chậm bí ẩn' rất hay gặp trên K8s\n- TLS thì payload encrypt, `tcpdump` chỉ thấy handshake — lỗi chứng chỉ/SNI dùng `openssl s_client -connect host:443 -servername host`\n- [[r:File pcap chứa dữ liệu thật]] đang truyền. Giới hạn `-c`, lọc hẹp, và xoá sau khi phân tích.\n:::","difficulty":"extra"},{"id":"21-linux-production-debug.jvm-network-deep-dive-on-prod.q5","difficulty":"advanced","q":"Điều tra latency incident trên production thế nào mà không làm hệ thống tệ hơn?","a":"Bắt đầu từ symptom user nhìn thấy và một time window, rồi thu thập evidence rẻ và bounded trước khi thay đổi: request/error/latency rate, saturation, queue age, database connection, GC pause, file descriptor, socket state, retransmit và dependency health.\n\n**Trình tự an toàn:**\n1. So instance khoẻ, instance bị ảnh hưởng và dependency path. Xác định vấn đề nằm local, shared hay do traffic shape.\n2. Dùng snapshot overhead thấp trước: process/container metric, ba thread dump cách nhau vài giây, socket/connection state và JVM/GC view có bound.\n3. Nếu cần profile, đặt duration, event set, output size, permission và stop condition. JFR hoặc async-profiler ngắn là evidence, không phải cam kết overhead thấp cho mọi môi trường.\n4. Chỉ lấy heap dump khi hypothesis về memory đủ mạnh để biện minh pause, disk, privacy và chi phí xử lý; ghi metadata và bảo vệ file.\n5. Packet capture phải narrow theo interface, peer, port và duration; redact hoặc restrict payload, và đừng suy ra “không có packet” nghĩa là application khoẻ.\n\nMỗi lần chỉ đổi một biến có thể rollback, ghi expected signal và thông báo incident commander. Đừng tăng limit, restart toàn bộ replica, bật verbose logging hay flush cache chỉ để graph đổi; mỗi việc có thể xoá evidence hoặc khuếch đại outage.\n\nSau mitigation, so cùng SLI và resource window trước/sau, giữ command output kèm timestamp, rồi biến failure mode đã xác nhận thành regression hoặc runbook test. Diagnosis không reproduce hoặc bound được vẫn chỉ là hypothesis.\n\n**Policy cho artifact:** coi heap dump, JFR recording, profiler output và pcap là operational artifact nhạy cảm.\n\nTrước khi capture, ghi owner, mục đích, path/volume, kích thước tối đa, encryption/access group, retention deadline và command cleanup.\n\nChỉ giữ evidence tối thiểu; nếu cần tồn tại qua restart thì lưu ngoài filesystem ephemeral của container; ghi hash/thời điểm tạo mà không log secret, rồi verify deletion sau incident.\n\n<table class=\"cmp\"><thead><tr><th>Triệu chứng</th><th>Evidence trước</th><th>Action có thể rollback</th><th>Rollback/cleanup</th></tr></thead><tbody>\n<tr><td>CPU hoặc run queue tăng</td><td>PSI, CPU từng core/process, ba thread dump</td><td>JFR/CPU recording có bound hoặc chuyển traffic</td><td>dừng recording, trả traffic, so cùng SLI window</td></tr>\n<tr><td>Đáy heap tăng</td><td>GC trend, histogram, live-set và RSS</td><td>drain một instance trước heap dump</td><td>bảo vệ/xoá dump theo retention policy; chỉ trả instance sau khi evidence an toàn</td></tr>\n<tr><td>Network timeout/reset</td><td><code>ss</code>, retransmit, tcpdump narrow, dependency SLI</td><td>capture bounded theo peer/port hoặc route một canary</td><td>dừng capture, restrict/xoá pcap, undo route change</td></tr>\n<tr><td>Telemetry hoặc diagnostic bị pressure</td><td>collector queue, disk, memory, evidence bị drop</td><td>giảm event set/rate và giữ signal quan trọng</td><td>gỡ config tạm, reclaim disk, verify monitoring health</td></tr>\n</tbody></table>"}]}]},"hasVi":true,"stem":"21-linux-production-debug","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distrib