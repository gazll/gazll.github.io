json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},"meta":{"topic_type":"design","key":"24-domain-driven-design","vi":{"label":"Domain-Driven Design","title":"Domain-Driven Design — chia miền và mô hình hoá","intro":"Chủ đề 12 nêu DDD trong bốn mục; đây là phần bị đào sâu khi bạn nói 'em làm theo DDD'. Ranh giới context tìm bằng cách nào, aggregate to nhỏ ra sao, domain event khác integration event chỗ nào — và quan trọng nhất: khi nào KHÔNG nên dùng.","tags":["Bounded context","Ubiquitous language","Aggregate","Domain event","Context mapping","Event storming","ACL"]},"en":{"label":"Domain-Driven Design","title":"Domain-Driven Design — splitting the domain and modelling it","intro":"Topic 12 introduces DDD in four items; this is what gets dug into once you say you follow DDD. How to find context boundaries, how big an aggregate should be, how a domain event differs from an integration event — and most importantly, when not to use any of it.","tags":["Bounded context","Ubiquitous language","Aggregate","Domain event","Context mapping","Event storming","ACL"]},"created_at":"2026-07-31","updated_at":"2026-08-23"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"la