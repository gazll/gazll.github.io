{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},"meta":{"topic_type":"design","key":"09-distributed-tx-fintech","vi":{"label":"Distributed tx (fintech)","title":"Transaction giữa các service (fintech)","intro":"Phần JD nhấn mạnh nhất: 'integration between systems'. Đảm bảo correctness khi tiền đi qua nhiều service mà không có transaction toàn cục — nơi phân biệt senior thật trong fintech.","tags":["Saga","2PC","Outbox","TCC","Idempotency","Reconciliation","Double-entry","BigDecimal"]},"en":{"label":"Distributed tx (fintech)","title":"Transactions across services (fintech)","intro":"What the job description leans on hardest: integration between systems. Keeping money correct as it crosses several services with no global transaction — where real seniority shows in fintech.","tags":["Saga","2PC","Outbox","TCC","Idempotency","Reconciliation","Double-entry","BigDecimal"]},"created_at":"2026-07-31","updated_at":"2026-10-25"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"09-distributed-tx-fintech.distributed-transaction-patterns.q1":"2026-09-12","09-distributed-tx-fintech.distributed-transaction-patterns.q2":"2026-08-19","09-distributed-tx-fintech.distributed-transaction-patterns.q3":"2026-08-19","09-distributed-tx-fintech.distributed-transaction-patterns.q4":"2026-09-12","09-distributed-tx-fintech.distributed-transaction-patterns.q5":"2026-08-19","09-distributed-tx-fintech.distributed-transaction-patterns.q6":"2026-08-19","09-distributed-tx-fintech.correctness-where-money-is-involved.q1":"2026-08-23","09-distributed-tx-fintech.correctness-where-money-is-involved.q2":"2026-08-23","09-distributed-tx-fintech.correctness-where-money-is-involved.q3":"2026-08-19","09-distributed-tx-fintech.correctness-where-money-is-involved.q4":"2026-09-12","09-distributed-tx-fintech.correctness-where-money-is-involved.q5":"2026-08-19","09-distributed-tx-fintech.correctness-where-money-is-involved.q6":"2026-09-12"},"lang":"vi","body":{"sections":[{"title":"Tính đúng đắn của workflow phân tán","items":[{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q1","q":"Chọn local ACID, 2PC/XA hay Saga như thế nào?","a":"Bắt đầu từ invariant, không bắt đầu từ tên pattern.\n\n1. [[g:Local ACID trước]]: giữ dữ liệu phải đổi nguyên tử trong cùng authority và cùng database transaction.\n2. [[b:2PC/XA]]: chỉ dùng khi participant, coordinator, latency budget và owner recovery đều rõ ràng, được hỗ trợ thật.\n3. [[b:Saga]]: dùng local transaction kèm forward recovery hoặc compensation rõ ràng khi boundary thực sự phân tán.\n\n2PC không phải lúc nào cũng sai. Trong lúc prepared và chưa được resolve, participant có thể giữ lock hoặc resource; coordinator/participant fail sẽ tạo bài toán recovery in-doubt. Vì vậy đây là lựa chọn có phạm vi, không phải default cho call dài tới người dùng hay provider.\n\n:::tip Chốt\nChỉ có service boundary chưa đủ để tách transaction. Hãy nêu authority, failure budget, recovery owner và state user nhìn thấy trước khi chọn pattern (25-microservice.10-system-design-putting-it-all-together.q5).\n:::\n\n:::deep\n2PC có thể cho atomic commit trong phạm vi protocol, nhưng không cho availability vô hạn.\n\nSaga không tạo intermediate state nguyên tử; nó điều phối các local commit để tiến tới desired state đã khai báo trong điều kiện eventual consistency. Mỗi local transaction chỉ nguyên tử trong authority của chính nó.\n:::\n\n:::deep\n**Điều gì làm câu trả lời này đổi** — nêu trước khi bảo vệ thiết kế; mỗi dòng là một giả định người phỏng vấn có thể yêu cầu bạn biện minh, và một phép đo có thể bác bỏ nó:\n\n- Ví dụ giả định contract của provider nào — Stripe và Adyen khác nhau về idempotency key và retry — hoặc nói rõ pseudocode là provider-neutral.\n- SLA reconciliation thật cho payment, inventory và booking. Không có nó, \"eventual\" là hy vọng, không phải contract vận hành.\n- 2PC có thật sự khả dụng trên database/driver mục tiêu và có người sở hữu recovery không; nếu không, 2PC chỉ là một so sánh có giới hạn, không bao giờ là hướng dẫn chạy được.\n- Cửa sổ giữ retry muộn và callback. Nếu nó dài hơn TTL của idempotency key, khuyến nghị bị bác bỏ cho tới khi có business reference bền.\n- Ledger có chứng minh được bất biến posting zero-sum dưới crash và replay không. Một property test thất bại là bác bỏ mọi cách nói \"chuyển tiền exactly-once\".\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q2","q":"Saga: choreography hay orchestration? Compensating transaction là gì?","a":"<figure class='dgm'><svg viewBox='0 0 680 150' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11' text-anchor='middle'>\n<text x='170' y='20' fill='#085239' font-weight='600'>ORCHESTRATION</text><rect x='105' y='34' width='130' height='30' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='170' y='54' fill='#3D4E8F'>workflow state</text><g stroke='#3D4E8F' stroke-width='1.4'><line x1='170' y1='64' x2='75' y2='105'/><line x1='170' y1='64' x2='170' y2='105'/><line x1='170' y1='64' x2='265' y2='105'/></g><text x='170' y='135' fill='#42536C'>explicit steps, retry, compensation</text><line x1='350' y1='12' x2='350' y2='140' stroke='#C6CFDC' stroke-dasharray='4 4'/><text x='515' y='20' fill='#7d2f24' font-weight='600'>CHOREOGRAPHY</text><text x='515' y='70' fill='#42536C'>local tx &#8594; event &#8594; local tx</text><text x='515' y='105' fill='#AE4536'>loose coupling, hidden flow</text></svg></figure>\n\n[[g:Saga]] chia một business operation dài thành các local transaction. Nó điều phối các bước hướng tới desired state đã khai báo; bước fail sẽ chạy [[g:compensating transaction]], tức business operation mới, không phải rollback database.\n\nCompensation có thể fail, chậm, bị từ chối hoặc không thể thực hiện sau side effect không đảo ngược.\n\n- [[b:Choreography]]: service phản ứng theo event, không có conductor; hợp với flow nhỏ, ổn định nhưng ownership và recovery khó nhìn tổng thể.\n- [[b:Orchestration]]: durable workflow state store điều khiển step, timer, retry và compensation; dễ quan sát hơn nhưng thêm control-plane dependency. Workflow engine replicated chỉ đổi crash mode, không đổi business invariant.\n\nMỗi step và compensation cần command idempotent cùng state rõ như `PENDING`, `COMPENSATING`, `RECONCILIATION_REQUIRED`. Nếu có thể, đặt side effect không đảo ngược sau pivot đã khai báo.\n\nCác trade-off Saga tổng quát nằm ở (25-microservice.03-distributed-data-consistency.q3); flow OTA cụ thể nằm ở (16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5).\n\n:::warn Boundary\nIntermediate state có thể bị nhìn thấy. Không cho user hoặc workflow khác tiêu số dư, hold hay payment chưa đạt settled state của authority.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q3","q":"Outbox pattern và vì sao dual-write nguy hiểm?","a":"<figure class='dgm'><svg viewBox='0 0 680 145' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11' text-anchor='middle'><rect x='35' y='35' width='190' height='75' rx='8' fill='#E4F1EB' stroke='#0B6E4F'/><text x='130' y='27' fill='#085239' font-weight='600'>ONE LOCAL TX</text><text x='130' y='65' fill='#14233A'>state + outbox intent</text><text x='350' y='72' fill='#42536C'>&#8594; relay / CDC &#8594;</text><rect x='480' y='35' width='155' height='75' rx='8' fill='#F6E8E5' stroke='#AE4536'/><text x='557' y='65' fill='#7d2f24'>consumer</text><text x='557' y='84' fill='#AE4536'>deduplicate</text><text x='340' y='135' fill='#42536C'>at-least-once publish; no end-to-end exactly-once</text></svg></figure>\n\n[[r:Dual write]] là commit business state và publish ra ngoài ở hai bước rời. Một bên fail sẽ tạo drift. [[g:Transactional Outbox]] ghi event intent trong cùng local transaction với business change.\n\nOutbox chỉ đóng boundary [[g:state &#8596; publish-intent]]. Relay hoặc CDC có thể publish at-least-once và crash sau publish nhưng trước khi ghi progress.\n\nConsumer vì vậy cần Inbox, event ID unique hoặc effect idempotent tương đương trong cùng local transaction với state change. Outbox không chứng minh broker đã deliver, consumer đã apply hay PSP đã settle.\n\n:::tip Boundary\nUnit này giữ workflow meaning và recovery boundary.\n\nChi tiết broker confirms, acknowledgement, partition và replay nằm ở (08-message-queue.reliability-delivery-semantics.q2), (08-message-queue.reliability-delivery-semantics.q6) và (08-message-queue.reliability-delivery-semantics.q7).\n:::\n\n:::deep\nGiữ event ID, metric relay error/age, repair/redrive policy và integration contract có version. Chỉ đưa public integration event vào outbox, không đưa mọi internal domain event (24-domain-driven-design.tactical-modelling-it.q3).\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q4","q":"TCC (Try-Confirm-Cancel) khác Saga thế nào?","a":"TCC là một protocol shape, không tự động đồng nghĩa với Saga hay seat hold.\n\n- [[b:Try]] reserve resource.\n- [[b:Confirm]] commit reservation.\n- [[b:Cancel]] release khi workflow không thể tiếp tục.\n\n<table class='cmp'><thead><tr><th></th><th>Saga</th><th>TCC</th></tr></thead><tbody><tr><td>Thứ tự</td><td>làm thật rồi compensate</td><td>reserve rồi confirm/cancel</td></tr><tr><td>Visibility</td><td>intermediate business state bị lộ</td><td>reservation vẫn observable và có thể hết hạn</td></tr><tr><td>Isolation</td><td>phụ thuộc compensation và authority</td><td>có thể mạnh hơn với resource đã reserve</td></tr><tr><td>Chi phí</td><td>local op cộng compensation</td><td>ba phase idempotent cho mỗi participant</td></tr></tbody></table>\n\nMỗi phase cần owner, idempotency, empty-rollback handling, expiry và recovery policy. Try, Confirm và Cancel đều phải chịu được call trùng hoặc đến muộn theo contract đó.\n\nSeat hold hoặc PSP authorize/capture chỉ nên gọi là [[o:TCC-like]] khi provider contract thật sự có các phase đó; không suy ra chỉ vì tên giống nhau. Race và invariant của OTA nằm ở (16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2).\n\n:::deep\nTCC giảm exposure của resource chưa commit nhưng không xóa timeout, reservation stale, provider failure hay reconciliation.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q5","q":"Hai service cần giữ consistent state mà không có distributed transaction — các lựa chọn?","a":"Chọn authority và atomic boundary trước:\n\n- [[g:Local ACID]] khi invariant thực sự dùng chung: giữ hai chân ledger hoặc inventory transition trong cùng bounded context và database.\n- [[b:Provider atomic contract hoặc 2PC/XA]] chỉ khi participant, latency, availability và recovery contract rõ ràng, chấp nhận được.\n- [[b:Saga + Outbox]] khi tách là bắt buộc: chấp nhận intermediate state quan sát được, step idempotent, compensation và reconciliation.\n- [[b:Eventual projection]] cho search, notification và report; phải revalidate với authority trước quyết định commit.\n\nIdempotency cần ở từng command, consumer và provider boundary; đó là các key và contract khác nhau. Reconciliation là control loop, không phải bằng chứng online invariant ban đầu đã an toàn.\n\n:::tip Chốt quan trọng\nService boundary thường nên theo consistency boundary, nhưng số participant không phải decision rule duy nhất. Ownership, khả năng đảo ngược, risk, latency và recovery evidence cũng quan trọng.\n\nSo sánh money-transfer end-to-end nằm ở (25-microservice.10-system-design-putting-it-all-together.q4).\n:::\n\n:::deep\nNếu booking, payment hoặc ledger chạm external authority, hãy model `PENDING`, `UNKNOWN`, `COMPENSATING`, `RECONCILIATION_REQUIRED`; đừng giả vờ local rollback có thể đảo ngược side effect bên ngoài.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.distributed-transaction-patterns.q6","q":"Distributed lock (Redis/Redlock) — khi nào dùng và rủi ro gì?","a":"Lock điều phối ownership của một attempt; nó không phải authority cho correctness tiền hay inventory. Một lease ngắn có thể ngăn scheduler chạy trùng: `SET key value NX PX ttl`.\n\n[[r:Rủi ro]]: pause, partition hoặc operation chậm có thể dài hơn TTL, khiến worker cũ và worker mới overlap. Dùng ownership token, release an toàn, giới hạn renewal và [[g:fencing token]] khi resource có thể từ chối stale writer.\n\n:::warn Fintech\nĐể database hoặc provider authority enforce invariant bằng unique constraint, version, conditional write hay idempotency contract đã được tài liệu hóa. Lock chỉ giảm contention.\n\nXem (28-distributed-lock-lease.choose-the-authority-before-the-mechanism.q1) và (28-distributed-lock-lease.design-for-expiry-and-stale-work.q3).\n:::\n\n:::deep\nSafety claim của Redlock hay lock multi-node phụ thuộc implementation và timing. Lock expiry không được biến thành charge, ledger posting hay event lần hai; hãy dùng durable state và reconciliation.\n:::","difficulty":"core"}]},{"title":"Tính đúng đắn của tiền bạc","items":[{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q1","q":"Tình huống thực chiến: gọi PSP/ngân hàng timeout, không biết tiền đã bị trừ chưa?","a":"[[r:Unknown outcome]] nghĩa là chưa đủ evidence để gọi operation là fail hay success.\n\n- Claim một payment attempt local và merchant reference ổn định. Dùng provider idempotency key khi provider tài liệu hóa scope và retention của nó.\n- Timeout thì lưu `PENDING` hoặc `UNKNOWN`; không tạo logical charge mới bằng key mới.\n- Dùng status inquiry hoặc callback đã verify nếu provider hỗ trợ. Nếu evidence vẫn thiếu, giữ unknown queue có owner và reconcile với record provider hoặc settlement.\n- Chỉ chuyển sang `SUCCEEDED`, `FAILED`, `COMPENSATING` hoặc `RECONCILIATION_REQUIRED` qua state transition hợp lệ, có audit.\n\n:::tip Chốt\nTimeout là thiếu quan sát, không phải bằng chứng failure. Local state machine, provider contract và reconciliation SLA quyết định khi nào có thể báo kết quả cho user.\n:::\n\n<pre><code>CREATE TABLE payment_attempt(\n  id uuid PRIMARY KEY,\n  idempotency_key text UNIQUE NOT NULL,\n  provider_ref text UNIQUE,\n  status text NOT NULL CHECK (status IN\n    ('CREATED','SUBMITTED','PENDING','UNKNOWN','SUCCEEDED','FAILED',\n     'RECONCILIATION_REQUIRED'))\n);\n-- claim một local attempt, rồi gọi provider ngoài DB tx này\nUPDATE payment_attempt SET status='SUBMITTED'\n WHERE id=:id AND status='CREATED';\nCOMMIT;\n-- timeout: giữ uncertainty, không đánh dấu FAILED\nUPDATE payment_attempt SET status='UNKNOWN'\n WHERE id=:id AND status='SUBMITTED';\n-- inquiry/callback/reconciliation áp dụng một transition hợp lệ\nUPDATE payment_attempt SET status='SUCCEEDED', provider_ref=:ref\n WHERE id=:id AND status IN ('PENDING','UNKNOWN','SUBMITTED');</code></pre>\n\nProvider contract là riêng cho từng integration; không phải PSP/ngân hàng nào cũng có idempotency, inquiry, callback hay retention tương đương (25-microservice.09-idempotency-the-central-link.q1).\n\nHãy biến unknown queue thành thứ vận hành được bằng cách lưu `unknown_since`, `next_inquiry_at`, `reconciliation_deadline`, `owner` và risk tier.\n\n**Age/risk bucket, không phải timeout ma thuật.** Gắn mỗi bucket với SLA phản hồi và settlement của provider:\n- còn trong cửa sổ được tài liệu hóa: backoff và inquiry\n- quá cửa sổ: escalate sang settlement hoặc manual review theo policy\n\nKhi authority chưa chứng minh outcome, client expiry không cho phép tạo charge thứ hai.\n\n:::deep\nTheo dõi unknown age, retry owner, callback verification, inquiry attempts, settlement drift và manual escalation. Auto-void/refund là policy sau khi có evidence và đủ điều kiện, không phải timeout handler mù.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q2","q":"Idempotency trong thanh toán: triển khai thế nào cho kín?","a":"Tách idempotency thành ba boundary:\n\n1. [[g:Command claim]]: scope key theo tenant, account, operation hoặc endpoint; lưu request fingerprint và reject cùng key nhưng payload khác.\n2. [[g:Local result]]: commit claim, business transition, final result và Outbox row trong cùng local transaction. Outbox là intent row bổ sung, không thay cho key/result record.\n3. [[g:Provider command]]: reuse provider key hoặc merchant reference chỉ theo contract provider đã tài liệu hóa.\n\n<pre><code><span class='k'>INSERT INTO</span> idempotency_keys(scope, key, request_fingerprint, status, response)\n<span class='k'>VALUES</span>(?, ?, ?, <span class='s'>'IN_PROGRESS'</span>, <span class='k'>NULL</span>);  <span class='c'>-- UNIQUE(scope, key)</span></code></pre>\n\nDuplicate cùng fingerprint thì trả stored result, poll attempt `IN_PROGRESS` hoặc trả conflict theo contract. Fingerprint khác là conflict, không phải retry.\n\nGiữ record lâu hơn retry/callback window của client/provider, hoặc giữ durable business reference; cache TTL ngắn không phải correctness boundary.\n\n**Trước production, pin behavior của provider:**\n- API/version và account/region\n- scope và retention của key\n- behavior khi payload mismatch và concurrent reuse\n- status inquiry\n- webhook authenticity/replay\n- semantics settlement/reversal\n\nStripe và Adyen tài liệu hóa các chi tiết idempotency khác nhau; đừng copy một provider thành default universal.\n\n:::deep\nĐừng hứa HTTP method, broker delivery mode hay local key tự nó ngăn duplicate external. Hãy gọi rõ boundary và test concurrent duplicate, late callback, replay result, payload mismatch và retention expiry (25-microservice.09-idempotency-the-central-link.q1).\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q3","q":"Double-entry bookkeeping — vì sao là gold standard cho ledger?","a":"Một posting là batch có các entry signed được kiểm soát: trong cùng currency hoặc asset, các entry phải cân bằng theo invariant của ledger. Transfer bình thường có debit và credit; issuance, fee, FX và reversal dùng account/policy rõ ràng thay vì âm thầm phá phương trình.\n\nLedger là [[g:append-only]]: không destructive update/delete entry đã post. Sửa sai bằng reversing hoặc adjustment entry có authorization, actor, reason, time và source reference.\n\n- Commit cả hai chân và posting identity atomically trong ledger authority, hoặc để posting ở pending.\n- Làm posting command idempotent bằng unique business key.\n- Tính balance từ entries, hoặc update materialized balance trong cùng local tx rồi reconcile định kỳ.\n- Check zero-sum theo từng posting batch và currency; không cộng một sum duy nhất cho các currency khác nhau.\n\n:::tip Chốt\nLedger là book of record; workflow state, lock, cache và projection không được âm thầm trở thành money authority thứ hai (25-microservice.10-system-design-putting-it-all-together.q4).\n:::\n\n:::deep\nTách state pending, posted, reversed và disputed. Hạn chế adjustment hành chính, giữ audit trail bất biến, và reconcile posting với provider hoặc settlement evidence.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q4","q":"Vì sao không dùng float cho tiền? Lưu trữ đúng cách?","a":"Binary float/double không biểu diễn chính xác nhiều phân số thập phân, nên phép tính lặp có thể tạo drift.\n\nDùng representation kèm policy domain rõ ràng:\n\n- `DECIMAL(p,s)` hoặc `BigDecimal` cho decimal amount, với scale và rounding được chọn minh bạch.\n- Minor unit dạng integer chỉ khi currency và operation có exponent cố định, đã validate; đừng mặc định mọi currency đều theo cents.\n- Lưu currency code, scale và, với FX, rate/source/time cùng kết quả rounding. Không cộng khác currency.\n- Validate metadata currency và rounding rule theo nguồn ISO 4217/domain đã chọn; `HALF_EVEN` chỉ là ví dụ policy, không phải luật chung.\n\nRepresentation không chứng minh provider đã settle, chargeback, tax, KYC/AML, PCI hay nghĩa vụ legal/compliance khác. Hãy giữ chúng thành contract và owner riêng của từng integration, không suy ra từ `DECIMAL` hay `BigDecimal`.\n\n<pre><code><span class='k'>new</span> BigDecimal(&amp;quot;0.1&amp;quot;)\n    .add(<span class='k'>new</span> BigDecimal(&amp;quot;0.2&amp;quot;))\n    .setScale(<span class='n'>2</span>, RoundingMode.HALF_EVEN); <span class='c'>// ví dụ: 0.30</span></code></pre>\n\n:::deep\nTest tax, fee, FX, split-payment, reversal và rounding khi reconcile ở currency boundary. Storage type ngăn một nhóm lỗi; nó không tự chọn accounting policy.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q5","q":"Chống double-spend / race trên số dư under high load thế nào?","a":"Đừng đọc balance, quyết định trong app rồi mới ghi. Đặt linearization point trong authoritative database transaction:\n\n- Dùng conditional update như `UPDATE account SET available_minor=available_minor-? WHERE id=? AND currency=? AND available_minor>=?`; 0 row nghĩa là điều kiện không đạt.\n- Dùng optimistic version check với retry có giới hạn, hoặc row lock ngắn khi contention và isolation yêu cầu.\n- Dùng unique constraint cho một logical debit/posting, và append cả hai ledger leg atomically.\n- Revalidate projection stale tại final authorization boundary. Distributed lock có thể giảm contention nhưng không thay guard này (28-distributed-lock-lease.choose-the-authority-before-the-mechanism.q1).\n\n:::tip Chốt\nCorrectness tiền phải neo vào ledger/account authority: conditional transition, uniqueness, balance invariant và durable idempotency. Queue hoặc sharding giúp throughput nhưng không phải bằng chứng correctness.\n:::\n\n:::deep\nVới resource nóng, serialize hoặc partition attempt chỉ là cách bảo vệ capacity. Nếu worker mất ownership hoặc request timeout, giữ `UNKNOWN` và reconcile; không retry bằng cách tạo logical debit thứ hai.\n:::","difficulty":"advanced"},{"id":"09-distributed-tx-fintech.correctness-where-money-is-involved.q6","q":"Eventual consistency trong fintech: chấp nhận ở đâu, cấm ở đâu?","a":"Có thể chấp nhận eventual cho projection mà stale được khai báo và không dùng để authorize movement tiền: history hiển thị, notification, report, analytics và reward view.\n\nỞ final decision boundary, dùng authoritative transaction hoặc conditional write cho available balance, limit, ledger posting, anti-double-spend và confirm inventory/hold. Read có thể bắt đầu request từ projection, nhưng phải revalidate trước commit.\n\n:::warn Đừng biến freshness preference thành slogan tuyệt đối\nYêu cầu là strong correctness ở invariant boundary, không phải mọi read trong fintech đều phải đồng bộ với một database. Hãy định nghĩa freshness, `PENDING`, `UNKNOWN` và escalation cho từng projection.\n:::\n\n:::deep\nVới OTA/commerce, search availability có thể stale nhưng hold/payment cuối flow phải revalidate với authority (16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4). Với tiền, reconcile drift giữa ledger, provider, Outbox/relay và projection theo owner và age SLA.\n\nTheo dõi unknown/pending age, reconciliation lag, tỷ lệ duplicate/replay, provider status drift, ledger imbalance và projection freshness.\n\nTest retry concurrent, callback muộn, provider timeout, replay, repair reconciliation và boundary ngăn projection stale authorize tiền.\n:::","difficulty":"extra"}]}]},"hasVi":true,"stem":"09-distributed-tx-fintech","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"distributed-rate-limiter","11-system-design-cases.the-big-prompts.q5":"distributed-rate-limiter","16-project-concurrency-whiteboard.whiteboard-dsa.q1":"distributed-rate-limiter","11-system-design-cases.the-big-prompts.q1":"payment-ledger","11-system-design-cases.the-big-prompts.q11":"payment-ledger","11-system-design-cases.the-big-prompts.q2":"notification-servic