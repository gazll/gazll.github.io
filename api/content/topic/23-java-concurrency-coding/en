bel":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"23-java-concurrency-coding.classic-synchronisation-problems.q1":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q2":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q3":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q4":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q1":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q2":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q3":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q4":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q5":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q6":"2026-09-12"},"lang":"en","body":{"sections":[{"title":"Classic synchronisation problems","items":[{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q1","q":"Bounded blocking queue: how would you implement it with wait/notify and with Lock/Condition?","a":"The \"hello world\" of concurrency. The way you implement it immediately reveals your level of fluency.\n\n**Proof labels — safety · liveness · visibility.**\n\nThe safety invariant is 0 ≤ q.size() ≤ cap. Liveness requires every signal or notifyAll to wake a waiter whose predicate may now hold. Lock/monitor release and reacquisition provide the visibility edge; interruption is part of the contract.\n\n**`ReentrantLock` + two `Condition` instances** (this is the version to present):\n\n<pre><code><span class=\"k\">class</span> BoundedQueue&lt;T&gt; {\n    <span class=\"k\">private final</span> Queue&lt;T&gt; q = <span class=\"k\">new</span> ArrayDeque&lt;&gt;();\n    <span class=\"k\">private final</span> <span class=\"k\">int</span> cap;\n    <span class=\"k\">private final</span> ReentrantLock lock = <span class=\"k\">new</span> ReentrantLock();\n    <span class=\"k\">private final</span> Condition notFull  = lock.<span class=\"f\">newCondition</span>();\n    <span class=\"k\">private final</span> Condition notEmpty = lock.<span class=\"f\">newCondition</span>();\n<span class=\"c\">    </span>\n    <span class=\"f\">BoundedQueue</span>(<span class=\"k\">int</span> cap) { <span class=\"k\">this</span>.cap = cap; }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">put</span>(T x) <span class=\"k\">throws</span> InterruptedException {\n        lock.<span class=\"f\">lockInterruptibly</span>();\n        <span class=\"k\">try</span> {\n            <span class=\"k\">while</span> (q.<span class=\"f\">size</span>() == cap) notFull.<span class=\"f\">await</span>();   <span class=\"c\">// WHILE, not IF</span>\n            q.<span class=\"f\">add</span>(x);\n            notEmpty.<span class=\"f\">signal</span>();                        <span class=\"c\">// wake only a consumer</span>\n        } <span class=\"k\">finally</span> { lock.<span class=\"f\">unlock</span>(); }\n    }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> T <span class=\"f\">take</span>() <span class=\"k\">throws</span> InterruptedException {\n        lock.<span class=\"f\">lockInterruptibly</span>();\n        <span class=\"k\">try</span> {\n            <span class=\"k\">while</span> (q.<span class=\"f\">isEmpty</span>()) notEmpty.<span class=\"f\">await</span>();\n            T x = q.<span class=\"f\">poll</span>();\n            notFull.<span class=\"f\">signal</span>();\n            <span class=\"k\">return</span> x;\n        } <span class=\"k\">finally</span> { lock.<span class=\"f\">unlock</span>(); }\n    }\n}</code></pre>\n\n**The `wait`/`notify` version** — the same logic, but there is only [[o:one]] wait set, so `notifyAll()` is mandatory:\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">put</span>(T x) <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (q.<span class=\"f\">size</span>() == cap) <span class=\"f\">wait</span>();\n    q.<span class=\"f\">add</span>(x);\n    <span class=\"f\">notifyAll</span>();          <span class=\"c\">// notify() may wake another producer =&gt; possible liveness failure</span>\n}</code></pre>\n\n:::warn Three classic mistakes\n[[r:`if` instead of `while`]] — spurious wakeups and contention after a wakeup can make the condition false again, so it must be rechecked.\n:::\n\n[[r:`notify()` with one shared wait set]] — it can wake a thread of the wrong type, one that is waiting for the wrong condition, and the entire system can hang. [[r:`unlock()` outside `finally`]] — an exception partway through means the lock is never released.\n:::deep\n- The decisive advantage of `Condition` is [[g:two separate wait sets]] → `signal()` (wake one) instead of `notifyAll()` (wake everyone and let them contend). On a heavily used queue, the performance difference is substantial.\n- `await()` [[o:releases the lock]] while waiting and reacquires it before returning. Without understanding that, it is impossible to explain why both sides can wait under the same lock without deadlocking.\n- In production, use the built-in `ArrayBlockingQueue`/`LinkedBlockingQueue`. [[o:Mention that]], then still implement it by hand, because that is what the interviewer wants to see.\n- ArrayBlockingQueue uses one lock for both ends. [[g:The current JDK implementation of LinkedBlockingQueue uses separate put/take locks]], which may permit more overlap; that layout is an implementation detail, not part of the BlockingQueue contract.\n- Common follow-ups: `offer(x, timeout)`, where `notFull.await(t, unit)` returns `false` on timeout; and graceful queue shutdown using a `closed` flag plus `signalAll`.\n- For a completely lock-free queue, use `ConcurrentLinkedQueue`, but it is [[r:neither blocking nor bounded]], so it does not solve this problem.\n\n**Shutdown contract (abridged):** BlockingQueue has no built-in close operation. Define closed under the same monitor, reject new puts, wake every waiter, and let consumers drain existing elements before returning an end-of-stream result.\n\n<pre><code><span class=\"k\">private</span> <span class=\"k\">boolean</span> closed;\n<span class=\"c\">// same monitor and queue as the wait/notify example</span>\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">close</span>() {\n    closed = <span class=\"k\">true</span>;\n    <span class=\"f\">notifyAll</span>();\n}\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> T <span class=\"f\">take</span>() <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (q.<span class=\"f\">isEmpty</span>() &amp;&amp; !closed) <span class=\"f\">wait</span>();\n    <span class=\"k\">if</span> (q.<span class=\"f\">isEmpty</span>()) <span class=\"k\">return</span> <span class=\"k\">null</span>; <span class=\"c\">// closed and drained</span>\n    T x = q.<span class=\"f\">remove</span>();\n    <span class=\"f\">notifyAll</span>();\n    <span class=\"k\">return</span> x;\n}</code></pre>\n\nBecause null elements are forbidden by BlockingQueue, null can be the reserved end-of-stream result in this abridged API.\n\nA put must wait while !closed and q.size() == cap, then reject after close. wait, await, put, and take may throw InterruptedException: propagate it, or restore the interrupt flag after cleanup; never swallow it.\n\nUse ArrayBlockingQueue or LinkedBlockingQueue for the queue contract: put/take are interruptible, offer/poll can be timed, and capacity is explicit. Add closure outside that contract with wrapper state or a sentinel; do not depend on a current implementation layout.\n\n- Test full and empty states with multiple producers/consumers; close while put/take waits; interrupt each wait; assert bounded size, prompt wake-up, drained items, and no task remains blocked.\n:::","difficulty":"core"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q2","q":"Printing in strict alternating order (print FooBar / print in order): what are the approaches and trade-offs?","a":"LC 1114/1115. The problem: two (or three) threads must produce output in the required order regardless of scheduling order.\n\n**Proof labels — safety · ordering · liveness · visibility.**\n\nThe safety property is the exact output sequence; fairness is a scheduling policy, not the proof of ordering. Cancellation is separate: if a participant exits after taking its permit, its partner can wait forever unless the protocol publishes a terminal state and wakes both sides.\n\n**Approach 1 — `Semaphore`** (the most concise and the best one to present):\n\n<pre><code><span class=\"k\">class</span> FooBar {\n    <span class=\"k\">private final</span> <span class=\"k\">int</span> n;\n    <span class=\"k\">private final</span> Semaphore fooReady = <span class=\"k\">new</span> Semaphore(<span class=\"n\">1</span>);   <span class=\"c\">// foo goes first</span>\n    <span class=\"k\">private final</span> Semaphore barReady = <span class=\"k\">new</span> Semaphore(<span class=\"n\">0</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">foo</span>(Runnable printFoo) <span class=\"k\">throws</span> InterruptedException {\n        <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; n; i++) {\n            fooReady.<span class=\"f\">acquire</span>();\n            printFoo.<span class=\"f\">run</span>();\n            barReady.<span class=\"f\">release</span>();          <span class=\"c\">// hand the turn to bar</span>\n        }\n    }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">bar</span>(Runnable printBar) <span class=\"k\">throws</span> InterruptedException {\n        <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; n; i++) {\n            barReady.<span class=\"f\">acquire</span>();\n            printBar.<span class=\"f\">run</span>();\n            fooReady.<span class=\"f\">release</span>();\n        }\n    }\n}</code></pre>\n\nThe idea: [[g:each thread has its own permit]]. After printing, it hands the permit to the next thread. The initial permit counts determine who goes first.\n\n**Approach 2 — `synchronized` + `wait/notifyAll` + a turn variable:**\n\n<pre><code><span class=\"k\">private</span> <span class=\"k\">int</span> turn = <span class=\"n\">0</span>;\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">foo</span>(Runnable p) <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (turn != <span class=\"n\">0</span>) <span class=\"f\">wait</span>();\n    p.<span class=\"f\">run</span>(); turn = <span class=\"n\">1</span>; <span class=\"f\">notifyAll</span>();\n}</code></pre>\n\nThis approach scales easily to three or more threads (`turn` cycles through them), but `notifyAll` wakes threads unnecessarily.\n\n<table class=\"cmp\"><thead><tr><th>Approach</th><th>Advantages</th><th>Drawbacks</th></tr></thead><tbody>\n<tr><td>Semaphore</td><td>concise, no explicit lock, clear intent</td><td>more threads require more semaphores</td></tr>\n<tr><td>wait/notifyAll + turn</td><td>scales easily to n threads</td><td>unnecessary wakeups; must remember <code>while</code></td></tr>\n<tr><td>Lock + n Condition</td><td>precise wakeups</td><td>the most verbose</td></tr>\n<tr><td>CyclicBarrier</td><td>suited to round-based synchronization</td><td>does not impose order within a round by itself</td></tr>\n</tbody></table>\n\n:::deep\n- [[r:Do not use `volatile` plus busy-waiting]] (`while (turn != 0) {}`). It produces the right output but burns CPU. The interviewer will immediately ask, *\"What if the other thread is slow?\"*\n- `Semaphore` generalizes to `n` threads: use a `Semaphore[n]` array; thread `i` waits on `sem[i]` and releases `sem[(i+1)%n]`. Explaining the general solution earns points.\n- The `printNumber` variant (LC 1116, zero-even-odd) follows the same pattern: one semaphore each for `zero`, `even`, and `odd`.\n- `Semaphore(1)` differs from `ReentrantLock`: a semaphore [[o:has no owner]], so thread A may acquire it and thread B may release it. That is precisely why it fits this problem while a lock does not.\n- `Exchanger` is the right tool when two threads need to exchange paired *data*, not merely hand off turns.\n- Always cover the edge cases: when `n` is zero, nothing is printed; and every thread must be able to exit, with none left blocked in `acquire` after the final round.\n\n- A fair Semaphore(1, true) can reduce starvation among queued acquirers, but it does not establish output order; the permit handoff does.\n- If foo/bar is interrupted or printing fails after acquire, publish cancellation and release or wake the peer according to a terminal-state policy; otherwise the other loop can block forever.\n- Test ordering with a barrier that starts both methods repeatedly. Inject interruption and failure at each handoff, then assert the peer exits instead of waiting on a permit that will never return.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q3","q":"Dining philosophers: which approaches prevent deadlock?","a":"Five philosophers, five forks, and each philosopher needs the two adjacent forks. If everyone picks up the left fork first, the result is a perfect [[r:deadlock]].\n\nThis problem is really about the four Coffman conditions and four ways to break them.\n\n**Proof labels — safety · liveness · ordering · visibility.**\n\nFor resource ordering, define one total order for every fork and acquire strictly ascending. A philosopher may hold a lower-ranked fork while waiting for a higher-ranked one.\n\nA circular wait would require an edge to go down the order; that is impossible. This proves deadlock freedom, not starvation freedom.\n\n**Approach 1 — Resource ordering** (the most common approach; breaks \"circular wait\"):\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">wantsToEat</span>(<span class=\"k\">int</span> p, Runnable pickLeft, Runnable pickRight,\n                        Runnable eat, Runnable putLeft, Runnable putRight) {\n    <span class=\"k\">int</span> left = p, right = (p + <span class=\"n\">1</span>) % <span class=\"n\">5</span>;\n    <span class=\"k\">int</span> first = Math.<span class=\"f\">min</span>(left, right), second = Math.<span class=\"f\">max</span>(left, right);\n<span class=\"c\">    </span>\n    forks[first].<span class=\"f\">lock</span>();                <span class=\"c\">// ALWAYS acquire the lower-numbered fork first</span>\n    forks[second].<span class=\"f\">lock</span>();\n    <span class=\"k\">try</span> {\n        pickLeft.<span class=\"f\">run</span>(); pickRight.<span class=\"f\">run</span>();\n        eat.<span class=\"f\">run</span>();\n        putLeft.<span class=\"f\">run</span>(); putRight.<span class=\"f\">run</span>();\n    } <span class=\"k\">finally</span> {\n        forks[second].<span class=\"f\">unlock</span>(); forks[first].<span class=\"f\">unlock</span>();\n    }\n}</code></pre>\n\n**Approach 2 — Limit how many philosophers may sit at the table** (breaks \"hold and wait\"): use `Semaphore(4)` for five philosophers, ensuring that at least one can always acquire both forks.\n\nThis breaks deadlock, but the semaphore's default unfairness does not prove starvation freedom; choose fair permits or an explicit queue when every philosopher needs a turn.\n\n**Approach 3 — Asymmetry**: even-numbered philosophers pick up the left fork first; odd-numbered philosophers pick up the right one first.\n\n**Approach 4 — `tryLock` with a timeout** (breaks \"no preemption\"): if a philosopher cannot acquire both forks, [[r:release everything]] and retry. Watch for [[o:livelock]]; randomized backoff is required.\n\n:::deep\n- The four Coffman conditions (all four are necessary for deadlock): [[b:mutual exclusion]], [[b:hold and wait]], [[b:no preemption]], and [[b:circular wait]]. Each approach above breaks one condition. Framing the answer this way makes the reasoning rigorous.\n- [[g:Resource ordering]] is the most broadly applicable technique in production: when transferring money between two accounts, always lock them in ascending ID order. Connecting this to 5.10 (database deadlocks) is a strong bonus.\n- `tryLock` without backoff can produce livelock: everyone repeatedly acquires and releases in lockstep, so nobody gets to eat. The CPUs remain busy, yet the system makes no progress; recognizing that distinction demonstrates depth.\n- Fairness: `new ReentrantLock(true)` can reduce starvation by favoring queued waiters, but it adds scheduling overhead and is not a substitute for bounded work inside the critical section. State the trade-off instead of choosing one policy by default.\n- A fifth concern that is often overlooked is [[o:starvation]]. It is not deadlock: the system continues to run, but one philosopher never gets a turn. Approach 2 and fair locks address it.\n- Production mapping: forks can represent database row locks, pooled connections, or file locks. It is the same problem with different names.\n\n- Test a bounded run with every approach under contention; inject interruption and timeout while a philosopher holds one resource. Assert every acquired fork is released, then record both deadlock freedom and wait-time/starvation rather than only the final output.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q4","q":"Read-heavy, write-light workloads: ReadWriteLock, StampedLock, or copy-on-write?","a":"**Proof labels — safety · ordering · visibility.**\n\n<table class=\"cmp\"><thead><tr><th>Tool</th><th>Mechanism</th><th>Best fit</th></tr></thead><tbody>\n<tr><td><code>synchronized</code></td><td>one thread at a time</td><td>frequent writes or a very short critical section</td></tr>\n<tr><td><code>ReentrantReadWriteLock</code></td><td>multiple readers OR one writer</td><td>reads ≫ writes and long critical sections</td></tr>\n<tr><td><code>StampedLock</code></td><td>adds lock-free <b>optimistic reads</b></td><td>extremely frequent reads and very rare writes</td></tr>\n<tr><td><code>CopyOnWriteArrayList</code></td><td>copies the entire array on each write</td><td><b>extremely rare</b> writes (listener lists)</td></tr>\n</tbody></table>\n\n**`StampedLock` — the standard optimistic-read pattern:**\n\n<pre><code><span class=\"k\">private final</span> StampedLock sl = <span class=\"k\">new</span> StampedLock();\n<span class=\"c\">//</span>\n<span class=\"k\">public</span> <span class=\"k\">double</span> <span class=\"f\">distanceFromOrigin</span>() {\n    <span class=\"k\">long</span> stamp = sl.<span class=\"f\">tryOptimisticRead</span>();      <span class=\"c\">// acquire NO lock</span>\n    <span class=\"k\">double</span> cx = x, cy = y;                    <span class=\"c\">// copy values into local variables</span>\n    <span class=\"k\">if</span> (!sl.<span class=\"f\">validate</span>(stamp)) {               <span class=\"c\">// did a writer intervene?</span>\n        stamp = sl.<span class=\"f\">readLock</span>();               <span class=\"c\">// yes =&gt; fall back to a real read lock</span>\n        <span class=\"k\">try</span> { cx = x; cy = y; } <span class=\"k\">finally</span> { sl.<span class=\"f\">unlockRead</span>(stamp); }\n    }\n    <span class=\"k\">return</span> Math.<span class=\"f\">sqrt</span>(cx * cx + cy * cy);\n}</code></pre>\n\nOptimistic read is not a read lock. Copy every field in the snapshot before validate; if validation fails, discard the entire local snapshot and reread under readLock. This is safe only for state protected by this StampedLock, not a transaction across unrelated state.\n\nThe fast path performs no memory writes → it can be much faster than `ReadWriteLock` when writes are rare. The trade-off is that you must follow the pattern exactly: copy into local variables, call `validate`, and provide a fallback path.\n\n:::warn StampedLock is not reentrant\nRe-entering it can [[r:deadlock immediately]], unlike `synchronized` and `ReentrantLock`. It also does not support `Condition`. This is the main reason it should not be the default choice.\n:::\n\n:::deep\n- `ReadWriteLock` is [[r:not]] always faster than `synchronized`. Its bookkeeping costs more, so `synchronized` wins for short critical sections of just a few lines. [[o:Measure it]]; do not guess.\n- Writer starvation: the default non-fair `ReentrantReadWriteLock` can admit readers continuously while a writer waits indefinitely. `new ReentrantReadWriteLock(true)` fixes that at the cost of throughput.\n- You can [[g:downgrade]] (write → read), but you [[r:cannot upgrade]] (read → write). Upgrading is a classic deadlock when two readers both attempt it.\n- A write to `CopyOnWriteArrayList` is O(n) and creates garbage. It is ideal for listener lists that are populated at startup and read forever, but a [[r:disaster]] for lists that change continuously.\n- A copy-on-write iterator captures a snapshot at creation time: iteration never throws `ConcurrentModificationException`, but it also does not observe later changes. State that semantic explicitly.\n- Often, [[g:the best lock is no lock]]: use `ConcurrentHashMap`, `AtomicReference` + `updateAndGet`, or an immutable snapshot swapped with a single volatile assignment.\n\n- Copy-on-write allocates a new backing array O(n) for each mutation. Old snapshots may remain live while iterators or readers use them, so memory and GC pressure depend on element count, write bursts, and retained iterators. Measure allocation and write latency; read-heavy alone is not enough.\n- Test optimistic reads while writers mutate, validate before using composite values, and verify the fallback path. Test that a copy-on-write iterator sees its creation-time snapshot, then measure allocation under a write burst.\n:::","difficulty":"advanced"}]},{"title":"Async & the modern toolkit","items":[{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q1","q":"CompletableFuture: how do you correctly make parallel calls, handle failures, and enforce timeouts?","a":"A common interview prompt: *\"A booking page must call three services (pricing, seat availability, and promotions). How do you run them in parallel so total latency is determined by the slowest service?\"*\n\n**Proof labels — safety · liveness · visibility.**\n\nThe safety boundary is one result contract per request; liveness is bounded completion and cancellation; visibility follows the future and executor handoff. Failure policy must be explicit at the fan-in point.\n\n<pre><code>CompletableFuture&lt;Price&gt; price =\n    CompletableFuture.<span class=\"f\">supplyAsync</span>(() -&gt; priceApi.<span class=\"f\">get</span>(id), pool)\n        .<span class=\"f\">orTimeout</span>(<span class=\"n\">800</span>, MILLISECONDS)              <span class=\"c\">// Java 9+</span>\n        .<span class=\"f\">exceptionally</span>(e -&gt; Price.<span class=\"f\">unavailable</span>());   <span class=\"c\">// degrade gracefully; do not fail the entire page</span>\n<span class=\"c\">//</span>\nCompletableFuture&lt;Seats&gt; seats =\n    CompletableFuture.<span class=\"f\">supplyAsync</span>(() -&gt; seatApi.<span class=\"f\">get</span>(id), pool)\n        .<span class=\"f\">orTimeout</span>(<span class=\"n\">800</span>, MILLISECONDS)\n        .<span class=\"f\">exceptionally</span>(e -&gt; Seats.<span class=\"f\">unknown</span>());\n<span class=\"c\">//</span>\n<span class=\"c\">// allOf waits for every stage; the subsequent join() calls no longer block in practice</span>\nCompletableFuture&lt;Page&gt; page = CompletableFuture\n    .<span class=\"f\">allOf</span>(price, seats)\n    .<span class=\"f\">thenApply</span>(v -&gt; <span class=\"k\">new</span> Page(price.<span class=\"f\">join</span>(), seats.<span class=\"f\">join</span>()));</code></pre>\n\n**Methods you must distinguish:**\n- `thenApply` (synchronous transformation) vs `thenCompose` (chain another future — [[o:effectively flatMap]])\n- `thenCombine` (combine **two** futures) vs `allOf` (wait for **many**) vs `anyOf` (take the first to complete)\n- `exceptionally` (runs only on failure) vs `handle` (runs on success or failure) vs `whenComplete` (observes the outcome without transforming it)\n\n:::warn Three traps you must know\n[[r:Using ForkJoinPool.commonPool()]] for I/O can saturate a resource [[o:shared across the JVM]]. Its default parallelism is often available processors minus one, but runtime configuration and container limits can differ. Inspect it; use an owned I/O pool.\n:::\n\n[[r:Calling `get()`/`join()` too early]] in the chain turns asynchronous work into sequential work and eliminates the benefit. [[r:Swallowing exceptions]]: without `exceptionally`/`handle`, the failure remains in the future until `join()` surfaces it, wrapped in `CompletionException`.\n:::deep\n- `thenApply` vs `thenApplyAsync`: the non-`Async` variant may run on [[o:the thread that completes the preceding stage]]. If that is Netty's I/O thread, you have just occupied the event loop. Heavy work belongs in the `Async` variant with a dedicated pool.\n- `orTimeout` (Java 9+) completes the future exceptionally with `TimeoutException`; `completeOnTimeout` supplies a default value. The latter is often the better degradation policy.\n- A `CompletableFuture` timeout [[r:does not cancel the underlying HTTP call]]; its thread can continue running to completion. You must also configure a timeout at the client layer (18-query-optimization.rewriting-the-query-reshaping-the-model.q4).\n- `allOf` returns `CompletableFuture&lt;Void&gt;`. To obtain the results, `join()` each constituent future afterward; that is safe because they have completed.\n- Failures are wrapped in `CompletionException`. Use `ex.getCause()` when classifying them; this is easy to forget.\n- Context such as MDC, trace IDs, and SecurityContext [[r:does not propagate automatically]] to another thread. Wrap the executor (for example, with Spring's `TaskDecorator`), or logs will lose their trace ID (20-observability-sre.slos-alerting-incidents.q4).\n- Java 21+: for I/O, [[g:virtual threads plus sequential code]] are often far clearer than a `CompletableFuture` chain (23-java-concurrency-coding.async-the-modern-toolkit.q4). Mentioning this shows that your concurrency model is current.\n\n- Exception policy belongs at fan-in. If degraded values are not acceptable, keep raw futures, use handle to collect outcome records, and make the aggregate preserve the root causes. allOf does not cancel siblings.\n- orTimeout only completes the stage. Keep a handle to the HTTP client's request or Future, configure a client-level deadline, and close or cancel that resource on timeout. Future.cancel(true) is only an interrupt request; test that the I/O stops and releases sockets.\n- The executor is an owned resource: use a bounded executor for the blocking workload, define rejection or degradation when full, and shut it down after its lifecycle. Never shut down an executor shared by other callers.\n- Test one fast failure, one slow child, timeout, and caller cancellation; assert the slow client is closed and no late side effect remains after the page future completes.\n:::","difficulty":"core"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q2","q":"CountDownLatch, CyclicBarrier, Semaphore, and Phaser: how do they differ?","a":"These four synchronization tools are often asked about back-to-back because they are easy to confuse.\n\n**Proof labels — safety · liveness · visibility.**\n\nThe safety property is the intended phase or permit state; liveness requires every participant to reach a terminal phase or be cancelled; synchronizer memory effects provide visibility across the handoff.\n\n<table class=\"cmp\"><thead><tr><th>Tool</th><th>Purpose</th><th>Reusable</th><th>Who waits for whom</th></tr></thead><tbody>\n<tr><td><code>CountDownLatch</code></td><td>wait for N tasks to finish before proceeding</td><td><b>no</b> — one-shot</td><td>one or more waiters await N events</td></tr>\n<tr><td><code>CyclicBarrier</code></td><td>rendezvous N threads at one point</td><td><b>yes</b> — resets automatically</td><td>the threads wait for one another</td></tr>\n<tr><td><code>Semaphore</code></td><td>limit concurrent entrants</td><td>yes</td><td>threads wait for permits</td></tr>\n<tr><td><code>Phaser</code></td><td>a barrier whose party count <b>can change</b></td><td>yes, across multiple phases</td><td>flexible</td></tr>\n</tbody></table>\n\n**`CountDownLatch` — accept traffic only after startup completes:**\n\n<pre><code>CountDownLatch ready = <span class=\"k\">new</span> CountDownLatch(<span class=\"n\">3</span>);\n<span class=\"c\">//</span>\npool.<span class=\"f\">submit</span>(() -&gt; { loadCache();  ready.<span class=\"f\">countDown</span>(); });\npool.<span class=\"f\">submit</span>(() -&gt; { warmPool();   ready.<span class=\"f\">countDown</span>(); });\npool.<span class=\"f\">submit</span>(() -&gt; { loadConfig(); ready.<span class=\"f\">countDown</span>(); });\n<span class=\"c\">//</span>\n<span class=\"k\">if</span> (!ready.<span class=\"f\">await</span>(<span class=\"n\">30</span>, SECONDS)) <span class=\"k\">throw</span> <span class=\"k\">new</span> IllegalStateException(<span class=\"s\">\"startup timed out\"</span>);</code></pre>\n\n**`CyclicBarrier` — round-based simulation, with every participant meeting after each round:**\n\n<pre><code>CyclicBarrier barrier = <span class=\"k\">new</span> CyclicBarrier(<span class=\"n\">4</span>, () -&gt; <span class=\"f\">mergeRoundResults</span>());\n<span class=\"c\">// each worker has finished computing one round</span>\nbarrier.<span class=\"f\">await</span>();     <span class=\"c\">// the last worker to arrive runs mergeRoundResults()</span></code></pre>\n\n:::deep\n- The key distinction: `CountDownLatch` [[o:cannot be reset]]. For repeated coordination, create a new latch or use `CyclicBarrier`/`Phaser`. This is the most common comparison question.\n- `countDown()` [[g:must]] be in a `finally` block; otherwise, one task throwing an exception can leave everyone waiting forever.\n- `await()` [[g:should always have a timeout]]. Waiting indefinitely in a production service is a recipe for hanging the entire system.\n- `CyclicBarrier` throws [[r:`BrokenBarrierException`]] for *every* participant when one thread is interrupted or times out. This is deliberate: without the full group, the round is meaningless.\n- `Semaphore` limits [[o:concurrency]] (for example, at most 10 simultaneous calls to a partner). This is a manual bulkhead, not rate limiting, which limits work over time (22.3).\n- `Phaser` is powerful but less common: the number of registered parties can change between phases (`register`/`arriveAndDeregister`), which suits multi-stage computations whose workers join and leave.\n- Java 21+: [[g:`StructuredTaskScope`]] can replace most \"run several tasks, then wait\" use cases more safely by canceling siblings automatically when one branch fails (23-java-concurrency-coding.async-the-modern-toolkit.q4).\n\n- Exercise the failure lifecycle: make one worker throw before countDown, interrupt a barrier waiter, exhaust semaphore permits, and add or remove Phaser parties. Every test needs a timeout and must verify that no worker remains blocked.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q3","q":"Atomics and CAS: how do you implement a lock-free counter/stack, and what is the ABA problem?","a":"**Proof labels — safety · linearizability · liveness · visibility.**\n\nThe counter invariant is exact only when the operation's atomicity matches the business rule; a stack additionally needs linearizability and a progress argument. CAS visibility does not prove either one.\n\n[[b:CAS]] (compare-and-swap) is an atomic CPU instruction: *\"If the memory location still equals `expected`, replace it with `newValue`.\"* The entire `java.util.concurrent.atomic` package is built on it.\n\n<pre><code><span class=\"c\">// The essence of incrementAndGet: a retry loop</span>\n<span class=\"k\">public</span> <span class=\"k\">int</span> <span class=\"f\">increment</span>() {\n    <span class=\"k\">int</span> cur, next;\n    <span class=\"k\">do</span> {\n        cur  = value.<span class=\"f\">get</span>();\n        next = cur + <span class=\"n\">1</span>;\n    } <span class=\"k\">while</span> (!value.<span class=\"f\">compareAndSet</span>(cur, next));   <span class=\"c\">// on failure, reread and retry</span>\n    <span class=\"k\">return</span> next;\n}</code></pre>\n\nNo locking and no blocking: a losing thread retries. This is [[g:lock-free]] as a system-level progress claim—some operation completes despite contention—not a guarantee that every thread finishes within a bound.\n\n**Lock-free stack (Treiber stack):**\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">push</span>(T item) {\n    Node&lt;T&gt; newHead = <span class=\"k\">new</span> Node&lt;&gt;(item);\n    Node&lt;T&gt; oldHead;\n    <span class=\"k\">do</span> {\n        oldHead = head.<span class=\"f\">get</span>();\n        newHead.next = oldHead;\n    } <span class=\"k\">while</span> (!head.<span class=\"f\">compareAndSet</span>(oldHead, newHead));\n}</code></pre>\n\n**The ABA problem:** thread 1 reads `head = A`. Before it performs CAS, thread 2 pops A, pops B, and then pushes A back. Thread 1's CAS [[r:still succeeds]] because the head is again `A`, but `A.next` has changed and the stack is corrupted.\n\nThe solution is to [[g:attach a version number]]. AtomicStampedReference compares both the reference and the stamp. It detects a class of ABA histories; it does not by itself prove the algorithm's linearizability, prevent stamp overflow, or define safe node-reclamation policy.\n\n<pre><code>AtomicStampedReference&lt;Node&gt; head = <span class=\"k\">new</span> AtomicStampedReference&lt;&gt;(<span class=\"k\">null</span>, <span class=\"n\">0</span>);\nhead.<span class=\"f\">compareAndSet</span>(oldHead, newHead, stamp, stamp + <span class=\"n\">1</span>);</code></pre>\n\n:::deep\n- CAS excels under [[o:low contention]]. Under high contention, retry loops burn CPU and can be [[r:slower than locks]]; a lock can at least park the thread.\n- Use [[g:LongAdder for high-contention statistics]], not for an exact balance, sequence, or ID. It spreads updates across cells and combines them on read; sum() is not an atomic snapshot while updates continue. Prefer AtomicLong, a lock, or ownership when the invariant needs an exact value.\n- GC makes ABA [[o:less dangerous]] than C++ for reclamation: a reachable object is not reclaimed and reused as an unrelated object. Logical A→B→A is still possible, and deliberately reused nodes still need a version or stamp plus an algorithm proof.\n- `AtomicReference.updateAndGet(fn)` packages the CAS loop for you. The [[r:function must be pure]] and free of side effects because it may be invoked multiple times.\n- The atomic API gives operations, not a proof that your stack is linearizable or lock-free. Distinguish the progress guarantees: [[o:lock-free]] means system-wide progress, stronger than [[o:obstruction-free]] and weaker than [[o:wait-free]], where every thread completes within a finite number of steps.\n- `volatile` provides visibility only; CAS provides both visibility and atomicity. This is one of the most common conceptual follow-ups (see 1.1, JMM).\n- Java 9+ provides `VarHandle` instead of `Unsafe` for low-level atomic operations; knowing the name is sufficient.\n\n- Use jcstress for JMM and atomic interleavings, and a linearizability or history checker for the stack. Include CAS-failure and progress observations, ABA or version-wrap cases, and memory-reclamation assumptions; a final-size assertion alone misses stale-state histories.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q4","q":"Virtual threads (Java 21+): how do they change the way you write concurrency code?","a":"**Proof labels — safety · liveness · visibility.**\n\nThe lifetime safety rule is that child work stays inside its owner scope; liveness is bounded by downstream admission and cancellation; virtual-thread scheduling does not remove either resource contract.\n\nA virtual thread is a Java `Thread` scheduled by the [[o:JVM]] over carrier threads. It is cheap enough to create per task; supported blocking operations park and unmount it so the carrier can run other work.\n\n<pre><code><span class=\"c\">// One virtual thread per task; this executor is not a reusable thread pool</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> executor = Executors.<span class=\"f\">newVirtualThreadPerTaskExecutor</span>()) {\n    <span class=\"k\">for</span> (<span class=\"k\">var</span> id : bookingIds) {\n        executor.<span class=\"f\">submit</span>(() -&gt; {\n            <span class=\"k\">var</span> price = priceApi.<span class=\"f\">get</span>(id);\n            <span class=\"k\">var</span> seats = seatApi.<span class=\"f\">get</span>(id);\n            <span class=\"k\">return new</span> Page(price, seats);\n        });\n    }\n} <span class=\"c\">// close() waits for submitted tasks</span></code></pre>\n\nThe main benefit is [[g:structured-looking blocking code]] with ordinary stack traces, exceptions, and debugger behavior at high I/O concurrency. It is not automatically faster than reactive code, and it does not add backpressure.\n\n**JDK 25 preview API — manage related task lifetimes together:**\n\n<pre><code><span class=\"c\">// Compile and run with --enable-preview on JDK 25</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> scope = StructuredTaskScope.<span class=\"f\">open</span>()) {\n    <span class=\"k\">var</span> price = scope.<span class=\"f\">fork</span>(() -&gt; priceApi.<span class=\"f\">get</span>(id));\n    <span class=\"k\">var</span> seats = scope.<span class=\"f\">fork</span>(() -&gt; seatApi.<span class=\"f\">get</span>(id));\n    scope.<span class=\"f\">join</span>();                         <span class=\"c\">// failure cancels the sibling and propagates</span>\n    <span class=\"k\">return new</span> Page(price.<span class=\"f\">get</span>(), seats.<span class=\"f\">get</span>());\n}</code></pre>\n\n**JDK 25 preview boundary:** The no-argument StructuredTaskScope.open() is a fail-fast preview policy: a failed subtask cancels siblings and join propagates the failure.\n\n:::warn Pinning guidance changed in JDK 24\nOn JDK 21–23, blocking while holding a `synchronized` monitor could pin the carrier, so moving I/O out of the monitor or using `ReentrantLock` was a valid targeted fix.\n:::\n\nJEP 491 removed monitor-related pinning in JDK 24. Native/foreign calls and class-initialization edge cases can still hold a carrier, but replacing every monitor is no longer sound advice.\n:::deep\n- [[r:Do not pool virtual threads]] merely to bound a scarce resource. Create one per task, then use a semaphore or the downstream's real pool as the capacity control; pooling tasks and limiting a resource are different concerns.\n- `ThreadLocal` remains compatible, but per-thread mutable state can be costly at large concurrency. `ScopedValue` is final in JDK 25 for immutable bounded context; it is not a replacement for all mutable thread-local state.\n- CPU-bound work remains limited by cores. Use bounded parallelism and measure context-switch/queue overhead.\n- A 20-connection database pool still admits only 20 concurrent queries. Cheap waiters can improve utilization, but excessive waiters consume memory and exhaust deadlines.\n- For JDK 21–23, `jdk.VirtualThreadPinned` JFR data and `-Djdk.tracePinnedThreads` can locate monitor pinning. The system property was removed in JDK 24; on newer JDKs use JFR, JSON thread dumps, carrier utilization, and latency evidence.\n- `StructuredTaskScope` is preview in JDK 25 and its constructors changed to `open(...)`; do not publish the older `new ShutdownOnFailure()` form as JDK 25 code.\n\nUse reactive/event-loop I/O where explicit streaming and backpressure fit the whole stack; use virtual threads where blocking APIs and sequential control flow improve maintainability. Compare the broader models in (15-network-i-o-models.realtime-event-driven.q3).\n\n- JEP 491 changed monitor pinning in JDK 24; it did not promise that virtual threads never pin. Test native or foreign calls, class initialization, and blocking resource clients on the target JDK with JFR instead of inferring safety from thread count.\n- Test cancellation and scope close: interrupt a child during I/O, verify resource cleanup, and run the same pinning probe on JDK 21–23 versus JDK 24+.\n:::","difficulty":"extra"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q5","difficulty":"core","q":"Interview drill: 20 threads each add one million to a `volatile int counter`. Is the total right, and how do you prove your answer?","a":"**Proof labels — safety · visibility.**\n\nThe safety question is whether each increment is an atomic compound action; volatile supplies visibility and ordering only. The proof must cover every interleaving, not one benchmark result.\n\nNo guarantee. The maximum is [[r:20,000,000]], and that result is possible when increments happen without overlapping. With concurrent read-modify-write interleavings, lost updates can make the result smaller; volatile provides visibility and ordering, not atomicity.\n\n`counter++` is three bytecodes: read the field, add one, write it back. Two threads that read the same value both write back `v + 1`, so one increment disappears. `volatile` guarantees each read sees a value from the synchronization order; it never fuses the three steps into one.\n\n<pre><code><span class=\"k\">static volatile int</span> counter = <span class=\"n\">0</span>;\n<span class=\"c\">// 20 threads x 1_000_000 increments</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> pool = Executors.<span class=\"f\">newFixedThreadPool</span>(<span class=\"n\">20</span>)) {\n    <span class=\"k\">for</span> (<span class=\"k\">int</span> t = <span class=\"n\">0</span>; t &lt; <span class=\"n\">20</span>; t++)\n        pool.<span class=\"f\">submit</span>(() -&gt; { <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; <span class=\"n\">1_000_000</span>; i++) counter++; });\n}\nSystem.out.<span class=\"f\">println</span>(counter);   <span class=\"r\">// e.g. 3_147_882 — lower is possible; 20_000_000 is possible too, so one run proves nothing</span></code></pre>\n\n**The fix ladder, cheapest correct option first:**\n\n<table class=\"cmp\"><thead><tr><th>Tool</th><th>Use when</th><th>What it costs</th></tr></thead><tbody>\n<tr><td>`AtomicInteger`</td><td>one counter, moderate contention</td><td>CAS retries, all on one cache line</td></tr>\n<tr><td>`LongAdder`</td><td>write-heavy counter, read rarely</td><td>striped cells; `sum()` is not a snapshot while writes continue</td></tr>\n<tr><td>`synchronized` / lock</td><td>two or more fields must move together</td><td>blocking; keeping the critical section small is on you</td></tr>\n<tr><td>no sharing at all</td><td>per-thread totals combined at the end</td><td>nothing — this is why reduce and collect scale</td></tr>\n</tbody></table>\n\n:::warn What volatile is actually for\nPublication, not accumulation: a `stop` flag, a swapped configuration reference — state whose every invariant fits inside one atomic read or one atomic write (01-java-core-jvm.memory-execution-model.q1).\n:::\n\n:::deep\n**\"Run it and look\" is a weak proof.** A lost update is timing-dependent, and a JIT-optimised loop on an idle laptop can print the right number while proving nothing. Two stronger arguments:\n\n- *by construction* — name the three steps and the interleaving that drops one; no measurement makes that safe\n- *by tooling* — jcstress, the OpenJDK concurrency harness, drives the interleavings and reports the outcomes actually observed, including ones a plain test never reaches\n\n**Atomics do not make compound actions atomic either.** `if (counter.get() &lt; limit) counter.incrementAndGet()` is the same bug one level up: use `compareAndSet` in a loop, `updateAndGet`, or a lock (23-java-concurrency-coding.async-the-modern-toolkit.q3).\n\n**Watch the read side too.** Incrementing under a lock is correct, but reading the field from another thread without that lock is a fresh visibility problem — the fix has to cover both sides of the field, which is exactly what `AtomicInteger` gives you in one object.\n\n**Test hooks.** A jcstress test with Actor methods and an Arbiter can record allowed outcomes for the race; a stress test can expose loss but cannot prove its absence. For an exact total, use AtomicInteger, a lock, or per-thread ownership followed by a final reduction.\n:::"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q6","q":"How do you design cancellation and backpressure for async fan-out without orphan work?","a":"Start with the resource contract, not with `CompletableFuture.allOf`. Fan-out must have a parent deadline, a bounded admission policy, an explicit executor owner, and a rule for what happens to children when the caller leaves.\n\n**Proof labels — safety · liveness · ordering · visibility.**\n\nThe safety property is no work or side effect after scope closure; liveness is bounded completion and cancellation; ordering covers deadline and admission propagation; visibility follows the owned cancellation state.\n\n<table class=\"cmp\"><thead><tr><th>Concern</th><th>Required decision</th><th>Failure to test</th></tr></thead><tbody>\n<tr><td>Admission</td><td>Bound concurrency with a semaphore, bounded executor/queue, or structured scope; reject or degrade explicitly</td><td>Unbounded fan-out exhausts CPU, sockets, DB connections or provider quota</td></tr>\n<tr><td>Deadline</td><td>Carry one monotonic deadline into each child and subtract elapsed time</td><td>Each child gets a fresh timeout and total latency exceeds the request budget</td></tr>\n<tr><td>Failure policy</td><td>Choose fail-fast, best-effort aggregation, or partial result; preserve the first/root cause</td><td>One failure is hidden behind an aggregate exception or partial side effects are mistaken for success</td></tr>\n<tr><td>Cancellation</td><td>Define whether cancellation interrupts the task, closes the I/O, releases permits, and prevents retries</td><td>`orTimeout` completes a future while the underlying supplier keeps running</td></tr>\n<tr><td>Lifecycle</td><td>Own and shut down executors; do not leak work into the common pool or a request-scoped executor</td><td>Orphan tasks survive deploy/shutdown and continue writing after the response timed out</td></tr>\n</tbody></table>\n\n:::deep\n- `CompletableFuture.orTimeout` changes completion of the future; it is not a proof that arbitrary blocking I/O stopped. The adapter must own cancellation/close semantics, and tests must observe the resource after timeout.\n- `allOf` does not decide whether sibling tasks should be cancelled, whether their exceptions are collected, or whether side effects are safe to retry. Write that policy in code and documentation.\n- A semaphore limits admission but does not cancel work already admitted; a bounded queue creates a different latency/rejection contract. Measure queue age, permit wait, child p99 and cancellation lag.\n- `StructuredTaskScope` in the researched JDK 25 API is preview. It provides a useful lifetime model, but the selected compiler/runtime must opt in and the application still needs downstream bulkheads.\n- For mutations, cancellation may leave an unknown external outcome. Use an idempotency key and reconciliation boundary rather than blindly retrying a timed-out child.\n- Tests should cover deadline propagation, sibling cancellation, executor shutdown, interrupted/late completion, retry suppression, permit release and no work after the request scope closes.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"23-java-concurrency-coding","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-de