bel":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"23-java-concurrency-coding.classic-synchronisation-problems.q1":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q2":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q3":"2026-09-12","23-java-concurrency-coding.classic-synchronisation-problems.q4":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q1":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q2":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q3":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q4":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q5":"2026-09-12","23-java-concurrency-coding.async-the-modern-toolkit.q6":"2026-09-12"},"lang":"vi","body":{"sections":[{"title":"Bài đồng bộ kinh điển","items":[{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q1","q":"Bounded blocking queue: cài bằng wait/notify và bằng Lock/Condition?","a":"Bài \"hello world\" của concurrency. Cách bạn viết nó lộ ra ngay mức độ thành thạo.\n\n**Nhãn chứng minh — safety · liveness · visibility.**\n\nInvariant an toàn là 0 ≤ q.size() ≤ cap. Liveness yêu cầu mỗi signal hoặc notifyAll đánh thức thread đang chờ có predicate có thể đã đúng. Việc nhả rồi giành lại lock/monitor tạo visibility; interruption là một phần contract.\n\n**Bản `ReentrantLock` + hai `Condition`** (nên trình bày bản này):\n\n<pre><code><span class=\"k\">class</span> BoundedQueue&lt;T&gt; {\n    <span class=\"k\">private final</span> Queue&lt;T&gt; q = <span class=\"k\">new</span> ArrayDeque&lt;&gt;();\n    <span class=\"k\">private final</span> <span class=\"k\">int</span> cap;\n    <span class=\"k\">private final</span> ReentrantLock lock = <span class=\"k\">new</span> ReentrantLock();\n    <span class=\"k\">private final</span> Condition notFull  = lock.<span class=\"f\">newCondition</span>();\n    <span class=\"k\">private final</span> Condition notEmpty = lock.<span class=\"f\">newCondition</span>();\n<span class=\"c\">    </span>\n    <span class=\"f\">BoundedQueue</span>(<span class=\"k\">int</span> cap) { <span class=\"k\">this</span>.cap = cap; }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">put</span>(T x) <span class=\"k\">throws</span> InterruptedException {\n        lock.<span class=\"f\">lockInterruptibly</span>();\n        <span class=\"k\">try</span> {\n            <span class=\"k\">while</span> (q.<span class=\"f\">size</span>() == cap) notFull.<span class=\"f\">await</span>();   <span class=\"c\">// WHILE, không phải IF</span>\n            q.<span class=\"f\">add</span>(x);\n            notEmpty.<span class=\"f\">signal</span>();                        <span class=\"c\">// chỉ đánh thức consumer</span>\n        } <span class=\"k\">finally</span> { lock.<span class=\"f\">unlock</span>(); }\n    }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> T <span class=\"f\">take</span>() <span class=\"k\">throws</span> InterruptedException {\n        lock.<span class=\"f\">lockInterruptibly</span>();\n        <span class=\"k\">try</span> {\n            <span class=\"k\">while</span> (q.<span class=\"f\">isEmpty</span>()) notEmpty.<span class=\"f\">await</span>();\n            T x = q.<span class=\"f\">poll</span>();\n            notFull.<span class=\"f\">signal</span>();\n            <span class=\"k\">return</span> x;\n        } <span class=\"k\">finally</span> { lock.<span class=\"f\">unlock</span>(); }\n    }\n}</code></pre>\n\n**Bản `wait`/`notify`** — cùng logic, nhưng chỉ có [[o:một]] hàng chờ nên bắt buộc `notifyAll()`:\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">put</span>(T x) <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (q.<span class=\"f\">size</span>() == cap) <span class=\"f\">wait</span>();\n    q.<span class=\"f\">add</span>(x);\n    <span class=\"f\">notifyAll</span>();          <span class=\"c\">// notify() có thể đánh thức nhầm producer =&gt; treo</span>\n}</code></pre>\n\n:::warn Ba lỗi kinh điển\n[[r:`if` thay vì `while`]] — spurious wakeup và tranh chấp sau khi được đánh thức làm điều kiện không còn đúng; phải kiểm tra lại.\n:::\n\n[[r:`notify()` với một hàng chờ chung]] — có thể đánh thức đúng loại thread đang chờ sai điều kiện → cả hệ treo. [[r:`unlock()` ngoài `finally`]] — ném exception giữa chừng là khoá không bao giờ được thả.\n:::deep\n- Ưu điểm quyết định của `Condition`: [[g:hai hàng chờ tách biệt]] → `signal()` (đánh thức một) thay cho `notifyAll()` (đánh thức tất cả rồi để chúng tranh nhau). Với queue nóng, khác biệt hiệu năng rất rõ.\n- `await()` [[o:nhả khoá]] khi chờ và giành lại trước khi trả về — không hiểu điều này thì không hiểu vì sao cả hai chờ trong cùng một khoá mà không deadlock\n- thực tế dùng `ArrayBlockingQueue`/`LinkedBlockingQueue` có sẵn — [[o:nêu ra]] rồi vẫn cài tay, vì đó là điều interviewer muốn thấy\n- ArrayBlockingQueue dùng một lock cho cả hai đầu. [[g:Implementation hiện tại của JDK dùng lock put/take tách biệt cho LinkedBlockingQueue]], có thể cho phép nhiều thao tác chồng lấn hơn; layout đó là chi tiết implementation, không phải contract của BlockingQueue.\n- biến thể hay bị hỏi thêm: `offer(x, timeout)` → `notFull.await(t, unit)` trả về `false` khi hết giờ; và đóng queue êm (cờ `closed` + `signalAll`)\n- lock-free hoàn toàn thì dùng `ConcurrentLinkedQueue` — nhưng nó [[r:không chặn và không có giới hạn]], nên không giải được đúng bài này\n\n**Contract shutdown (abridged):** BlockingQueue không có sẵn thao tác close. Giữ closed dưới cùng monitor, từ chối put mới, đánh thức mọi waiter, rồi để consumer rút hết phần tử hiện có trước khi trả kết quả kết thúc stream.\n\n<pre><code><span class=\"k\">private</span> <span class=\"k\">boolean</span> closed;\n<span class=\"c\">// cùng monitor và queue với ví dụ wait/notify</span>\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">close</span>() {\n    closed = <span class=\"k\">true</span>;\n    <span class=\"f\">notifyAll</span>();\n}\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> T <span class=\"f\">take</span>() <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (q.<span class=\"f\">isEmpty</span>() &amp;&amp; !closed) <span class=\"f\">wait</span>();\n    <span class=\"k\">if</span> (q.<span class=\"f\">isEmpty</span>()) <span class=\"k\">return</span> <span class=\"k\">null</span>; <span class=\"c\">// đã close và queue đã cạn</span>\n    T x = q.<span class=\"f\">remove</span>();\n    <span class=\"f\">notifyAll</span>();\n    <span class=\"k\">return</span> x;\n}</code></pre>\n\nVì BlockingQueue không cho phần tử null, null có thể là kết quả kết thúc stream dành riêng trong API abridged này.\n\nput phải chờ khi !closed và q.size() == cap, rồi từ chối sau close. wait, await, put và take có thể ném InterruptedException: propagate nó, hoặc restore interrupt flag sau cleanup; không được nuốt lỗi.\n\nDùng ArrayBlockingQueue hoặc LinkedBlockingQueue cho contract queue: put/take có thể bị interrupt, offer/poll có timeout, và capacity rõ ràng. Đặt closure bên ngoài contract đó bằng wrapper state hoặc sentinel; đừng phụ thuộc vào layout của implementation hiện tại.\n\n- Test trạng thái full/empty với nhiều producer/consumer; close khi put/take đang chờ; interrupt từng wait; assert size có bound, đánh thức kịp thời, drain hết item và không còn task bị kẹt.\n:::","difficulty":"core"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q2","q":"In xen kẽ theo thứ tự (print FooBar / print in order): các cách và trade-off?","a":"LC 1114/1115. Đề: hai (hoặc ba) thread, buộc output ra đúng thứ tự dù thứ tự chạy tuỳ ý.\n\n**Nhãn chứng minh — safety · ordering · liveness · visibility.**\n\nThuộc tính safety là output phải đúng thứ tự; fairness là policy lập lịch, không phải bằng chứng của ordering. Cancellation là chuyện riêng: nếu một participant thoát sau khi lấy permit, thread đối diện có thể chờ mãi trừ khi protocol công bố trạng thái kết thúc và đánh thức cả hai bên.\n\n**Cách 1 — `Semaphore` (gọn nhất, nên dùng để trình bày):**\n\n<pre><code><span class=\"k\">class</span> FooBar {\n    <span class=\"k\">private final</span> <span class=\"k\">int</span> n;\n    <span class=\"k\">private final</span> Semaphore fooReady = <span class=\"k\">new</span> Semaphore(<span class=\"n\">1</span>);   <span class=\"c\">// foo đi trước</span>\n    <span class=\"k\">private final</span> Semaphore barReady = <span class=\"k\">new</span> Semaphore(<span class=\"n\">0</span>);\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">foo</span>(Runnable printFoo) <span class=\"k\">throws</span> InterruptedException {\n        <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; n; i++) {\n            fooReady.<span class=\"f\">acquire</span>();\n            printFoo.<span class=\"f\">run</span>();\n            barReady.<span class=\"f\">release</span>();          <span class=\"c\">// trao lượt cho bar</span>\n        }\n    }\n<span class=\"c\">    </span>\n    <span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">bar</span>(Runnable printBar) <span class=\"k\">throws</span> InterruptedException {\n        <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; n; i++) {\n            barReady.<span class=\"f\">acquire</span>();\n            printBar.<span class=\"f\">run</span>();\n            fooReady.<span class=\"f\">release</span>();\n        }\n    }\n}</code></pre>\n\nÝ tưởng: [[g:mỗi thread có một giấy phép riêng]], in xong thì trao cho thread kế. Số permit ban đầu quyết định ai đi trước.\n\n**Cách 2 — `synchronized` + `wait/notifyAll` + biến lượt:**\n\n<pre><code><span class=\"k\">private</span> <span class=\"k\">int</span> turn = <span class=\"n\">0</span>;\n<span class=\"k\">public</span> <span class=\"k\">synchronized</span> <span class=\"k\">void</span> <span class=\"f\">foo</span>(Runnable p) <span class=\"k\">throws</span> InterruptedException {\n    <span class=\"k\">while</span> (turn != <span class=\"n\">0</span>) <span class=\"f\">wait</span>();\n    p.<span class=\"f\">run</span>(); turn = <span class=\"n\">1</span>; <span class=\"f\">notifyAll</span>();\n}</code></pre>\n\nCách này mở rộng lên 3+ thread dễ (`turn` chạy vòng), nhưng `notifyAll` đánh thức thừa.\n\n<table class=\"cmp\"><thead><tr><th>Cách</th><th>Ưu</th><th>Nhược</th></tr></thead><tbody>\n<tr><td>Semaphore</td><td>gọn, không khoá, ý đồ rõ</td><td>nhiều thread thì nhiều semaphore</td></tr>\n<tr><td>wait/notifyAll + turn</td><td>mở rộng n thread dễ</td><td>đánh thức thừa, phải nhớ <code>while</code></td></tr>\n<tr><td>Lock + n Condition</td><td>đánh thức chính xác</td><td>dài dòng nhất</td></tr>\n<tr><td>CyclicBarrier</td><td>hợp khi cần đồng bộ theo vòng</td><td>không tự áp đặt thứ tự trong vòng</td></tr>\n</tbody></table>\n\n:::deep\n- [[r:Không dùng được `volatile` + vòng lặp bận]] (`while (turn != 0) {}`) — đúng về mặt kết quả nhưng đốt CPU. Interviewer sẽ hỏi ngay *\"nếu thread kia chậm thì sao?\"*.\n- `Semaphore` mở rộng cho `n` thread: mảng `Semaphore[n]`, thread `i` chờ `sem[i]` và release `sem[(i+1)%n]`. Nói được cách tổng quát là ghi điểm.\n- biến thể `printNumber` (LC 1116 zero-even-odd) cùng khuôn: một semaphore cho `zero`, một cho `even`, một cho `odd`\n- `Semaphore(1)` khác `ReentrantLock`: semaphore [[o:không có chủ sở hữu]], nên thread A acquire mà thread B release là hợp lệ — chính vì thế nó hợp bài này còn lock thì không\n- `Exchanger` là công cụ đúng khi hai thread cần trao đổi *dữ liệu* theo cặp, không chỉ trao lượt\n- luôn nêu: `n` bằng 0 thì không in gì; và mọi thread phải thoát được, không để thread nào kẹt ở `acquire` khi hết vòng\n\n- Semaphore(1, true) có fairness có thể giảm starvation giữa các thread đang xếp hàng, nhưng không tạo ra output order; chính permit handoff mới tạo thứ tự.\n- Nếu foo/bar bị interrupt hoặc việc in lỗi sau acquire, phải công bố cancellation và release/đánh thức peer theo terminal-state policy; nếu không loop kia có thể chờ mãi.\n- Test ordering bằng barrier để khởi động lặp lại cả hai method. Inject interrupt và failure ở từng handoff, rồi assert peer thoát thay vì chờ một permit sẽ không bao giờ quay lại.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q3","q":"Dining philosophers: tránh deadlock bằng những cách nào?","a":"5 triết gia, 5 chiếc đũa, mỗi người cần hai chiếc hai bên. Ai cũng cầm đũa trái trước → [[r:deadlock]] hoàn hảo.\n\nBài này dạy đúng bốn điều kiện Coffman và bốn cách phá.\n\n**Nhãn chứng minh — safety · liveness · ordering · visibility.**\n\nVới resource ordering, đặt một total order cho mọi chiếc đũa và luôn lấy theo thứ tự tăng dần. Triết gia có thể giữ đũa hạng thấp trong khi chờ đũa hạng cao.\n\nCircular wait sẽ phải có một cạnh đi ngược thứ tự; điều đó không thể xảy ra. Cách này chứng minh không deadlock, không chứng minh không starvation.\n\n**Cách 1 — Đánh thứ tự tài nguyên (phổ biến nhất, phá \"chờ vòng tròn\"):**\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">wantsToEat</span>(<span class=\"k\">int</span> p, Runnable pickLeft, Runnable pickRight,\n                        Runnable eat, Runnable putLeft, Runnable putRight) {\n    <span class=\"k\">int</span> left = p, right = (p + <span class=\"n\">1</span>) % <span class=\"n\">5</span>;\n    <span class=\"k\">int</span> first = Math.<span class=\"f\">min</span>(left, right), second = Math.<span class=\"f\">max</span>(left, right);\n<span class=\"c\">    </span>\n    forks[first].<span class=\"f\">lock</span>();                <span class=\"c\">// LUÔN lấy đũa số nhỏ trước</span>\n    forks[second].<span class=\"f\">lock</span>();\n    <span class=\"k\">try</span> {\n        pickLeft.<span class=\"f\">run</span>(); pickRight.<span class=\"f\">run</span>();\n        eat.<span class=\"f\">run</span>();\n        putLeft.<span class=\"f\">run</span>(); putRight.<span class=\"f\">run</span>();\n    } <span class=\"k\">finally</span> {\n        forks[second].<span class=\"f\">unlock</span>(); forks[first].<span class=\"f\">unlock</span>();\n    }\n}</code></pre>\n\n**Cách 2 — Giới hạn số người vào bàn** (phá \"giữ và chờ\"): dùng `Semaphore(4)` cho 5 triết gia → luôn có ít nhất một người lấy đủ hai đũa.\n\nCách này phá deadlock, nhưng semaphore mặc định không công bằng không chứng minh được starvation freedom; cần fair permit hoặc queue tường minh nếu ai cũng phải có lượt.\n\n**Cách 3 — Bất đối xứng**: người chẵn lấy trái trước, người lẻ lấy phải trước.\n\n**Cách 4 — `tryLock` có timeout** (phá \"không thể chiếm dụng\"): lấy không đủ thì [[r:thả hết]] rồi thử lại. Cẩn thận [[o:livelock]] — phải có backoff ngẫu nhiên.\n\n:::deep\n- Bốn điều kiện Coffman (cần đủ cả bốn mới deadlock): [[b:loại trừ tương hỗ]], [[b:giữ và chờ]], [[b:không chiếm dụng]], [[b:chờ vòng tròn]]. Mỗi cách trên phá đúng một điều kiện — trả lời theo khung này nghe rất chắc.\n- [[g:Đánh thứ tự tài nguyên]] là cách áp dụng được nhiều nhất ngoài đời: luôn khoá theo id tăng dần khi chuyển tiền giữa hai tài khoản. Liên hệ được sang 5.10 (deadlock trong DB) là điểm cộng lớn.\n- `tryLock` mà không backoff → livelock: ai cũng lấy rồi thả nhịp nhàng, không ai ăn được. Không có CPU nào rảnh mà cũng không có tiến triển — nêu được là hiểu sâu.\n- fairness: `new ReentrantLock(true)` có thể giảm starvation bằng cách ưu tiên waiter đã xếp hàng, nhưng thêm scheduling overhead và không thay thế việc giới hạn work trong critical section. Nêu trade-off thay vì mặc định chọn một bên.\n- điều kiện thứ năm ít ai nhắc: [[o:chết đói]] (starvation) không phải deadlock — hệ vẫn chạy, chỉ có một người không bao giờ tới lượt. Cách 2 và fairness lock giải quyết nó.\n- ánh xạ thực tế: đũa = khoá dòng DB, kết nối pool, file lock. Cùng một bài toán, chỉ đổi tên.\n\n- Test một run có bound với mọi approach dưới contention; inject interruption và timeout khi triết gia đang giữ một resource. Assert mọi fork đã lấy đều được release, rồi ghi nhận cả deadlock freedom lẫn wait-time/starvation thay vì chỉ nhìn output.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.classic-synchronisation-problems.q4","q":"Đọc nhiều ghi ít: ReadWriteLock, StampedLock hay copy-on-write?","a":"**Nhãn chứng minh — safety · ordering · visibility.**\n\n<table class=\"cmp\"><thead><tr><th>Công cụ</th><th>Cơ chế</th><th>Hợp khi</th></tr></thead><tbody>\n<tr><td><code>synchronized</code></td><td>một thread tại một thời điểm</td><td>ghi nhiều, hoặc vùng găng rất ngắn</td></tr>\n<tr><td><code>ReentrantReadWriteLock</code></td><td>nhiều reader HOẶC một writer</td><td>đọc ≫ ghi, vùng găng dài</td></tr>\n<tr><td><code>StampedLock</code></td><td>thêm <b>đọc lạc quan</b> không khoá</td><td>đọc cực nhiều, ghi rất hiếm</td></tr>\n<tr><td><code>CopyOnWriteArrayList</code></td><td>ghi thì chép cả mảng</td><td>ghi <b>cực hiếm</b> (danh sách listener)</td></tr>\n</tbody></table>\n\n**`StampedLock` — đọc lạc quan, mẫu chuẩn:**\n\n<pre><code><span class=\"k\">private final</span> StampedLock sl = <span class=\"k\">new</span> StampedLock();\n<span class=\"c\">//</span>\n<span class=\"k\">public</span> <span class=\"k\">double</span> <span class=\"f\">distanceFromOrigin</span>() {\n    <span class=\"k\">long</span> stamp = sl.<span class=\"f\">tryOptimisticRead</span>();      <span class=\"c\">// KHÔNG khoá gì cả</span>\n    <span class=\"k\">double</span> cx = x, cy = y;                    <span class=\"c\">// đọc vào biến cục bộ</span>\n    <span class=\"k\">if</span> (!sl.<span class=\"f\">validate</span>(stamp)) {               <span class=\"c\">// có ai ghi xen vào không?</span>\n        stamp = sl.<span class=\"f\">readLock</span>();               <span class=\"c\">// có =&gt; lùi về khoá đọc thật</span>\n        <span class=\"k\">try</span> { cx = x; cy = y; } <span class=\"k\">finally</span> { sl.<span class=\"f\">unlockRead</span>(stamp); }\n    }\n    <span class=\"k\">return</span> Math.<span class=\"f\">sqrt</span>(cx * cx + cy * cy);\n}</code></pre>\n\nOptimistic read không phải read lock. Hãy copy mọi field thuộc cùng snapshot trước khi validate; nếu validation fail, bỏ toàn bộ snapshot cục bộ và đọc lại dưới readLock. Protocol này chỉ an toàn với state được StampedLock bảo vệ, không phải transaction trên state rời rạc.\n\nĐường đi nhanh không có ghi memory nào → nhanh hơn `ReadWriteLock` rất nhiều khi ghi hiếm. Đổi lại phải viết đúng khuôn: đọc vào biến cục bộ, `validate`, có đường lùi.\n\n:::warn StampedLock không tái nhập\nGọi lồng nhau là [[r:deadlock ngay]] — khác hẳn `synchronized` và `ReentrantLock`. Nó cũng không hỗ trợ `Condition`. Đây là lý do chính không nên dùng nó làm mặc định.\n:::\n\n:::deep\n- `ReadWriteLock` [[r:không phải]] luôn nhanh hơn `synchronized`: nó tốn chi phí quản lý hơn, nên vùng găng ngắn (vài dòng) thì `synchronized` thắng. [[o:Phải đo]], đừng đoán.\n- chết đói writer: `ReentrantReadWriteLock` không công bằng (mặc định) có thể để reader vào liên tục và writer chờ mãi. `new ReentrantReadWriteLock(true)` giải quyết, đổi lấy throughput.\n- [[g:hạ cấp]] được (write → read) nhưng [[r:không nâng cấp]] được (read → write) — nâng cấp là deadlock kinh điển vì hai reader cùng muốn nâng\n- `CopyOnWriteArrayList` ghi là O(n) và tạo rác — hoàn hảo cho danh sách listener (ghi lúc khởi động, đọc mãi), [[r:thảm hoạ]] cho danh sách thay đổi liên tục\n- iterator của COW chụp ảnh tại thời điểm tạo: duyệt không bao giờ `ConcurrentModificationException`, nhưng cũng không thấy thay đổi mới — phải nói rõ ngữ nghĩa này\n- thường thì [[g:cách tốt nhất là không dùng khoá]]: `ConcurrentHashMap`, `AtomicReference` + `updateAndGet`, hoặc snapshot bất biến hoán đổi bằng một phép gán volatile\n\n- Copy-on-write cấp phát backing array mới O(n) cho mỗi mutation. Snapshot cũ có thể còn sống khi iterator hoặc reader dùng nó, nên memory và GC pressure phụ thuộc số phần tử, burst ghi và iterator bị giữ. Hãy đo allocation và write latency; chỉ đọc nhiều là chưa đủ.\n- Test optimistic read trong lúc writer mutate, validate trước khi dùng composite value và kiểm tra fallback path. Test iterator copy-on-write thấy snapshot tại lúc tạo, rồi đo allocation dưới write burst.\n:::","difficulty":"advanced"}]},{"title":"Bất đồng bộ & công cụ hiện đại","items":[{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q1","q":"CompletableFuture: gọi song song, xử lý lỗi và timeout thế nào cho đúng?","a":"Bài rất hay gặp: *\"trang đặt vé cần gọi 3 service (giá, chỗ trống, khuyến mãi) — làm sao chạy song song và tổng thời gian bằng service chậm nhất?\"*\n\n**Nhãn chứng minh — safety · liveness · visibility.**\n\nRanh giới safety là mỗi request có một contract kết quả; liveness là hoàn tất và cancellation có giới hạn; visibility đi qua việc future hoàn thành và executor handoff. Failure policy phải rõ ở fan-in.\n\n<pre><code>CompletableFuture&lt;Price&gt; price =\n    CompletableFuture.<span class=\"f\">supplyAsync</span>(() -&gt; priceApi.<span class=\"f\">get</span>(id), pool)\n        .<span class=\"f\">orTimeout</span>(<span class=\"n\">800</span>, MILLISECONDS)              <span class=\"c\">// Java 9+</span>\n        .<span class=\"f\">exceptionally</span>(e -&gt; Price.<span class=\"f\">unavailable</span>());   <span class=\"c\">// degrade, không sập cả trang</span>\n<span class=\"c\">//</span>\nCompletableFuture&lt;Seats&gt; seats =\n    CompletableFuture.<span class=\"f\">supplyAsync</span>(() -&gt; seatApi.<span class=\"f\">get</span>(id), pool)\n        .<span class=\"f\">orTimeout</span>(<span class=\"n\">800</span>, MILLISECONDS)\n        .<span class=\"f\">exceptionally</span>(e -&gt; Seats.<span class=\"f\">unknown</span>());\n<span class=\"c\">//</span>\n<span class=\"c\">// allOf chờ tất cả; join() sau đó không còn chặn thật sự</span>\nCompletableFuture&lt;Page&gt; page = CompletableFuture\n    .<span class=\"f\">allOf</span>(price, seats)\n    .<span class=\"f\">thenApply</span>(v -&gt; <span class=\"k\">new</span> Page(price.<span class=\"f\">join</span>(), seats.<span class=\"f\">join</span>()));</code></pre>\n\n**Các method cần phân biệt:**\n- `thenApply` (biến đổi đồng bộ) vs `thenCompose` (nối một future khác — [[o:chính là flatMap]])\n- `thenCombine` (ghép **hai** future) vs `allOf` (chờ **nhiều**) vs `anyOf` (lấy cái xong trước)\n- `exceptionally` (chỉ chạy khi lỗi) vs `handle` (chạy cả hai) vs `whenComplete` (xem nhưng không đổi kết quả)\n\n:::warn Ba bẫy phải biết\n[[r:Dùng ForkJoinPool.commonPool()]] cho I/O có thể làm nghẽn resource [[o:dùng chung toàn JVM]]. Default parallelism thường là số processor khả dụng trừ một, nhưng runtime config và container limit có thể khác. Hãy inspect nó; dùng pool I/O có owner.\n:::\n\n[[r:`get()`/`join()` sớm]] giữa chuỗi → biến bất đồng bộ thành tuần tự, mất sạch lợi ích. [[r:Nuốt exception]]: không có `exceptionally`/`handle` thì lỗi nằm im trong future tới lúc `join()` mới nổ, kèm `CompletionException` bọc ngoài.\n:::deep\n- `thenApply` vs `thenApplyAsync`: bản không `Async` chạy trên [[o:thread vừa hoàn thành future trước]] — nếu đó là thread I/O của Netty thì bạn vừa chiếm event loop. Việc nặng phải dùng bản `Async` kèm pool riêng.\n- `orTimeout` (Java 9+) huỷ future và ném `TimeoutException`; `completeOnTimeout` trả giá trị mặc định — cái sau thường đúng hơn cho degrade\n- timeout ở `CompletableFuture` [[r:không huỷ được lời gọi HTTP bên dưới]] — thread vẫn chạy tới hết. Phải đặt thêm timeout ở tầng client (18-query-optimization.rewriting-the-query-reshaping-the-model.q4).\n- `allOf` trả `CompletableFuture&lt;Void&gt;`; muốn lấy kết quả phải `join()` từng cái sau đó (an toàn vì đã hoàn thành)\n- lỗi bị bọc trong `CompletionException` → dùng `ex.getCause()` khi phân loại lỗi, đây là chỗ hay quên\n- context (MDC, trace id, SecurityContext) [[r:không tự đi theo]] sang thread khác — phải bọc executor (`TaskDecorator` của Spring) nếu không log mất trace id (20-observability-sre.slos-alerting-incidents.q4)\n- Java 21+: với I/O, [[g:virtual threads + code tuần tự]] thường rõ ràng hơn hẳn chuỗi `CompletableFuture` (23-java-concurrency-coding.async-the-modern-toolkit.q4) — nêu được là cho thấy đang theo kịp\n\n- Failure policy thuộc về fan-in. Nếu không chấp nhận degraded value, giữ raw future, dùng handle để gom outcome record và để aggregate giữ root cause. allOf không tự cancel sibling.\n- orTimeout chỉ hoàn tất stage. Giữ handle tới request hoặc Future của HTTP client, cấu hình deadline ở client và close/cancel resource đó khi timeout. Future.cancel(true) chỉ là yêu cầu interrupt; test để biết I/O đã dừng và socket đã được release chưa.\n- Executor là resource có owner: dùng bounded executor cho workload blocking, định nghĩa reject hoặc degrade khi đầy, rồi shutdown theo lifecycle. Không shutdown executor dùng chung.\n- Test một fast failure, một child chậm, timeout và caller cancellation; assert slow client được close và không còn late side effect sau khi page future hoàn thành.\n:::","difficulty":"core"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q2","q":"CountDownLatch, CyclicBarrier, Semaphore và Phaser: phân biệt?","a":"Bốn công cụ đồng bộ hay bị hỏi dồn, vì rất dễ nhầm.\n\n**Nhãn chứng minh — safety · liveness · visibility.**\n\nThuộc tính safety là phase hoặc permit phải ở trạng thái hợp lệ; liveness yêu cầu participant đi tới phase kết thúc hoặc bị cancel; memory effect của synchronizer tạo visibility qua lần handoff.\n\n<table class=\"cmp\"><thead><tr><th>Công cụ</th><th>Dùng để</th><th>Tái sử dụng</th><th>Ai chờ ai</th></tr></thead><tbody>\n<tr><td><code>CountDownLatch</code></td><td>chờ N việc xong rồi mới đi tiếp</td><td><b>không</b> — dùng một lần</td><td>một/nhiều chờ N event</td></tr>\n<tr><td><code>CyclicBarrier</code></td><td>N thread hẹn nhau tại một điểm</td><td><b>có</b> — tự reset</td><td>các thread chờ lẫn nhau</td></tr>\n<tr><td><code>Semaphore</code></td><td>giới hạn số thread vào cùng lúc</td><td>có</td><td>chờ giấy phép</td></tr>\n<tr><td><code>Phaser</code></td><td>như barrier nhưng số bên <b>thay đổi được</b></td><td>có, nhiều pha</td><td>linh hoạt</td></tr>\n</tbody></table>\n\n**`CountDownLatch` — khởi động xong mới nhận traffic:**\n\n<pre><code>CountDownLatch ready = <span class=\"k\">new</span> CountDownLatch(<span class=\"n\">3</span>);\n<span class=\"c\">//</span>\npool.<span class=\"f\">submit</span>(() -&gt; { loadCache();  ready.<span class=\"f\">countDown</span>(); });\npool.<span class=\"f\">submit</span>(() -&gt; { warmPool();   ready.<span class=\"f\">countDown</span>(); });\npool.<span class=\"f\">submit</span>(() -&gt; { loadConfig(); ready.<span class=\"f\">countDown</span>(); });\n<span class=\"c\">//</span>\n<span class=\"k\">if</span> (!ready.<span class=\"f\">await</span>(<span class=\"n\">30</span>, SECONDS)) <span class=\"k\">throw</span> <span class=\"k\">new</span> IllegalStateException(<span class=\"s\">\"khởi động quá lâu\"</span>);</code></pre>\n\n**`CyclicBarrier` — mô phỏng theo vòng, mỗi vòng đợi đủ người:**\n\n<pre><code>CyclicBarrier barrier = <span class=\"k\">new</span> CyclicBarrier(<span class=\"n\">4</span>, () -&gt; <span class=\"f\">mergeRoundResults</span>());\n<span class=\"c\">// mỗi worker: tính xong một vòng rồi</span>\nbarrier.<span class=\"f\">await</span>();     <span class=\"c\">// người cuối cùng tới sẽ chạy mergeRoundResults()</span></code></pre>\n\n:::deep\n- Khác biệt cốt lõi: `CountDownLatch` [[o:không thể reset]] — cần lặp lại thì phải tạo cái mới, hoặc dùng `CyclicBarrier`/`Phaser`. Đây là câu phân biệt hay hỏi nhất.\n- `countDown()` [[g:phải]] nằm trong `finally`, nếu không một task ném exception là mọi người chờ mãi\n- `await()` [[g:luôn nên có timeout]]. Chờ vô hạn trong service production là công thức treo cả hệ.\n- `CyclicBarrier` ném [[r:`BrokenBarrierException`]] cho *tất cả* khi một thread bị ngắt hoặc timeout — thiết kế cố ý: nhóm không đủ thì cả vòng vô nghĩa\n- `Semaphore` dùng để giới hạn [[o:đồng thời]] (vd tối đa 10 lời gọi song song sang đối tác) — đây là bulkhead thủ công, khác rate limiting (giới hạn theo thời gian, 22.3)\n- `Phaser` mạnh nhưng ít dùng: số bên đăng ký thay đổi giữa các pha (`register`/`arriveAndDeregister`), hợp cho tính toán nhiều giai đoạn có worker vào/ra\n- Java 21+: [[g:`StructuredTaskScope`]] thay được phần lớn nhu cầu \"chạy nhiều task rồi chờ\" một cách an toàn hơn — huỷ tự động khi một nhánh lỗi (23-java-concurrency-coding.async-the-modern-toolkit.q4)\n\n- Exercise failure lifecycle: cho một worker throw trước countDown, interrupt barrier waiter, làm cạn semaphore permit và add/remove party của Phaser. Mọi test cần timeout và phải verify không còn worker bị block.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q3","q":"Atomic và CAS: tự cài counter/stack lock-free, ABA problem là gì?","a":"**Nhãn chứng minh — safety · linearizability · liveness · visibility.**\n\nInvariant của counter chỉ exact khi atomicity của operation khớp business rule; stack còn cần linearizability và lập luận về progress. CAS cho visibility nhưng không tự chứng minh hai điều đó.\n\n[[b:CAS]] (compare-and-swap) là một lệnh CPU nguyên tử: *\"nếu ô nhớ còn bằng `expected` thì đặt thành `newValue`\"*. Toàn bộ `java.util.concurrent.atomic` dựng trên nó.\n\n<pre><code><span class=\"c\">// Bản chất của incrementAndGet — vòng lặp thử lại</span>\n<span class=\"k\">public</span> <span class=\"k\">int</span> <span class=\"f\">increment</span>() {\n    <span class=\"k\">int</span> cur, next;\n    <span class=\"k\">do</span> {\n        cur  = value.<span class=\"f\">get</span>();\n        next = cur + <span class=\"n\">1</span>;\n    } <span class=\"k\">while</span> (!value.<span class=\"f\">compareAndSet</span>(cur, next));   <span class=\"c\">// thua thì đọc lại và thử lại</span>\n    <span class=\"k\">return</span> next;\n}</code></pre>\n\nKhông khoá, không chặn: thread thua thử lại. Đây là [[g:lock-free]] theo nghĩa progress của toàn hệ — vẫn có operation hoàn tất dù contention — không phải bảo đảm mọi thread hoàn thành trong một bound.\n\n**Stack lock-free (Treiber stack):**\n\n<pre><code><span class=\"k\">public</span> <span class=\"k\">void</span> <span class=\"f\">push</span>(T item) {\n    Node&lt;T&gt; newHead = <span class=\"k\">new</span> Node&lt;&gt;(item);\n    Node&lt;T&gt; oldHead;\n    <span class=\"k\">do</span> {\n        oldHead = head.<span class=\"f\">get</span>();\n        newHead.next = oldHead;\n    } <span class=\"k\">while</span> (!head.<span class=\"f\">compareAndSet</span>(oldHead, newHead));\n}</code></pre>\n\n**Bài toán ABA:** thread 1 đọc `head = A`. Trước khi nó CAS, thread 2 pop A, pop B, rồi push lại A. CAS của thread 1 [[r:vẫn thành công]] vì head vẫn là `A` — nhưng `A.next` giờ đã khác, và stack hỏng.\n\nGiải: [[g:gắn thêm số phiên bản]] — AtomicStampedReference so cả tham chiếu lẫn tem. Nó phát hiện một nhóm lịch sử ABA; tự nó không chứng minh linearizability của algorithm, không chặn stamp overflow và không định nghĩa policy reclaim node an toàn.\n\n<pre><code>AtomicStampedReference&lt;Node&gt; head = <span class=\"k\">new</span> AtomicStampedReference&lt;&gt;(<span class=\"k\">null</span>, <span class=\"n\">0</span>);\nhead.<span class=\"f\">compareAndSet</span>(oldHead, newHead, stamp, stamp + <span class=\"n\">1</span>);</code></pre>\n\n:::deep\n- CAS thắng khi [[o:tranh chấp thấp]]. Tranh chấp cao thì vòng lặp thử lại đốt CPU và có thể [[r:chậm hơn khoá]] — khoá ít nhất còn cho thread đi ngủ.\n- Dùng [[g:LongAdder cho thống kê có contention cao]], không dùng cho balance, sequence hay ID cần exact. Nó phân tán update vào nhiều cell rồi cộng khi đọc; sum() không phải atomic snapshot khi vẫn còn update. Nếu invariant cần giá trị chính xác, chọn AtomicLong, lock hoặc ownership.\n- GC làm ABA [[o:ít nguy hiểm hơn]] C++ ở phần reclamation: object còn reachable không bị reclaim rồi tái dùng thành object không liên quan. ABA logic A→B→A vẫn có thể xảy ra; node được reuse có chủ đích vẫn cần version hoặc stamp và algorithm proof.\n- `AtomicReference.updateAndGet(fn)` gói sẵn vòng lặp CAS — [[r:hàm truyền vào phải thuần]] và không có tác dụng phụ, vì nó có thể chạy lại nhiều lần\n- Atomic API chỉ cung cấp operation, không chứng minh stack của bạn linearizable hay lock-free. Phân biệt progress: [[o:lock-free]] là progress toàn hệ, mạnh hơn [[o:obstruction-free]] và yếu hơn [[o:wait-free]], nơi mọi thread hoàn thành trong số bước hữu hạn.\n- `volatile` chỉ cho khả kiến; CAS cho cả khả kiến lẫn nguyên tử. Đây là cặp khái niệm hay bị hỏi vặn nhất (liên hệ 1.1 JMM).\n- Java 9+ có `VarHandle` thay `Unsafe` cho thao tác nguyên tử mức thấp; biết tên là đủ\n\n- Dùng jcstress cho interleaving của JMM và atomic, cùng linearizability/history checker cho stack. Bao gồm quan sát CAS failure và progress, case ABA hoặc version-wrap và giả định reclaim memory; chỉ assert final size sẽ bỏ sót lịch sử state cũ.\n:::","difficulty":"advanced"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q4","q":"Virtual threads (Java 21+): viết lại bài concurrency thế nào?","a":"**Nhãn chứng minh — safety · liveness · visibility.**\n\nQuy tắc safety về lifetime là child work phải nằm trong owner scope; liveness bị giới hạn bởi admission và cancellation ở downstream; virtual-thread scheduling không xoá contract resource.\n\nVirtual thread là Java `Thread` do [[o:JVM]] lập lịch trên các carrier thread. Nó đủ rẻ để tạo cho từng task; operation blocking được hỗ trợ sẽ park và unmount VT để carrier chạy việc khác.\n\n<pre><code><span class=\"c\">// Mỗi task một virtual thread; executor này không phải pool tái dùng thread</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> executor = Executors.<span class=\"f\">newVirtualThreadPerTaskExecutor</span>()) {\n    <span class=\"k\">for</span> (<span class=\"k\">var</span> id : bookingIds) {\n        executor.<span class=\"f\">submit</span>(() -&gt; {\n            <span class=\"k\">var</span> price = priceApi.<span class=\"f\">get</span>(id);\n            <span class=\"k\">var</span> seats = seatApi.<span class=\"f\">get</span>(id);\n            <span class=\"k\">return new</span> Page(price, seats);\n        });\n    }\n} <span class=\"c\">// close() chờ các task đã submit</span></code></pre>\n\nLợi ích chính là [[g:blocking code có cấu trúc rõ]] với stack trace, exception và debugger bình thường ở I/O concurrency cao. Nó không tự động nhanh hơn reactive và không tự tạo backpressure.\n\n**Preview API JDK 25 — quản lý lifetime của các task liên quan như một đơn vị:**\n\n<pre><code><span class=\"c\">// Compile và chạy với --enable-preview trên JDK 25</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> scope = StructuredTaskScope.<span class=\"f\">open</span>()) {\n    <span class=\"k\">var</span> price = scope.<span class=\"f\">fork</span>(() -&gt; priceApi.<span class=\"f\">get</span>(id));\n    <span class=\"k\">var</span> seats = scope.<span class=\"f\">fork</span>(() -&gt; seatApi.<span class=\"f\">get</span>(id));\n    scope.<span class=\"f\">join</span>();                         <span class=\"c\">// lỗi sẽ cancel sibling và propagate</span>\n    <span class=\"k\">return new</span> Page(price.<span class=\"f\">get</span>(), seats.<span class=\"f\">get</span>());\n}</code></pre>\n\n**Ranh giới preview JDK 25:** StructuredTaskScope.open() không tham số là policy fail-fast ở dạng preview: subtask lỗi sẽ cancel sibling và join propagate failure.\n\n:::warn Hướng dẫn pinning đã đổi từ JDK 24\nTrên JDK 21–23, blocking khi giữ monitor `synchronized` có thể ghim carrier, nên đưa I/O ra khỏi monitor hoặc dùng `ReentrantLock` là targeted fix hợp lý.\n:::\n\nJEP 491 đã gỡ pinning do monitor ở JDK 24. Native/foreign call và edge case class initialization vẫn có thể giữ carrier, nhưng thay mọi monitor không còn là lời khuyên đúng.\n:::deep\n- [[r:Đừng pool virtual thread]] chỉ để bound resource khan hiếm. Tạo một VT cho mỗi task, rồi dùng semaphore hoặc pool thật của downstream làm capacity control; pool task và giới hạn resource là hai concern khác nhau.\n- `ThreadLocal` vẫn tương thích, nhưng mutable state trên mỗi thread có thể tốn ở concurrency lớn. `ScopedValue` final trên JDK 25 cho context immutable, có scope; nó không thay mọi mutable thread-local state.\n- CPU-bound vẫn giới hạn bởi số core. Dùng bounded parallelism và đo context-switch/queue overhead.\n- DB pool 20 connection vẫn chỉ nhận 20 query concurrent. Waiter rẻ có thể tăng utilization, nhưng quá nhiều waiter vẫn tốn memory và làm hết deadline.\n- Với JDK 21–23, JFR `jdk.VirtualThreadPinned` và `-Djdk.tracePinnedThreads` giúp tìm monitor pinning. System property này bị bỏ ở JDK 24; trên JDK mới dùng JFR, JSON thread dump, carrier utilization và số liệu latency.\n- `StructuredTaskScope` còn preview ở JDK 25 và constructor đã đổi thành `open(...)`; đừng công bố dạng `new ShutdownOnFailure()` cũ như code JDK 25.\n\nDùng reactive/event-loop I/O khi streaming và backpressure tường minh hợp toàn stack; dùng virtual thread khi blocking API và control flow tuần tự dễ bảo trì hơn. So sánh các model rộng hơn ở (15-network-i-o-models.realtime-event-driven.q3).\n\n- JEP 491 đã đổi monitor pinning ở JDK 24; nó không hứa virtual thread không bao giờ pin. Test native/foreign call, class initialization và blocking resource client trên JDK đích bằng JFR, đừng suy ra safety từ số thread.\n- Test cancellation và scope close: interrupt child giữa lúc I/O, verify cleanup resource, rồi chạy cùng pinning probe trên JDK 21–23 và JDK 24+.\n:::","difficulty":"extra"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q5","difficulty":"core","q":"Bài tập phỏng vấn: 20 luồng, mỗi luồng cộng một triệu vào `volatile int counter`. Tổng có đúng không, và chứng minh câu trả lời thế nào?","a":"**Nhãn chứng minh — safety · visibility.**\n\nCâu hỏi safety là mỗi lần tăng có phải compound action atomic không; volatile chỉ cho visibility và ordering. Phần chứng minh phải xét mọi interleaving, không chỉ một lần benchmark.\n\nKhông có gì bảo đảm. Mức tối đa là [[r:20.000.000]], và số này có thể xảy ra khi các lần tăng không chồng lấn. Khi read-modify-write chạy đồng thời, lost update có thể làm kết quả thấp hơn; volatile chỉ cho visibility và ordering, không đảm bảo atomicity.\n\n`counter++` là ba bytecode: đọc field, cộng một, ghi lại. Hai thread đọc cùng một giá trị rồi cùng ghi `v + 1`, thế là mất một lần tăng. `volatile` bảo đảm mỗi lần đọc thấy một giá trị hợp lệ theo synchronization order; nó không bao giờ gộp ba bước thành một.\n\n<pre><code><span class=\"k\">static volatile int</span> counter = <span class=\"n\">0</span>;\n<span class=\"c\">// 20 thread x 1_000_000 lần tăng</span>\n<span class=\"k\">try</span> (<span class=\"k\">var</span> pool = Executors.<span class=\"f\">newFixedThreadPool</span>(<span class=\"n\">20</span>)) {\n    <span class=\"k\">for</span> (<span class=\"k\">int</span> t = <span class=\"n\">0</span>; t &lt; <span class=\"n\">20</span>; t++)\n        pool.<span class=\"f\">submit</span>(() -&gt; { <span class=\"k\">for</span> (<span class=\"k\">int</span> i = <span class=\"n\">0</span>; i &lt; <span class=\"n\">1_000_000</span>; i++) counter++; });\n}\nSystem.out.<span class=\"f\">println</span>(counter);   <span class=\"r\">// ví dụ 3_147_882 — có thể thấp hơn; 20_000_000 cũng có thể xảy ra, nên một lần chạy không chứng minh gì</span></code></pre>\n\n**Thang sửa lỗi, rẻ và đúng trước:**\n\n<table class=\"cmp\"><thead><tr><th>Công cụ</th><th>Dùng khi</th><th>Trả giá gì</th></tr></thead><tbody>\n<tr><td>`AtomicInteger`</td><td>một counter, contention vừa phải</td><td>CAS retry, dồn hết vào một cache line</td></tr>\n<tr><td>`LongAdder`</td><td>counter ghi nhiều, đọc thưa</td><td>striped cell; `sum()` không phải snapshot khi vẫn còn ghi</td></tr>\n<tr><td>`synchronized` / lock</td><td>từ hai field trở lên phải đổi cùng nhau</td><td>blocking; giữ critical section nhỏ là việc của bạn</td></tr>\n<tr><td>không chia sẻ gì</td><td>tổng theo từng thread rồi gộp cuối</td><td>không gì — đây là lý do reduce và collect scale được</td></tr>\n</tbody></table>\n\n:::warn volatile thật ra dành cho việc gì\nPublication, không phải accumulation: một cờ `stop`, một tham chiếu config được hoán đổi — trạng thái mà mọi invariant của nó nằm gọn trong một lần đọc hoặc một lần ghi atomic (01-java-core-jvm.memory-execution-model.q1).\n:::\n\n:::deep\n**\"Chạy thử rồi nhìn\" là chứng minh yếu.** Lost update phụ thuộc thời điểm, và một vòng lặp đã được JIT tối ưu trên laptop rảnh có thể in ra số đúng mà chẳng chứng minh được gì. Hai lập luận mạnh hơn:\n\n- *theo cấu trúc* — chỉ ra ba bước và cách đan xen làm rơi một lần tăng; không phép đo nào biến nó thành an toàn\n- *theo công cụ* — jcstress, harness concurrency của OpenJDK, ép chạy các cách đan xen và báo cáo đúng những kết quả quan sát được, gồm cả kết quả mà test thường không bao giờ chạm tới\n\n**Atomic cũng không làm compound action thành atomic.** `if (counter.get() &lt; limit) counter.incrementAndGet()` là đúng bug đó ở mức cao hơn: dùng `compareAndSet` trong vòng lặp, `updateAndGet`, hoặc một lock (23-java-concurrency-coding.async-the-modern-toolkit.q3).\n\n**Đừng quên phía đọc.** Tăng biến trong lock là đúng, nhưng đọc field đó từ thread khác mà không qua lock lại là một bài toán visibility mới — bản sửa phải phủ cả hai phía của field, và đó chính là thứ `AtomicInteger` gói sẵn trong một object.\n\n**Test hooks.** Test jcstress với Actor và Arbiter có thể ghi lại các outcome hợp lệ của race; stress test có thể làm lộ lost update nhưng không chứng minh nó không bao giờ xảy ra. Với tổng exact, dùng AtomicInteger, lock hoặc ownership theo thread rồi reduction ở cuối.\n:::"},{"id":"23-java-concurrency-coding.async-the-modern-toolkit.q6","q":"Thiết kế cancellation và backpressure cho async fan-out thế nào để không có orphan work?","a":"Bắt đầu từ resource contract, không bắt đầu từ `CompletableFuture.allOf`. Fan-out phải có parent deadline, admission có giới hạn, executor owner rõ ràng và rule xác định child làm gì khi caller rời đi.\n\n**Nhãn chứng minh — safety · liveness · ordering · visibility.**\n\nThuộc tính safety là không còn work hay side effect sau khi scope đóng; liveness là hoàn tất và cancellation có giới hạn; ordering bao gồm truyền deadline và admission; visibility đi qua cancellation state có owner.\n\n<table class=\"cmp\"><thead><tr><th>Concern</th><th>Quyết định bắt buộc</th><th>Failure cần test</th></tr></thead><tbody>\n<tr><td>Admission</td><td>Giới hạn concurrency bằng semaphore, executor/queue bounded hoặc structured scope; reject/degrade phải rõ</td><td>Fan-out không giới hạn làm cạn CPU, socket, DB connection hoặc quota provider</td></tr>\n<tr><td>Deadline</td><td>Truyền một monotonic deadline vào từng child và trừ thời gian đã trôi qua</td><td>Mỗi child nhận timeout mới, tổng latency vượt request budget</td></tr>\n<tr><td>Failure policy</td><td>Chọn fail-fast, best-effort aggregation hoặc partial result; giữ root cause đầu tiên</td><td>Một lỗi bị giấu trong aggregate exception hoặc partial side effect bị coi là success</td></tr>\n<tr><td>Cancellation</td><td>Định nghĩa cancellation có interrupt task, đóng I/O, trả permit và chặn retry hay không</td><td>`orTimeout` complete future nhưng supplier bên dưới vẫn chạy</td></tr>\n<tr><td>Lifecycle</td><td>Executor có owner và shutdown; không để work rơi vào common pool hay executor theo request bị bỏ quên</td><td>Orphan task sống qua deploy/shutdown và tiếp tục ghi sau khi response timeout</td></tr>\n</tbody></table>\n\n:::deep\n- `CompletableFuture.orTimeout` chỉ đổi completion của future; không chứng minh arbitrary blocking I/O đã dừng. Adapter phải sở hữu semantics cancel/close và test phải quan sát resource sau timeout.\n- `allOf` không tự quyết định có cancel sibling, gom exception thế nào hay side effect có retry an toàn không. Policy phải ghi rõ trong code và docs.\n- Semaphore giới hạn admission nhưng không cancel work đã được nhận; bounded queue tạo latency/rejection contract khác. Đo queue age, permit wait, child p99 và cancellation lag.\n- `StructuredTaskScope` trong API JDK 25 được nghiên cứu vẫn là preview. Nó cho lifetime model hữu ích, nhưng compiler/runtime phải opt-in và app vẫn cần bulkhead cho downstream.\n- Với mutation, cancellation có thể để lại external outcome không biết. Dùng idempotency key và reconciliation boundary thay vì retry mù child đã timeout.\n- Test deadline propagation, sibling cancellation, executor shutdown, interrupted/late completion, retry suppression, permit release và không còn work sau khi request scope đóng.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"23-java-concurrency-coding","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limi