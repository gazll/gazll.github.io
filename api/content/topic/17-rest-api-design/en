{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},"meta":{"topic_type":"design","key":"17-rest-api-design","vi":{"label":"Thiết kế REST API","title":"Thiết kế REST API — resource, hợp đồng và vòng đời","intro":"Ngày 4 nói REST *là gì*; chủ đề này nói *thiết kế thế nào*. Từ mô hình hoá resource, ánh xạ hành động nghiệp vụ, tới idempotency, chuẩn lỗi và cách khai tử một version mà không gãy client — đúng những gì interviewer đào khi bạn nói 'em thiết kế API'.","tags":["Resource modeling","Idempotency-Key","RFC 9457","PATCH","Async 202","Sunset header","Bulk API","Webhooks"]},"en":{"label":"REST API design","title":"REST API design — resources, contracts and lifecycle","intro":"Topic 4 covers what REST is; this one covers how you design it. From modelling resources and mapping business actions, through idempotency and error standards, to retiring a version without breaking clients — exactly what an interviewer digs into once you say you design APIs.","tags":["Resource modeling","Idempotency-Key","RFC 9457","PATCH","Async 202","Sunset header","Bulk API","Webhooks"]},"created_at":"2026-07-31","updated_at":"2026-10-25"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"17-rest-api-design.contracts-errors-lifecycle.q5":"2026-08-01","17-rest-api-design.contracts-errors-lifecycle.q4":"2026-08-12"},"lang":"en","body":{"sections":[{"title":"Modelling resources & URIs","items":[{"id":"17-rest-api-design.modelling-resources-uris.q1","q":"How should resources and URIs be modelled when moving from a use case to an API?","a":"Start with [[g:business nouns]], not database tables and certainly not service methods.\n\n**Naming rules:**\n- use plural nouns, lowercase letters, and hyphens: `/flight-bookings`\n- use hierarchy to express ownership: `/bookings/{id}/passengers`\n- [[r:do not put verbs in URIs]]: `/getBooking` and `/createBooking` are RPC disguised as REST\n- limit nesting to two levels; beyond that, expose an independent resource and use query parameters\n\nA resource [[o:is not]] a table. `/bookings` may be assembled from four tables; conversely, one `user` table may be exposed as `/users` and `/users/{id}/preferences`, two distinct resources.\n\n:::deep\nA one-to-one mapping between resources and tables [[r:leaks the storage model]] into the public contract; a later schema change then breaks clients.\n\n- resources should align with the [[g:bounded context]] (DDD), not the ERD\n- identifiers in URIs should be [[o:external IDs]] (a UUID or booking reference such as `VN8H2K`), not internal auto-increment values: sequential IDs expose order volume and enable enumeration attacks (IDOR)\n- for a many-to-many relationship, model the relationship itself as a resource (`/bookings/{id}/seat-assignments`) when it has its own attributes\n- always wrap collection responses in an object (`{\"data\":[...], \"next\":\"...\"}`); [[r:do not return a bare array]] because it leaves nowhere to add metadata without breaking clients\n\nIn an OTA, `/flights` (search-oriented, read-heavy, cacheable) should be separate from `/bookings` (transactional); they have different consistency requirements and rate limits.\n:::","difficulty":"core"},{"id":"17-rest-api-design.modelling-resources-uris.q2","q":"How should non-CRUD actions such as cancellation, refund, and ticket issuance be mapped to REST?","a":"Interviewers often use this question to distinguish someone who has only read tutorials from someone who has designed real APIs. There are three approaches, in order of preference:\n\n**1. Model the action as a resource** — best when the action has its own lifecycle:\n\n`POST /bookings/{id}/refunds` → creates a `Refund` with an ID, status, and history. It can be queried later with `GET /refunds/{rid}`.\n\n**2. Change state through a sub-resource** — when the operation is only a state transition:\n\n`PUT /bookings/{id}/status` with body `{\"value\":\"CANCELLED\"}`.\n\n**3. Use a controller action** — the final escape hatch, using a verb deliberately:\n\n`POST /bookings/{id}:cancel` (Google AIP style) or `/bookings/{id}/cancel`.\n\n[[g:Decision rule]]: if an action needs an audit trail, retries, or its own state, use option 1. If it only flips a flag, use option 2. Otherwise use option 3 without apology.\n\n:::deep\nOption 1 wins because it answers questions that option 3 cannot: *How far has the refund progressed? Who initiated it? Which retry attempt is this?*\n\n- money-moving actions ([[o:refund, charge, payout]]) should [[g:always]] be resources; you will inevitably need their history\n- a `POST` to an action is [[r:not idempotent]] by default, so pair it with an `Idempotency-Key` (see 17.5)\n- avoid multiplexing many actions through one endpoint with an `action` field in the body: doing so removes per-action authorization, rate limiting, and observability\n- an invalid state transition should return [[b:409 Conflict]] with the current state, not 400\n\nIn an OTA, `POST /bookings/{id}/cancellations` supports partial cancellation, such as canceling one of three passengers—something `PUT .../status` cannot express.\n:::\n\n:::tip This is a contract style, not a universal REST law\nResource-shaped actions are preferable when the result has its own lifecycle, history, authorization, or retry identity.\n\nA deliberate controller action is still a valid compatibility choice when the domain operation is atomic and short-lived; document its status, idempotency, authorization, and error contract instead of pretending the URI alone supplies those guarantees.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.modelling-resources-uris.q3","q":"PUT vs PATCH: how do JSON Merge Patch and JSON Patch differ, and when should each be used?","a":"[[b:PUT]] replaces the [[o:entire]] representation. An omitted field is deleted or reset to its default. It is idempotent.\n\n[[b:PATCH]] performs a [[o:partial]] update. PATCH itself is [[r:not guaranteed to be idempotent]]; that depends on the patch format.\n\n<table class=\"cmp\"><thead><tr><th></th><th>JSON Merge Patch (RFC 7396)</th><th>JSON Patch (RFC 6902)</th></tr></thead><tbody>\n<tr><td>Content-Type</td><td><code>application/merge-patch+json</code></td><td><code>application/json-patch+json</code></td></tr>\n<tr><td>Syntax</td><td>same shape as the original object, containing only fields to change</td><td>array of operations: add/remove/replace/move/test</td></tr>\n<tr><td>Delete a field</td><td><code>null</code></td><td><code>{\"op\":\"remove\",\"path\":\"/x\"}</code></td></tr>\n<tr><td>Set a field to null</td><td>cannot be expressed</td><td>supported</td></tr>\n<tr><td>Update one array element</td><td>not supported; the entire array must be sent</td><td>supported, by index</td></tr>\n<tr><td>Idempotent</td><td>yes</td><td>not always (<code>add</code> to an array)</td></tr>\n</tbody></table>\n\nChoose [[g:Merge Patch]] for ordinary object updates when its null/delete semantics fit; choose [[g:JSON Patch]] when updating individual array elements, using `test` for optimistic concurrency, or building collaborative editing.\n\n:::deep\nThe classic Merge Patch trap is that it [[r:cannot distinguish 'field omitted' from 'set field to null']]. In Java, both `{\"note\": null}` and `{}` deserialize to `note == null`.\n\nHandle this by wrapping fields in an `Optional`-like type (`JsonNullable` from openapi-generator), or by reading the raw `JsonNode` and checking `has(\"note\")`.\n\n- for PATCH with optimistic concurrency, require `If-Match: \"&lt;etag&gt;\"` and return [[b:412 Precondition Failed]] on a mismatch; this prevents lost updates when two clients edit concurrently\n- PUT to a resource that does not exist may create it (upsert) and return 201, but that behavior must be documented explicitly\n- [[r:failing to validate]] the entire entity after applying a PATCH is a common vulnerability: each field may be valid independently while the resulting combination is invalid\n:::\n\n:::tip Patch format is a contract, not a percentage rule\nThe “95%” choice is a teaching heuristic, not an HTTP or RFC requirement. Choose Merge Patch when object replacement and null-delete semantics fit; choose JSON Patch when operation-level array edits or `test` preconditions are needed.\n\nValidate the complete post-patch representation and bind `If-Match` to the resource version; neither patch format provides optimistic concurrency by itself.\n:::","difficulty":"core"},{"id":"17-rest-api-design.modelling-resources-uris.q4","q":"How can bulk APIs and field selection reduce chattiness without switching to GraphQL?","a":"Use three techniques, and only after clients have demonstrated real pain rather than as speculative design:\n\n**1. Field selection** — `GET /bookings?fields=id,status,total` reduces the payload while preserving the opportunity to use a covering index.\n\n**2. Expand / embed** — `GET /bookings/{id}?expand=passengers,payments` collapses N+1 client round trips into one. Enforce an [[o:allowlist]] and a maximum depth.\n\n**3. Bulk endpoint** — `POST /bookings/bulk` accepts an array and returns a per-item result array.\n\nA bulk endpoint should return [[b:207 Multi-Status]], or 200 with a result array containing a `status` for every item. [[r:Do not let one failed item fail the entire batch]] unless the consumer explicitly requires all-or-nothing semantics, in which case document that it is transactional.\n\n:::deep\n- with bulk requests and `Idempotency-Key`, the key must be at the [[g:individual-item level]], not the request level: if three items in a batch of 100 succeeded before a retry, only the remaining 97 should be processed\n- enforce a hard batch-size limit, such as 100, and return [[b:413]] when it is exceeded; move larger batches to an asynchronous job (17-rest-api-design.contracts-errors-lifecycle.q3)\n- arbitrarily deep `expand` support means [[r:building a DoS vector]] against your own service because every expansion level multiplies the query count\n- field selection also helps the database: `fields=id,status` can enable an index-only scan (see 18.5)\n- consider GraphQL only when clients genuinely need arbitrary response shapes (04-rest-grpc-webflux.protocols.q6), and accept its costs as well: query-depth limits, persisted queries, and N+1 resolvers\n\nDo not build all three on day one. [[o:Measure]] which client calls dominate, then add the appropriate capability.\n:::\n\n:::tip Bulk is a contract boundary, not an unbounded array\n`207 Multi-Status` versus `200` with per-item results is a client contract choice; neither implies all-or-nothing behavior. Define per-item authorization, validation, retry identity, ordering, maximum size, and whether partial effects are allowed.\n\nWhen the work cannot fit the request deadline, accept it as a durable operation with `202` and a status resource instead of increasing the synchronous batch limit without bound.\n:::","difficulty":"extra"}]},{"title":"Contracts, errors & lifecycle","items":[{"id":"17-rest-api-design.contracts-errors-lifecycle.q1","q":"How should an Idempotency-Key be designed end to end for POST requests that create bookings or payments?","a":"The problem: a client calls `POST /payments` and the network times out. Did the server debit the money or not? If the client retries, it may [[r:charge the customer twice]].\n\n**Contract:** the client generates a key (UUID) for each business *intent* and sends it in the `Idempotency-Key` header. Every retry must [[o:reuse exactly the same key]].\n\n**On the server:**\n1. `INSERT` the key into an `idempotency_keys` table protected by a unique constraint; the winner continues and a loser jumps to step 4\n2. execute the business operation\n3. store the [[g:status, response body, and request hash]] in that same row\n4. for a later call with the same key, return the stored response verbatim without executing the operation again\n\n<pre><code><span class=\"k\">INSERT INTO</span> idempotency_keys(key, user_id, req_hash, state)\n<span class=\"k\">VALUES</span>(?,?,?,<span class=\"s\">'IN_PROGRESS'</span>)\n<span class=\"k\">ON CONFLICT</span>(key) <span class=\"k\">DO NOTHING</span>;  <span class=\"c\">-- 0 rows =&gt; another request is already processing it</span></code></pre>\n\nA different key with the same body is a new request, so [[o:process it normally]]. The same key with a different body should return [[b:422]] because it is a client bug.\n\n:::deep\nThree details distinguish a textbook answer from a system that has been operated in production:\n\n- **`req_hash`**: without it, a client that reuses a key for a different payload receives an unrelated old result. Hash a canonicalised body and compare it.\n- **`IN_PROGRESS` state**: if a retry arrives before the first request completes, return [[b:409]] with `Retry-After`; [[r:do not run it concurrently]] and do not block indefinitely.\n- **Retention/expiry**: choose it from the business retry and late-arrival window, provider contract, storage cost, and replay policy. Keeping keys forever bloats the table; deleting them too early allows a late retry through.\n\nPersisting the key and executing the business operation must happen [[g:in the same transaction]]—or through an outbox—otherwise there is a window in which the money has been debited but the key has not been recorded.\n\nGET, PUT, and DELETE are already idempotent by semantics and do not need a key. POST and controller actions are the operations that need one.\n\nStripe and Adyen document idempotency behavior in their own APIs; do not generalize that contract to VNPay or another provider without current first-party evidence.\n\nNaming the header and persistence table demonstrates operational understanding, but the provider-specific scope still belongs in the contract.\n:::\n\n:::tip Scope and expiry are part of the contract\n`Idempotency-Key` deduplicates one declared operation intent only within a scope such as tenant + endpoint + provider account. Persist a canonical request fingerprint and reject same-key/different-body reuse.\n\n- `COMPLETED` replays the stored response.\n- `IN_PROGRESS` needs a bounded lease/recovery path.\n- Expiry must cover the documented late-arrival window; it is not a universal 24-hour or 7-day rule.\n\nA new key for the same business intent remains a domain duplicate, so pair this API control with a business identifier/unique constraint and provider status or reconciliation when the external result is unknown.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q2","q":"How should errors be standardized with RFC 9457 Problem Details, and why should it be used?","a":"Letting every service invent its own error format is the fastest way to force clients to maintain five different parsers. [[g:RFC 9457]] (which supersedes RFC 7807) standardises the contract.\n\n`Content-Type: application/problem+json`\n\n<pre><code>{\n  <span class=\"s\">\"type\"</span>:     <span class=\"s\">\"https://api.acme.vn/errors/seat-unavailable\"</span>,\n  <span class=\"s\">\"title\"</span>:    <span class=\"s\">\"Seat is already held\"</span>,\n  <span class=\"s\">\"status\"</span>:   <span class=\"n\">409</span>,\n  <span class=\"s\">\"detail\"</span>:   <span class=\"s\">\"Seat 12A on flight VN231 was held at 10:04.\"</span>,\n  <span class=\"s\">\"instance\"</span>: <span class=\"s\">\"/bookings/8H2K\"</span>,\n  <span class=\"s\">\"traceId\"</span>:  <span class=\"s\">\"4bf92f3577b34da6\"</span>,      <span class=\"c\">// custom extension</span>\n  <span class=\"s\">\"errors\"</span>:   [{<span class=\"s\">\"field\"</span>:<span class=\"s\">\"seatNo\"</span>,<span class=\"s\">\"code\"</span>:<span class=\"s\">\"TAKEN\"</span>}]\n}</code></pre>\n\n- [[b:type]] — a stable URI identifying the *category* of error; clients branch on it\n- [[b:title]] — a short human-readable description that does not vary by occurrence\n- [[b:status]] — the repeated HTTP status, convenient for logging\n- [[b:detail]] — a description specific to this occurrence\n- [[b:instance]] — the resource associated with the error\n\n[[r:Do not make clients parse `title`]] to choose a branch; localisation will break them. Branch on `type` or on a stable `code` field.\n\n:::tip Key interview point\nSay: *'The status code serves the infrastructure layer—proxies, retries, and circuit breakers—while `type`/`code` serves the business layer.'* Two layers, two purposes.\n:::\n\n:::deep\n- [[r:Never]] put a stack trace, table name, SQL statement, or original exception message in `detail`; that leaks information. Log the complete error on the server and return a `traceId` that the customer can provide to support.\n- set `traceId` to the OpenTelemetry trace ID so a reported failure can be located in seconds\n- for validation failures across multiple fields, use an `errors[]` extension instead of concatenating strings\n- 401 vs 403: [[o:401 = the server does not yet know who you are]] (missing or expired token), while [[o:403 = your identity is known but lacks permission]]. Confusing them makes clients retry incorrectly.\n- transient errors (429, 503) [[g:must]] include `Retry-After`; otherwise every client invents its own backoff, usually badly\n- Spring Boot 3 provides `ProblemDetail` and `@ExceptionHandler` out of the box; enable `spring.mvc.problemdetails.enabled=true`\n:::","difficulty":"core"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q3","q":"For a long-running REST operation, when should you use 202 with polling, a webhook, or streaming?","a":"Ticket issuance, reconciliation, and report exports can take 30 seconds to several minutes. [[r:Keeping the HTTP connection open and waiting]] is the wrong design because of load-balancer timeouts (often 60 seconds), client retries, and occupied threads.\n\n**Standard pattern — 202 with polling:**\n\n1. `POST /reports` → [[b:202 Accepted]], a `Location: /operations/{opId}` header, and a body containing `opId`\n2. the client calls `GET /operations/{opId}` → `{\"state\":\"RUNNING\",\"progress\":42}`\n3. on completion → `{\"state\":\"SUCCEEDED\",\"resultUrl\":\"/reports/{id}\"}` or `{\"state\":\"FAILED\",\"error\":{...}}`\n\nInclude `Retry-After` in polling responses so the client does not send ten requests per second.\n\n<table class=\"cmp\"><thead><tr><th>Approach</th><th>Use when</th><th>Trade-off</th></tr></thead><tbody>\n<tr><td>202 + polling</td><td>the default; the client is a browser or mobile app</td><td>latency equals the polling interval; additional requests</td></tr>\n<tr><td>Webhook / callback</td><td>the client is a server, such as a B2B partner</td><td>the client needs a public endpoint, signature verification, and idempotent handling</td></tr>\n<tr><td>SSE / WebSocket</td><td>the UI needs real-time progress</td><td>stateful connections are harder to scale through a load balancer</td></tr>\n</tbody></table>\n\n:::deep\n`operations` is a [[g:real resource]]: it has an ID and state, can be retrieved with `GET`, and remains available after the job finishes. That is what distinguishes it from an internal job queue.\n\n- `POST /reports` [[g:must]] be idempotent through `Idempotency-Key` (17-rest-api-design.contracts-errors-lifecycle.q1), otherwise every retry creates another expensive job\n- support cancellation with `DELETE /operations/{opId}` or `POST /operations/{opId}:cancel`\n- `resultUrl` should be an expiring [[o:pre-signed URL]], not a permanently public link\n- for webhooks, sign the payload with HMAC plus a timestamp to prevent replay, retry with backoff, and remember that the [[r:client must handle duplicates]] because at-least-once delivery is the default\n- retain the operation record for several days after completion so a client that loses connectivity can still query it\n\nIn an OTA, ticket issuance through a GDS may take 5–40 seconds: use 202 plus polling for the consumer app and a webhook for B2B partners. One job, two notification channels.\n:::\n\n:::tip 202 means durable admission, not completion\nPersist the operation intent and status before returning `202`; after a process restart the client must still be able to query it.\n\nDefine retention/expiry, terminal `SUCCEEDED` and `FAILED` states, provider `UNKNOWN` or reconciliation states where relevant, authorization on the status and result resources, and `Retry-After` or `Link` guidance. A response body saying “accepted” without durable status is only an optimistic acknowledgment.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q4","q":"How do you roll out deprecation and safely retire an old API version in production?","a":"(04-rest-grpc-webflux.protocols.q4) covers *choosing a versioning scheme*. This is the harder part: [[o:retiring an old version without breaking consumers]].\n\n**Five-step process:**\n\n1. **Measure first** — log `api_version` and `client_id` for every request. Without usage data, nothing may be switched off.\n2. **Signal through headers** — on responses from the old version itself:\n   - `Deprecation: @1735689600` (RFC 9745, Unix timestamp)\n   - `Sunset: Sat, 01 Nov 2026 00:00:00 GMT` (RFC 8594)\n   - `Link: &lt;https://docs.acme.vn/migrate/v2&gt;; rel=\"deprecation\"`\n3. **Contact the highest-volume clients directly** — headers do not read anyone's email for them.\n4. **Brownout** — deliberately return [[b:503]] for a few minutes each day, then increase the duration. Any live consumer will surface errors and its owner will call you *before* the deadline rather than after it.\n5. **Retire the version** — return [[b:410 Gone]] with Problem Details linking to the migration guide, not 404.\n\n:::deep\nThe golden rule is that [[g:additive changes do not require a new version]]. Adding an optional field, a *documented* enum value, or an endpoint is safe when correctly written clients ignore unknown fields.\n\nA [[r:breaking change]] always requires a version: removing or renaming a field, changing its type, tightening validation, changing the semantics of an existing field, or changing a returned status code.\n\n- [[o:Enum trap]]: adding a new enum value *is* breaking for a client whose `switch` has no `default`. Document from v1 that clients must tolerate unknown enum values.\n- consumer-driven contract tests such as Pact catch breaking changes in CI before they reach production\n- run no more than [[o:two versions]] concurrently; the appearance of a third indicates that the deprecation process has failed\n- v2 should be a [[g:thin adapter]] in front of the same core domain, not a code fork; a fork duplicates every bug fix\n- reasonable deprecation windows are 6–12 months for public APIs and 1–3 months for internal APIs\n\nMentioning step 4, the brownout, is a strong differentiator because very few candidates do.\n\n**Wire-visible lifecycle contract (RFC 9745 + RFC 8594):**\n<pre><code>HTTP/1.1 200 OK\nDeprecation: @1798761600\nSunset: Wed, 30 Jun 2027 23:59:59 GMT\nLink: &lt;/docs/migrate-v2&gt;; rel=\"deprecation\"; type=\"text/html\"\n# after the announced sunset\nHTTP/1.1 410 Gone\nContent-Type: application/problem+json\nLink: &lt;/docs/migrate-v2&gt;; rel=\"deprecation\"\n{\"type\":\"https://api.example.test/problems/version-retired\",\n \"title\":\"API version retired\",\"status\":410}</code></pre>\n\n`Deprecation` uses an epoch-seconds structured date; `Sunset` uses an HTTP date and cannot precede it.\n\n- **Benefit:** clients and inventory scanners detect lifecycle state without scraping release notes.\n- **Limit:** headers do not migrate anyone. Measure traffic by client, notify owners, run a reversible brownout and keep rollback until residual use is understood.\n:::\n\n:::tip Retirement is an observed migration, not a date in a document\nMeasure traffic by client, version, tenant and operation before choosing a retirement date. Publish owners, compatibility rules, warning/deprecation signals, migration examples, a brownout or canary plan, and a rollback path; keep telemetry until the last supported client has moved.\n\nDeprecation headers and sunset dates communicate intent, but they do not replace enforcement, authorization, or a tested migration.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q5","difficulty":"advanced","q":"How should cursor pagination, HTTP caching, conditional requests, and rate-limit fields work together?","a":"Design them as one observable contract; each mechanism has a different scope.\n\n**Cursor pagination:** use a stable, unique total order such as `(created_at, id)` and keyset predicates rather than a deep offset.\n\nMake the cursor opaque and versioned; encode or server-side store the last sort tuple plus the filters/order and, when the product requires repeatable traversal, a snapshot or high-water mark.\n\nSign or authenticate client-visible cursors, set an expiry policy, clamp page size, and return a link or `next_cursor`. Define what inserts, deletes, and updates between pages mean—an opaque cursor does not automatically create snapshot consistency.\n\n<pre><code>GET /bookings?status=CONFIRMED&amp;limit=50&amp;cursor=eyJ2IjoyLC4uLn0\n200 OK\nETag: \"page-7f42\"\nCache-Control: private, max-age=30\n{\"items\":[...],\"next_cursor\":\"eyJ2IjoyLC4uLn0\"}</code></pre>\n\n**Caching and preconditions:** the ETag identifies that response representation, including authorization-sensitive variants and query parameters. `If-None-Match` can yield `304 Not Modified`; configure `Cache-Control` and `Vary` so shared caches do not cross users or representations.\n\nFor a write, `If-Match` can protect a versioned resource and returns `412 Precondition Failed` when stale. It does not replace a domain idempotency key.\n\n**Rate limits:** use `429 Too Many Requests` and, when useful, `Retry-After`. As of 2026-08-01, the IETF `RateLimit-Policy`/`RateLimit` field work is still Internet-Draft `draft-ietf-httpapi-ratelimit-headers-11`, not an RFC.\n\nIf adopted, pin the draft/version in the API contract and do not mix its structured-field semantics with legacy `X-RateLimit-*` fields accidentally. Quota values are hints, not authorization or a service guarantee.\n\n:::deep\nReturn invalid/expired cursor and precondition failures as stable RFC 9457 problem types (17-rest-api-design.contracts-errors-lifecycle.q2). Do not expose database keys, tenant information, capacity, or signed state that can be tampered with.\n\nA cached page may contain stale quota fields; clients should prioritize `Retry-After` and the documented contract, while servers must enforce limits independently.\n\nTest duplicate/omitted records under concurrent mutation, cursor replay across users and filter changes, 304 behavior through the real CDN/proxy, ETag changes on representation changes, 429 caching, clock skew, and client backoff.\n:::"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q6","q":"You have to deliver webhooks to hundreds of partner endpoints you do not control. What does that system actually need?","a":"Publishing webhooks makes you an HTTP client to servers that are slow, wrong, or gone — while still owing every one of them delivery. Treat it as a queue with retries, never as a call inside the request that produced the event.\n\n<pre><code>business transaction commits &#8594; outbox row\n        &#8594; dispatcher picks it up &#8594; per-subscriber delivery attempt\n        &#8594; 2xx: done | 4xx: stop | 5xx or timeout: schedule retry\n        &#8594; retries exhausted &#8594; dead-letter + subscriber marked unhealthy</code></pre>\n\n**What each part is protecting you from:**\n\n- [[g:signing]] — HMAC over the raw body plus a timestamp header, so the receiver can prove the payload is yours and reject a replay\n- [[g:bounded retries with backoff and jitter]] — a published schedule (say 1m, 5m, 30m, 2h, 6h) that partners can reason about, not an infinite loop\n- [[g:isolation per subscriber]] — one partner timing out at 30 s must not consume the workers every other partner is waiting on (25-microservice.01-cascading-failure-retry-storm.q4)\n- [[g:a delivery log]] — attempt, status, response snippet, next retry — because the first support question is always \"we never received it\"\n\n<table class=\"cmp\"><thead><tr><th>Guarantee</th><th>What you can promise</th></tr></thead><tbody>\n<tr><td>Delivery</td><td>at-least-once — so include a stable `event_id`</td></tr>\n<tr><td>Order</td><td>none; include `occurred_at` and a per-resource sequence</td></tr>\n<tr><td>Timing</td><td>best effort; a partner outage delays everything behind it</td></tr>\n<tr><td>Payload</td><td>a versioned contract you cannot silently change</td></tr>\n</tbody></table>\n\n:::warn The subscriber URL is attacker-controlled input\nWhoever registers the endpoint chooses where your servers send traffic. Validate the resolved address and send through a restricted egress path, or webhook registration becomes SSRF (13-security-oauth2.secure-coding-at-the-boundary.q4).\n:::\n\n:::deep\n- generate the event from the [[o:same transaction]] that changed the data, via an outbox. Firing an HTTP call inside the transaction couples your commit to a partner's uptime (08-message-queue.reliability-delivery-semantics.q7).\n- give each subscriber [[b:two active secrets]] during rotation so they can switch without a coordinated deploy; sign with the new one and accept both for a window (13-security-oauth2.designing-the-auth-system.q4).\n- auto-disable endpoints that have failed for days, and require a manual re-enable. Retrying a dead URL forever is how a delivery queue turns into a backlog nobody can drain.\n- offer replay as a product feature — \"resend events from this window\" — otherwise every partner incident becomes a manual database job for you.\n- alert on delivery lag and failure rate per subscriber, not globally; one broken partner is invisible in an aggregate success rate (20-observability-sre.slos-alerting-incidents.q2).\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q7","q":"A payment provider posts a webhook to you. What must the handler do before it trusts a single field?","a":"An inbound webhook is an unauthenticated public endpoint carrying instructions about money. The order of operations is the control.\n\n<pre><code><span class=\"k\">@PostMapping</span>(<span class=\"s\">\"/webhooks/psp\"</span>)\nResponseEntity&lt;Void&gt; <span class=\"f\">receive</span>(<span class=\"k\">@RequestBody</span> <span class=\"k\">byte</span>[] raw,\n                             <span class=\"k\">@RequestHeader</span>(<span class=\"s\">\"X-Signature\"</span>) String sig,\n                             <span class=\"k\">@RequestHeader</span>(<span class=\"s\">\"X-Timestamp\"</span>) String ts) {\n    <span class=\"k\">if</span> (!signatures.valid(raw, ts, sig)) <span class=\"k\">return</span> ResponseEntity.status(<span class=\"n\">401</span>).build();\n    <span class=\"k\">if</span> (clock.instant().minus(TOLERANCE).isAfter(Instant.parse(ts)))\n        <span class=\"k\">return</span> ResponseEntity.status(<span class=\"n\">400</span>).build();          <span class=\"c\">// outside the replay window</span>\n<span class=\"c\">    </span>\n    inbox.recordIfNew(eventIdOf(raw));                    <span class=\"c\">// unique index = dedup</span>\n    <span class=\"k\">return</span> ResponseEntity.accepted().build();             <span class=\"c\">// process asynchronously</span>\n}</code></pre>\n\n**The order matters:**\n\n- verify the signature over the [[g:raw bytes]], before parsing — a re-serialized body no longer matches, and parsing untrusted input is itself an attack surface (13-security-oauth2.secure-coding-at-the-boundary.q3)\n- compare in [[g:constant time]], and reject anything outside the timestamp tolerance so a captured request cannot be replayed tomorrow\n- [[g:acknowledge fast, process later]] — providers time out in seconds and retry, so heavy work inside the handler manufactures duplicates\n- [[g:deduplicate on the provider's event id]] with a unique constraint, since at-least-once is the only guarantee on offer (25-microservice.09-idempotency-the-central-link.q1)\n\n<table class=\"cmp\"><thead><tr><th>Situation</th><th>Wrong response</th><th>Right response</th></tr></thead><tbody>\n<tr><td>Signature invalid</td><td>ignore quietly</td><td>401 and alert — someone is probing</td></tr>\n<tr><td>Event already processed</td><td>reprocess it</td><td>2xx, do nothing</td></tr>\n<tr><td>Event arrives out of order</td><td>apply blindly</td><td>compare state or sequence, ignore the older one</td></tr>\n<tr><td>Your handler is broken</td><td>200 so retries stop</td><td>5xx, let the provider retry while you fix it</td></tr>\n<tr><td>Unknown event type</td><td>fail</td><td>2xx, record it, ignore</td></tr>\n</tbody></table>\n\n:::warn Never let the payload be the last word on money\nAmounts and statuses in a webhook body are a notification, not a source of truth. For anything financial, confirm against the provider's API before crediting an account (09-distributed-tx-fintech.correctness-where-money-is-involved.q1).\n:::\n\n:::deep\n- [[o:webhook plus polling]] is the reliable pairing: the webhook makes the common case fast, a reconciliation job catches what was never delivered. Neither alone is enough.\n- store the raw payload and headers before processing. When a partner disputes an outcome, the received bytes are the only evidence you have.\n- keep the endpoint out of your standard auth chain but inside rate limiting; it is public by necessity and a free amplification target otherwise.\n- a `409` or `422` teaches a provider nothing — most implement \"retry on 5xx, give up on 4xx\", so choose the class deliberately (17-rest-api-design.contracts-errors-lifecycle.q2).\n- test the ugly paths: duplicate delivery, out-of-order arrival, a signature from a rotated secret, and a payload for an entity you have never seen (26-testing-strategy.testing-what-usually-breaks.q3).\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q8","q":"How should a large upload be modelled as an API resource?","a":"Model the upload session as a durable resource rather than keeping one HTTP request open.\n\nA typical contract is:\n\n1. <code>POST /uploads</code> authenticates the owner and returns <code>201 Created</code> with an upload ID, object constraints, part size, expiry, checksum algorithm, and either an upload URL or direct-storage instructions.\n2. The client uploads parts with the upload ID, part number or byte range, size, and checksum. A part retry addresses the same session and part; it does not create a second business object.\n3. <code>GET /uploads/{id}</code> returns accepted parts, progress, expiry, and an explicit state: <code>INITIATED</code>, <code>PARTIAL</code>, <code>VERIFYING</code>, <code>COMPLETE</code>, <code>ABORTED</code>, or <code>EXPIRED</code>.\n4. <code>POST /uploads/{id}/complete</code> supplies or confirms the manifest. The server verifies ownership, part list, size and integrity before publishing the immutable object.\n5. <code>DELETE /uploads/{id}</code> or an expiry job aborts incomplete parts and releases temporary storage.\n\nOnly after completion is durable should the API enqueue downstream processing and return <code>202 Accepted</code> for a long-running job. Completion must be conditional and idempotent; a repeated request returns the same result or a documented conflict.\n\nEnforce limits at every proxy, protect the session from cross-tenant access, and clean up abandoned parts.\n\n:::deep\nDirect multipart/resumable object storage reduces application bandwidth, but it does not remove authorization, expiry, checksum, reconciliation, or lifecycle responsibility. The upload resource is not the source-of-truth business record until completion passes.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q9","q":"When is 202 Accepted a truthful contract for a long-running job?","a":"202 Accepted means the request was accepted for processing; it does not mean the work succeeded, will finish exactly once, or can be cancelled for free.\n\nBefore returning 202, create a durable job identity and persist enough intent to recover it: owner and authorization scope, input or object version, idempotency key, state, timestamps, attempt policy, and a status URL.\n\nA retry with the same client intent must return or resume the same job rather than enqueueing a duplicate.\n\nDefine states and ownership explicitly: <code>ACCEPTED</code>, <code>RUNNING</code>, <code>SUCCEEDED</code>, <code>FAILED</code>, <code>CANCELLED</code>, <code>EXPIRED</code>, and <code>UNKNOWN</code> when the worker or provider outcome cannot yet be determined.\n\nA worker claim needs a lease or visibility deadline, bounded retry, checkpoint semantics, and a rule for side effects already committed. Cancellation is cooperative unless the system can prove no side effect escaped.\n\nReturn progress only when it is meaningful and monotonic; expose a result resource or error problem type, and offer reconciliation for ambiguous timeouts.\n\nA queue, Kubernetes Job, or workflow engine supplies execution primitives, not automatically the API's idempotency, authorization, cancellation, or exactly-once guarantee.\n\n:::tip Ownership\nTopic 17 owns the wire contract. Topic 08 owns broker delivery semantics; Topic 25 owns consumer retry and deduplication; domain topics decide which side effects need compensation or strong consistency.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"17-rest-api-design","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q5":"surviving-high-load","10-system-design-rate-limit.rate-limiting-in-depth.q1":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q2":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q3":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q4":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q5":"distributed-rate-limiter","10-system-design-rate-limit.rate-limiting-in-depth.q6":"distributed-rate-limiter","11-system-design-c