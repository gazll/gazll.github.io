{"rows":[{"n":1,"file":"topics/01-java-core-jvm.json","topic_type":"core"},{"n":2,"file":"topics/02-java-8-25-java-vs-go.json","topic_type":"core"},{"n":3,"file":"topics/03-spring-boot-deep-build.json","topic_type":"core"},{"n":4,"file":"topics/04-rest-grpc-webflux.json","topic_type":"design"},{"n":5,"file":"topics/05-db-core-index-lock.json","topic_type":"data"},{"n":6,"file":"topics/06-db-scaling.json","topic_type":"data"},{"n":7,"file":"topics/07-sql-nosql-db-engines.json","topic_type":"data"},{"n":8,"file":"topics/08-message-queue.json","topic_type":"data"},{"n":9,"file":"topics/09-distributed-tx-fintech.json","topic_type":"design"},{"n":12,"file":"topics/12-architecture-patterns.json","topic_type":"design"},{"n":13,"file":"topics/13-security-oauth2.json","topic_type":"platform"},{"n":14,"file":"topics/14-devops-k8s-best-practices.json","topic_type":"platform"},{"n":15,"file":"topics/15-network-i-o-models.json","topic_type":"core"},{"n":16,"file":"topics/16-project-concurrency-whiteboard.json","topic_type":"algorithm","system_design_items":["16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q1","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q2","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q3","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q4","16-project-concurrency-whiteboard.presenting-dissecting-the-ota-project.q5","16-project-concurrency-whiteboard.whiteboard-dsa.q1"]},{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},{"n":18,"file":"topics/18-query-optimization.json","topic_type":"data"},{"n":19,"file":"topics/19-dsa-leetcode.json","topic_type":"algorithm"},{"n":20,"file":"topics/20-observability-sre.json","topic_type":"platform"},{"n":21,"file":"topics/21-linux-production-debug.json","topic_type":"platform"},{"n":22,"file":"topics/22-low-level-design-ood.json","topic_type":"algorithm"},{"n":23,"file":"topics/23-java-concurrency-coding.json","topic_type":"algorithm"},{"n":24,"file":"topics/24-domain-driven-design.json","topic_type":"design"},{"n":25,"topic_type":"microservice","file":"topics/25-microservice.json"},{"n":26,"file":"topics/26-testing-strategy.json","topic_type":"core"},{"n":28,"file":"topics/28-distributed-lock-lease.json","topic_type":"design"}],"row":{"n":17,"file":"topics/17-rest-api-design.json","topic_type":"design"},"meta":{"topic_type":"design","key":"17-rest-api-design","vi":{"label":"Thiết kế REST API","title":"Thiết kế REST API — resource, hợp đồng và vòng đời","intro":"Ngày 4 nói REST *là gì*; chủ đề này nói *thiết kế thế nào*. Từ mô hình hoá resource, ánh xạ hành động nghiệp vụ, tới idempotency, chuẩn lỗi và cách khai tử một version mà không gãy client — đúng những gì interviewer đào khi bạn nói 'em thiết kế API'.","tags":["Resource modeling","Idempotency-Key","RFC 9457","PATCH","Async 202","Sunset header","Bulk API","Webhooks"]},"en":{"label":"REST API design","title":"REST API design — resources, contracts and lifecycle","intro":"Topic 4 covers what REST is; this one covers how you design it. From modelling resources and mapping business actions, through idempotency and error standards, to retiring a version without breaking clients — exactly what an interviewer digs into once you say you design APIs.","tags":["Resource modeling","Idempotency-Key","RFC 9457","PATCH","Async 202","Sunset header","Bulk API","Webhooks"]},"created_at":"2026-07-31","updated_at":"2026-10-25"},"topicMeta":{"1":{"en":{"label":"Java Core & JVM"},"vi":{"label":"Java Core & JVM"}},"2":{"en":{"label":"Java 8→25 & Java vs Go"},"vi":{"label":"Java 8→25 & Java vs Go"}},"3":{"en":{"label":"Spring Boot deep dive + build"},"vi":{"label":"Spring Boot deep + build"}},"4":{"en":{"label":"REST/gRPC & WebFlux"},"vi":{"label":"REST/gRPC & WebFlux"}},"5":{"en":{"label":"DB core: indexes & locking"},"vi":{"label":"DB core: index & lock"}},"6":{"en":{"label":"DB scaling"},"vi":{"label":"DB scaling"}},"7":{"en":{"label":"SQL/NoSQL & DB engines"},"vi":{"label":"SQL/NoSQL & DB engines"}},"8":{"en":{"label":"Message queue"},"vi":{"label":"Message queue"}},"9":{"en":{"label":"Distributed tx (fintech)"},"vi":{"label":"Distributed tx (fintech)"}},"10":{"en":{"label":"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"17-rest-api-design.contracts-errors-lifecycle.q5":"2026-08-01","17-rest-api-design.contracts-errors-lifecycle.q4":"2026-08-12"},"lang":"vi","body":{"sections":[{"title":"Mô hình hoá resource & URI","items":[{"id":"17-rest-api-design.modelling-resources-uris.q1","q":"Từ use case tới resource: mô hình hoá và đặt tên URI thế nào cho đúng?","a":"Bắt đầu từ [[g:danh từ nghiệp vụ]], không phải từ table DB và càng không phải từ method của service.\n\n**Quy tắc đặt tên:**\n- danh từ số nhiều, chữ thường, gạch nối: `/flight-bookings`\n- phân cấp thể hiện quan hệ sở hữu: `/bookings/{id}/passengers`\n- [[r:không đặt động từ vào URI]]: `/getBooking`, `/createBooking` là RPC đội lốt REST\n- lồng tối đa 2 cấp — sâu hơn thì tách resource độc lập + query param\n\nResource [[o:không phải]] là table. `/bookings` có thể ghép từ 4 table; ngược lại một table `user` có thể lộ ra `/users` và `/users/{id}/preferences` như hai resource khác nhau.\n\n:::deep\nÁnh xạ 1-1 giữa resource và table là [[r:rò rỉ mô hình lưu trữ]] ra hợp đồng công khai — sau này đổi schema là phá client.\n\n- resource nên bám [[g:bounded context]] (DDD), không bám ERD\n- id trong URI dùng [[o:id đối ngoại]] (UUID/mã booking `VN8H2K`), không dùng auto-increment nội bộ: số tuần tự lộ lượng đơn và cho phép dò tuần tự (IDOR)\n- quan hệ nhiều-nhiều: tạo resource cho chính mối quan hệ (`/bookings/{id}/seat-assignments`) khi nó có thuộc tính riêng\n- collection luôn trả object bọc ngoài (`{\"data\":[...], \"next\":\"...\"}`), [[r:đừng trả mảng trần]] — không còn chỗ thêm metadata mà không phá client\n\nOTA: `/flights` (search, read-heavy, cache được) tách hẳn khỏi `/bookings` (transactional) — khác nhau cả về consistency lẫn rate limit.\n:::","difficulty":"core"},{"id":"17-rest-api-design.modelling-resources-uris.q2","q":"Hành động không phải CRUD (cancel, refund, issue ticket) ánh xạ vào REST ra sao?","a":"Đây là câu interviewer hay dùng để phân biệt người đọc tutorial với người từng thiết kế thật. Ba cách, theo thứ tự ưu tiên:\n\n**1. Biến hành động thành resource** — tốt nhất khi hành động có vòng đời riêng:\n\n`POST /bookings/{id}/refunds` → tạo một `Refund` có id, trạng thái, lịch sử. Truy vấn lại được: `GET /refunds/{rid}`.\n\n**2. Đổi state qua sub-resource** — khi chỉ là chuyển trạng thái:\n\n`PUT /bookings/{id}/status` với body `{\"value\":\"CANCELLED\"}`.\n\n**3. Controller action** — lối thoát cuối, dùng động từ có chủ đích:\n\n`POST /bookings/{id}:cancel` (kiểu Google AIP) hoặc `/bookings/{id}/cancel`.\n\n[[g:Nguyên tắc chọn]]: hành động cần audit / retry / trạng thái riêng → cách 1. Chỉ lật một cờ → cách 2. Còn lại → cách 3, và đừng thấy tội lỗi.\n\n:::deep\nCách 1 thắng vì nó trả lời được những câu mà cách 3 không trả lời được: *refund đang tới đâu? ai bấm? thử lại lần mấy?*\n\n- hành động sinh tiền ([[o:refund, charge, payout]]) [[g:luôn]] nên là resource — bạn sẽ cần lịch sử của nó, chắc chắn\n- `POST` tới action là [[r:không idempotent]] theo mặc định → cặp với `Idempotency-Key` (xem 17.5)\n- tránh dồn nhiều hành động vào một endpoint bằng field `action` trong body: mất khả năng authorization, rate limit và đo lường theo từng hành động\n- state transition không hợp lệ trả [[b:409 Conflict]] kèm state hiện tại, không phải 400\n\nOTA: `POST /bookings/{id}/cancellations` cho phép cancel một phần (huỷ 1 trong 3 hành khách) — điều mà `PUT .../status` không diễn đạt nổi.\n:::\n\n:::tip Đây là contract style, không phải luật REST tuyệt đối\nNên dùng action dạng resource khi kết quả có lifecycle, history, authorization hoặc retry identity riêng.\n\nController action có chủ đích vẫn hợp lệ khi operation là atomic và ngắn; hãy ghi rõ status, idempotency, authorization và error contract, vì riêng URI không tự tạo ra các guarantee đó.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.modelling-resources-uris.q3","q":"PUT vs PATCH: JSON Merge Patch và JSON Patch khác nhau thế nào, chọn cái nào?","a":"[[b:PUT]] = thay [[o:toàn bộ]] representation. Thiếu field = field đó bị xoá/về default. Idempotent.\n\n[[b:PATCH]] = cập nhật [[o:một phần]]. Bản thân PATCH [[r:không đảm bảo idempotent]] — tuỳ định dạng patch.\n\n<table class=\"cmp\"><thead><tr><th></th><th>JSON Merge Patch (RFC 7396)</th><th>JSON Patch (RFC 6902)</th></tr></thead><tbody>\n<tr><td>Content-Type</td><td><code>application/merge-patch+json</code></td><td><code>application/json-patch+json</code></td></tr>\n<tr><td>Cú pháp</td><td>giống object gốc, chỉ field muốn đổi</td><td>mảng operation: add/remove/replace/move/test</td></tr>\n<tr><td>Xoá field</td><td><code>null</code></td><td><code>{\"op\":\"remove\",\"path\":\"/x\"}</code></td></tr>\n<tr><td>Set field = null</td><td>không diễn đạt được</td><td>được</td></tr>\n<tr><td>Sửa 1 phần tử mảng</td><td>không (phải gửi cả mảng)</td><td>được, theo index</td></tr>\n<tr><td>Idempotent</td><td>có</td><td>không (<code>add</code> vào mảng)</td></tr>\n</tbody></table>\n\nChọn [[g:Merge Patch]] cho object update thông thường khi semantics null/delete phù hợp; chọn [[g:JSON Patch]] khi cần sửa phần tử mảng, dùng `test` cho optimistic concurrency, hoặc build collaborative editing.\n\n:::deep\nCái bẫy kinh điển của Merge Patch: [[r:không phân biệt được 'không gửi field' với 'set field = null']]. Trong Java, `{\"note\": null}` và `{}` cùng deserialize ra `note == null`.\n\nCách xử lý: bọc field trong `Optional`-like wrapper (`JsonNullable` của openapi-generator), hoặc đọc raw `JsonNode` và kiểm tra `has(\"note\")`.\n\n- PATCH + optimistic concurrency: yêu cầu `If-Match: \"&lt;etag&gt;\"`, trả [[b:412 Precondition Failed]] nếu lệch → chống lost update khi 2 người sửa cùng lúc\n- PUT lên resource chưa tồn tại: có thể tạo mới (upsert) và trả 201 — nhưng phải nêu rõ trong tài liệu\n- [[r:PATCH mà không validate]] toàn bộ entity sau khi merge là lỗ hổng phổ biến: từng field hợp lệ nhưng tổ hợp thì không\n:::\n\n:::tip Patch format là contract, không phải quy tắc phần trăm\nQuy tắc chọn “95%” chỉ là heuristic giảng dạy, không phải yêu cầu của HTTP hay RFC. Chọn Merge Patch khi semantics thay object và xoá bằng null phù hợp; chọn JSON Patch khi cần sửa array theo operation hoặc dùng precondition `test`.\n\nPhải validate representation sau khi patch và gắn `If-Match` với version resource; không format nào tự cung cấp optimistic concurrency.\n:::","difficulty":"core"},{"id":"17-rest-api-design.modelling-resources-uris.q4","q":"Bulk API và field selection: giảm chattiness mà không phải chuyển sang GraphQL?","a":"Ba kỹ thuật, dùng khi client thật sự đau chứ không phải phòng xa:\n\n**1. Field selection** — `GET /bookings?fields=id,status,total` → giảm payload, giữ covering index dùng được.\n\n**2. Expand / embed** — `GET /bookings/{id}?expand=passengers,payments` → gộp N+1 round-trip của client thành 1. Giới hạn [[o:whitelist]] và độ sâu.\n\n**3. Bulk endpoint** — `POST /bookings/bulk` nhận mảng, trả mảng kết quả từng phần tử.\n\nBulk phải trả [[b:207 Multi-Status]] hoặc 200 kèm mảng có `status` từng item — [[r:đừng để một phần tử lỗi làm fail cả lô]] trừ khi khách hàng yêu cầu all-or-nothing (và khi đó nói rõ là transaction).\n\n:::deep\n- bulk + `Idempotency-Key`: key phải ở [[g:cấp từng item]], không phải cấp request — retry lô 100 item mà 3 item đã thành công thì chỉ 97 item còn lại được xử lý\n- giới hạn cứng kích thước lô (vd 100) và trả [[b:413]] khi vượt; lô lớn → chuyển sang async job (17-rest-api-design.contracts-errors-lifecycle.q3)\n- `expand` sâu tuỳ ý = [[r:tự tạo DoS]] cho chính mình — mỗi cấp expand nhân số query\n- field selection giúp cả DB: `fields=id,status` cho phép index-only scan (xem 18.5)\n- khi client cần shape dữ liệu tự do thật sự → đó mới là lúc cân nhắc GraphQL (04-rest-grpc-webflux.protocols.q6), và nhận luôn chi phí: query depth limit, persisted query, N+1 resolver\n\nĐừng build cả ba từ ngày đầu. [[o:Đo]] xem client gọi gì nhiều nhất rồi mới thêm.\n:::\n\n:::tip Bulk là boundary của contract, không phải array không giới hạn\n`207 Multi-Status` hay `200` kèm kết quả từng item là lựa chọn contract cho client; không lựa chọn nào mặc định có all-or-nothing. Phải định nghĩa authorization, validation, retry identity, ordering, giới hạn kích thước và việc cho phép partial effect theo từng item.\n\nKhi work không thể nằm trong deadline request, hãy nhận request thành operation durable với `202` và status resource thay vì tăng giới hạn batch đồng bộ vô hạn.\n:::","difficulty":"extra"}]},{"title":"Hợp đồng, lỗi & vòng đời","items":[{"id":"17-rest-api-design.contracts-errors-lifecycle.q1","q":"Idempotency-Key: thiết kế đầu-cuối cho POST tạo booking / thanh toán?","a":"Bài toán: client gọi `POST /payments`, mạng timeout. Server đã trừ tiền hay chưa? Client retry → [[r:trừ tiền hai lần]].\n\n**Hợp đồng:** client sinh key (UUID) cho mỗi *ý định* nghiệp vụ, gửi qua header `Idempotency-Key`. Retry dùng [[o:lại đúng key cũ]].\n\n**Phía server:**\n1. `INSERT` key vào table `idempotency_keys` với unique constraint → thắng cuộc đi tiếp, thua cuộc nhảy bước 4\n2. thực thi nghiệp vụ\n3. lưu [[g:status + response body + hash của request]] vào chính hàng đó\n4. lần gọi sau cùng key: trả nguyên response đã lưu, không chạy lại\n\n<pre><code><span class=\"k\">INSERT INTO</span> idempotency_keys(key, user_id, req_hash, state)\n<span class=\"k\">VALUES</span>(?,?,?,<span class=\"s\">'IN_PROGRESS'</span>)\n<span class=\"k\">ON CONFLICT</span>(key) <span class=\"k\">DO NOTHING</span>;  <span class=\"c\">-- 0 row =&gt; đã có người xử lý</span></code></pre>\n\nKey khác nhưng body giống → là request mới, [[o:cứ xử lý]]. Key giống nhưng body khác → trả [[b:422]], đó là bug phía client.\n\n:::deep\nBa chi tiết phân biệt câu trả lời sách vở với câu trả lời từng vận hành:\n\n- **`req_hash`**: không có nó, client dùng lại key cho payload khác sẽ nhận nhầm kết quả cũ. Hash body chuẩn hoá rồi so.\n- **Trạng thái `IN_PROGRESS`**: request đầu chưa xong mà retry tới → trả [[b:409]] kèm `Retry-After`, [[r:đừng chạy song song]] cũng đừng block vô hạn.\n- **Retention/expiry**: chọn theo cửa sổ retry và late-arrival của nghiệp vụ, contract provider, chi phí lưu trữ và replay policy. Giữ mãi thì table phình; dọn sớm thì retry muộn lọt lưới.\n\nViệc lưu key và việc thực thi nghiệp vụ phải [[g:cùng một transaction]] — hoặc dùng outbox — nếu không sẽ có cửa sổ mà tiền đã trừ nhưng key chưa ghi.\n\nGET/PUT/DELETE đã idempotent sẵn theo ngữ nghĩa, không cần key. Chỉ POST và các controller action mới cần.\n\nStripe và Adyen có tài liệu idempotency cho API riêng của họ; không được suy rộng contract đó sang VNPay hay provider khác nếu chưa có first-party evidence hiện tại.\n\nNêu được tên header và table lưu là hữu ích, nhưng scope riêng của provider vẫn phải nằm trong contract.\n:::\n\n:::tip Scope và expiry là một phần của contract\n`Idempotency-Key` chỉ dedup một operation intent trong scope đã khai báo, ví dụ tenant + endpoint + provider account. Lưu fingerprint chuẩn hoá của request và từ chối việc dùng cùng key với body khác.\n\n- `COMPLETED` trả lại response đã lưu.\n- `IN_PROGRESS` cần lease/recovery có giới hạn.\n- Expiry phải bao phủ cửa sổ retry đến muộn đã ghi trong contract, không phải mặc định chung 24 giờ hay 7 ngày.\n\nMột key mới cho cùng business intent vẫn là duplicate ở domain, nên kết hợp API control này với business identifier/unique constraint và status lookup hoặc reconciliation khi kết quả external chưa rõ.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q2","q":"Chuẩn hoá lỗi: RFC 9457 Problem Details gồm gì và vì sao nên dùng?","a":"Mỗi service tự chế một format lỗi là cách nhanh nhất để client phải viết 5 parser khác nhau. [[g:RFC 9457]] (thay thế RFC 7807) chuẩn hoá việc đó.\n\n`Content-Type: application/problem+json`\n\n<pre><code>{\n  <span class=\"s\">\"type\"</span>:     <span class=\"s\">\"https://api.acme.vn/errors/seat-unavailable\"</span>,\n  <span class=\"s\">\"title\"</span>:    <span class=\"s\">\"Ghế đã được giữ\"</span>,\n  <span class=\"s\">\"status\"</span>:   <span class=\"n\">409</span>,\n  <span class=\"s\">\"detail\"</span>:   <span class=\"s\">\"Ghế 12A trên chuyến VN231 đã được giữ lúc 10:04.\"</span>,\n  <span class=\"s\">\"instance\"</span>: <span class=\"s\">\"/bookings/8H2K\"</span>,\n  <span class=\"s\">\"traceId\"</span>:  <span class=\"s\">\"4bf92f3577b34da6\"</span>,      <span class=\"c\">// extension tự thêm</span>\n  <span class=\"s\">\"errors\"</span>:   [{<span class=\"s\">\"field\"</span>:<span class=\"s\">\"seatNo\"</span>,<span class=\"s\">\"code\"</span>:<span class=\"s\">\"TAKEN\"</span>}]\n}</code></pre>\n\n- [[b:type]] — URI định danh *loại* lỗi, ổn định, client switch trên nó\n- [[b:title]] — mô tả ngắn cho người, không đổi theo instance\n- [[b:status]] — lặp lại HTTP status để tiện log\n- [[b:detail]] — mô tả cụ thể lần lỗi này\n- [[b:instance]] — resource gây lỗi\n\n[[r:Đừng bắt client parse `title`]] để phân nhánh — dịch tiếng là gãy. Phân nhánh trên `type` (hoặc một field `code` ổn định).\n\n:::tip Ghi điểm\nNói được: *'status code cho tầng hạ tầng — proxy, retry, circuit breaker; `type`/`code` cho tầng nghiệp vụ.'* Hai tầng, hai mục đích.\n:::\n\n:::deep\n- [[r:Tuyệt đối không]] đưa stack trace, tên table, câu SQL hay message của exception gốc vào `detail` — đó là rò rỉ thông tin. Log đầy đủ ở server, trả `traceId` cho client đọc lên hotline.\n- gắn `traceId` = trace id của OpenTelemetry → khách báo lỗi là tra ra đúng request trong 10 giây\n- validation lỗi nhiều field: dùng extension `errors[]`, đừng nối chuỗi\n- 401 vs 403: [[o:401 = chưa biết bạn là ai]] (thiếu/hết hạn token), [[o:403 = biết rồi nhưng không đủ quyền]]. Nhầm hai cái này làm client retry sai cách.\n- lỗi tạm thời (429, 503) [[g:phải]] kèm `Retry-After` — không có nó client tự chế backoff và thường chế sai\n- Spring Boot 3: `ProblemDetail` + `@ExceptionHandler` là built-in, bật `spring.mvc.problemdetails.enabled=true`\n:::","difficulty":"core"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q3","q":"Long-running operation trong REST: 202 + polling, webhook hay streaming?","a":"Xuất vé, đối soát, export báo cáo — chạy 30 giây tới vài phút. [[r:Giữ HTTP connection chờ]] là sai: timeout của LB (thường 60s), retry của client, và thread bị treo.\n\n**Mẫu chuẩn — 202 + polling:**\n\n1. `POST /reports` → [[b:202 Accepted]], header `Location: /operations/{opId}`, body chứa `opId`\n2. client `GET /operations/{opId}` → `{\"state\":\"RUNNING\",\"progress\":42}`\n3. xong → `{\"state\":\"SUCCEEDED\",\"resultUrl\":\"/reports/{id}\"}` hoặc `{\"state\":\"FAILED\",\"error\":{...}}`\n\nTrả kèm `Retry-After` trong response polling để client không đập 10 lần/giây.\n\n<table class=\"cmp\"><thead><tr><th>Cách</th><th>Hợp khi</th><th>Trade-off</th></tr></thead><tbody>\n<tr><td>202 + polling</td><td>mặc định, client là browser/mobile</td><td>latency = chu kỳ poll; tốn request</td></tr>\n<tr><td>Webhook / callback</td><td>client là server (B2B, đối tác)</td><td>client phải có endpoint public + verify chữ ký + idempotent</td></tr>\n<tr><td>SSE / WebSocket</td><td>cần tiến độ realtime trên UI</td><td>connection stateful, khó scale qua LB</td></tr>\n</tbody></table>\n\n:::deep\n`operations` là một [[g:resource thật]] — có id, có trạng thái, `GET` được, và tồn tại sau khi job xong. Đó là điều khiến nó khác một job queue nội bộ.\n\n- `POST /reports` [[g:phải]] idempotent qua `Idempotency-Key` (17-rest-api-design.contracts-errors-lifecycle.q1), nếu không mỗi lần retry sinh một job nặng mới\n- cho phép huỷ: `DELETE /operations/{opId}` hoặc `POST /operations/{opId}:cancel`\n- `resultUrl` nên là [[o:pre-signed URL]] có hạn, không phải link công khai vĩnh viễn\n- webhook: ký payload bằng HMAC + timestamp (chống replay), retry có backoff, và [[r:client phải xử lý được duplicate]] — at-least-once là mặc định\n- giữ operation record thêm vài ngày sau khi xong: client mất mạng giữa chừng vẫn tra lại được\n\nOTA: xuất vé gọi sang GDS mất 5–40s → 202 + polling cho app khách, webhook cho đối tác B2B. Cùng một job, hai kênh thông báo.\n:::\n\n:::tip 202 nghĩa là durable admission, không phải đã hoàn thành\nPhải persist operation intent và status trước khi trả `202`; sau restart client vẫn phải query được.\n\nĐịnh nghĩa retention/expiry, state cuối `SUCCEEDED` và `FAILED`, state `UNKNOWN` hoặc reconciliation khi liên quan provider, authorization cho status/result resource, cùng hướng dẫn `Retry-After` hoặc `Link`. Body chỉ nói “accepted” mà không có status durable chỉ là optimistic acknowledgment.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q4","q":"Deprecation & versioning thực chiến: rollout và tắt một version cũ thế nào cho an toàn?","a":"(04-rest-grpc-webflux.protocols.q4) nói *chọn kiểu versioning*. Câu này là phần khó hơn: [[o:tắt version cũ mà không gãy ai]].\n\n**Quy trình 5 bước:**\n\n1. **Đo trước** — log `api_version` + `client_id` trên mọi request. Không có số liệu thì không được tắt gì cả.\n2. **Báo hiệu bằng header** — trên chính response của version cũ:\n   - `Deprecation: @1735689600` (RFC 9745, timestamp Unix)\n   - `Sunset: Sat, 01 Nov 2026 00:00:00 GMT` (RFC 8594)\n   - `Link: &lt;https://docs.acme.vn/migrate/v2&gt;; rel=\"deprecation\"`\n3. **Liên hệ trực tiếp** top client theo lưu lượng — header không tự đọc email hộ ai.\n4. **Brownout** — chủ ý trả [[b:503]] vài phút mỗi ngày, tăng dần. Client còn sống sẽ hiện lỗi và người ta sẽ gọi bạn *trước* deadline thay vì sau.\n5. **Tắt** — trả [[b:410 Gone]] kèm Problem Details chỉ sang docs migration, không phải 404.\n\n:::deep\nNguyên tắc vàng: [[g:thay đổi thêm vào (additive) không cần version mới]]. Thêm field optional, thêm enum value *có tài liệu*, thêm endpoint — client viết đúng sẽ bỏ qua field lạ.\n\n[[r:Breaking]] thì luôn cần version: xoá/đổi tên field, đổi kiểu, siết validation, đổi ngữ nghĩa field cũ, đổi status code trả về.\n\n- [[o:Bẫy enum]]: thêm giá trị enum mới *là* breaking với client dùng `switch` không có `default`. Ghi trong tài liệu ngay từ v1: 'client phải chấp nhận giá trị enum chưa biết.'\n- consumer-driven contract test (Pact) bắt breaking change ở CI, trước khi nó lên prod\n- chạy song song tối đa [[o:2 version]]; version thứ 3 xuất hiện là dấu hiệu quy trình deprecation đã hỏng\n- v2 nên là [[g:adapter mỏng]] trước cùng một core domain, không phải fork code — fork là nhân đôi bug fix\n- khoảng deprecation hợp lý: 6–12 tháng cho API công khai, 1–3 tháng cho internal\n\nNói được bước 4 (brownout) là điểm cộng lớn — rất ít ứng viên nhắc tới.\n\n**Contract lifecycle nhìn thấy trên wire (RFC 9745 + RFC 8594):**\n<pre><code>HTTP/1.1 200 OK\nDeprecation: @1798761600\nSunset: Wed, 30 Jun 2027 23:59:59 GMT\nLink: &lt;/docs/migrate-v2&gt;; rel=\"deprecation\"; type=\"text/html\"\n# sau thời điểm sunset đã thông báo\nHTTP/1.1 410 Gone\nContent-Type: application/problem+json\nLink: &lt;/docs/migrate-v2&gt;; rel=\"deprecation\"\n{\"type\":\"https://api.example.test/problems/version-retired\",\n \"title\":\"API version retired\",\"status\":410}</code></pre>\n\n`Deprecation` dùng structured date theo epoch-second; `Sunset` dùng HTTP date và không được sớm hơn.\n\n- **Ưu điểm:** client và inventory scanner phát hiện lifecycle state mà không scrape release note.\n- **Giới hạn:** header không tự migrate ai. Đo traffic theo client, báo owner, chạy brownout có thể đảo ngược và giữ rollback tới khi hiểu residual use.\n:::\n\n:::tip Tắt version là migration có quan sát, không phải một ngày ghi trong tài liệu\nĐo traffic theo client, version, tenant và operation trước khi chọn ngày tắt. Công bố owner, compatibility rule, warning/deprecation signal, ví dụ migration, kế hoạch brownout/canary và rollback; giữ telemetry đến khi client cuối cùng chuyển xong.\n\nDeprecation header và sunset date chỉ truyền đạt ý định, không thay cho enforcement, authorization hay migration đã test.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q5","difficulty":"advanced","q":"Cursor pagination, HTTP caching, conditional request và rate-limit field nên phối hợp như thế nào?","a":"Hãy thiết kế chúng thành một contract có thể quan sát; mỗi cơ chế có scope khác nhau.\n\n**Cursor pagination:** dùng total order ổn định và unique như `(created_at, id)` cùng keyset predicate thay cho offset sâu.\n\nCursor phải opaque và có version; encode hoặc lưu phía server last sort tuple kèm filter/order và, khi sản phẩm cần traversal lặp lại được, snapshot hay high-water mark. Ký hoặc authenticate cursor hiển thị cho client, đặt expiry policy, clamp page size và trả link hoặc `next_cursor`.\n\nPhải định nghĩa ý nghĩa của insert, delete và update giữa các page—opaque cursor không tự tạo snapshot consistency.\n\n<pre><code>GET /bookings?status=CONFIRMED&amp;limit=50&amp;cursor=eyJ2IjoyLC4uLn0\n200 OK\nETag: \"page-7f42\"\nCache-Control: private, max-age=30\n{\"items\":[...],\"next_cursor\":\"eyJ2IjoyLC4uLn0\"}</code></pre>\n\n**Caching và precondition:** ETag định danh representation của response đó, gồm variant phụ thuộc authorization và query parameter. `If-None-Match` có thể trả `304 Not Modified`; cấu hình `Cache-Control` và `Vary` để shared cache không trộn user hay representation.\n\nVới write, `If-Match` có thể bảo vệ versioned resource và trả `412 Precondition Failed` khi stale. Nó không thay thế domain idempotency key.\n\n**Rate limit:** dùng `429 Too Many Requests` và `Retry-After` khi hữu ích. Tại 2026-08-01, công việc IETF về field `RateLimit-Policy`/`RateLimit` vẫn là Internet-Draft `draft-ietf-httpapi-ratelimit-headers-11`, chưa phải RFC.\n\nNếu áp dụng, pin draft/version trong API contract và không vô tình trộn structured-field semantics của nó với field `X-RateLimit-*` cũ. Giá trị quota là hint, không phải authorization hay service guarantee.\n\n:::deep\nTrả cursor hết hạn/không hợp lệ và precondition failure dưới dạng RFC 9457 problem type ổn định (17-rest-api-design.contracts-errors-lifecycle.q2). Không lộ database key, tenant information, capacity hoặc signed state có thể bị sửa.\n\nCached page có thể chứa quota field cũ; client nên ưu tiên `Retry-After` và contract đã công bố, còn server luôn phải tự enforce limit.\n\nKiểm thử record bị lặp/bỏ sót khi có concurrent mutation, cursor replay giữa user hoặc filter khác nhau, behavior 304 qua CDN/proxy thật, ETag đổi khi representation đổi, caching của 429, clock skew và client backoff.\n:::"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q6","q":"Bạn phải gửi webhook tới hàng trăm endpoint của đối tác mà mình không kiểm soát. Hệ thống đó thật sự cần những gì?","a":"Phát webhook biến bạn thành HTTP client tới những server chậm, sai, hoặc đã biến mất — mà vẫn nợ từng bên một lần giao. Hãy coi nó là một queue có retry, đừng bao giờ coi là một lời gọi nằm trong chính request sinh ra event.\n\n<pre><code>transaction nghiệp vụ commit &#8594; dòng outbox\n        &#8594; dispatcher lấy ra &#8594; gửi tới từng subscriber\n        &#8594; 2xx: xong | 4xx: dừng | 5xx hoặc timeout: hẹn retry\n        &#8594; hết lượt retry &#8594; dead-letter + đánh dấu subscriber không khoẻ</code></pre>\n\n**Mỗi phần bảo vệ bạn khỏi điều gì:**\n\n- [[g:ký payload]] — HMAC trên body thô kèm header timestamp, để bên nhận chứng minh được payload là của bạn và từ chối bản phát lại\n- [[g:retry có chặn, có backoff và jitter]] — một lịch công bố rõ (ví dụ 1 phút, 5 phút, 30 phút, 2 giờ, 6 giờ) để đối tác suy luận được, không phải vòng lặp vô hạn\n- [[g:cách ly theo từng subscriber]] — một đối tác timeout 30 giây không được ăn hết worker mà mọi đối tác khác đang chờ (25-microservice.01-cascading-failure-retry-storm.q4)\n- [[g:nhật ký giao]] — lần thử, status, một đoạn response, lần retry kế tiếp — vì câu hỏi hỗ trợ đầu tiên luôn là \"bên tôi không hề nhận được\"\n\n<table class=\"cmp\"><thead><tr><th>Bảo đảm</th><th>Bạn hứa được gì</th></tr></thead><tbody>\n<tr><td>Giao hàng</td><td>at-least-once — nên phải kèm `event_id` ổn định</td></tr>\n<tr><td>Thứ tự</td><td>không có; hãy kèm `occurred_at` và một sequence theo từng tài nguyên</td></tr>\n<tr><td>Thời điểm</td><td>cố gắng hết sức; một đối tác chết là mọi thứ phía sau bị trễ theo</td></tr>\n<tr><td>Payload</td><td>một contract có version, không được đổi âm thầm</td></tr>\n</tbody></table>\n\n:::warn URL của subscriber là input do kẻ khác kiểm soát\nAi đăng ký endpoint là người chọn chỗ server của bạn gửi traffic tới. Hãy kiểm địa chỉ đã resolve và gửi qua đường egress bị siết, nếu không đăng ký webhook chính là SSRF (13-security-oauth2.secure-coding-at-the-boundary.q4).\n:::\n\n:::deep\n- sinh event từ [[o:chính transaction]] đã đổi dữ liệu, thông qua outbox. Bắn HTTP ngay trong transaction là buộc lần commit của bạn vào uptime của đối tác (08-message-queue.reliability-delivery-semantics.q7).\n- cho mỗi subscriber [[b:hai secret cùng hiệu lực]] trong lúc xoay khoá để họ đổi mà không cần deploy đồng bộ; ký bằng khoá mới và chấp nhận cả hai trong một cửa sổ (13-security-oauth2.designing-the-auth-system.q4).\n- tự động tắt endpoint đã lỗi nhiều ngày và bắt bật lại thủ công. Retry mãi một URL đã chết là cách queue giao tin biến thành đống tồn không ai xử lý nổi.\n- hãy coi replay là một tính năng — \"gửi lại các event trong khoảng này\" — nếu không mỗi sự cố của đối tác lại thành một job chạy tay trên database của bạn.\n- cảnh báo theo latency giao và tỉ lệ lỗi của từng subscriber, đừng cảnh báo theo tổng; một đối tác hỏng là vô hình trong tỉ lệ thành công gộp (20-observability-sre.slos-alerting-incidents.q2).\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q7","q":"Một payment provider gửi webhook tới bạn. Handler phải làm gì trước khi tin dù chỉ một field?","a":"Một webhook đi vào là endpoint công khai không authenticate, mang theo mệnh lệnh liên quan tới tiền. Thứ tự các bước chính là biện pháp kiểm soát.\n\n<pre><code><span class=\"k\">@PostMapping</span>(<span class=\"s\">\"/webhooks/psp\"</span>)\nResponseEntity&lt;Void&gt; <span class=\"f\">receive</span>(<span class=\"k\">@RequestBody</span> <span class=\"k\">byte</span>[] raw,\n                             <span class=\"k\">@RequestHeader</span>(<span class=\"s\">\"X-Signature\"</span>) String sig,\n                             <span class=\"k\">@RequestHeader</span>(<span class=\"s\">\"X-Timestamp\"</span>) String ts) {\n    <span class=\"k\">if</span> (!signatures.valid(raw, ts, sig)) <span class=\"k\">return</span> ResponseEntity.status(<span class=\"n\">401</span>).build();\n    <span class=\"k\">if</span> (clock.instant().minus(TOLERANCE).isAfter(Instant.parse(ts)))\n        <span class=\"k\">return</span> ResponseEntity.status(<span class=\"n\">400</span>).build();          <span class=\"c\">// ngoài cửa sổ chống replay</span>\n<span class=\"c\">    </span>\n    inbox.recordIfNew(eventIdOf(raw));                    <span class=\"c\">// unique index = khử trùng lặp</span>\n    <span class=\"k\">return</span> ResponseEntity.accepted().build();             <span class=\"c\">// xử lý bất đồng bộ</span>\n}</code></pre>\n\n**Thứ tự có ý nghĩa:**\n\n- verify chữ ký trên [[g:byte thô]], trước khi parse — body đã serialize lại thì không còn khớp, và parse input không tin cậy tự nó đã là một bề mặt tấn công (13-security-oauth2.secure-coding-at-the-boundary.q3)\n- so sánh theo [[g:thời gian hằng]], và từ chối mọi thứ ngoài dung sai timestamp để một request bị bắt lại không thể phát lại vào ngày mai\n- [[g:xác nhận nhanh, xử lý sau]] — provider timeout trong vài giây rồi retry, nên làm việc nặng ngay trong handler là tự chế ra bản trùng\n- [[g:khử trùng lặp theo event id của provider]] bằng một unique constraint, vì at-least-once là bảo đảm duy nhất họ cho bạn (25-microservice.09-idempotency-the-central-link.q1)\n\n<table class=\"cmp\"><thead><tr><th>Tình huống</th><th>Phản hồi sai</th><th>Phản hồi đúng</th></tr></thead><tbody>\n<tr><td>Chữ ký không hợp lệ</td><td>lặng lẽ bỏ qua</td><td>401 và cảnh báo — có người đang dò</td></tr>\n<tr><td>Event đã xử lý rồi</td><td>xử lý lại</td><td>2xx, không làm gì cả</td></tr>\n<tr><td>Event tới sai thứ tự</td><td>áp dụng mù</td><td>so trạng thái hoặc sequence, bỏ qua cái cũ hơn</td></tr>\n<tr><td>Handler của bạn đang hỏng</td><td>trả 200 cho nó thôi retry</td><td>5xx, để provider retry trong lúc bạn sửa</td></tr>\n<tr><td>Loại event lạ</td><td>báo lỗi</td><td>2xx, ghi lại, bỏ qua</td></tr>\n</tbody></table>\n\n:::warn Đừng bao giờ để payload là tiếng nói cuối cùng về tiền\nSố tiền và trạng thái trong body webhook là một thông báo, không phải nguồn sự thật. Với mọi thứ dính tài chính, hãy xác nhận lại qua API của provider trước khi ghi có (09-distributed-tx-fintech.correctness-where-money-is-involved.q1).\n:::\n\n:::deep\n- [[o:webhook cộng với polling]] mới là cặp đáng tin: webhook làm ca thông thường nhanh, còn job đối soát bắt những cái chưa từng được giao. Đứng riêng thì cái nào cũng thiếu.\n- lưu payload thô và header trước khi xử lý. Khi đối tác tranh cãi về kết quả, đúng những byte đã nhận là bằng chứng duy nhất bạn có.\n- để endpoint này ra ngoài chuỗi auth thông thường nhưng vẫn nằm trong rate limiting; nó buộc phải công khai, và nếu không giới hạn thì thành mục tiêu khuếch đại miễn phí.\n- trả `409` hay `422` không dạy provider được gì — phần lớn họ cài \"retry khi 5xx, bỏ khi 4xx\", nên hãy chọn nhóm status một cách có chủ đích (17-rest-api-design.contracts-errors-lifecycle.q2).\n- test các nhánh xấu: giao trùng, tới sai thứ tự, chữ ký từ secret đã xoay, và payload của một thực thể bạn chưa từng thấy (26-testing-strategy.testing-what-usually-breaks.q3).\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q8","q":"Nên model large upload như một API resource thế nào?","a":"Hãy model upload session như một durable resource thay vì giữ một HTTP request mở trong thời gian dài.\n\nMột contract điển hình:\n\n1. <code>POST /uploads</code> xác thực owner và trả <code>201 Created</code> với upload ID, giới hạn object, part size, expiry, checksum algorithm và upload URL hoặc hướng dẫn direct-storage.\n2. Client upload từng part với upload ID, part number hoặc byte range, size và checksum. Retry của part phải quay lại cùng session và part; không tạo business object thứ hai.\n3. <code>GET /uploads/{id}</code> trả các part đã nhận, progress, expiry và state rõ ràng: <code>INITIATED</code>, <code>PARTIAL</code>, <code>VERIFYING</code>, <code>COMPLETE</code>, <code>ABORTED</code> hoặc <code>EXPIRED</code>.\n4. <code>POST /uploads/{id}/complete</code> gửi hoặc xác nhận manifest. Server kiểm tra owner, danh sách part, size và integrity trước khi publish immutable object.\n5. <code>DELETE /uploads/{id}</code> hoặc expiry job abort part chưa hoàn tất và giải phóng temporary storage.\n\nChỉ sau khi completion đã durable, API mới enqueue downstream processing và trả <code>202 Accepted</code> cho job chạy lâu. Completion phải conditional và idempotent; request lặp lại trả cùng result hoặc conflict đã document.\n\nĐặt limit ở mọi proxy, bảo vệ session khỏi cross-tenant access và dọn các part bị bỏ quên.\n\n:::deep\nDirect multipart/resumable với object storage giảm application bandwidth, nhưng không loại bỏ trách nhiệm về authorization, expiry, checksum, reconciliation và lifecycle. Upload resource chưa phải business record authoritative cho tới khi completion pass.\n:::","difficulty":"advanced"},{"id":"17-rest-api-design.contracts-errors-lifecycle.q9","q":"Khi nào 202 Accepted mới là contract trung thực cho long-running job?","a":"202 Accepted nghĩa là request đã được nhận để xử lý; không có nghĩa work đã thành công, sẽ chạy đúng một lần hay có thể cancel miễn phí.\n\nTrước khi trả 202, phải tạo durable job identity và persist đủ intent để recover: owner và authorization scope, input hoặc object version, idempotency key, state, timestamps, attempt policy và status URL.\n\nRetry với cùng client intent phải trả hoặc resume đúng job đó, không enqueue duplicate.\n\nHãy định nghĩa rõ state và ownership: <code>ACCEPTED</code>, <code>RUNNING</code>, <code>SUCCEEDED</code>, <code>FAILED</code>, <code>CANCELLED</code>, <code>EXPIRED</code> và <code>UNKNOWN</code> khi chưa xác định được outcome của worker/provider.\n\nWorker claim cần lease hoặc visibility deadline, retry có giới hạn, checkpoint semantics và quy tắc cho side effect đã commit. Cancellation là cooperative trừ khi hệ thống chứng minh được chưa có side effect thoát ra ngoài.\n\nChỉ trả progress khi nó có ý nghĩa và monotonic; expose result resource hoặc error problem type, đồng thời có reconciliation cho ambiguous timeout.\n\nQueue, Kubernetes Job hay workflow engine chỉ cung cấp execution primitive, không tự động cung cấp idempotency, authorization, cancellation hay exactly-once guarantee cho API.\n\n:::tip Phân định ownership\nTopic 17 sở hữu wire contract. Topic 08 sở hữu broker delivery semantics; Topic 25 sở hữu consumer retry và deduplication; các topic domain quyết định side effect nào cần compensation hoặc consistency mạnh.\n:::","difficulty":"advanced"}]}]},"hasVi":true,"stem":"17-rest-api-design","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q6":"traffic-caching-building-blocks","10-system-design-rate-limit.surviving-high-load.q1":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q2":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q3":"surviving-high-load","10-system-design-rate-limit.surviving-high-load.q4":"surviving-high-load","10-system-