:"System design + rate limit"},"vi":{"label":"System design + rate limit"}},"11":{"en":{"label":"System design cases"},"vi":{"label":"System design cases"}},"12":{"en":{"label":"Architecture & patterns"},"vi":{"label":"Architecture & patterns"}},"13":{"en":{"label":"Security & OAuth2"},"vi":{"label":"Security & OAuth2"}},"14":{"en":{"label":"DevOps · K8s · best practices"},"vi":{"label":"DevOps · K8s · best practices"}},"15":{"en":{"label":"Network & I/O models"},"vi":{"label":"Network & I/O models"}},"16":{"en":{"label":"Project · concurrency · whiteboard"},"vi":{"label":"Project · concurrency · whiteboard"}},"17":{"en":{"label":"REST API design"},"vi":{"label":"Thiết kế REST API"}},"18":{"en":{"label":"Query optimisation"},"vi":{"label":"Tối ưu query"}},"19":{"en":{"label":"DSA & LeetCode"},"vi":{"label":"DSA & LeetCode"}},"20":{"en":{"label":"Observability & SRE"},"vi":{"label":"Observability & SRE"}},"21":{"en":{"label":"Linux & production debug"},"vi":{"label":"Linux & production debug"}},"22":{"en":{"label":"Low-level design / OOD"},"vi":{"label":"Low-level design / OOD"}},"23":{"en":{"label":"Java concurrency coding"},"vi":{"label":"Java concurrency coding"}},"24":{"en":{"label":"Domain-Driven Design"},"vi":{"label":"Domain-Driven Design"}},"25":{"en":{"label":"Microservices at Scale — Technical Mastery Track"},"vi":{"label":"Microservices at Scale — Technical Mastery Track"}},"26":{"en":{"label":"Testing"},"vi":{"label":"Testing"}},"27":{"en":{"label":"API Gateway & Identity Edge"},"vi":{"label":"API Gateway & Identity Edge"}},"28":{"en":{"label":"Distributed Lock & Lease"},"vi":{"label":"Distributed Lock & Lease"}}},"reviewedAt":{"06-db-scaling.replication-consistency.q2":"2026-08-23","06-db-scaling.replication-consistency.q4":"2026-08-17","06-db-scaling.sharding-partitioning.q8":"2026-08-23"},"lang":"vi","body":{"sections":[{"title":"Replication & nhất quán","items":[{"id":"06-db-scaling.replication-consistency.q1","q":"Replication async/semi-sync/sync khác gì? Replication lag gây hệ quả gì?","a":"<figure class='dgm'><svg viewBox='0 0 680 220' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11.5' text-anchor='middle'>\n<rect x='270' y='30' width='140' height='44' rx='6' fill='#E4F1EB' stroke='#0B6E4F'/><text x='340' y='50' fill='#085239' font-weight='600'>PRIMARY</text><text x='340' y='66' fill='#42536C'>nhận mọi WRITE</text>\n<rect x='60' y='140' width='150' height='44' rx='6' fill='#fff' stroke='#42536C'/><text x='135' y='160' fill='#14233A'>Replica 1</text><text x='135' y='176' fill='#7E8DA3'>READ</text>\n<rect x='265' y='140' width='150' height='44' rx='6' fill='#fff' stroke='#42536C'/><text x='340' y='160' fill='#14233A'>Replica 2</text><text x='340' y='176' fill='#7E8DA3'>READ</text>\n<rect x='470' y='140' width='150' height='44' rx='6' fill='#fff' stroke='#42536C'/><text x='545' y='160' fill='#14233A'>Replica 3</text><text x='545' y='176' fill='#7E8DA3'>READ</text>\n<g stroke='#3D4E8F' stroke-width='1.6' stroke-dasharray='5 4' marker-end='url(#ar4)'>\n<line x1='300' y1='74' x2='150' y2='138'/><line x1='340' y1='74' x2='340' y2='138'/><line x1='380' y1='74' x2='530' y2='138'/></g>\n<text x='200' y='112' fill='#3D4E8F'>async replicate (có LAG)</text>\n<defs><marker id='ar4' markerWidth='9' markerHeight='9' refX='7' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#3D4E8F'/></marker></defs>\n<text x='340' y='208' text-anchor='middle' fill='#AE4536'>Read-your-writes: route đọc về primary vài giây sau khi ghi · semi-sync: đợi 1 replica ack</text>\n</svg></figure>\n\n- [[b:Async]]: primary commit trả về ngay, replica apply sau → có [[r:lag]] (đọc replica thấy data cũ)\n- [[b:Semi-sync]]: primary đợi ≥1 replica ack mới commit → giảm lag/tăng durability, đổi lấy write latency\n- [[b:Sync]]: đợi mọi replica → an toàn nhất, chậm nhất\n\n[[r:Hệ quả lag]]: 'tôi vừa chuyển tiền sao số dư chưa đổi?' khi đọc nhầm replica chậm.\n\n:::deep\nHai loại lag:\n- [[b:apply lag]]: replica chậm replay\n- [[b:transport lag]]: mạng\n\nĐo bằng `Seconds_Behind_Master` (thô) hoặc heartbeat table (chính xác hơn).\n\n- [[r:Bẫy semi-sync]]: replica duy nhất chết → primary có thể *degrade về async* → phải cấu hình ngưỡng & cảnh báo\n- Aurora tách storage/compute → 'replica' đọc cùng volume → lag mili-giây (khác hẳn binlog replication)\n\nOTA: 'lịch sử/loyalty' đọc replica thoải mái; 'số dư ví / booking vừa tạo' phải [[g:read-your-writes]] về writer.\n**Đo lag cho trung thực:**\n<pre><code><span class=\"c\">-- Postgres: chậm bao nhiêu byte, theo từng replica. write/flush/replay KHÁC nhau;</span>\n<span class=\"c\">-- replay_lag mới là cái mà một lần đọc dữ liệu cũ thực sự gặp.</span>\n<span class=\"k\">SELECT</span> client_addr, state, sync_state,\n       <span class=\"f\">pg_wal_lsn_diff</span>(<span class=\"f\">pg_current_wal_lsn</span>(), replay_lsn) <span class=\"k\">AS</span> bytes_behind,\n       write_lag, flush_lag, replay_lag\n<span class=\"k\">FROM</span> pg_stat_replication;\n<span class=\"c\">--</span>\n<span class=\"c\">-- Table heartbeat: con số lag duy nhất còn trung thực khi primary rảnh</span>\n<span class=\"c\">-- (Seconds_Behind_Master báo 0 khi không có traffic).</span>\n<span class=\"k\">SELECT</span> <span class=\"f\">NOW</span>() - ts <span class=\"k\">AS</span> real_lag <span class=\"k\">FROM</span> repl_heartbeat <span class=\"k\">WHERE</span> id = <span class=\"n\">1</span>;</code></pre>\n\n`Seconds_Behind_Master` nói dối theo hai hướng: nó báo [[r:0 khi primary rảnh]] dù replica đang tụt rất xa, và nó chỉ đo latency *apply*, bỏ sót hoàn toàn transport lag. Một dòng heartbeat update mỗi giây trên primary biến lag thành con số theo đồng hồ thật — thứ có thể alert và đưa vào SLO.\n:::","difficulty":"core"},{"id":"06-db-scaling.replication-consistency.q2","q":"Đảm bảo read-after-write consistency khi đọc từ replica?","a":"- [[g:Read-your-writes]]: sau khi ghi, route read của user đó về primary trong vài giây\n- [[g:Version/LSN check]]: chỉ đọc replica đã apply tới vị trí commit của user (Aurora hỗ trợ)\n- [[g:Sticky/monotonic reads]]: cùng một replica đủ mới\n\n:::tip Fintech\nsố dư & data core đọc từ primary; chỉ đẩy report/lịch sử cũ/analytics sang replica.\n:::\n\n:::deep\n- [[b:read-your-writes]]: route đọc của user vừa-ghi về primary trong window vài giây (sticky theo user/session)\n- [[b:LSN/GTID gating]]: ghi xong nhận vị trí log, chỉ đọc replica đã apply tới đó (Aurora/Postgres)\n- [[b:monotonic reads]]: cùng một replica cho một phiên để không 'lùi thời gian'\n\n[[r:Bẫy]]: load balancer round-robin giữa replica có lag khác nhau → user thấy data nhảy.\n\nQuy tắc: data vừa ghi mà user kỳ vọng thấy ngay → primary.\n\n**Lower-bound token PostgreSQL chạy được — đợi replay rồi fallback về primary:**\n<pre><code>-- cùng primary session, ngay sau COMMIT\nSELECT pg_current_wal_flush_lsn() AS required_lsn;  -- ví dụ 0/16B6C50\n-- trên replica được chọn\nSELECT pg_last_wal_replay_lsn() &gt;= '0/16B6C50'::pg_lsn AS caught_up;\n-- f = đợi với deadline ngắn, hoặc route read này về primary\n-- t = replica đã replay ít nhất tới lower bound yêu cầu</code></pre>\n\nFlush LSN có thể gồm WAL đồng thời không liên quan, nên đây là lower bound an toàn nhưng đôi khi bảo thủ—không phải vị trí chính xác của “row của tôi”. Chỉ mang token cho workflow cần monotonic read.\n\n- **Ưu điểm:** phần lớn read sau đó vẫn có thể dùng replica.\n- **Chi phí:** truyền token và chờ làm tốn latency; fallback primary tiêu thụ capacity write node.\n- **An toàn:** không chờ vô hạn hoặc so LSN thuộc timeline khác sau failover.\n:::","difficulty":"advanced"},{"id":"06-db-scaling.replication-consistency.q3","q":"Master-slave vs multi-master — trade-off?","a":"<table class=\"cmp\"><thead><tr><th></th><th>Single-primary</th><th>Multi-master</th></tr></thead><tbody>\n<tr><td>Ghi</td><td>1 nơi</td><td>nhiều nơi</td></tr>\n<tr><td>Write conflict</td><td>không có</td><td>phải giải (LWW/CRDT/app)</td></tr>\n<tr><td>Điểm yếu</td><td>bottleneck + SPOF (cần failover)</td><td>phức tạp, dễ mất nhất quán</td></tr>\n<tr><td>Hợp cho</td><td>đa số hệ (nhất là ledger)</td><td>multi-region availability cao</td></tr>\n</tbody></table>\n\nFintech [[r:hiếm khi multi-master]] cho ledger.\n\n:::deep\n- single-primary: đơn giản, không xung đột ghi, nhưng bottleneck + SPOF → cần failover tự động (Patroni/Orchestrator/RDS Multi-AZ) với rủi ro [[r:split-brain]] (hai primary) nếu fencing kém → cần quorum/STONITH\n- multi-master: ghi nhiều nơi (đa region latency thấp) nhưng phải giải *write conflict* (LWW mất data, CRDT cho kiểu hợp nhất được, app resolve)\n\nFintech/OTA: ledger gần như không multi-master; multi-region thường single-primary-per-region + phân vùng theo region (data residency) + replicate đọc. Active-active chỉ cho data chịu eventual (catalog, session).\n:::","difficulty":"extra"},{"id":"06-db-scaling.replication-consistency.q4","difficulty":"advanced","q":"Case: thêm sáu node vào cụm Cassandra/ScyllaDB và số dư của một số khách hàng bắt đầu trả về rỗng. Các nghi phạm là gì, và tách chúng ra bằng cách nào?","a":"Bắt đầu từ triệu chứng, vì chính nó là manh mối: [[r:row thiếu không phải là lỗi]]. Một read do replica chưa từng nhận write phục vụ sẽ trả về *không có row nào*, nên ứng dụng hiển thị số dư rỗng thay vì báo lỗi.\n\nCâu hỏi vì vậy luôn là \"replica nào đã trả lời, và vì sao nó không có gì?\"\n\n**Nghi phạm, kiểm tra cái rẻ trước:**\n\n1. [[b:Phép toán consistency]] — an toàn cần `R + W > RF`. Với `RF = 3`, QUORUM cả hai phía thì giao nhau (2 + 2 > 3); `ONE`/`ONE` thì không, và một thay đổi topology mở rộng đúng khoảng thời gian lộ ra điều đó. Hãy kiểm tra consistency level mặc định của driver, không chỉ câu lệnh đang nhìn.\n2. [[r:Node join mà không stream dữ liệu]] — `auto_bootstrap: false` chép từ runbook \"node đầu tiên của một cụm mới\" khiến node nhận token range rồi phục vụ read với con số không phía sau. Lỗ hổng xuất hiện ngay và không tự lành.\n3. [[r:Sáu node cùng lúc]] — node phải bootstrap từng cái một, cái trước hiện `UN` trong `nodetool status` rồi cái sau mới bắt đầu. Ép join song song, vượt qua guard consistent range movement, làm quyền sở hữu chuyển trước khi dữ liệu kịp chuyển.\n4. `nodetool cleanup` chạy quá sớm — cleanup xoá phần mà node không còn sở hữu, nên chạy trước khi streaming và repair hội tụ sẽ xoá đúng những row mà chủ mới chưa nhận được.\n5. Hint hết hạn — replica chết lâu hơn hint window (mặc định ba giờ) sẽ không được hinted handoff đuổi kịp, và chỉ repair mới sửa được.\n\n**Phép thử quyết định là theo từng key, không phải theo cả cụm:**\n<pre><code><span class=\"c\">-- replica nào sở hữu khách hàng này?</span>\nnodetool getendpoints ledger balances 8f3c1a2e\n<span class=\"c\">-- rồi hỏi với một replica, và xem coordinator làm gì</span>\nCONSISTENCY ONE; TRACING ON;\n<span class=\"k\">SELECT</span> * <span class=\"k\">FROM</span> ledger.balances <span class=\"k\">WHERE</span> customer_id = 8f3c1a2e;\n<span class=\"c\">-- ONE không thấy gì nhưng ALL trả ra row =&gt; một replica thiếu dữ liệu,</span>\n<span class=\"c\">-- chứ không phải write chưa bao giờ xảy ra</span></code></pre>\n\n:::warn Nâng consistency trước khi debug\nChuyển read và write sang LOCAL_QUORUM tốn thêm latency nhưng chặn được việc khách hàng nhìn thấy số dư rỗng, để việc điều tra diễn ra mà sự cố không chạy tiếp bên dưới.\n:::\n\n:::deep\n**Thứ tự khôi phục có ý nghĩa: repair trước, cleanup sau.** `nodetool repair -pr` trên mọi node, hoặc một dịch vụ repair theo lịch, dựng lại phần mà các replica mới đang thiếu; xong rồi `cleanup` mới xoá phần các node cũ không còn sở hữu.\n\nNode đã join với `auto_bootstrap: false` thì không repair mà thay — decommission nó rồi cho bootstrap lại cho đúng.\n\n**Phải biết version của mình hứa gì về topology.** Luật mỗi lần một node tồn tại vì quyền sở hữu từng đổi trước khi dữ liệu kịp đổi.\n\nScyllaDB đã đưa thay đổi topology lên Raft để chính cụm điều phối việc join, Cassandra cũng đang đi hướng đó. Hãy xác nhận release của bạn làm gì thay vì thừa hưởng luật nào đó từ một bài blog.\n\n**Khiếm khuyết thật sự nằm phía trên database.** Một ô `balance` mutable trong store eventually consistent không có read-modify-write nào an toàn: hai writer ở QUORUM vẫn ghi đè nhau, và last-write-wins xử lý xung đột bằng timestamp, một cách âm thầm.\n\nTiền cần một ledger chỉ ghi thêm rồi suy ra số dư (09-distributed-tx-fintech.correctness-where-money-is-involved.q3), hoặc một lightweight transaction (Paxos, `IF` kèm SERIAL) trả giá cho compare-and-set.\n\nDù chọn đường nào, reconciliation lẽ ra phải phát hiện chuyện này trước khách hàng vẫn là bắt buộc (09-distributed-tx-fintech.correctness-where-money-is-involved.q6).\n:::"}]},{"title":"Sharding & partitioning","items":[{"id":"06-db-scaling.sharding-partitioning.q1","q":"Partitioning vs sharding khác gì? Chọn shard key thế nào?","a":"<figure class='dgm'><svg viewBox='0 0 680 220' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11.5' text-anchor='middle'>\n<rect x='250' y='24' width='180' height='42' rx='6' fill='#E7EAF6' stroke='#3D4E8F'/><text x='340' y='44' fill='#3D4E8F' font-weight='600'>Router / shard map</text><text x='340' y='60' fill='#42536C'>hash(account_id)</text>\n<g stroke='#C6CFDC' stroke-width='1.6' marker-end='url(#ar5)'>\n<line x1='300' y1='66' x2='130' y2='130'/><line x1='340' y1='66' x2='340' y2='130'/><line x1='380' y1='66' x2='550' y2='130'/></g>\n<rect x='50' y='132' width='160' height='56' rx='6' fill='#E4F1EB' stroke='#0B6E4F'/><text x='130' y='154' fill='#085239' font-weight='600'>Shard 1</text><text x='130' y='172' fill='#42536C'>acct id % 3 == 0</text>\n<rect x='260' y='132' width='160' height='56' rx='6' fill='#E4F1EB' stroke='#0B6E4F'/><text x='340' y='154' fill='#085239' font-weight='600'>Shard 2</text><text x='340' y='172' fill='#42536C'>== 1</text>\n<rect x='470' y='132' width='160' height='56' rx='6' fill='#E4F1EB' stroke='#0B6E4F'/><text x='550' y='154' fill='#085239' font-weight='600'>Shard 3</text><text x='550' y='172' fill='#42536C'>== 2</text>\n<defs><marker id='ar5' markerWidth='9' markerHeight='9' refX='7' refY='3' orient='auto'><path d='M0,0 L7,3 L0,6 z' fill='#9AA6B8'/></marker></defs>\n<text x='340' y='208' text-anchor='middle' fill='#AE4536'>Mọi transaction của 1 account nằm cùng shard &#8594; tránh JOIN/transaction xuyên shard</text>\n</svg></figure>\n\n- [[b:Partitioning]]: chia 1 table thành nhiều partition trong *cùng DB* (range/hash/list) → prune partition, quản data cũ\n- [[b:Sharding]]: chia data ra *nhiều node độc lập* → scale ghi & dung lượng vượt 1 máy\n\n[[g:Shard key tốt]]: cardinality cao, phân bố đều (tránh hotspot), khớp pattern truy vấn chính.\n\nFintech thường shard theo `account_id` để transaction của 1 user cùng shard (không cross-shard).\n\n:::deep\nBa khái niệm hay bị hỏi chung:\n- [[b:Partition]] = chia table trong 1 node (range theo tháng cho `booking` để prune + drop partition cũ nhanh)\n- [[b:Sharding]] = chia ra nhiều node (theo `user_id`)\n- [[b:Composite index]] = index nhiều cột phục vụ pattern truy vấn (không phải chia data)\n\nMột table có thể *vừa* partition theo range *vừa* có composite index trong mỗi partition.\n\n[[r:Bẫy shard]]: `flight_id` làm shard key → hotspot ở chuyến hot; `user_id` phân bố đều nhưng 'tất cả booking của 1 chuyến' thành scatter-gather. Chốt: shard key bám *truy vấn nóng nhất*, chấp nhận trade-off cho truy vấn phụ (đẩy sang read model riêng).\n:::","difficulty":"advanced"},{"id":"06-db-scaling.sharding-partitioning.q2","q":"Resharding vì sao đau? Consistent hashing giúp gì?","a":"<figure class='dgm'><svg viewBox='0 0 680 280' xmlns='http://www.w3.org/2000/svg' font-family='IBM Plex Mono, monospace' font-size='11.5' text-anchor='middle'>\n<circle cx='250' cy='140' r='100' fill='none' stroke='#C6CFDC' stroke-width='2'/>\n<g fill='#0B6E4F'><circle cx='250' cy='40' r='9'/><circle cx='337' cy='190' r='9'/><circle cx='163' cy='190' r='9'/></g>\n<text x='250' y='28' fill='#085239'>Node A</text><text x='370' y='205' fill='#085239'>Node B</text><text x='130' y='205' fill='#085239'>Node C</text>\n<g fill='#AE4536'><circle cx='320' cy='75' r='6'/><circle cx='290' cy='235' r='6'/><circle cx='150' cy='95' r='6'/></g>\n<text x='345' y='72' fill='#AE4536'>k1</text><text x='300' y='255' fill='#AE4536'>k2</text><text x='128' y='92' fill='#AE4536'>k3</text>\n<text x='250' y='150' fill='#42536C'>key &#8594; node kế</text><text x='250' y='168' fill='#42536C'>tiếp theo chiều kim</text>\n<g font-size='11' text-anchor='start' fill='#42536C'>\n<text x='430' y='70' fill='#085239' font-weight='600'>Thêm node mới:</text>\n<text x='430' y='92'>chỉ remap 1 lát key giữa node</text>\n<text x='430' y='110'>mới và node kế &#8212; KHÔNG xáo trộn</text>\n<text x='430' y='128'>toàn bộ (như hash % N).</text>\n<text x='430' y='160' fill='#3D4E8F' font-weight='600'>Virtual nodes:</text>\n<text x='430' y='182'>mỗi node ánh xạ tới nhiều điểm</text>\n<text x='430' y='200'>trên vòng &#8594; phân bố đều hơn,</text>\n<text x='430' y='218'>tránh hotspot.</text></g>\n</svg></figure>\n\nResharding phải di chuyển data + đổi mapping khi đang chạy.\n\n[[g:Consistent hashing]]: ánh xạ key & node lên một vòng băm.\n- thêm/bớt node chỉ remap một phần nhỏ key (thay vì gần như toàn bộ với modulo)\n- [[g:virtual node]] giúp cân bằng\n\nMẹo: over-provision nhiều 'logical shard' từ đầu để giãn dễ.\n\n:::warn Mất mát khi shard\nJOIN/transaction xuyên shard, AUTO_INCREMENT toàn cục, aggregation phải scatter-gather. [[r:Đừng shard sớm]] — tối ưu index/replica/cache trước.\n:::\n\n:::deep\n- mỗi physical node chỉ 1 điểm trên vòng → phân bố lệch + mất node dồn tải sang đúng 1 node kế\n- gán mỗi node ~100–200 vnode rải đều → mất node thì tải phân tán, thêm node thì 'cướp' đều một ít từ mọi node (kỹ thuật Cassandra/DynamoDB)\n\nHạn chế consistent hashing thuần:\n- vẫn cần *rebalance* data + xử lý replica (replicate sang N node kế trên vòng)\n- [[r:range query]] là yêu cầu chính → hash phá locality → dùng range sharding + directory thay vì hash\n:::","difficulty":"advanced"},{"id":"06-db-scaling.sharding-partitioning.q3","q":"Sinh ID toàn cục khi đã shard: Snowflake vs UUID?","a":"Mất auto-increment toàn cục khi shard → cần ID duy nhất phân tán.\n\n<table class=\"cmp\"><thead><tr><th></th><th>Snowflake</th><th>UUIDv4</th><th>UUIDv7</th></tr></thead><tbody>\n<tr><td>Cấu tạo</td><td>timestamp+machine+seq (64-bit)</td><td>ngẫu nhiên 128-bit</td><td>time-ordered 128-bit</td></tr>\n<tr><td>Index-friendly</td><td>tốt (tuần tự thời gian)</td><td>tệ (page split)</td><td>tốt</td></tr>\n<tr><td>Cần phối hợp</td><td>machine id + clock sync</td><td>không</td><td>không</td></tr>\n</tbody></table>\n\n:::deep\n- [[b:Snowflake]] 64-bit = timestamp(41b)+machine(10b)+sequence(12b) → tuần tự theo thời gian (thân thiện B+Tree, ít split), sortable, ~4096 id/ms/node; cần clock sync + xử lý clock-skew/leap\n- [[b:UUIDv4]] ngẫu nhiên (không phối hợp nhưng phá locality → split, phình secondary index); [[b:UUIDv7]] time-ordered khắc phục\n- hoặc *ticket server*/*hi-lo* cấp khoảng id\n\nOTA: `booking_id`/`pnr` nên sortable theo thời gian (Snowflake/UUIDv7) để index ghi tốt + tiện keyset pagination + [[o:lộ ít thông tin volume]] (tránh id tuần tự liên tục để đối thủ không đoán lượng booking).\n:::","difficulty":"core"},{"id":"06-db-scaling.sharding-partitioning.q4","q":"Giải thích CAP và PACELC. Fintech nghiêng phía nào?","a":"- [[b:CAP]]: khi có Partition phải chọn Consistency hoặc Availability (P bất khả kháng)\n- [[b:PACELC]]: nếu Partition chọn A/C; Else (bình thường) vẫn trade-off Latency vs Consistency\n\nFintech:\n- core ledger/số dư = [[g:CP]] (thà từ chối còn hơn sai tiền)\n- ngoại vi (feed, lịch sử hiển thị) = [[o:AP/eventual]]\n\n:::tip Chốt\nđừng trả lời CAP chung chung — nói rõ 'phần nào CP, phần nào AP'.\n:::\n\n:::deep\n- khi [[b:P]]artition → chọn A hay C; [[b:E]]lse (không partition) → vẫn trade-off Latency vs Consistency (đọc primary mạnh-nhất-quán nhưng chậm/xa, hay đọc replica nhanh nhưng có thể cũ)\n- ví dụ: DynamoDB = PA/EL (ưu availability+latency), Spanner = PC/EC (ưu consistency, trả giá latency bằng TrueTime)\n\nFintech/OTA nói rõ *theo từng phần*:\n- ledger/số dư/giữ ghế = [[g:CP/EC]] (thà từ chối/chậm còn hơn sai tiền/bán trùng)\n- search/availability/feed/loyalty = [[o:AP/EL]] (nhanh, chấp nhận cũ)\n:::","difficulty":"advanced"},{"id":"06-db-scaling.sharding-partitioning.q5","q":"Distributed consensus (Raft/Paxos) dùng để làm gì — nắm ở mức nào?","a":"[[g:Consensus]] (Raft/Paxos): nhiều node đồng thuận một giá trị/log thứ tự bất chấp lỗi node (leader election, replicated log).\n\nNền của etcd, Kafka controller (KRaft), Consul, DB phân tán.\n\nSenior cần hiểu [[o:khái niệm]] (quorum, leader, log replication, tại sao số lẻ node) hơn là tự cài đặt.\n\n:::deep\n- [[b:Raft]] (dễ hiểu hơn Paxos): leader election + replicated log + [[g:quorum]] (đa số N/2+1, nên số lẻ: 3 chịu mất 1, 5 chịu mất 2)\n- một entry commit khi đa số đã ghi → nhất quán bất chấp mất minority\n- nền của etcd (K8s), Consul, Kafka KRaft (thay Zookeeper), CockroachDB/TiDB\n\n- vì sao [[o:số lẻ]]: tránh tie + tối ưu fault tolerance/cost\n- vì sao [[o:quorum]]: bất kỳ hai đa số luôn giao nhau (không hai leader hợp lệ đồng thời)\n- consensus thường 'ẩn' trong hạ tầng (leader election cho scheduler/distributed lock) — biết khi nào nó đang dùng là đủ\n:::","difficulty":"extra"},{"id":"06-db-scaling.sharding-partitioning.q6","q":"N+1 trong JPA/Hibernate — phát hiện và xử lý?","a":"[[r:N+1]]: 1 query danh sách N parent → mỗi lần truy cập association lazy bắn thêm 1 query.\n\n**Fix theo ngữ cảnh:**\n- `JOIN FETCH`/`@EntityGraph` (eager có chủ đích)\n- `default_batch_fetch_size`/`@BatchSize` (gom IN → N/k+1)\n- [[g:DTO projection]] cho màn read-heavy\n\nĐừng EAGER toàn cục; cảnh giác `LazyInitializationException`.\n\n:::deep\n- phát hiện: bật `spring.jpa.show-sql`/Hibernate statistics hoặc datasource-proxy đếm query trong dev — N+1 lộ ra là 'một danh sách → N query con'\n- trị: `JOIN FETCH`/`@EntityGraph`, `@BatchSize`/`hibernate.default_batch_fetch_size` (N+1 → N/k+1), hoặc [[g:DTO projection]] (chỉ lấy cột cần)\n\n[[r:Bẫy]]: `JOIN FETCH` nhiều collection cùng lúc → cartesian product phình kết quả; fetch một collection mỗi query.\n\nOTA: màn danh sách booking + segments + passengers dễ N+1 → dùng projection/2 query batch thay lazy lặp.\n\n- Cùng vấn đề nhìn từ tầng ứng dụng (batch, fetch size, statement timeout) ở 18.8\n- còn nếu tách domain khỏi entity JPA thì phần lớn N+1 biến mất cùng lazy loading (12-architecture-patterns.clean-layered-building-it-for-real.q2).\n**Ba cách sửa, và cách thứ ba nổ ngay lúc khởi động:**\n<pre><code><span class=\"c\">// 1. @EntityGraph - khai báo, không cần JPQL, đi kèm Pageable được</span>\n<span class=\"k\">@EntityGraph</span>(attributePaths = {<span class=\"s\">\"segments\"</span>})\nPage&lt;Booking&gt; <span class=\"f\">findByUserId</span>(Long userId, Pageable page);\n<span class=\"c\">    </span>\n<span class=\"c\">// 2. JOIN FETCH - tường minh, nhưng pagination diễn ra TRONG BỘ NHỚ</span>\n<span class=\"k\">@Query</span>(<span class=\"s\">\"select distinct b from Booking b join fetch b.segments where b.userId = :u\"</span>)\nList&lt;Booking&gt; <span class=\"f\">findWithSegments</span>(<span class=\"k\">@Param</span>(<span class=\"s\">\"u\"</span>) Long u);\n<span class=\"c\">    </span>\n<span class=\"c\">// 3. Fetch hai collection cùng lúc -&gt; MultipleBagFetchException, ngay lúc STARTUP</span>\n<span class=\"k\">@Query</span>(<span class=\"s\">\"select b from Booking b join fetch b.segments join fetch b.passengers\"</span>)\n<span class=\"r\">// org.hibernate.loader.MultipleBagFetchException: cannot simultaneously fetch multiple bags</span></code></pre>\n\nSửa case 3 bằng cách fetch mỗi query một collection rồi để Hibernate ghép cái thứ hai trong cùng persistence context, hoặc đổi collection từ `List` sang `Set`. Nên dùng `@EntityGraph` kèm `hibernate.default_batch_fetch_size=100` — graph lo association mình biết, batch fetch đỡ cho những cái mình quên.\n:::","difficulty":"core"},{"id":"06-db-scaling.sharding-partitioning.q7","q":"CDC (Change Data Capture) / Debezium dùng để làm gì?","a":"[[g:CDC]] đọc *binlog/WAL* của DB → phát stream 'data đã đổi' mà không cần app dual-write.\n\nDebezium đẩy vào Kafka, dùng cho:\n- đồng bộ sang hệ khác\n- cập nhật cache/search index\n- triển khai [[g:Outbox]] hiệu quả (đọc table outbox qua binlog)\n\nĐảm bảo at-least-once → consumer [[o:idempotent]].\n\n:::deep\n- CDC đọc *transaction log* (MySQL binlog / Postgres WAL logical decoding) → phát stream 'row đã đổi' KHÔNG cần app dual-write (giải bài toán atomic DB↔event)\n- Debezium → Kafka: đồng bộ search/cache, data lake, triển khai Outbox (đọc table outbox qua binlog thay vì poll)\n- at-least-once + giữ thứ tự theo PK → consumer phải idempotent\n\n[[r:Bẫy]]: schema change, snapshot ban đầu (đọc toàn table) tốn tài nguyên, 'tombstone' khi delete.\n\nOTA: CDC từ DB booking để cập nhật search index 'còn ghế', đồng bộ loyalty/analytics, materialize read model — tách service mà vẫn eventual consistency.\n:::","difficulty":"extra"},{"id":"06-db-scaling.sharding-partitioning.q8","difficulty":"advanced","q":"Chọn partition hoặc shard key thế nào, và migrate sang key tốt hơn mà không mất correctness?","a":"Bắt đầu từ access pattern và invariant, không bắt đầu từ hàm hash. Chấm một candidate key theo các chiều:\n\n- read locality: query phổ biến có trả lời trong một partition không, hay request nào cũng fan-out?\n- write distribution: một tenant, product, account hay time bucket có thành hotspot không?\n- tenant isolation và privacy: tenant lớn có ăn hết failure/capacity budget của tenant nhỏ không?\n- growth và lifecycle: partition có bounded không, dữ liệu cũ có archive/drop được không?\n- luật cross-partition: uniqueness, ordering, counter hay transaction nào trở nên khó hơn?\n- migration cost: có backfill online và cutover có repair được không?\n\n**Mỗi kiểu key đánh đổi một thứ:**\n- time bucket giúp chặn partition phình vô hạn nhưng query sẽ phải chạm boundary\n- tenant key giữ locality nhưng có thể dồn tenant lớn vào một chỗ\n- salt/bucket key chia write nhưng cần fan-out bounded và làm mất total order đơn giản\n\nConsistent hashing giúp thay đổi placement; nó không giải quyết một hot key đơn lẻ hay invariant xuyên shard.\n\n**Migration an toàn:** `DISCOVER -> BACKFILL -> DUAL_VERIFY -> DUAL_READ/CUTOVER -> DRAIN -> RETIRE`.\n- ghi source position/checkpoint và làm copy idempotent\n- apply write sau snapshot boundary\n- so counts/checksums và invariant ngữ nghĩa, tính cả delete/tombstone\n- ramp traffic theo tenant hoặc cell\n\nGiữ route cũ để rollback cho tới khi route mới qua stability window đã đo.\n\nGlobal uniqueness và ordering cần owner rõ ràng: database constraint tại một authority, chiến lược namespace/ID, hoặc workflow chấp nhận reconciliation eventual. Shard map chỉ trả lời “key nằm ở đâu” chưa phải là thiết kế correctness.\n\n:::deep\nĐo skew, kích thước partition p95/p99, tỷ lệ của hot key, cross-partition fan-out, replication/repair lag và error class trong migration. Average load có thể vẫn đẹp trong khi một tenant hoặc key đã vượt budget.\n:::"}]}]},"hasVi":true,"stem":"06-db-scaling","sourceOwners":{"10-system-design-rate-limit.framework-building-blocks.q1":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q2":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q7":"design-review-framework","11-system-design-cases.the-big-prompts.q12":"design-review-framework","11-system-design-cases.the-big-prompts.q21":"design-review-framework","10-system-design-rate-limit.framework-building-blocks.q3":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q4":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks.q5":"traffic-caching-building-blocks","10-system-design-rate-limit.framework-building-blocks